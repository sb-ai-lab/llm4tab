def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_DE'] = df_input['Credit history rating'].isin(['E1', 'E2', 'E3', 'D1', 'D2', 'D3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_gt_0_9_Initial_limit'] = (df_input['Debt'] > df_input['Initial limit'] * 0.9).astype(int)
    df_output['INCOME_lt_1000'] = (df_input['INCOME'] < 1000).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_ge_60_and_INCOME_lt_1500'] = ((df_input['TERM'] >= 60) & (df_input['INCOME'] < 1500)).astype(int)
    df_output['SEX_Male_and_Credit_history_C123_and_PDN_gt_0_25'] = ((df_input['SEX'] == 'Male') & 
                                                                     df_input['Credit history rating'].isin(['C1', 'C2', 'C3']) & 
                                                                     (df_input['PDN'] > 0.25)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2_and_INCOME_lt_1500'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 2) & 
                                                                   (df_input['INCOME'] < 1500)).astype(int)
    df_output['FAMILYSTATUS_2_and_PDN_gt_0_3'] = ((df_input['FAMILYSTATUS'] == 2) & (df_input['PDN'] > 0.3)).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_less_0_25'] = (df_input['PDN'] < 0.25).astype(int)
    df_output['Debt_less_half_Initial_limit'] = (df_input['Debt'] < df_input['Initial limit'] * 0.5).astype(int)
    df_output['INCOME_gte_1800'] = (df_input['INCOME'] >= 1800).astype(int)
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['TERM_lte_60_and_INCOME_gte_2000'] = ((df_input['TERM'] <= 60) & (df_input['INCOME'] >= 2000)).astype(int)
    df_output['SEX_Female_and_Credit_history_A1_A3'] = ((df_input['SEX'] == 'Female') & (df_input['Credit history rating'].isin(['A1', 'A3']))).astype(int)
    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Production', 'Transport/Logistic']).astype(int)
    df_output['FAMILYSTATUS_1_and_UNDERAGECHILDRENCOUNT_lte_1'] = ((df_input['FAMILYSTATUS'] == 1) & (df_input['UNDERAGECHILDRENCOUNT'] <= 1)).astype(int)
    return df_output

