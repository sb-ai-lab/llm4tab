def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_C1_C3_D1_D2_D3_E1_E2_E3'] = df_input['Credit history rating'].isin(['C1', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_gte_0_30'] = (df_input['PDN'] >= 0.30).astype(int)
    df_output['Debt_gt_5000'] = (df_input['Debt'] > 5000).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Initial_limit_lte_8000'] = (df_input['Initial limit'] <= 8000).astype(int)
    df_output['INCOME_lt_1800'] = (df_input['INCOME'] < 1800).astype(int)
    df_output['EDU_in_High_school_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_gte_60_and_Credit_history_rating_in_C1_E1'] = ((df_input['TERM'] >= 60) & (df_input['Credit history rating'].isin(['C1', 'E1']))).astype(int)
    df_output['SEX_Female_and_PDN_gte_0_35'] = ((df_input['SEX'] == 'Female') & (df_input['PDN'] >= 0.35)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_gte_1_and_PDN_gte_0_25'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 1) & (df_input['PDN'] >= 0.25)).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A1_A2_A3_B1_B2_B3'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_less_than_0_30'] = (df_input['PDN'] < 0.30).astype(int)
    df_output['Initial_limit_greater_than_8000'] = (df_input['Initial limit'] > 8000).astype(int)
    df_output['INCOME_greater_equal_1800'] = (df_input['INCOME'] >= 1800).astype(int)
    df_output['Debt_less_equal_3000'] = (df_input['Debt'] <= 3000).astype(int)
    df_output['Overdue_days_equal_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM_less_equal_60_and_Credit_history_rating_in_A1_A3'] = ((df_input['TERM'] <= 60) & (df_input['Credit history rating'].isin(['A1', 'A3']))).astype(int)
    df_output['INDUSTRYNAME_in_Finance_Insurance_Production_Transport_Logistic'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Production', 'Transport/Logistic']).astype(int)
    df_output['FAMILYSTATUS_in_1_2'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)
    return df_output

