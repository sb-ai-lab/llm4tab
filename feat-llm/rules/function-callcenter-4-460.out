def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_is_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_le_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_lt_3'] = (df_input['Satisfaction_with_the_doctors_response'] < 3.0).astype(int)
    df_output['Call_151_is_Yes'] = (df_input['Call_151'] == 'Yes').astype(int)
    df_output['Aware_151_is_Yes_and_Satisfaction_lt_3'] = ((df_input['Aware_151'] == 'Yes') & (df_input['Satisfaction_with_the_doctors_response'] < 3.0)).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_lt_2_5'] = (df_input['Call_center_employee_communication_skills_evaluation'] < 2.5).astype(int)
    df_output['How_often_do_you_receive_call_center_news_lt_3'] = (df_input['How_often_do_you_receive_call_center_news'] < 3.0).astype(int)
    df_output['Nationality_Other_and_Communication_skills_le_3'] = ((df_input['Nationality'] == 'Other nationality') & (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0)).astype(int)
    df_output['Age_18_24_and_The_reason_of_the_call_Complaints'] = ((df_input['Age'] == '18-24') & (df_input['The_reason_of_the_call'] == 'Complaints')).astype(int)
    df_output['Education_High_school_or_Less_and_Satisfaction_lt_3'] = (((df_input['Education'] == 'High school') | (df_input['Education'] == 'Less than high school')) & (df_input['Satisfaction_with_the_doctors_response'] < 3.0)).astype(int)
    return df_output

