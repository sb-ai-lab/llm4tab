def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call_in_selected'] = df_input['The_reason_of_the_call'].isin(['Inquiries', 'Inquiries_COVID19', 'Medical_Consultation', 'Vaccination']).astype(int)
    df_output['Call_151_No_Aware_151_Yes_Satisfaction_ge_3'] = ((df_input['Call_151'] == 'No') & (df_input['Aware_151'] == 'Yes') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['How_often_do_you_receive_call_center_news_ge_3'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3.0).astype(int)
    df_output['Age_50_59_or_60_and_above_Satisfaction_ge_3'] = (df_input['Age'].isin(['50-59', '60 and above']) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['Gender_Female_Communication_skills_ge_3'] = ((df_input['Gender'] == 'Female') & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)
    df_output['Nationality_Kuwaiti_Satisfaction_ge_3'] = ((df_input['Nationality'] == 'Kuwaiti') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['Marital_Status_Married_Communication_skills_ge_3'] = ((df_input['Marital_Status'] == 'Married') & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)
    education_order = ['Less than high school', 'High school', 'Diploma', 'Bachelor', 'Master', 'Doctor', 'Other']
    edu_rank = {k: v for v, k in enumerate(education_order)}
    edu_series = df_input['Education'].map(edu_rank)
    bachelor_rank = edu_rank['Bachelor']
    df_output['Education_Bachelor_or_higher_Satisfaction_ge_3'] = ((edu_series >= bachelor_rank) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    return df_output