def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call_not_Complaints'] = (df_input['The_reason_of_the_call'] != 'Complaints').astype(int)
    df_output['Call_151_No_and_Satisfaction_ge_3'] = ((df_input['Call_151'] == 'No') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['How_often_do_you_receive_call_center_news_ge_3'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3.0).astype(int)
    df_output['Age_50_59_or_60_and_above_and_Satisfaction_ge_3'] = ((df_input['Age'].isin(['50-59', '60 and above'])) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['Nationality_Kuwaiti_and_Communication_skills_ge_3'] = ((df_input['Nationality'] == 'Kuwaiti') & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)
    df_output['Education_Bachelor_or_higher_and_Satisfaction_ge_3'] = ((df_input['Education'].isin(['Bachelor', 'Master', 'Doctor'])) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['Aware_151_Yes_and_Satisfaction_ge_3'] = ((df_input['Aware_151'] == 'Yes') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['Marital_Status_Widow_or_Widower_and_Satisfaction_ge_3'] = ((df_input['Marital_Status'].isin(['Widow', 'Widower'])) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    return df_output

