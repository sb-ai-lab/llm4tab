def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call'] = (~df_input['The_reason_of_the_call'].isin(['Complaints'])).astype(int)
    df_output['Call_151'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['How_often_do_you_receive_call_center_news'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3.0).astype(int)
    df_output['Nationality'] = (df_input['Nationality'] == 'Kuwaiti').astype(int)
    df_output['Age'] = df_input['Age'].isin(['50-59', '60 and above']).astype(int)
    df_output['Education'] = df_input['Education'].isin(['Diploma', 'Bachelor', 'Master', 'Doctor']).astype(int)
    df_output['Marital_Status'] = df_input['Marital_Status'].isin(['Widow', 'Widower']).astype(int)
    df_output['Governorate'] = df_input['Governorate'].isin(['Capital', 'Farwaniya', 'Around']).astype(int)
    return df_output

