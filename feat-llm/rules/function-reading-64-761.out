def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_3'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    freq_map = {
        'On everyday basis': 'Daily',
        'A few times a week': 'Weekly',
        'A few times a month': 'A few times a month',
        'Less than once a year': 'Less than once a year',
        'Once or twice a year': 'Once or twice a year'
    }
    freq_values = ['Daily', 'Weekly', 'A few times a month']
    freq_mapped = df_input['Frequency of reading books'].map(freq_map)
    df_output['Frequency_of_reading_books_in_Daily_Weekly_A_few_times_a_month'] = freq_mapped.isin(freq_values).astype(int)
    printed_books_values = ['6-10', '11-15', '16-20', 'More than 20']
    df_output['Number_of_printed_books_read_last_two_years_in_6_10_11_15_16_20_More_than_20'] = df_input['Number of printed books you read last two years'].isin(printed_books_values).astype(int)
    ebooks_values = ['6-10', '11-15', '16-20', 'More than 20']
    df_output['Number_of_e_books_read_last_two_years_in_6_10_11_15_16_20_More_than_20'] = df_input['Number of e-books you read last two years'].isin(ebooks_values).astype(int)
    dept_values = ['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT', 'Textile']
    df_output['Department_in_selected'] = df_input['Department'].isin(dept_values).astype(int)
    df_output['Change_after_reading_books_is_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    manage_books_values = ['Buy', 'E-books', 'Used-all']
    df_output['How_to_manage_books_for_reading_in_Buy_E_books_Used_all'] = df_input['How to manage books for reading'].isin(manage_books_values).astype(int)
    fav_books_values = ['Non-Fiction', 'Biography']
    df_output['Favorite_books_for_reading_in_Non_Fiction_Biography'] = df_input['Favorite books for reading to spend leisure time'].isin(fav_books_values).astype(int)
    influenced_values = ['Self-Decision', 'Teachers']
    df_output['Who_influenced_you_to_read_books_in_Self_Decision_Teachers'] = df_input['Who influenced you to read books'].isin(influenced_values).astype(int)
    return df_output

