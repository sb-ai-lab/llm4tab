def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'Textile', 'CIS', 'MCT']).astype(int)
    df_output['Time_spent_reading_2_or_more'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Frequency_reading_selected'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Ebooks_read_selected'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Printed_books_read_selected'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Change_after_reading_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Influenced_by_Teachers'] = (df_input['Who influenced you to read books'] == 'Teachers').astype(int)
    df_output['Favorite_books_NonFiction_Biography'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Manage_books_Buy_Usedall'] = df_input['How to manage books for reading'].isin(['Buy', 'Used-all']).astype(int)
    return df_output

