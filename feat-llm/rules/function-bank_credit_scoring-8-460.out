def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Credit_history_rating_condition'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1', 'C2', 'C3']).astype(int)  
    df_output['PDN_condition'] = (df_input['PDN'] < 0.2).astype(int)  
    df_output['Debt_condition'] = (df_input['Debt'] <= 3000).astype(int)  
    df_output['INCOME_condition'] = (df_input['INCOME'] >= 1000).astype(int)  
    df_output['EDU_condition'] = df_input['EDU'].isin(['University', 'College']).astype(int)  
    df_output['Initial_limit_condition'] = (df_input['Initial limit'] >= 2500).astype(int)  
    df_output['Overdue_days_condition'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['TERM_condition'] = (df_input['TERM'] == 60).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT_condition'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)  
    df_output['FAMILYSTATUS_condition'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)  
    return df_output

