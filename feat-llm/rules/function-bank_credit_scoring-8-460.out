def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_D_E'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_22'] = (df_input['PDN'] >= 0.22).astype(int)
    df_output['Debt_ge_1790'] = (df_input['Debt'] >= 1790).astype(int)
    df_output['Initial_limit_le_2800'] = (df_input['Initial limit'] <= 2800).astype(int)
    df_output['INCOME_le_1700'] = (df_input['INCOME'] <= 1700).astype(int)
    df_output['EDU_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_C_and_PDN_ge_0_3'] = ((df_input['Credit history rating'].isin(['C1', 'C2', 'C3'])) & (df_input['PDN'] >= 0.3)).astype(int)
    df_output['FAMILYSTATUS_le_1'] = (df_input['FAMILYSTATUS'] <= 1).astype(int)
    df_output['TERM_ge_60_and_Debt_Income_ratio_gt_1_5'] = ((df_input['TERM'] >= 60) & ((df_input['Debt'] / df_input['INCOME']) > 1.5)).astype(int)
    return df_output

