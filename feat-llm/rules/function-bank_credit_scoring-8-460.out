def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Credit_history_rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)  
    df_output['PDN'] = (df_input['PDN'] < 0.15).astype(int)  
    df_output['Debt'] = (df_input['Debt'] < 3000).astype(int)  
    df_output['Overdue_days'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['Initial_limit'] = (df_input['Initial limit'] >= 2500).astype(int)  
    df_output['INCOME'] = (df_input['INCOME'] >= 2000).astype(int)  
    df_output['EDU'] = df_input['EDU'].isin(['University', 'College']).astype(int)  
    df_output['TERM'] = (df_input['TERM'] >= 48).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT'] = df_input['UNDERAGECHILDRENCOUNT'].isin([0,1]).astype(int)  
    df_output['FAMILYSTATUS'] = (df_input['FAMILYSTATUS'] == 2).astype(int)  
    return df_output