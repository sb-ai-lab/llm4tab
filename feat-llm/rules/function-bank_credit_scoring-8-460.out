def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3']).astype(int)  
    df_output['PDN'] = (df_input['PDN'] <= 0.28).astype(int)  
    df_output['Debt'] = (df_input['Debt'] <= 3000).astype(int)  
    df_output['Initial limit'] = (df_input['Initial limit'] >= 2800).astype(int)  
    df_output['INCOME'] = (df_input['INCOME'] >= 1000).astype(int)  
    df_output['EDU'] = df_input['EDU'].isin(['University', 'College']).astype(int)  
    df_output['Overdue days'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['FAMILYSTATUS'] = (df_input['FAMILYSTATUS'] >= 1).astype(int)  
    df_output['INDUSTRYNAME'] = df_input['INDUSTRYNAME'].isin(['Production', 'Agriculture', 'Construction', 'Information Technology']).astype(int)  
    df_output['Debt/INCOME and TERM'] = ((df_input['Debt'] / df_input['INCOME'] < 1.5) & (df_input['TERM'] == 60)).astype(int)  
    return df_output

