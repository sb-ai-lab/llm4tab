def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_bad'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_high'] = (df_input['PDN'] >= 0.2).astype(int)
    df_output['Debt_high'] = (df_input['Debt'] >= 2000).astype(int)
    df_output['INCOME_low'] = (df_input['INCOME'] <= 1700).astype(int)
    df_output['EDU_low'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['Initial_limit_low'] = (df_input['Initial limit'] <= 3000).astype(int)
    df_output['Overdue_days_positive'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['TERM_short'] = (df_input['TERM'] <= 60).astype(int)
    df_output['SEX_Male_low_income'] = ((df_input['SEX'] == 'Male') & (df_input['INCOME'] <= 1500)).astype(int)
    df_output['LV_AREA_selected'] = df_input['LV_AREA'].isin(['GRODNENSKAJa', 'Mogilevskaja oblast', "Gomel'skaja oblast"]).astype(int)
    return df_output

