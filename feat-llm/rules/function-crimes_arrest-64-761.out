def extracting_features_0(df_input):
    primary_types = ['BATTERY', 'THEFT', 'MOTOR VEHICLE THEFT', 'CRIMINAL DAMAGE', 'ASSAULT', 'WEAPONS VIOLATION']
    descriptions = ['SIMPLE', 'TO VEHICLE', 'OVER $500', 'AGGRAVATED - HANDGUN', 'AGGRAVATED - OTHER DANGEROUS WEAPON']
    location_descriptions = ['RESIDENCE', 'STREET', 'VEHICLE - OTHER RIDE SHARE SERVICE (LYFT, UBER, ETC.)', 'VEHICLE NON-COMMERCIAL', 'NURSING / RETIREMENT HOME']
    fbi_codes = ['04B', '04A', '06', '07', '14', '15']

    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(primary_types).astype(int)
    df_output['Description'] = df_input['Description'].isin(descriptions).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(location_descriptions).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(fbi_codes).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 700) & (df_input['Beat'] <= 900)).astype(int)
    df_output['District'] = ((df_input['District'] >= 2) & (df_input['District'] <= 8)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 3) & (df_input['Ward'] <= 27)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 19) & (df_input['Community Area'] <= 67)).astype(int)
    df_output['Year'] = (df_input['Year'] == 2025).astype(int)
    return df_output

