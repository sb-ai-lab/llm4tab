def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Debt'] = (df_input['Debt'] >= 900).astype(int)
    df_output['Overdue days'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] < 2000).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] < 2000).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3', 'C1', 'C2', 'C3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['LV_AREA'] = df_input['LV_AREA'].str.replace("'", "").str.strip().isin(['Brestskaja oblast', "Gomel'skaja oblast", 'Vitebskaja oblast', 'Mogilevskaja oblast']).astype(int)
    df_output['TERM'] = (df_input['TERM'] <= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 2).astype(int)
    return df_output

