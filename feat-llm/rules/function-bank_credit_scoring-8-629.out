def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Debt_lt_2000'] = (df_input['Debt'] < 2000).astype(int)
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Initial_limit_ge_1500'] = (df_input['Initial limit'] >= 1500).astype(int)
    df_output['INCOME_ge_1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['Credit_history_rating_in'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_lt_0_3'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['EDU_in'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['LV_AREA_in'] = df_input['LV_AREA'].str.lower().isin(['g. minsk', 'minskaja oblast', 'minskaja']).astype(int)
    df_output['TERM_ge_24'] = (df_input['TERM'] >= 24).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_le_1'] = (df_input['UNDERAGECHILDRENCOUNT'] <= 1).astype(int)
    return df_output

