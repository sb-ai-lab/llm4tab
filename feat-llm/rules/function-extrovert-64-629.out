def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['social_connection_frequency'].str.lower().isin(['weekly', 'daily', 'never'])) & (df_input['social_battery_recharge'] == 'Talking to someone')).astype(int)
    df_output['cond_2'] = (df_input['gathering_size_preference'].isin(['Small gatherings', 'Both'])).astype(int)
    df_output['cond_3'] = (df_input['valued_friendship_traits'] == 'Support').astype(int)
    df_output['cond_4'] = (df_input['conflict_resolution_style'].isin(['Talk it out', 'Apologize first', 'Let time fix it'])).astype(int)
    df_output['cond_5'] = (df_input['family_support_level'].str.lower().isin(['yes', 'sometimes'])).astype(int)
    df_output['cond_6'] = ((df_input['social_orientation_type'].isin(['Extrovert', 'Ambivert'])) & (df_input['social_battery_recharge'] == 'Talking to someone')).astype(int)
    df_output['cond_7'] = (df_input['emotional_expression_method'].isin(['Talk openly', 'Express emotion strongly'])).astype(int)
    df_output['cond_8'] = (df_input['social_anxiety_level'].isin(['Excited', 'Neutral'])).astype(int)
    df_output['cond_9'] = ((df_input['social_connection_frequency'] == 'Never') & (df_input['gathering_size_preference'] == 'Both') & (df_input['social_battery_recharge'] == 'Social media')).astype(int)
    df_output['cond_10'] = ((df_input['conflict_resolution_style'] == 'Let time fix it') & (df_input['family_support_level'].str.lower() == 'no') & (df_input['valued_friendship_traits'] == 'Support')).astype(int)
    return df_output

