def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['social_connection_frequency_in_weekly_monthly_daily_and_social_battery_recharge_social_media'] = ((df_input['social_connection_frequency'].str.lower().isin(['weekly', 'monthly', 'daily'])) & (df_input['social_battery_recharge'] == 'Social media')).astype(int)  
    df_output['gathering_size_preference_in_large_events_never'] = df_input['gathering_size_preference'].isin(['Large events', 'Never']).astype(int)  
    df_output['valued_friendship_traits_in_loyalty_honesty'] = df_input['valued_friendship_traits'].isin(['Loyalty', 'Honesty']).astype(int)  
    df_output['conflict_resolution_style_in_avoid_conflict_let_time_fix_it'] = df_input['conflict_resolution_style'].isin(['Avoid conflict', 'Let time fix it']).astype(int)  
    df_output['family_support_level_in_no_sometimes'] = df_input['family_support_level'].str.lower().isin(['no', 'sometimes']).astype(int)  
    df_output['social_orientation_type_in_introvert_ambivert_and_social_battery_recharge_social_media'] = ((df_input['social_orientation_type'].isin(['Introvert', 'Ambivert'])) & (df_input['social_battery_recharge'] == 'Social media')).astype(int)  
    df_output['emotional_expression_method_is_stay_silent'] = (df_input['emotional_expression_method'] == 'Stay silent').astype(int)  
    df_output['social_anxiety_level_is_nervous'] = (df_input['social_anxiety_level'] == 'Nervous').astype(int)  
    df_output['social_connection_frequency_monthly_and_gathering_size_preference_large_events'] = ((df_input['social_connection_frequency'] == 'Monthly') & (df_input['gathering_size_preference'] == 'Large events')).astype(int)  
    df_output['conflict_resolution_style_talk_it_out_and_family_support_level_sometimes_and_social_battery_recharge_social_media'] = ((df_input['conflict_resolution_style'] == 'Talk it out') & (df_input['family_support_level'].str.lower() == 'sometimes') & (df_input['social_battery_recharge'] == 'Social media')).astype(int)  
    return df_output

