    start_date = pd.to_datetime('01/04/2025 10:00:00 PM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/10/2025 11:59:00 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    df_output['Latitude'] = df_input['Latitude'].between(41.85, 41.90).astype(int)
    df_output['Longitude'] = df_input['Longitude'].between(-87.70, -87.60).astype(int)
    return df_output

