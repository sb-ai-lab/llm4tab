def extracting_features_1(df_input):  
    import pandas as pd  
    df_output = pd.DataFrame()  
  
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'HOMICIDE', 'ROBBERY']).astype(int)  
  
    df_output['Description_in_list'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY', 'ATTEMPT ARREST', 'AGGRAVATED']).astype(int)  
  
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'ALLEY']).astype(int)  
  
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)  
  
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['08B', '06', '01A']).astype(int)  
  
    df_output['Primary_Theft_and_Description_in_list'] = ((df_input['Primary Type'] == 'THEFT') &  
                                                          df_input['Description'].isin(['ATTEMPT ARREST', 'AGGRAVATED'])).astype(int)  
  
    def weekend_night_condition(date_str):  
        dt = pd.to_datetime(date_str, format='%m/%d/%Y %I:%M:%S %p')  
        day = dt.dayofweek  
        hour = dt.hour  
        minute = dt.minute  
        # weekend days: Saturday=5, Sunday=6  
        if day in [5,6]:  
            # time between 8:00 PM and 11:59 PM  
            if hour >= 20:  
                return 1  
            # time between 12:00 AM and 3:00 AM  
            if hour < 3:  
                return 1  
        return 0  
  
    df_output['Date_weekend_night'] = df_input['Date'].apply(weekend_night_condition)  
  
    df_output['Beat_in_range'] = df_input['Beat'].between(10, 50).astype(int)  
  
    df_output['Community_Area_in_range'] = df_input['Community Area'].between(10, 30).astype(int)  
  
    df_output['Year_ge_2024'] = (df_input['Year'] >= 2024).astype(int)  
  
    return df_output