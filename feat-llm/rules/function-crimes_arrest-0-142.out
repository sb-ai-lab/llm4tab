    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'CRIM SEXUAL ASSAULT', 'ROBBERY']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY', 'AGGRAVATED']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'ALLEY']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
