def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['THEFT', 'MOTOR VEHICLE THEFT', 'ROBBERY', 'CRIMINAL DAMAGE', 'OTHER OFFENSE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['RETAIL THEFT', 'OVER $500', 'ARMED - HANDGUN', 'TO PROPERTY', 'VEHICLE TITLE / REGISTRATION OFFENSE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['SMALL RETAIL STORE', 'DRUG STORE', 'APARTMENT', 'SIDEWALK', 'STREET']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['06', '07', '03', '14', '26']).astype(int)
    df_output['Primary_Type_THEFT_and_Description_RETAIL_THEFT'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT')).astype(int)
    df_output['Primary_Type_BATTERY_and_Description_AGGRAVATED_HANDGUN'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'AGGRAVATED - HANDGUN')).astype(int)
    df_output['Beat_in_range'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2600)).astype(int)
    df_output['District_in_range'] = ((df_input['District'] >= 10) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 20) & (df_input['Ward'] <= 50)).astype(int)
    return df_output

