def extracting_features_1(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'BATTERY', 'ASSAULT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['MANUFACTURE / DELIVER - COCAINE', 'UNLAWFUL POSSESSION - HANDGUN', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY', 'SIMPLE', 'POSSESS - HEROIN (WHITE)']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['SIDEWALK', 'STREET', 'BAR OR TAVERN', 'SCHOOL - PUBLIC GROUNDS', 'CHA APARTMENT']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].astype(str).isin(['18', '15', '08B', '08A']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 100) & (df_input['Beat'] <= 1700)).astype(int)
    df_output['District'] = ((df_input['District'] >= 1) & (df_input['District'] <= 16)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 4) & (df_input['Ward'] <= 38)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 27) & (df_input['Community Area'] <= 76)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/25/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)).astype(int)
    return df_output

