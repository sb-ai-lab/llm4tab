def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['NARCOTICS', 'ASSAULT', 'WEAPONS VIOLATION', 'BATTERY', 'OTHER OFFENSE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['MANUFACTURE / DELIVER - COCAINE', 'SIMPLE', 'UNLAWFUL POSSESSION - HANDGUN', 'OTHER VEHICLE OFFENSE', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY', 'POSSESS - HEROIN (WHITE)']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['SIDEWALK', 'CHA APARTMENT', 'STREET', 'SCHOOL - PUBLIC GROUNDS', 'BAR OR TAVERN']).astype(int)
    df_output['Domestic_is_0_or_1'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['18', '08A', '15', '08B', '26']).astype(int)
    df_output['Primary_NARCOTICS_and_Description_POSSESS_or_MANUFACTURE'] = ((df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'].str.contains('POSSESS|MANUFACTURE / DELIVER'))).astype(int)
    df_output['Primary_WEAPONS_and_Description_UNLAWFUL_POSSESSION_HANDGUN'] = ((df_input['Primary Type'] == 'WEAPONS VIOLATION') & (df_input['Description'] == 'UNLAWFUL POSSESSION - HANDGUN')).astype(int)
    df_output['Beat_in_range'] = ((df_input['Beat'] >= 100) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District_in_range'] = ((df_input['District'] >= 1) & (df_input['District'] <= 25)).astype(int)
    return df_output

