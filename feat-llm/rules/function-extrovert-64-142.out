def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Daily', 'Weekly']).astype(int)  
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.strip().str.title().isin(['Small Gatherings', 'Both']).astype(int)  
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.strip().str.capitalize().isin(['Support', 'Honesty']).astype(int)  
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.strip().str.title().isin(['Talk It Out', 'Apologize First']).astype(int)  
    df_output['family_support_level'] = df_input['family_support_level'].str.strip().str.capitalize().isin(['Yes', 'Sometimes']).astype(int)  
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.strip().str.title().isin(['Talking To Someone', 'Alone Time']).astype(int)  
    positive_comm = (df_output['social_connection_frequency'] & df_output['gathering_size_preference'] & df_output['valued_friendship_traits'] & df_output['conflict_resolution_style'] & df_output['family_support_level'] & df_output['social_battery_recharge'])  
    df_output['social_orientation_type'] = (df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Extrovert', 'Ambivert', 'Introvert']) & positive_comm).astype(int)  
    df_output['social_anxiety_level'] = (df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Excited', 'Neutral', 'Avoid It']) & positive_comm).astype(int)  
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.strip().str.title().isin(['Talk Openly', 'Express Emotion Strongly']).astype(int)  
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.strip().str.title().isin(['Injustice', 'Being Interrupted']).astype(int)  
    return df_output

