def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.lower().isin(['large events', 'never']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.lower().isin(['loyalty', 'honesty']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.lower().isin(['no', 'sometimes']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.lower().isin(['social media', 'none of the above']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.lower().isin(['selfishness', 'unnecessary criticism']).astype(int)

    # For social_orientation_type and social_anxiety_level, conditions depend on combination with other negative indicators
    # Define negative indicators for combination
    negative_social_orientation = df_input['social_orientation_type'].str.lower().isin(['not sure', 'extrovert'])
    avoidance_conflict = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it'])
    nervous_excited = df_input['social_anxiety_level'].str.lower().isin(['nervous', 'excited'])

    df_output['social_orientation_type'] = (negative_social_orientation & (df_output['conflict_resolution_style'] == 1)).astype(int)
    df_output['social_anxiety_level'] = (nervous_excited & (df_output['conflict_resolution_style'] == 1)).astype(int)

    return df_output

