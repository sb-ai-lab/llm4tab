def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['OTHER OFFENSE', 'OFFENSE INVOLVING CHILDREN', 'LIQUOR LAW VIOLATION', 'NON-CRIMINAL', 'MOTOR VEHICLE THEFT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['VEHICLE TITLE / REGISTRATION OFFENSE', 'SIMPLE', 'UNLAWFUL ENTRY', 'LOST PROPERTY']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'RESIDENCE', 'APARTMENT', 'SIDEWALK']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['26', '35', '10', '22']).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/10/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1500) & (df_input['Beat'] <= 1600)).astype(int)
    df_output['District'] = df_input['District'].isin([15, 8]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([23, 37]).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 20) & (df_input['Community Area'] <= 30)).astype(int)
    return df_output

