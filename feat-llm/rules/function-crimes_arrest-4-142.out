def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'NARCOTICS', 'ASSAULT', 'CRIM SEXUAL ASSAULT', 'ROBBERY']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['SIMPLE', 'AGGRAVATED', 'POSSESS - HEROIN (WHITE)', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['SMALL RETAIL STORE', 'SIDEWALK', 'STREET', 'CTA BUS STOP']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '18', '03', '04']).astype(int)
    df_output['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce').between(pd.to_datetime('01/11/2025 12:00:00 AM'), pd.to_datetime('01/29/2025 11:59:59 PM')).astype(int)
    df_output['Beat'] = df_input['Beat'].between(800, 1200).astype(int)
    df_output['District'] = df_input['District'].isin([8, 11]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([12, 28]).astype(int)
    df_output['Community Area'] = df_input['Community Area'].between(25, 60).astype(int)
    return df_output

