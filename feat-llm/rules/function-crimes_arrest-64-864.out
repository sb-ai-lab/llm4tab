def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'BATTERY', 'MOTOR VEHICLE THEFT', 'DECEPTIVE PRACTICE', 'OTHER OFFENSE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['SIMPLE', '$500 AND UNDER', 'THEFT FROM MOTOR VEHICLE', 'DOMESTIC BATTERY SIMPLE', 'FINANCIAL IDENTITY THEFT OVER $ 300', 'HARASSMENT BY TELEPHONE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['APARTMENT', 'STREET', 'RESTAURANT', 'CTA TRAIN', 'NURSING / RETIREMENT HOME']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '08B', '11', '07', '26']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 300) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District'] = ((df_input['District'] >= 1) & (df_input['District'] <= 18)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 3) & (df_input['Ward'] <= 33)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 69)).astype(int)
    dates = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025', format='%m/%d/%Y')
    end_date = pd.to_datetime('01/29/2025', format='%m/%d/%Y')
    df_output['Date'] = ((dates >= start_date) & (dates <= end_date)).astype(int)
    return df_output

