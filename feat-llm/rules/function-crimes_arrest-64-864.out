def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'OTHER OFFENSE', 'CRIMINAL DAMAGE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['POSSESS - PCP', 'POSSESS - CRACK', 'FALSE / STOLEN / ALTERED TRP', 'TO VEHICLE', 'GUN OFFENDER - DUTY TO REGISTER', 'UNLAWFUL POSSESSION - HANDGUN', 'POSSESS - CANNABIS MORE THAN 30 GRAMS']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'PARK PROPERTY', 'SIDEWALK', 'CTA BUS']).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['15', '18', '26', '14']).astype(int)
    df_output['Beat_in_range'] = (((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2000)) | ((df_input['Beat'] >= 2000) & (df_input['Beat'] <= 3000))).astype(int)
    df_output['District_in_range'] = ((df_input['District'] >= 10) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 10) & (df_input['Ward'] <= 45)).astype(int)
    df_output['Community_Area_in_range'] = ((df_input['Community Area'] >= 10) & (df_input['Community Area'] <= 52)).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date_in_range'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    return df_output

