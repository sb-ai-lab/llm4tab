def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.capitalize().isin(['Small gatherings', 'Both']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.capitalize().isin(['Loyalty', 'Support', 'All', 'All the three and trust', 'Understanding person']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.capitalize().isin(['Talk it out', 'Apologize first']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.capitalize().isin(['Yes', 'Sometimes']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.capitalize().isin(['Talking to someone', 'Alone time']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.capitalize().isin(['Extrovert', 'Ambivert']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.capitalize().isin(['Excited', 'Neutral']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.capitalize().isin(['Talk openly', 'Express emotion strongly']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.capitalize().isin(['Injustice', 'Selfishness']).astype(int)
    return df_output

