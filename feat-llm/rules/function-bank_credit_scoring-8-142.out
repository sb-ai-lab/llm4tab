def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue days > 0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit history rating in specified'] = df_input['Credit history rating'].isin(['C3', 'C1', 'C2', 'D3', 'D2', 'D1', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN >= 0.29'] = (df_input['PDN'] >= 0.29).astype(int)
    df_output['Debt >= 8000'] = (df_input['Debt'] >= 8000).astype(int)
    df_output['INCOME <= 1600'] = (df_input['INCOME'] <= 1600).astype(int)
    df_output['EDU in specified'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM >= 60'] = (df_input['TERM'] >= 60).astype(int)
    df_output['Initial limit <= 10000'] = (df_input['Initial limit'] <= 10000).astype(int)
    df_output['UNDERAGECHILDRENCOUNT >= 1'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['SEX Male and Credit history rating in D2,E1'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(['D2', 'E1']))).astype(int)
    return df_output

