def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue days'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] < 0.4).astype(int)
    df_output['Debt'] = (df_input['Debt'] < 11000).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 1600).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM'] = (df_input['TERM'] <= 60).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] >= 10000).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] == 0).astype(int)
    df_output['INDUSTRYNAME'] = df_input['INDUSTRYNAME'].isin(['Production', 'Construction', 'Public Administration', 'Ministry of Internal Affairs/Ministry of Emergency Situations/Ministry of Defense']).astype(int)
    return df_output

---VERSION---

def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_CDE'] = df_input['Credit history rating'].isin(['C3', 'C2', 'C1', 'D3', 'D2', 'D1', 'E3', 'E2', 'E1']).astype(int)
    df_output['PDN_ge_0_29'] = (df_input['PDN'] >= 0.29).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Initial_limit_lt_11000'] = (df_input['Initial limit'] < 11000).astype(int)
    df_output['INCOME_lt_2000'] = (df_input['INCOME'] < 2000).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['Debt_gt_8000'] = (df_input['Debt'] > 8000).astype(int)
    birthdate_parsed = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    df_output['BIRTHDATE_in_range'] = ((birthdate_parsed >= pd.Timestamp('1995-01-01')) & (birthdate_parsed <= pd.Timestamp('2003-12-31'))).astype(int)
    df_output['TERM_ge_60'] = (df_input['TERM'] >= 60).astype(int)
    df_output['SEX_Male_and_Credit_history_rating_in_DE'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(['D2', 'E1']))).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_less_0_4'] = (df_input['PDN'] < 0.4).astype(int)
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Initial_limit_ge_10000'] = (df_input['Initial limit'] >= 10000).astype(int)
    df_output['INCOME_ge_1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['Debt_lt_11000'] = (df_input['Debt'] < 11000).astype(int)
    df_output['BIRTHDATE_in_range'] = pd.to_datetime(df_input['BIRTHDATE']).between('1960-01-01', '1985-12-31').astype(int)
    df_output['FAMILYSTATUS_ge_1'] = (df_input['FAMILYSTATUS'] >= 1).astype(int)
    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Production', 'Public Administration', 'Ministry of Internal Affairs/Ministry of Emergency Situations/Ministry of Defense', 'Construction']).astype(int)
    return df_output

