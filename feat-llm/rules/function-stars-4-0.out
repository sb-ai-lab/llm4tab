def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Vmag'] = ((df_input['Vmag'] >= 7.0).astype(int))
    df_output['Plx'] = ((df_input['Plx'] <= 5.0).astype(int))
    df_output['B-V'] = ((df_input['B-V'] >= 0.5).astype(int))
    df_output['SpType'] = (df_input['SpType'].isin(['G1V', 'F3V', 'A0V', 'K5V', 'B8/B9V'])).astype(int)
    df_output['Amag'] = ((df_input['Amag'] >= 15.0).astype(int))
    df_output['Vmag_range'] = ((df_input['Vmag'].between(7.0, 9.0)).astype(int))
    df_output['Plx_range'] = ((df_input['Plx'].between(0.0, 5.0)).astype(int))
    df_output['B-V_range'] = ((df_input['B-V'].between(0.0, 0.5)).astype(int))
    df_output['SpType_range'] = (df_input['SpType'].isin(['K5V', 'G1V'])).astype(int)
    df_output['Amag_range'] = ((df_input['Amag'].between(15.0, 17.0)).astype(int))
    return df_output

