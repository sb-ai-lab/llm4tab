def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Vmag'] = (df_input['Vmag'] >= 7.0).astype(int)
    df_output['Plx'] = (df_input['Plx'] <= 5.0).astype(int)
    df_output['e_Plx'] = (df_input['e_Plx'] <= 1.0).astype(int)
    df_output['B-V'] = (df_input['B-V'] <= 0.5).astype(int)
    df_output['SpType'] = df_input['SpType'].isin(['G1V', 'F3V', 'A0V', 'K1V', 'M0V']).astype(int)
    df_output['Amag'] = (df_input['Amag'] >= 15.0).astype(int)
    df_output['Vmag_Plx'] = ((df_input['Vmag'] >= 6.5) & (df_input['Plx'] <= 6.0)).astype(int)
    df_output['B-V_SpType'] = ((df_input['B-V'] <= 0.7) & df_input['SpType'].isin(['G2V', 'K0V'])).astype(int)
    df_output['Amag_Vmag'] = ((df_input['Amag'] >= 15.5) & (df_input['Vmag'] > 7.0)).astype(int)
    df_output['Plx_range'] = ((df_input['Plx'] >= 0) & (df_input['Plx'] <= 5.0)).astype(int)
    return df_output

