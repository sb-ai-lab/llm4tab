def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Vmag_condition_1'] = (df_input['Vmag'] <= 7.0).astype(int)
    df_output['Plx_condition_1'] = (df_input['Plx'] < 5.0).astype(int)
    df_output['B-V_condition_1'] = (df_input['B-V'] >= 0.8).astype(int)
    df_output['SpType_condition_1'] = df_input['SpType'].isin(['G6III', 'K1III', 'B9III', 'A0III', 'F3III']).astype(int)
    df_output['Amag_condition_1'] = (df_input['Amag'] < 15.0).astype(int)
    df_output['Vmag_condition_2'] = (df_input['Vmag'] <= 6.5).astype(int)
    df_output['Plx_condition_2'] = ((df_input['Plx'] >= 0.0) & (df_input['Plx'] <= 4.0)).astype(int)
    df_output['B-V_condition_2'] = (df_input['B-V'] > 1.0).astype(int)
    df_output['SpType_condition_2'] = df_input['SpType'].isin(['K5III', 'G5III', 'M2III']).astype(int)
    df_output['Amag_condition_2'] = (df_input['Amag'] < 14.0).astype(int)
    return df_output

