def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Vmag_condition'] = (df_input['Vmag'] <= 6.5).astype(int)
    df_output['Plx_condition'] = (df_input['Plx'] >= 6.0).astype(int)
    df_output['e_Plx_condition'] = (df_input['e_Plx'] <= 0.5).astype(int)
    df_output['B-V_condition'] = (df_input['B-V'] >= 0.8).astype(int)
    df_output['SpType_condition'] = df_input['SpType'].isin(['G6III', 'K1III', 'B9III', 'F2III']).astype(int)
    df_output['Amag_condition'] = (df_input['Amag'] <= 15.0).astype(int)
    df_output['Vmag_Plx_condition'] = ((df_input['Vmag'] <= 6.0) & (df_input['Plx'] >= 7.0)).astype(int)
    df_output['B-V_SpType_condition'] = ((df_input['B-V'] >= 1.0) & df_input['SpType'].isin(['K3III', 'M0III'])).astype(int)
    df_output['Amag_Vmag_condition'] = ((df_input['Amag'] <= 16.0) & (df_input['Vmag'] < 6.5)).astype(int)
    df_output['Plx_B-V_condition'] = ((df_input['Plx'].between(6.0, 10.0)) & (df_input['B-V'] >= 0.9)).astype(int)
    return df_output