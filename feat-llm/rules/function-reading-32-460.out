def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Frequency_of_reading_books_1'] = df_input['Frequency of reading books'].isin(['A few times a week', 'Rarely']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Number_of_printed_books_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_ebooks_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Favorite_books_for_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['Change_after_reading_books'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    df_output['Department'] = df_input['Department'].isin(['BBA', 'JMC', 'Textile', 'Civil', 'Others']).astype(int)
    df_output['Who_influenced_you'] = df_input['Who influenced you to read books'].isin(['Friends', 'None']).astype(int)
    df_output['Frequency_of_reading_books_2'] = df_input['Frequency of reading books'].isin(['A few times a week', 'Rarely', 'Once a week']).astype(int)
    return df_output

