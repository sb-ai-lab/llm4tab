def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason for reading books is Academic Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Department is in [CSE, SWE, Pharmacy, EEE, CIS, MCT]'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'CIS', 'MCT']).astype(int)
    df_output['Amount of time spent reading books per day >= 1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency of reading books is in [On everyday basis, Almost every day]'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'Almost every day']).astype(int)
    df_output['Number of printed books you read last two years is in [6-10, 11-15, 16-20, More than 20]'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number of e-books you read last two years is in [6-10, 11-15, 16-20, More than 20]'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['What is the change that you felt after reading books is Increase Academic Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['How to manage books for reading is in [Buy, Used-all]'] = df_input['How to manage books for reading'].isin(['Buy', 'Used-all']).astype(int)
    df_output['The format that you used for reading books is in [Printed, Both]'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Who influenced you to read books is Self-Decision or Academic Influence'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Academic Influence']).astype(int)
    return df_output

