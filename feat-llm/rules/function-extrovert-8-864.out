def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].isin(['Daily', 'Monthly']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].isin(['Large events']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].isin(['Honesty']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].isin(['Talk it out']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.capitalize().isin(['Yes']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].isin(['Alone time']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].isin(['Introvert', 'Ambivert']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].isin(['Neutral', 'Nervous']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].isin(['Stay silent', 'Other']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].isin(['Injustice', 'Selfishness']).astype(int)
    return df_output

