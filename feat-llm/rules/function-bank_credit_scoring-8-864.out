def extracting_features_0(df_input):  
    low_rating = ['C2', 'C3', 'D3', 'D2', 'E1', 'E2', 'E3']  
    df_output = pd.DataFrame()  
    df_output['Debt'] = (df_input['Debt'] >= 1900).astype(int)  
    df_output['Overdue days'] = (df_input['Overdue days'] > 0).astype(int)  
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(low_rating).astype(int)  
    df_output['PDN'] = (df_input['PDN'] >= 0.34).astype(int)  
    df_output['INCOME'] = (df_input['INCOME'] <= 1921).astype(int)  
    df_output['Initial limit'] = (df_input['Initial limit'] <= 2000).astype(int)  
    df_output['EDU_low_rating'] = ((df_input['EDU'].isin(['College', 'University'])) & (df_input['Credit history rating'].isin(low_rating))).astype(int)  
    df_output['TERM_low_rating'] = ((df_input['TERM'] >= 60) & (df_input['Credit history rating'].isin(low_rating))).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT_high_debt'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 1) & (df_input['Debt'] >= 1900)).astype(int)  
    df_output['SEX_low_rating'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(low_rating))).astype(int)  
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Debt'] = (df_input['Debt'] < 1700).astype(int)
    df_output['Overdue days'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1']).astype(int)
    df_output['PDN'] = (df_input['PDN'] < 0.34).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 1900).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] >= 1900).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['High school', 'University', 'College']).astype(int)
    df_output['TERM'] = (df_input['TERM'] <= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] <= 1).astype(int)
    df_output['FAMILYSTATUS'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)
    return df_output

