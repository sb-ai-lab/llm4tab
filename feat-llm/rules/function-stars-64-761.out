def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_lum_class_V_IV/V_Vm_V'] = df_input['SpType'].str.contains(r'V$|IV/V$|Vm$|V$').astype(int)
    df_output['Amag_gt_14_7'] = (df_input['Amag'] > 14.7).astype(int)
    df_output['B_V_lt_0_5'] = (df_input['B-V'] < 0.5).astype(int)
    df_output['Plx_ge_2_0'] = (df_input['Plx'] >= 2.0).astype(int)
    df_output['Vmag_gt_5_0'] = (df_input['Vmag'] > 5.0).astype(int)
    df_output['SpType_in_list'] = df_input['SpType'].isin(['B9V', 'A0IV/V', 'F6V', 'G3V', 'A0Vm']).astype(int)
    df_output['Amag_in_15_20'] = df_input['Amag'].between(15, 20).astype(int)
    df_output['B_V_in_range'] = df_input['B-V'].between(-0.05, 0.5).astype(int)
    df_output['e_Plx_lt_1_1'] = (df_input['e_Plx'] < 1.1).astype(int)
    df_output['Plx_in_range'] = df_input['Plx'].between(0.05, 15.8).astype(int)
    return df_output

