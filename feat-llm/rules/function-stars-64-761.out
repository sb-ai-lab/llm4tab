    df_output['Plx_le_7_5'] = (df_input['Plx'] <= 7.5).astype(int)
    df_output['Vmag_le_8_0'] = (df_input['Vmag'] <= 8.0).astype(int)
    df_output['SpType_in_specific'] = df_input['SpType'].isin(['G8/K0III', 'K2/K3III', 'K0III', 'G8III', 'K3III', 'K5/M0III', 'B9III']).astype(int)
