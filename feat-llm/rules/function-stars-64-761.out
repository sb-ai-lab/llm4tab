def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_V_only'] = df_input['SpType'].apply(lambda x: ('V' in x) and ('IV' not in x) and ('III' not in x))
    df_output['Amag_gt_13_5'] = (df_input['Amag'] > 13.5).astype(int)
    df_output['B_V_lt_0_5'] = (df_input['B-V'] < 0.5).astype(int)
    df_output['Plx_ge_3_5'] = (df_input['Plx'] >= 3.5).astype(int)
    df_output['Vmag_gt_7_5'] = (df_input['Vmag'] > 7.5).astype(int)
    df_output['SpType_IV_or_V_not_III'] = df_input['SpType'].apply(lambda x: (('IV' in x or 'V' in x) and ('III' not in x)))
