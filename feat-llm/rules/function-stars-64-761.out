    df_output['B_V_greater_equal_0_9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_less_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['Vmag_less_8'] = (df_input['Vmag'] < 8).astype(int)
    df_output['Amag_in_14_16'] = df_input['Amag'].between(14, 16).astype(int)
