def extracting_features_0(df_input):  
    import numpy as np  
    df_output = pd.DataFrame()  
  
    sp_types_list = ['G1V', 'F3V', 'B9V', 'A0Vm', 'A0V', 'F6V', 'G3V', 'B9V', 'A0IV/V']  
  
    def sp_type_condition(sp):  
        if pd.isna(sp):  
            return 0  
        if sp in sp_types_list:  
            return 1  
        if sp.startswith('B1V:nn'):  
            return 1  
        return 0  
  
    df_output['SpType_in_list'] = df_input['SpType'].apply(sp_type_condition)  
    df_output['SpType_endswith_V'] = df_input['SpType'].apply(lambda x: 1 if isinstance(x, str) and x.endswith('V') else 0)  
    df_output['B-V_le_0.5'] = (df_input['B-V'] <= 0.5).astype(int)  
    df_output['Amag_ge_15'] = (df_input['Amag'] >= 15).astype(int)  
    df_output['Plx_ge_2.5'] = (df_input['Plx'] >= 2.5).astype(int)  
    df_output['Vmag_ge_4.9'] = (df_input['Vmag'] >= 4.9).astype(int)  
    df_output['B-V_in_range'] = ((df_input['B-V'] >= -0.05) & (df_input['B-V'] <= 0.5)).astype(int)  
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 2.0) & (df_input['Plx'] <= 16.0)).astype(int)  
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 15) & (df_input['Amag'] <= 20)).astype(int)  
    df_output['e_Plx_le_1.1'] = (df_input['e_Plx'] <= 1.1).astype(int)  
  
    return df_output

