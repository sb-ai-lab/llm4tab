def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_III'] = df_input['SpType'].str.contains('III', na=False).astype(int)
    df_output['Amag_le_16.5'] = (df_input['Amag'] <= 16.5).astype(int)
    df_output['B-V_ge_0.9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_le_7.5'] = (df_input['Plx'] <= 7.5).astype(int)
    df_output['Vmag_le_8.0'] = (df_input['Vmag'] <= 8.0).astype(int)
    df_output['Amag_14_17'] = ((df_input['Amag'] >= 14) & (df_input['Amag'] <= 17)).astype(int)
    df_output['B-V_0.9_1.5'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.5)).astype(int)
    df_output['Plx_1.5_7.5'] = ((df_input['Plx'] >= 1.5) & (df_input['Plx'] <= 7.5)).astype(int)
    df_output['e_Plx_le_1.5'] = (df_input['e_Plx'] <= 1.5).astype(int)
    df_output['SpType_III_or_III_IV'] = df_input['SpType'].str.contains('III(/IV)?', na=False).astype(int)
    return df_output