def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Fear_of_pregnancy_Yes'] = (df_input.get('Fear of pregnancy') == 'Yes').astype(int)
    df_output['Feeling_for_regular_activities_in_list'] = df_input.get('Feeling for regular activities').isin(['Afraid', 'Worried', 'Tired']).astype(int)
    df_output['Relationship_with_inlaws_bad_poor'] = df_input.get('Relationship with the in-laws').isin(['Bad', 'Poor']).astype(int)
    df_output['Received_Support_low_medium'] = df_input.get('Recieved Support').isin(['Low', 'Medium']).astype(int)
    df_output['Relax_sleep_no'] = (df_input.get('Relax/sleep when the newborn is asleep') == 'No').astype(int)
    df_output['Breastfeed_no'] = (df_input.get('Breastfeed') == 'No').astype(int)
    df_output['History_of_pregnancy_loss'] = df_input.get('History of pregnancy loss').isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Number_of_household_members_2_to_5'] = df_input.get('Number of household members').between(2,5).astype(int)
    df_output['Occupation_after_latest_childbirth_housewife'] = (df_input.get('Occupation After Your Latest Childbirth') == 'Housewife').astype(int)
    df_output['Current_monthly_income_in_list'] = df_input.get('Current monthly income').isin(['No', 'Less than 5000', '5000 to 10000']).astype(int)
    return df_output

