def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)  
    df_output['Trust_and_share_feelings'] = (df_input['Trust and share feelings'] == 'No').astype(int)  
    df_output['Received_Support'] = df_input['Recieved Support'].isin(['Low', 'Medium']).astype(int)  
    df_output['Relationship_with_inlaws'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor']).astype(int)  
    breastfeed_no = (df_input['Breastfeed'] == 'No')  
    breastfeed_yes = (df_input['Breastfeed'] == 'Yes')  
    negative_factors = (df_output['Feeling_about_motherhood'] == 1) | (df_output['Trust_and_share_feelings'] == 1) | (df_output['Received_Support'] == 1) | (df_output['Relationship_with_inlaws'] == 1)  
    df_output['Breastfeed'] = ((breastfeed_no) | (breastfeed_yes & negative_factors)).astype(int)  
    df_output['Family_type'] = df_input['Family type'].isin(['Nuclear', 'Joint']).astype(int)  
    df_output['Major_changes_or_losses'] = df_input['Major changes or losses during pregnancy'].isin(['Yes', 'No']).astype(int)  
    df_output['Age'] = ((df_input['Age'] >= 21) & (df_input['Age'] <= 30)).astype(int)  
    df_output['Disease_before_pregnancy'] = (df_input['Disease before pregnancy'] == 'No').astype(int)  
    df_output['Residence'] = (df_input['Residence'] == 'City').astype(int)  
    return df_output