def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling about motherhood'] = df_input['Feeling about motherhood'].apply(lambda x: 1 if x == 'Happy' else 0)
    df_output['Trust and share feelings'] = df_input['Trust and share feelings'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Received Support'] = df_input['Recieved Support'].apply(lambda x: 1 if x in ['High', 'Medium'] else 0)
    df_output['Relationship with the in-laws'] = df_input['Relationship with the in-laws'].apply(lambda x: 1 if x in ['Good', 'Friendly', 'Neutral'] else 0)
    df_output['Breastfeed'] = df_input['Breastfeed'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Family type'] = df_input['Family type'].apply(lambda x: 1 if x in ['Joint', 'Nuclear'] else 0)
    df_output['Major changes or losses during pregnancy'] = df_input['Major changes or losses during pregnancy'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Age'] = df_input['Age'].apply(lambda x: 1 if 20 <= x <= 34 else 0)
    df_output['Disease before pregnancy'] = df_input['Disease before pregnancy'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Residence'] = df_input['Residence'].apply(lambda x: 1 if x == 'City' else 0)
    return df_output

