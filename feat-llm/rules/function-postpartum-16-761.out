def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Fear_of_pregnancy_No'] = (df_input['Fear of pregnancy'] == 'No').astype(int)
    df_output['Need_for_Support_Low_No'] = df_input['Need for Support'].isin(['Low', 'No']).astype(int)
    df_output['Trust_and_share_feelings_Yes'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['Disease_before_pregnancy_No_NonChronic'] = df_input['Disease before pregnancy'].isin(['No', 'Non-Chronic Disease']).astype(int)
    df_output['Occupation_After_Your_Latest_Childbirth_Housewife_Student'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'Student']).astype(int)
    df_output['Mode_of_delivery_Normal_Caesarean'] = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section']).astype(int)
    df_output['Relationship_between_father_and_newborn_Good'] = (df_input['Relationship between father and newborn'] == 'Good').astype(int)
    df_output['Number_of_the_latest_pregnancy_1_to_5'] = df_input['Number of the latest pregnancy'].between(1,5).astype(int)
    df_output['Newborn_illness_No'] = (df_input['Newborn illness'] == 'No').astype(int)
    df_output['Diseases_during_pregnancy_No_NonChronic'] = df_input['Diseases during pregnancy'].isin(['No', 'Non-Chronic Disease']).astype(int)
    return df_output

