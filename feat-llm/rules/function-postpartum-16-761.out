def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Fear_of_pregnancy_Yes'] = (df_input.get('Fear of pregnancy', '') == 'Yes').astype(int)
    df_output['Need_for_Support_in_Low_Medium_No'] = df_input.get('Need for Support', '').isin(['Low', 'Medium', 'No']).astype(int)
    df_output['Trust_and_share_feelings_No'] = (df_input.get('Trust and share feelings', '') == 'No').astype(int)
    df_output['Disease_before_pregnancy_Chronic_or_No'] = df_input.get('Disease before pregnancy', '').isin(['Chronic Disease', 'No']).astype(int)
    df_output['Occupation_After_Your_Latest_Childbirth_in_list'] = df_input.get('Occupation After Your Latest Childbirth', '').isin(['Housewife', 'Teacher', 'Other', 'Student', 'Business']).astype(int)
    df_output['Mode_of_delivery_in_list'] = df_input.get('Mode of delivery', '').isin(['Normal Delivery', 'Caesarean Section']).astype(int)
    df_output['Relationship_between_father_and_newborn_in_list'] = df_input.get('Relationship between father and newborn', '').isin(['Neutral', 'Good']).astype(int)
    num_latest_preg = pd.to_numeric(df_input.get('Number of the latest pregnancy', pd.Series()), errors='coerce')
    df_output['Number_of_the_latest_pregnancy_in_range'] = ((num_latest_preg >= 1) & (num_latest_preg <= 5)).astype(int)
    df_output['Newborn_illness_Yes_or_No'] = df_input.get('Newborn illness', '').isin(['Yes', 'No']).astype(int)
    df_output['Diseases_during_pregnancy_in_list'] = df_input.get('Diseases during pregnancy', '').isin(['Chronic Disease', 'Non-Chronic Disease']).astype(int)
    return df_output

