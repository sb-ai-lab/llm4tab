def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['History_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Feeling_regular_activities'] = df_input['Feeling for regular activities'].isin(['Worried', 'Afraid', 'No', 'Tired']).astype(int)
    df_output['Major_changes_losses'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Relax_sleep_newborn'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Relationship_newborn'] = df_input['Relationship with the newborn'].isin(['Neutral', 'Bad']).astype(int)
    df_output['Relationship_inlaws'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    df_output['Trust_share_feelings'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Total_children'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Number_latest_pregnancy'] = (df_input['Number of the latest pregnancy'] <= 2).astype(int)
    df_output['Feeling_trust_combined'] = ((df_input['Feeling for regular activities'].isin(['Worried', 'Afraid'])) & (df_input['Trust and share feelings'] == 'No')).astype(int)
    return df_output