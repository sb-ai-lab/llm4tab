def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Need for Support is Low'] = (df_input['Need for Support'] == 'Low').astype(int)  
    df_output['Fear of pregnancy is Yes'] = (df_input['Fear of pregnancy'] == 'Yes').astype(int)  
    df_output['Relationship with the in-laws is in [Bad, Poor]'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor']).astype(int)  
    df_output['Occupation before latest pregnancy is in [Housewife, Student, Other]'] = df_input['Occupation before latest pregnancy'].isin(['Housewife', 'Student', 'Other']).astype(int)  
    df_output['Age of newborn is in [0 to 6 months, 1 year to 1.5 year]'] = df_input['Age of newborn'].isin(['0 to 6 months', '1 year to 1.5 year']).astype(int)  
    df_output['Pregnancy plan is No or Yes'] = df_input['Pregnancy plan'].isin(['No', 'Yes']).astype(int)  
    df_output['Residence is in [City, Village]'] = df_input['Residence'].isin(['City', 'Village']).astype(int)  
    df_output['Monthly income before latest pregnancy is No or More than 30000'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'More than 30000']).astype(int)  
    df_output['Mode of delivery is Normal Delivery or Caesarean Section with Fear of pregnancy Yes'] = ((df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section'])) & (df_input['Fear of pregnancy'] == 'Yes')).astype(int)  
    df_output['Pregnancy length is in [8 months, 9 months, 10 months] with other risk factors'] = (df_input['Pregnancy length'].isin(['8 months', '9 months', '10 months'])).astype(int)  
    return df_output

