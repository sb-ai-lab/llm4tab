    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.lower().isin(['talking to someone', 'social media']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.lower().isin(['extrovert', 'ambivert']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.lower().isin(['excited', 'neutral']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.lower().isin(['talk openly', 'express emotion strongly']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.lower().isin(['being interrupted', 'selfishness']).astype(int)
    return df_output

