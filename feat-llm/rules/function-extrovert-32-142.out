def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['social_connection_frequency_in_Monthly_Never'] = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never']).astype(int)  
    df_output['gathering_size_preference_in_Never_Large_events'] = df_input['gathering_size_preference'].str.lower().isin(['never', 'large events']).astype(int)  
    df_output['valued_friendship_traits_in_Honesty'] = df_input['valued_friendship_traits'].str.lower().isin(['honesty']).astype(int)  
    df_output['conflict_resolution_style_in_Avoid_conflict_Let_time_fix_it'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)  
    df_output['family_support_level_in_No_Never'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)  
    df_output['social_battery_recharge_in_Social_media_Alone_time'] = df_input['social_battery_recharge'].str.lower().isin(['social media', 'alone time']).astype(int)  
    df_output['social_orientation_type_in_Introvert'] = df_input['social_orientation_type'].str.lower().isin(['introvert']).astype(int)  
    df_output['social_anxiety_level_in_Nervous_Avoid_it'] = df_input['social_anxiety_level'].str.lower().isin(['nervous', 'avoid it']).astype(int)  
    df_output['emotional_expression_method_in_Stay_silent_Other'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)  
    df_output['social_connection_frequency_Monthly_and_gathering_size_preference_Never'] = ((df_input['social_connection_frequency'].str.lower() == 'monthly') & (df_input['gathering_size_preference'].str.lower() == 'never')).astype(int)  
    return df_output

