    df_output['Gender_Female_and_Satisfaction_lt_3_5'] = ((df_input['Gender'] == 'Female') & (df_input['Satisfaction_with_the_doctors_response'] < 3.5)).astype(int)
    df_output['How_often_do_you_receive_call_center_news_lt_2_7'] = (df_input['How_often_do_you_receive_call_center_news'] < 2.7).astype(int)
    return df_output

