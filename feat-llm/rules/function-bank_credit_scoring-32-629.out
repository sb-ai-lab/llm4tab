def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_less_than_0_3'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['Initial_limit_gte_1500'] = (df_input['Initial limit'] >= 1500).astype(int)
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['INCOME_gte_1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['Debt_lte_0_5_Initial_limit'] = (df_input['Debt'] <= df_input['Initial limit'] * 0.5).astype(int)
    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Public Administration', 'Ministry of Internal Affairs/Ministry of Emergency Situations/Ministry of Defense']).astype(int)
    df_output['FAMILYSTATUS_1_or_2'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_lte_1'] = (df_input['UNDERAGECHILDRENCOUNT'] <= 1).astype(int)
    return df_output

