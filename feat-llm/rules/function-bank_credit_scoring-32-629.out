def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Debt'] = (df_input['Debt'] <= 1000).astype(int)
    df_output['Overdue days'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] <= 0.3).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] >= 1500).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM'] = (df_input['TERM'] <= 36).astype(int)
    df_output['INDUSTRYNAME'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Production', 'Agriculture']).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    return df_output

