def extracting_features_0(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame()

    df_output['Debt_gt_900'] = (df_input['Debt'] > 900).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_DE'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Initial_limit_le_1500'] = (df_input['Initial limit'] <= 1500).astype(int)
    df_output['INCOME_lt_1600'] = (df_input['INCOME'] < 1600).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_ge_36_and_Overdue_days_gt_0'] = ((df_input['TERM'] >= 36) & (df_input['Overdue days'] > 0)).astype(int)

    today = pd.to_datetime('today')
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    age = (today - birthdates).dt.days // 365
    cond_age = (age < 40)
    cond_credit = df_input['Credit history rating'].isin(['D1', 'D2', 'D3'])
    df_output['Age_lt_40_and_Credit_history_D'] = (cond_age & cond_credit).astype(int)

    cond_sex = (df_input['SEX'] == 'Female')
    cond_pdn = (df_input['PDN'] > 0.3)
    df_output['SEX_Female_and_PDN_gt_0_3'] = (cond_sex & cond_pdn).astype(int)

    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame(index=df_input.index)

    df_output['Credit_history_rating_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_lt_0_3'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['Debt_le_1800'] = (df_input['Debt'] <= 1800).astype(int)
    df_output['Initial_limit_ge_1500'] = (df_input['Initial limit'] >= 1500).astype(int)
    df_output['INCOME_ge_900'] = (df_input['INCOME'] >= 900).astype(int)
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM_le_36_and_PDN_lt_0_2'] = ((df_input['TERM'] <= 36) & (df_input['PDN'] < 0.2)).astype(int)

    # Calculate age
    today = pd.to_datetime('today')
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    age = (today - birthdates).dt.days // 365
    cond_age_credit = ((age >= 40) & (df_input['Credit history rating'].isin(['B1', 'B2']))).astype(int)
    df_output['Age_ge_40_and_Credit_history_B1_B2'] = cond_age_credit

    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Trade', 'Finance and Insurance', 'Production']).astype(int)

    return df_output

---VERSION---

