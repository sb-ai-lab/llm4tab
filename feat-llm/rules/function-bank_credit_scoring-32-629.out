def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue days = 0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Credit history rating in A1,A2,A3,B1,B2,B3'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN < 0.3'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['Debt <= Initial limit'] = (df_input['Debt'] <= df_input['Initial limit']).astype(int)
    df_output['INCOME >= 1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['Initial limit > 1000'] = (df_input['Initial limit'] > 1000).astype(int)
    df_output['TERM <= 36'] = (df_input['TERM'] <= 36).astype(int)
    df_output['EDU in College, University'] = df_input['EDU'].isin(['College', 'University']).astype(int)
    df_output['UNDERAGECHILDRENCOUNT = 0 or 1'] = df_input['UNDERAGECHILDRENCOUNT'].isin([0,1]).astype(int)
    df_output['FAMILYSTATUS = 2'] = (df_input['FAMILYSTATUS'] == 2).astype(int)
    return df_output

