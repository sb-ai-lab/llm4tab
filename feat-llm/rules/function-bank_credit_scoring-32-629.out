def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_C3_D1_D2_D3_E1_E2_E3'] = df_input['Credit history rating'].isin(['C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_gt_0_8_Initial_limit'] = (df_input['Debt'] > df_input['Initial limit'] * 0.8).astype(int)
    df_output['INCOME_lt_1000'] = (df_input['INCOME'] < 1000).astype(int)
    df_output['EDU_in_High_school_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_ge_60_and_Debt_gt_1500'] = ((df_input['TERM'] >= 60) & (df_input['Debt'] > 1500)).astype(int)
    df_output['SEX_Male_and_Credit_history_rating_in_D1_D2_D3'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(['D1', 'D2', 'D3']))).astype(int)
    df_output['INDUSTRYNAME_in_Trade_Agriculture_and_PDN_gt_0_25'] = ((df_input['INDUSTRYNAME'].isin(['Trade', 'Agriculture'])) & (df_input['PDN'] > 0.25)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2_and_PDN_gt_0_3'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 2) & (df_input['PDN'] > 0.3)).astype(int)
    return df_output

