def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Machine_Type_is_Mill'] = (df_input['Machine_Type'] == 'Mill').astype(int)  
    df_output['Temperature_ge_80'] = (df_input['Temperature'] >= 80).astype(int)  
    df_output['Vibration_ge_50'] = (df_input['Vibration'] >= 50).astype(int)  
    df_output['Power_Usage_ge_7'] = (df_input['Power_Usage'] >= 7).astype(int)  
    df_output['Humidity_lt_30'] = (df_input['Humidity'] < 30).astype(int)  
    df_output['Temperature_65_80_and_Machine_Type_Drill'] = ((df_input['Temperature'].between(65, 80)) & (df_input['Machine_Type'] == 'Drill')).astype(int)  
    df_output['Vibration_gt_55_and_Machine_Type_Mill'] = ((df_input['Vibration'] > 55) & (df_input['Machine_Type'] == 'Mill')).astype(int)  
    df_output['Power_Usage_6_13_and_Machine_Type_Mill'] = ((df_input['Power_Usage'].between(6, 13)) & (df_input['Machine_Type'] == 'Mill')).astype(int)  
    df_output['Temperature_ge_65_and_Vibration_ge_50'] = ((df_input['Temperature'] >= 65) & (df_input['Vibration'] >= 50)).astype(int)  
    df_output['Humidity_lt_30_and_Temperature_ge_70'] = ((df_input['Humidity'] < 30) & (df_input['Temperature'] >= 70)).astype(int)  
    return df_output