def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['Amag_gt_15'] = (df_input['Amag'] > 15).astype(int)
    df_output['Plx_ge_4'] = (df_input['Plx'] >= 4).astype(int)
    df_output['B_V_lt_1'] = (df_input['B-V'] < 1.0).astype(int)
    df_output['Vmag_ge_7_5'] = (df_input['Vmag'] >= 7.5).astype(int)
    df_output['e_Plx_le_1_5'] = (df_input['e_Plx'] <= 1.5).astype(int)
    df_output['SpType_IV_uncertain'] = df_input['SpType'].apply(lambda x: int(('IV' in x or 'IV:' in x) and ('III' not in x) and ('Ib' not in x) and ('II' not in x)))
    df_output['Amag_in_16_20'] = ((df_input['Amag'] >= 16) & (df_input['Amag'] <= 20)).astype(int)
    df_output['Plx_in_4_20'] = ((df_input['Plx'] >= 4) & (df_input['Plx'] <= 20)).astype(int)
    df_output['B_V_in_0_0_7'] = ((df_input['B-V'] >= 0.0) & (df_input['B-V'] <= 0.7)).astype(int)
    return df_output

