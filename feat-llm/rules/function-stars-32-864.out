def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K2III', 'G8/K0III', 'K0/K1III:', 'B2III', 'G5III', 'B1Ib/II', 'K0III', 'G8III', 'B1Ib/II', 'K0III']).astype(int)
    df_output['Amag_le_15_5'] = (df_input['Amag'] <= 15.5).astype(int)
    df_output['B_V_ge_0_9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_le_3_0'] = (df_input['Plx'] <= 3.0).astype(int)
    df_output['Vmag_le_9_5'] = (df_input['Vmag'] <= 9.5).astype(int)
    df_output['e_Plx_le_1_4'] = (df_input['e_Plx'] <= 1.4).astype(int)
    df_output['SpType_contains_III_or_Ib_II'] = df_input['SpType'].str.contains('III|Ib/II', regex=True).fillna(False).astype(int)
    df_output['B_V_in_range'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.37)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 0.5) & (df_input['Plx'] <= 3.1)).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 12.5) & (df_input['Amag'] <= 15.5)).astype(int)
    return df_output