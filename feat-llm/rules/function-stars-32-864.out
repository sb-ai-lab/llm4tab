def extracting_features_1(df_input):
    import numpy as np
    df_output = pd.DataFrame()
    df_output['SpType_ends_III_Ib_II'] = df_input['SpType'].str.contains(r'(III$|Ib$|II$)', regex=True).astype(int)
    df_output['Amag_le_15'] = (df_input['Amag'] <= 15).astype(int)
    df_output['Plx_lt_4'] = (df_input['Plx'] < 4).astype(int)
    df_output['B_V_ge_0_9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Vmag_lt_9_5'] = (df_input['Vmag'] < 9.5).astype(int)
    df_output['e_Plx_le_1_5'] = (df_input['e_Plx'] <= 1.5).astype(int)
    df_output['SpType_lum_class_III_or_brighter'] = df_input['SpType'].str.contains(r'III|II|Ib|Ia|Iab|Ia-', regex=True).astype(int)
    df_output['Amag_in_12_15'] = ((df_input['Amag'] >= 12) & (df_input['Amag'] <= 15)).astype(int)
    df_output['Plx_in_0_3_5'] = ((df_input['Plx'] >= 0) & (df_input['Plx'] <= 3.5)).astype(int)
    df_output['B_V_in_0_9_1_4'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.4)).astype(int)
    return df_output

