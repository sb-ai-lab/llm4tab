    df_output['Change_not_selected'] = (~df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill'])).astype(int)
    df_output['Manage_books_in_selected'] = df_input['How to manage books for reading'].isin(['Others', 'Used-all']).astype(int)
    df_output['Gender_in_selected'] = df_input['Gender'].isin(['Male', 'Female']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_3'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'CIS']).astype(int)
    df_output['Number_of_e_books_read_last_two_years_in_selected'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_selected'] = df_input['Number of printed books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Frequency_of_reading_books_is_On_everyday_basis'] = (df_input['Frequency of reading books'] == 'On everyday basis').astype(int)
    df_output['What_is_the_change_after_reading_books_in_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['How_to_manage_books_for_reading_in_selected'] = df_input['How to manage books for reading'].isin(['E-books', 'Borrow', 'Buy']).astype(int)
    df_output['Favorite_books_for_reading_leisure_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Who_influenced_you_to_read_books_is_Self_Decision'] = (df_input['Who influenced you to read books'] == 'Self-Decision').astype(int)
    return df_output