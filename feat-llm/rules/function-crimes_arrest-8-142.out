def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['MOTOR VEHICLE THEFT', 'OTHER OFFENSE', 'OFFENSE INVOLVING CHILDREN']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['AUTOMOBILE', 'VEHICLE TITLE / REGISTRATION OFFENSE', 'AGGRAVATED SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER', 'HARASSMENT BY ELECTRONIC MEANS']).astype(int)
    df_output['Domestic_1_and_Primary_Type_in_list'] = ((df_input['Domestic'] == 1) & (df_input['Primary Type'].isin(['OFFENSE INVOLVING CHILDREN', 'OTHER OFFENSE']))).astype(int)
    df_output['Location_Description_in_list_and_Primary_Type_in_list'] = ((df_input['Location Description'].isin(['RESIDENCE', 'APARTMENT', 'STREET'])) & (df_input['Primary Type'].isin(['OTHER OFFENSE', 'MOTOR VEHICLE THEFT']))).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['07', '26', '02']).astype(int)
    df_output['Beat_in_range_and_Primary_Type_MVT'] = ((df_input['Beat'] >= 600) & (df_input['Beat'] <= 650) & (df_input['Primary Type'] == 'MOTOR VEHICLE THEFT')).astype(int)
    df_output['District_in_list_and_Primary_Type_in_list'] = ((df_input['District'].isin([6, 15, 8])) & (df_input['Primary Type'].isin(['OTHER OFFENSE', 'MOTOR VEHICLE THEFT']))).astype(int)
    df_output['Ward_in_list_and_Domestic_1_and_Primary_Type_OO'] = ((df_input['Ward'].isin([8, 37, 23, 42])) & (df_input['Domestic'] == 1) & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
    df_output['Year_2025_and_Primary_Type_in_list'] = ((df_input['Year'] == 2025) & (df_input['Primary Type'].isin(['OTHER OFFENSE', 'MOTOR VEHICLE THEFT']))).astype(int)
    df_output['Location_Description_STREET_and_Primary_Type_OO_and_Domestic_0'] = ((df_input['Location Description'] == 'STREET') & (df_input['Primary Type'] == 'OTHER OFFENSE') & (df_input['Domestic'] == 0)).astype(int)
    return df_output

