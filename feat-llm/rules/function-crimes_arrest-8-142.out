def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'CONCEALED CARRY LICENSE VIOLATION', 'BATTERY']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['POSSESS - HEROIN (WHITE)', 'UNLAWFUL POSSESSION - HANDGUN', 'PROHIBITED PLACES', 'SIMPLE']).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['15', '18', '08B']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['SIDEWALK', 'STREET', 'AIRPORT TERMINAL UPPER LEVEL - SECURE AREA', 'SMALL RETAIL STORE']).astype(int)
    df_output['Domestic_0_and_Primary_Type_in_list'] = ((df_input['Domestic'] == 0) & (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))).astype(int)
    df_output['Beat_in_range_and_Primary_Type_in_list'] = ((df_input['Beat'] >= 1100) & (df_input['Beat'] <= 1250) & (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))).astype(int)
    df_output['District_in_list_and_Primary_Type_in_list'] = ((df_input['District'].isin([1,8,11])) & (df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'CONCEALED CARRY LICENSE VIOLATION']))).astype(int)
    df_output['Ward_in_list_and_Primary_Type_in_list'] = ((df_input['Ward'].isin([4,13,28,12])) & (df_input['Primary Type'].isin(['BATTERY', 'WEAPONS VIOLATION']))).astype(int)
    df_output['Year_2025_and_Primary_Type_in_list'] = ((df_input['Year'] == 2025) & (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'BATTERY']))).astype(int)
    df_output['Location_Description_in_list_and_FBI_Code_in_list'] = ((df_input['Location Description'].isin(['STREET', 'SIDEWALK'])) & (df_input['FBI Code'].isin(['15', '18']))).astype(int)
    return df_output

