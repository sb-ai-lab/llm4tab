def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['OTHER OFFENSE', 'MOTOR VEHICLE THEFT', 'OFFENSE INVOLVING CHILDREN']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['HARASSMENT BY ELECTRONIC MEANS', 'VEHICLE TITLE / REGISTRATION OFFENSE', 'AGGRAVATED SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['APARTMENT', 'STREET', 'RESIDENCE']).astype(int)
    df_output['Domestic_and_Offense_Involving_Children'] = ((df_input['Domestic'] == 1) & (df_input['Primary Type'] == 'OFFENSE INVOLVING CHILDREN')).astype(int)
    df_output['FBI_Code_26'] = (df_input['FBI Code'] == '26').astype(int)
    df_output['Beat_in_range_and_Other_Offense'] = ((df_input['Beat'] >= 100) & (df_input['Beat'] <= 200) & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
    df_output['District_1_and_Motor_Vehicle_Theft'] = ((df_input['District'] == 1) & (df_input['Primary Type'] == 'MOTOR VEHICLE THEFT')).astype(int)
    df_output['Ward_in_range_and_Other_Offense'] = ((df_input['Ward'] >= 20) & (df_input['Ward'] <= 50) & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
    df_output['Year_2025_and_Offense_Involving_Children'] = ((df_input['Year'] == 2025) & (df_input['Primary Type'] == 'OFFENSE INVOLVING CHILDREN')).astype(int)
    df_output['Lat_Long_in_range_and_Other_Offense'] = ((df_input['Latitude'] >= 41.7) & (df_input['Latitude'] <= 41.9) & (df_input['Longitude'] >= -87.8) & (df_input['Longitude'] <= -87.6) & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
    return df_output

