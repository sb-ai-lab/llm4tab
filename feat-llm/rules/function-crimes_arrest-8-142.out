def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'CONCEALED CARRY LICENSE VIOLATION', 'NARCOTICS', 'BATTERY']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'PROHIBITED PLACES', 'POSSESS - HEROIN (WHITE)', 'SIMPLE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'SMALL RETAIL STORE', 'AIRPORT TERMINAL UPPER LEVEL - SECURE AREA']).astype(int)
    df_output['Domestic_0_and_Primary_Weapons'] = ((df_input['Domestic'] == 0) & (df_input['Primary Type'] == 'WEAPONS VIOLATION')).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['15', '18', '08B']).astype(int)
    df_output['Beat_in_range_and_Primary_Weapons'] = ((df_input['Beat'] >= 100) & (df_input['Beat'] <= 130) & (df_input['Primary Type'] == 'WEAPONS VIOLATION')).astype(int)
    df_output['District_in_range_and_Primary_Narcotics_Battery'] = ((df_input['District'] >= 1) & (df_input['District'] <= 11) & (df_input['Primary Type'].isin(['NARCOTICS', 'BATTERY']))).astype(int)
    df_output['Ward_in_range_and_Primary_Battery_Narcotics'] = ((df_input['Ward'] >= 4) & (df_input['Ward'] <= 28) & (df_input['Primary Type'].isin(['BATTERY', 'NARCOTICS']))).astype(int)
    df_output['Year_2025_and_Primary_Weapons_Narcotics'] = ((df_input['Year'] == 2025) & (df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'NARCOTICS']))).astype(int)
    df_output['Lat_Long_in_range_and_Primary_Battery_Weapons'] = (((df_input['Latitude'] >= 41.8) & (df_input['Latitude'] <= 41.9)) & ((df_input['Longitude'] >= -87.7) & (df_input['Longitude'] <= -87.6)) & (df_input['Primary Type'].isin(['BATTERY', 'WEAPONS VIOLATION']))).astype(int)
    return df_output