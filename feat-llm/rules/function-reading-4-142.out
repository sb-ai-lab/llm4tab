    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Friends', 'Parents']).astype(int)
    df_output['Department'] = df_input['Department'].isin(['English', 'BBA', 'JMC', 'Textile', 'Others']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_3'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Frequency_of_reading_books_in_selected'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_selected'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['What_is_the_change_after_reading_books_in_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'CIS', 'Civil', 'MCT']).astype(int)
    df_output['Format_used_for_reading_books_in_selected'] = df_input['The format that you used for reading books'].isin(['Both', 'Printed']).astype(int)
    df_output['Where_do_you_read_printed_books_is_Library'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    df_output['Who_influenced_you_to_read_books_in_selected'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    df_output['Number_of_ebooks_read_last_two_years_in_selected'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    return df_output