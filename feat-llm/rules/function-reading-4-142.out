def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Reading_High'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Time_Spent_Reading_3plus'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Department_Selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'Textile', 'CIS']).astype(int)
    df_output['Printed_Books_High'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20']).astype(int)
    df_output['Ebooks_Books_High'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_Academic_ProblemSolving'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Favorite_Books_Selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Biography', 'Non-Fiction', 'Politics']).astype(int)
    df_output['Format_Both_Ebooks'] = df_input['The format that you used for reading books'].isin(['Both', 'E-books']).astype(int)
    df_output['Influenced_Teachers_Self'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    return df_output

