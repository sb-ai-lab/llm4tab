def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Freq_Read_Academic_Informative'] = (
        (df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week'])) &
        (df_input['Reason for reading books'].isin(['Academic Purpose', 'Keep me informative']))
    ).astype(int)
    df_output['Time_Spent_Reading_2plus'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Printed_Books_11plus'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Ebooks_11plus'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Change_Increase_Performance_ProblemSolving'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Format_Both_Printed'] = df_input['The format that you used for reading books'].isin(['Both', 'Printed']).astype(int)
    df_output['Dept_Academic_Purpose'] = (
        df_input['Department'].isin(['CSE', 'BBA', 'Pharmacy', 'SWE', 'CIS']) &
        (df_input['Reason for reading books'] == 'Academic Purpose')
    ).astype(int)
    df_output['Influence_Teachers_Self_Freq_Everyday'] = (
        df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']) &
        (df_input['Frequency of reading books'] == 'On everyday basis')
    ).astype(int)
    df_output['Lang_English_Freq_Regular'] = (
        (df_input['Which language books do you like to read'] == 'English') &
        (df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']))
    ).astype(int)
    return df_output

