    df_output['Frequency_reading_books_condition'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Amount_time_reading_books_condition'] = (df_input['Amount of time spent reading books per day'] < 2).astype(int)
    df_output['Printed_books_read_condition'] = df_input['Number of printed books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['E_books_read_condition'] = df_input['Number of e-books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['Change_after_reading_condition'] = df_input['What is the change that you fell after reading books'].isin(['Feel Relax', 'Increase Creative Thinking']).astype(int)
    df_output['Favorite_books_leisure_condition'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Others']).astype(int)
    cond1 = df_input['Frequency of reading books'].isin(['A few times a week'])
    cond2 = df_input['Reason for reading books'] != 'Academic Purpose'
    df_output['Freq_week_and_not_academic_reason'] = (cond1 & cond2).astype(int)
    cond3 = df_input['The format that you used for reading books'].isin(['E-books'])
    cond4 = df_input['Frequency of reading books'] != 'On everyday basis'
    df_output['Format_ebooks_and_freq_not_everyday'] = (cond3 & cond4).astype(int)
    cond5 = df_input['Department'].isin(['English', 'JMC', 'Textile', 'Civil', 'NFE'])
    cond6 = df_input['Reason for reading books'] != 'Academic Purpose'
    df_output['Dept_in_list_and_reason_not_academic'] = (cond5 & cond6).astype(int)
    return df_output

