def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
  
    df_output['The_reason_of_the_call_Inquiries_or_Inquiries_COVID19'] = df_input['The_reason_of_the_call'].isin(['Inquiries', 'Inquiries_COVID19']).astype(int)  
  
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)  
  
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)  
  
    df_output['How_often_do_you_receive_call_center_news_ge_2'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.0).astype(int)  
  
    cond_call_151 = (df_input['Call_151'] == 'No') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)  
    df_output['Call_151_No_with_moderate_high_satisfaction'] = cond_call_151.astype(int)  
  
    df_output['Aware_151_Yes'] = (df_input['Aware_151'] == 'Yes').astype(int)  
  
    cond_age = df_input['Age'].isin(['18-24', '25-29']) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)  
    df_output['Age_18_24_25_29_with_moderate_high_satisfaction'] = cond_age.astype(int)  
  
    cond_education = df_input['Education'].isin(['Bachelor', 'High school']) & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)  
    df_output['Education_Bachelor_High_school_with_good_communication'] = cond_education.astype(int)  
  
    cond_nationality = df_input['Nationality'].isin(['Other nationality', 'Unspecified']) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)  
    df_output['Nationality_Other_Unspecified_with_positive_satisfaction'] = cond_nationality.astype(int)  
  
    cond_gender = (df_input['Gender'] == 'Male') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)  
    df_output['Gender_Male_with_moderate_high_satisfaction'] = cond_gender.astype(int)  
  
    return df_output

