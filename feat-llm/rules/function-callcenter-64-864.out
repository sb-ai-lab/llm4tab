def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation_gt_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] > 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_gt_3'] = (df_input['Satisfaction_with_the_doctors_response'] > 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news_gt_2_5'] = (df_input['How_often_do_you_receive_call_center_news'] > 2.5).astype(int)
    df_output['The_reason_of_the_call_in_selected'] = df_input['The_reason_of_the_call'].isin(['Inquiries', 'Inquiries_COVID19', 'Vaccination']).astype(int)
    df_output['Call_151_yes_or_no_and_high_communication_skills'] = ((df_input['Call_151'].isin(['Yes', 'No'])) & (df_input['Call_center_employee_communication_skills_evaluation'] > 3.0)).astype(int)
    df_output['Aware_151_yes'] = (df_input['Aware_151'] == 'Yes').astype(int)
    df_output['Age_in_selected'] = df_input['Age'].isin(['18-24', '25-29']).astype(int)
    df_output['Nationality_in_selected'] = df_input['Nationality'].isin(['Unspecified', 'Other nationality']).astype(int)
    df_output['Marital_Status_single'] = (df_input['Marital_Status'] == 'Single').astype(int)
    df_output['Governorate_in_selected'] = df_input['Governorate'].isin(['Jahra', 'Mubarak AlKabir', 'Around']).astype(int)
    return df_output

