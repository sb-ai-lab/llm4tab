def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Comm_Skills_GTE_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)  
    df_output['Doctor_Satisfaction_GTE_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)  
    df_output['Complaints_and_High_Comm_and_Sat'] = ((df_input['The_reason_of_the_call'] == 'Complaints') &  
                                                    (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0) &  
                                                    (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    df_output['Call_151_No_and_Sat_GTE_3'] = ((df_input['Call_151'] == 'No') &  
                                             (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    df_output['Aware_151_No_and_Comm_GTE_3'] = ((df_input['Aware_151'] == 'No') &  
                                               (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)  
    df_output['News_Freq_GTE_2'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.0).astype(int)  
    df_output['Age_18_24_or_25_29'] = df_input['Age'].isin(['18-24', '25-29']).astype(int)  
    higher_education = ['Bachelor', 'Master', 'Doctor']  
    df_output['Education_Bachelor_or_Higher_and_Comm_GTE_3'] = ((df_input['Education'].isin(higher_education)) &  
                                                               (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)  
    nationality_cond = df_input['Nationality'].isin(['Unspecified', 'Other nationality'])  
    df_output['Nationality_Unspecified_or_Other_and_Sat_GTE_3'] = (nationality_cond &  
                                                                 (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    df_output['Marital_Single_and_Sat_GTE_3'] = ((df_input['Marital_Status'] == 'Single') &  
                                                (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    return df_output

