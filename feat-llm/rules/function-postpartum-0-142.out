def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood_Happy'] = df_input['Feeling about motherhood'].isin(['Happy']).astype(int)
    df_output['Relationship_with_husband_Good_Friendly'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Recieved_Support_High_Medium'] = df_input['Recieved Support'].isin(['High', 'Medium']).astype(int)
    df_output['Need_for_Support_No_Low'] = df_input['Need for Support'].isin(['No', 'Low']).astype(int)
    df_output['Abuse_No'] = df_input['Abuse'].isin(['No']).astype(int)
    df_output['Regular_checkups_Yes'] = df_input['Regular checkups'].isin(['Yes']).astype(int)
    df_output['Pregnancy_plan_Yes'] = df_input['Pregnancy plan'].isin(['Yes']).astype(int)
    df_output['Relationship_with_newborn_Good_Very_good'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Relax_sleep_when_newborn_is_asleep_Yes'] = df_input['Relax/sleep when the newborn is asleep'].isin(['Yes']).astype(int)
    df_output['Age_of_newborn_Older_than_1.5_year_1_year_to_1.5_year'] = df_input['Age of newborn'].isin(['Older than 1.5 year', '1 year to 1.5 year']).astype(int)
    return df_output

