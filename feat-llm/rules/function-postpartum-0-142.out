def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband_bad_poor'] = df_input['Relationship with husband'].isin(['Bad', 'Poor']).astype(int)
    df_output['Feeling_about_motherhood_sad_neutral'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Received_Support_low'] = df_input['Recieved Support'].isin(['Low']).astype(int)
    df_output['Need_for_Support_high_medium'] = df_input['Need for Support'].isin(['High', 'Medium']).astype(int)
    df_output['Abuse_yes'] = df_input['Abuse'].isin(['Yes']).astype(int)
    df_output['History_of_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery', 'Still-born delivery']).astype(int)
    df_output['Angry_after_latest_childbirth_yes'] = df_input['Angry after latest child birth'].isin(['Yes']).astype(int)
    df_output['Feeling_for_regular_activities'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Fear_of_pregnancy_yes'] = df_input['Fear of pregnancy'].isin(['Yes']).astype(int)
    df_output['Newborn_illness_yes'] = df_input['Newborn illness'].isin(['Yes']).astype(int)
    return df_output