def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood_Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Relax_sleep_when_newborn_is_tended_Yes'] = (df_input['Relax/sleep when newborn is tended'] == 'Yes').astype(int)
    df_output['Relationship_with_newborn_Good_or_Very_good'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_No'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Received_Support_High'] = (df_input['Received Support'] == 'High').astype(int)
    df_output['Family_type_Joint'] = (df_input['Family type'] == 'Joint').astype(int)
    df_output['Current_monthly_income_in_range'] = df_input['Current monthly income'].isin(['10000 to 20000', '20000 to 30000', 'More than 30000']).astype(int)
    df_output['Age_of_immediate_older_children_in_range'] = df_input['Age of immediate older children'].isin(['1yr to 3yr', '4yr to 6yr', '7yr to 12yr', '13yr or more']).astype(int)
    df_output['Total_children_more_than_two'] = df_input['Total children'].isin(['More than two', 'More than Two']).astype(int)
    df_output['Age_in_range_25_40'] = ((df_input['Age'] >= 25) & (df_input['Age'] <= 40)).astype(int)
    return df_output

