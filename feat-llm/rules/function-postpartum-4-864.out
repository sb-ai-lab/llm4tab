def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Current_monthly_income_condition'] = df_input['Current monthly income'].isin(['No', 'Less than 5000', '10000 to 20000']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_condition'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Mode_of_delivery_condition'] = (df_input['Mode of delivery'] == 'Normal Delivery').astype(int)
    df_output['Newborn_illness_condition'] = (df_input['Newborn illness'] == 'Yes').astype(int)
    df_output['Regular_checkups_condition'] = (df_input['Regular checkups'] == 'No').astype(int)
    df_output['Relax_sleep_when_newborn_tended_condition'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Received_Support_condition'] = df_input['Received Support'].isin(['Medium', 'Low']).astype(int)
    df_output['Relationship_with_husband_condition'] = df_input['Relationship with husband'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    df_output['Number_of_latest_pregnancy_condition'] = (df_input['Number of the latest pregnancy'] == 1).astype(int)
    df_output['Need_for_Support_condition'] = df_input['Need for Support'].isin(['Medium', 'High']).astype(int)
    return df_output

