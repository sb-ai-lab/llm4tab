def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Relax_sleep_newborn_tended'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Relationship_with_newborn'] = df_input['Relationship with the newborn'].isin(['Neutral', 'Bad']).astype(int)
    df_output['Major_changes_losses_pregnancy'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Received_Support'] = df_input['Received Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Family_type_Nuclear'] = (df_input['Family type'] == 'Nuclear').astype(int)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].isin(['No', 'Less than 5000', '5000 to 10000']).astype(int)
    df_output['Age_immediate_older_children_No'] = (df_input['Age of immediate older children'] == 'No').astype(int)
    df_output['Total_children_One_Two'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Age_18_30'] = ((df_input['Age'] >= 18) & (df_input['Age'] <= 30)).astype(int)
    return df_output

