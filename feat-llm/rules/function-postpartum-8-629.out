def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Abuse_Yes'] = (df_input['Abuse'] == 'Yes').astype(int)
    df_output['Relationship_with_newborn_Good_or_Very_good'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Trust_and_share_feelings_Yes'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['Relax_sleep_when_newborn_tended_Yes'] = (df_input['Relax/sleep when newborn is tended'] == 'Yes').astype(int)
    df_output['Birth_compliancy_No'] = (df_input['Birth compliancy'] == 'No').astype(int)
    df_output['Age_of_newborn_0_to_6_months_or_1_to_1.5_year'] = df_input['Age of newborn'].apply(lambda x: 1 if (x >= 0 and x <= 6) or (x >= 12 and x <= 18) else 0)
    df_output['Current_monthly_income_No_or_5000_to_10000'] = df_input['Current monthly income'].isin(['No', '5000 to 10000']).astype(int)
    df_output['Husband_monthly_income_10000_to_20000_or_More_than_30000'] = df_input['Husband’s monthly income'].isin(['10000 to 20000', 'More than 30000']).astype(int)
    df_output['Number_of_household_members_2_to_5_or_6_to_8'] = df_input['Number of household members'].apply(lambda x: 1 if (x >= 2 and x <= 5) or (x >= 6 and x <= 8) else 0)
    df_output['Major_changes_or_losses_during_pregnancy_No'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    return df_output

