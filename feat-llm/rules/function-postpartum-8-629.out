def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Occupation_After_Latest_Childbirth'] = df_input['Occupation before latest pregnancy'].isin(['Housewife', 'Student', 'Doctor']).astype(int)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Age'] = ((df_input['Age'] >= 20) & (df_input['Age'] <= 35)).astype(int)
    df_output['Pregnancy_length'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Diseases_during_pregnancy'] = df_input['Diseases during pregnancy'].isin(['No', 'Non-Chronic Disease']).astype(int)
    df_output['Worry_about_newborn'] = (df_input['Worry about newborn'] == 'No').astype(int)
    df_output['Pregnancy_plan'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)
    df_output['Feeling_for_regular_activities'] = (df_input['Feeling for regular activities'] == 'No').astype(int)
    df_output['Addiction'] = (df_input['Addiction'] == 'No').astype(int)
    return df_output

