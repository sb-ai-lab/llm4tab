def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Birth compliancy Yes'] = (df_input['Birth compliancy'] == 'Yes').astype(int)
    df_output['Angry after latest child birth Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Received Support Low or Medium'] = df_input['Recieved Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Worry about newborn Yes'] = (df_input['Worry about newborn'] == 'Yes').astype(int)
    df_output['Pregnancy plan No'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Marital status Married'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Current monthly income Less than 5000 or 10000 to 20000 or No'] = df_input['Current monthly income'].isin(['Less than 5000', '10000 to 20000', 'No']).astype(int)
    df_output['Total children One or Two'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Occupation before latest pregnancy Housewife, Teacher, or Other'] = df_input['Occupation before latest pregnancy'].isin(['Housewife', 'Teacher', 'Other', 'House wife']).astype(int)
    df_output['Pregnancy length 9 months or 10 months'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    return df_output