def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Pregnancy plan'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)
    df_output['Worry about newborn'] = (df_input['Worry about newborn'] == 'No').astype(int)
    df_output['Birth compliancy'] = (df_input['Birth compliancy'] == 'No').astype(int)
    df_output['Marital status'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Recieved Support'] = (df_input['Recieved Support'] == 'High').astype(int)
    df_output['Angry after latest child birth'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['Total children'] = df_input['Total children'].apply(lambda x: 1 if x in ['One', 'Two'] else 0)
    df_output['Pregnancy length'] = df_input['Pregnancy length'].apply(lambda x: 1 if x in ['9 months', '10 months'] else 0)
    df_output['Current monthly income'] = df_input['Current monthly income'].apply(lambda x: 1 if x in ['5000 to 10000', 'No'] else 0)
    df_output['Occupation before latest pregnancy'] = df_input['Occupation before latest pregnancy'].apply(lambda x: 1 if x in ['Housewife', 'Teacher'] else 0)
    return df_output

