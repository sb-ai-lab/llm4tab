def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Occupation After Your Latest Childbirth'] = df_input['Occupation After Your Latest Childbirth'].isin(['Teacher', 'Housewife']).astype(int)
    df_output['Relationship with husband'] = df_input['Relationship with husband'].isin(['Neutral', 'Bad', 'Poor']).astype(int)
    df_output['Age'] = df_input['Age'].between(20, 30).astype(int)
    df_output['Pregnancy length'] = df_input['Pregnancy length'].isin(['6 months', '7 months', 'Less than 5 months']).astype(int)
    df_output['Major changes or losses during pregnancy'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Diseases during pregnancy'] = df_input['Diseases during pregnancy'].isin(['Chronic Disease', 'Chronic disease']).astype(int)
    df_output['Worry about newborn'] = (df_input['Worry about newborn'] == 'Yes').astype(int)
    df_output['Pregnancy plan'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Feeling for regular activities'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Addiction'] = df_input['Addiction'].isin(['Smoking', 'Drinking', 'Drugs']).astype(int)
    return df_output

