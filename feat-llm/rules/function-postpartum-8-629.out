def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Abuse_No'] = (df_input['Abuse'] == 'No').astype(int)  
    df_output['Trust_and_share_feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)  
    df_output['Relax_sleep_when_newborn_tended_No'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)  
    df_output['Major_changes_or_losses_during_pregnancy_Yes'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)  
    df_output['Birth_compliancy_Yes'] = (df_input['Birth compliancy'] == 'Yes').astype(int)  
    df_output['Relationship_with_newborn_Good'] = (df_input['Relationship with the newborn'] == 'Good').astype(int)  
    df_output['Current_monthly_income_Less_than_5000_or_No'] = df_input['Current monthly income'].isin(['Less than 5000', 'No']).astype(int)  
    df_output['Husband_monthly_income_Less_than_5000_or_No'] = df_input['Husband’s monthly income'].isin(['No', 'Less than 5000']).astype(int)  
    df_output['Number_of_household_members_2_to_5'] = df_input['Number of household members'].between(2,5).astype(int)  
    df_output['Age_of_newborn_0_to_6_months_or_Older_than_1_5_year'] = ((df_input['Age of newborn'].between(0,6)) | (df_input['Age of newborn'] > 18)).astype(int)  
    return df_output

