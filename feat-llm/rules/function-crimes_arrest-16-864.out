    df_output['Beat_in_range_and_Primary_Type_WV'] = ((df_input['Beat'] >= 1500) & (df_input['Beat'] <= 2300) & (df_input['Primary Type'] == 'WEAPONS VIOLATION')).astype(int)
    df_output['District_in_list_and_Primary_Type_Narcotics'] = (df_input['District'].isin([4, 11, 15, 22, 25]) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)
    df_output['X_Coordinate_in_range_and_Location_Street'] = ((df_input['X Coordinate'] >= 1130000) & (df_input['X Coordinate'] <= 1199000) & (df_input['Location Description'] == 'STREET')).astype(int)
    df_output['Latitude_in_range_and_Primary_Type_WV'] = ((df_input['Latitude'] >= 41.7) & (df_input['Latitude'] <= 41.9) & (df_input['Primary Type'] == 'WEAPONS VIOLATION')).astype(int)
    df_output['Description_RETAIL_THEFT_and_Location_DEPARTMENT_STORE'] = ((df_input['Description'] == 'RETAIL THEFT') & (df_input['Location Description'] == 'DEPARTMENT STORE')).astype(int)
    return df_output

