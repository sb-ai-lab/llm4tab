    df_output['Primary_Type_PUBLIC_PEACE_VIOLATION_and_Location_Description_STREET'] = ((df_input['Primary Type'] == 'PUBLIC PEACE VIOLATION') & (df_input['Location Description'] == 'STREET')).astype(int)
    return df_output

