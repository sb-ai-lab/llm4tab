def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['cond_1'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']).astype(int)  
    df_output['cond_2'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'FOUND SUSPECT NARCOTICS']).astype(int)  
    df_output['cond_3'] = ((df_input['Primary Type'] == 'MOTOR VEHICLE THEFT') & (df_input['Description'] == 'THEFT / RECOVERY - AUTOMOBILE')).astype(int)  
    df_output['cond_4'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT') & (df_input['Location Description'] == 'DEPARTMENT STORE')).astype(int)  
    df_output['cond_5'] = ((df_input['Primary Type'] == 'CRIMINAL DAMAGE') & (df_input['Description'] == 'TO VEHICLE') & (df_input['Domestic'] == 1)).astype(int)  
    df_output['cond_6'] = df_input['FBI Code'].isin(['07', '15', '18']).astype(int)  
    df_output['cond_7'] = ((df_input['Location Description'] == 'STREET') & (df_input['Primary Type'] == 'WEAPONS VIOLATION')).astype(int)  
    df_output['cond_8'] = ((df_input['Domestic'] == 0) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)  
    df_output['cond_9'] = (((df_input['Beat'] >= 1500) & (df_input['Beat'] <= 2300)) & (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))).astype(int)  
    df_output['cond_10'] = ((df_input['Year'] == 2025) & (df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT')).astype(int)  
    return df_output