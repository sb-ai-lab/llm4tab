    df_output['Primary_Type_Motor_Vehicle_Theft_and_Description_Automobile_and_Location_Description_Street'] = ((df_input['Primary Type'] == 'MOTOR VEHICLE THEFT') & (df_input['Description'] == 'AUTOMOBILE') & (df_input['Location Description'] == 'STREET')).astype(int)  
    df_output['Primary_Type_Deceptive_Practice_and_Description_Credit_Card_Fraud'] = ((df_input['Primary Type'] == 'DECEPTIVE PRACTICE') & (df_input['Description'] == 'CREDIT CARD FRAUD')).astype(int)  
    df_output['Domestic_0_and_Primary_Type_Public_Peace_Violation'] = ((df_input['Domestic'] == 0) & (df_input['Primary Type'] == 'PUBLIC PEACE VIOLATION')).astype(int)  
