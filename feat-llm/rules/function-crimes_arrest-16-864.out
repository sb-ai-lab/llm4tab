def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'MOTOR VEHICLE THEFT', 'THEFT', 'CRIMINAL DAMAGE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'RETAIL THEFT', 'THEFT / RECOVERY - AUTOMOBILE', 'TO VEHICLE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'DEPARTMENT STORE', 'SIDEWALK', 'APARTMENT']).astype(int)
    df_output['Domestic_1_and_Primary_MOTOR_VEHICLE_THEFT'] = ((df_input['Domestic'] == 1) & (df_input['Primary Type'] == 'MOTOR VEHICLE THEFT')).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['07', '15', '18', '06', '14']).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/10/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/31/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date_in_range_and_Primary_WEAPONS_VIOLATION'] = ((df_input['Date_parsed'] >= start_date) & (df_input['Date_parsed'] <= end_date) & (df_input['Primary Type'] == 'WEAPONS VIOLATION')).astype(int)
    df_output['Beat_in_range_and_Primary_NARCOTICS'] = ((df_input['Beat'] >= 1500) & (df_input['Beat'] <= 1900) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)
    df_output['District_in_range_and_Primary_NARCOTICS'] = ((df_input['District'] >= 15) & (df_input['District'] <= 25) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)
    df_output['Ward_in_range_and_Primary_THEFT_and_Description_RETAIL_THEFT'] = ((df_input['Ward'] >= 9) & (df_input['Ward'] <= 42) & (df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT')).astype(int)
    df_output['Community_Area_in_range_and_Primary_CRIMINAL_DAMAGE'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 29) & (df_input['Primary Type'] == 'CRIMINAL DAMAGE')).astype(int)
    df_output.drop(columns=['Date_parsed'], inplace=True, errors='ignore')
    return df_output

