    df_output['Location_Description_DEPARTMENT_STORE_and_Primary_Type_OTHER_OFFENSE'] = ((df_input['Location Description'] == 'DEPARTMENT STORE') & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
