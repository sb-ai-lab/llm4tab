    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/15/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date_in_range_and_Primary_Type_OTHER_OFFENSE'] = (((df_input['Date_parsed'] >= start_date) & (df_input['Date_parsed'] <= end_date)) & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
    df_output['Beat_in_range_and_Location_Description_APARTMENT'] = (((df_input['Beat'] >= 100) & (df_input['Beat'] <= 400)) & (df_input['Location Description'] == 'APARTMENT')).astype(int)
    df_output['District_in_range_and_Primary_Type_BATTERY'] = (((df_input['District'] >= 1) & (df_input['District'] <= 5)) & (df_input['Primary Type'] == 'BATTERY')).astype(int)
    df_output['Ward_in_range_and_Domestic_1'] = (((df_input['Ward'] >= 20) & (df_input['Ward'] <= 30)) & (df_input['Domestic'] == 1)).astype(int)
    df_output['Community_Area_in_range_and_Primary_Type_MOTOR_VEHICLE_THEFT'] = (((df_input['Community Area'] >= 25) & (df_input['Community Area'] <= 50)) & (df_input['Primary Type'] == 'MOTOR VEHICLE THEFT')).astype(int)
    df_output = df_output.astype(int)
    return df_output

