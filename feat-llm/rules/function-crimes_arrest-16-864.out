    df_output['Description_in_list'] = df_input['Description'].isin(['FOUND SUSPECT NARCOTICS', 'UNLAWFUL POSSESSION - HANDGUN', 'RETAIL THEFT', 'THEFT / RECOVERY - AUTOMOBILE, TO VEHICLE', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'DEPARTMENT STORE', 'APARTMENT', 'SIDEWALK']).astype(int)
