    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['08B', '04']).astype(int)
    df_output['Beat_in_range_and_Primary_Type_BATTERY'] = (((df_input['Beat'] >= 1800) & (df_input['Beat'] <= 1900)) & (df_input['Primary Type'] == 'BATTERY')).astype(int)
    df_output['Ward_in_range_and_Description_SIMPLE'] = (((df_input['Ward'] >= 1) & (df_input['Ward'] <= 10)) & (df_input['Description'] == 'SIMPLE')).astype(int)
    df_output['Date_in_range_and_Primary_Type_BATTERY'] = (pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce').between(pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p'), pd.to_datetime('01/31/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')) & (df_input['Primary Type'] == 'BATTERY')).astype(int)
    df_output['X_Coordinate_in_range_and_Location_Description_DEPARTMENT_STORE'] = (((df_input['X Coordinate'] >= 1170000) & (df_input['X Coordinate'] <= 1180000)) & (df_input['Location Description'] == 'DEPARTMENT STORE')).astype(int)
    df_output['Community_Area_in_range_and_Primary_Type_BATTERY'] = (((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 15)) & (df_input['Primary Type'] == 'BATTERY')).astype(int)
    return df_output

