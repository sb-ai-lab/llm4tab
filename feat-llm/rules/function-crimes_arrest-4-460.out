def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'CRIM SEXUAL ASSAULT']).astype(int)  
    df_output['Description'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY']).astype(int)  
    df_output['Location Description'] = df_input['Location Description'].isin(['NURSING / RETIREMENT HOME', 'STREET', 'CTA BUS STOP']).astype(int)  
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)  
    df_output['Beat'] = (df_input['Beat'] > 200).astype(int)  
    df_output['District'] = (df_input['District'] < 10).astype(int)  
    df_output['Ward'] = (df_input['Ward'] == 25).astype(int)  
    df_output['Community Area'] = (df_input['Community Area'] == 32).astype(int)  
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '06', '22']).astype(int)  
    df_output['X Coordinate'] = (df_input['X Coordinate'] > 1000000).astype(int)  
    df_output['Y Coordinate'] = (df_input['Y Coordinate'] > 2000000).astype(int)  
    df_output['Year'] = (df_input['Year'] == 2025).astype(int)  
    df_output['Latitude'] = (df_input['Latitude'] > 41.8).astype(int)  
    df_output['Longitude'] = (df_input['Longitude'] < -87.6).astype(int)  
    return df_output