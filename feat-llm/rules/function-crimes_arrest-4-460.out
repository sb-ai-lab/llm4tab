    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['DEPARTMENT STORE', 'STREET', 'CTA BUS STOP']).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['08B', '03', '04']).astype(int)
    df_output['Primary_BATTERY_and_Description_SIMPLE'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'SIMPLE')).astype(int)
    df_output['Beat_in_range_and_Primary_BATTERY'] = ((df_input['Beat'] >= 1800) & (df_input['Beat'] <= 1900) & (df_input['Primary Type'] == 'BATTERY')).astype(int)
    df_output['Community_Area_in_range_and_Primary_BATTERY_or_ASSAULT'] = ((df_input['Community Area'] >= 5) & (df_input['Community Area'] <= 15) & (df_input['Primary Type'].isin(['BATTERY', 'ASSAULT']))).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    df_output['Date_early_morning_and_Primary_BATTERY_or_ASSAULT'] = ((df_input['Date_parsed'].dt.hour >= 0) & (df_input['Date_parsed'].dt.hour < 5) & (df_input['Primary Type'].isin(['BATTERY', 'ASSAULT']))).astype(int)
    df_output['Ward_in_range_and_Primary_BATTERY_or_ROBBERY'] = ((df_input['Ward'] >= 1) & (df_input['Ward'] <= 10) & (df_input['Primary Type'].isin(['BATTERY', 'ROBBERY']))).astype(int)
    df_output.drop(columns=['Date_parsed'], inplace=True, errors='ignore')
    return df_output

