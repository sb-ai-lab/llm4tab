def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['MOTOR VEHICLE THEFT', 'THEFT', 'CRIMINAL DAMAGE', 'BURGLARY', 'NARCOTICS']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['THEFT / RECOVERY - AUTOMOBILE', 'TO PROPERTY', 'SIMPLE THEFT']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['ALLEY', 'RESIDENCE', 'APARTMENT', 'PARKING LOT', 'GAS STATION']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['07', '14', '06']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 900) & (df_input['Beat'] <= 1100)).astype(int)
    df_output['District'] = ((df_input['District'] >= 8) & (df_input['District'] <= 11)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 15) & (df_input['Ward'] <= 25)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 20) & (df_input['Community Area'] <= 40)).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    date_condition = (date_parsed >= pd.to_datetime('01/01/2025 12:00:00 AM')) & (date_parsed <= pd.to_datetime('01/30/2025 11:59:59 PM'))
    time_condition = (date_parsed.dt.hour >= 6) & (date_parsed.dt.hour < 18)
    df_output['Date'] = (date_condition & time_condition).astype(int)
    return df_output

