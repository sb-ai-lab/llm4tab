def extracting_features_1(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'NARCOTICS', 'ASSAULT', 'ROBBERY', 'SEX OFFENSE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['SIMPLE', 'POSSESS - PCP', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'SIDEWALK', 'PARK']).astype(int)
    violent_crimes = ['BATTERY', 'ASSAULT', 'ROBBERY', 'SEX OFFENSE']
    cond_domestic = (df_input['Domestic'] == 1) | ((df_input['Domestic'] == 0) & (df_input['Primary Type'].isin(violent_crimes)))
    df_output['Domestic'] = cond_domestic.astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '18', '03']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1100) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District'] = ((df_input['District'] >= 12) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 30) & (df_input['Ward'] <= 50)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 20)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    date_cond = (df_input['Date'] >= pd.to_datetime('01/01/2025 12:00:00 AM')) & (df_input['Date'] <= pd.to_datetime('01/30/2025 11:59:59 PM'))
    time_cond = (df_input['Date'].dt.hour >= 18) | (df_input['Date'].dt.hour < 6)
    df_output['Date'] = (date_cond & time_cond).astype(int)
    return df_output

