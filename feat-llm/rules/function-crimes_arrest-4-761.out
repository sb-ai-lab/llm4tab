def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['NARCOTICS', 'BATTERY', 'ASSAULT', 'WEAPONS VIOLATION']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['SIMPLE', 'POSSESS - PCP', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'SIDEWALK']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].apply(lambda x: 1 if x in [0,1] else 0)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '18', '15']).astype(int)
    df_output['Beat'] = df_input['Beat'].apply(lambda x: 1 if (1100 <= x <= 1200) or (1900 <= x <= 2000) else 0)
    df_output['District'] = df_input['District'].isin([11, 19]).astype(int)
    df_output['Ward'] = df_input['Ward'].apply(lambda x: 1 if 40 <= x <= 45 else 0)
    df_output['Community Area'] = df_input['Community Area'].apply(lambda x: 1 if 5 <= x <= 25 else 0)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    df_output['Date'] = df_input['Date_parsed'].dt.hour.apply(lambda x: 1 if (18 <= x <= 23) else 0)
    df_output = df_output.astype(int)
    return df_output

