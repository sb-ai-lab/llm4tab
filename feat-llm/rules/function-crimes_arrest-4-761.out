def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['NARCOTICS', 'BATTERY', 'ASSAULT', 'CRIMINAL SEXUAL ASSAULT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['POSSESS - PCP', 'SIMPLE', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'CTA BUS STOP']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '18', '04']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1100) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District'] = ((df_input['District'] >= 10) & (df_input['District'] <= 20)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 30) & (df_input['Ward'] <= 50)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 5) & (df_input['Community Area'] <= 30)).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/21/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/30/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    return df_output