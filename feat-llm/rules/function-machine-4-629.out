def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Temperature_gt_70'] = (df_input['Temperature'] > 70).astype(int)
    df_output['Vibration_gt_50'] = (df_input['Vibration'] > 50).astype(int)
    df_output['Power_Usage_gt_10'] = (df_input['Power_Usage'] > 10).astype(int)
    df_output['Humidity_lt_35'] = (df_input['Humidity'] < 35).astype(int)
    df_output['Machine_Type_in_Mill_Drill'] = df_input['Machine_Type'].isin(['Mill', 'Drill']).astype(int)
    df_output['Temperature_in_71_77'] = df_input['Temperature'].between(71, 77).astype(int)
    df_output['Vibration_in_51_60'] = df_input['Vibration'].between(51, 60).astype(int)
    df_output['Power_Usage_in_11_15'] = df_input['Power_Usage'].between(11, 15).astype(int)
    df_output['Humidity_le_35'] = (df_input['Humidity'] <= 35).astype(int)
    df_output['Machine_Type_not_Lathe'] = (df_input['Machine_Type'] != 'Lathe').astype(int)
    return df_output