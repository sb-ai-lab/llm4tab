def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_child_birth_No'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['Need_for_Support_No'] = (df_input['Need for Support'] == 'No').astype(int)
    df_output['Relationship_with_newborn_Good_or_Very_good'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Relationship_between_father_and_newborn_Good_or_Very_good'] = df_input['Relationship between father and newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Age_of_newborn_in_range'] = df_input['Age of newborn'].isin(['Older than 1.5 year', '1 year to 1.5 year', '6 months to 1 year']).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_in_range'] = df_input['Monthly income before latest pregnancy'].isin(['No', '10000 to 20000', '20000 to 30000', 'More than 30000']).astype(int)
    df_output['Addiction_No'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Number_of_latest_pregnancy_ge_2'] = (df_input['Number of the latest pregnancy'] >= 2).astype(int)
    df_output['Age_in_range_25_35'] = df_input['Age'].between(25, 35).astype(int)
    df_output['Mode_of_delivery_in_list'] = df_input['Mode of delivery'].isin(['Caesarean Section', 'Normal Delivery']).astype(int)
    return df_output

