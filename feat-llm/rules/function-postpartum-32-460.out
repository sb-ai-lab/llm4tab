def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_inlaws'] = df_input['Relationship with in-laws'].isin(['Good', 'Friendly', 'Neutral']).astype(int)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly', 'Neutral']).astype(int)
    df_output['Relationship_with_newborn'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Birth_compliancy'] = (df_input['Birth compliancy'] == 'No').astype(int)
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['No', 'Low']).astype(int)
    df_output['Pregnancy_plan'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)
    df_output['History_of_pregnancy_loss'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Monthly_income_before_latest_pregnancy'] = df_input['Monthly income before latest pregnancy'].isin(['More than 30000', '20000 to 30000', 'No']).astype(int)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].isin(['More than 30000', '20000 to 30000', 'No']).astype(int)
    df_output['Age_of_immediate_older_children'] = df_input['Age of immediate older children'].isin(['No', '4yr to 6yr', '7yr to 12yr', '13yr or more']).astype(int)
