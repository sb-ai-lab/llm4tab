def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_newborn_is_Good'] = (df_input['Relationship with the newborn'] == 'Good').astype(int)
    df_output['Number_of_household_members_2_to_5'] = df_input['Number of household members'].between(2,5).astype(int)
    df_output['Husband_education_University_or_College'] = df_input['Husband education level'].isin(['University', 'College']).astype(int)
    df_output['Angry_after_latest_child_birth_is_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_is_No'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Regular_checkups_Yes_or_No'] = df_input['Regular checkups'].isin(['Yes', 'No']).astype(int)
    df_output['Age_of_newborn_in_0_to_6_months_or_6_months_to_1_year'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year']).astype(int)
    df_output['Fear_of_pregnancy_Yes_or_No'] = df_input['Fear of pregnancy'].isin(['Yes', 'No']).astype(int)
    df_output['Mode_of_delivery_is_Normal_Delivery'] = (df_input['Mode of delivery'] == 'Normal Delivery').astype(int)
    df_output['Relationship_Good_and_Angry_Yes'] = ((df_input['Relationship with the newborn'] == 'Good') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    return df_output