def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Angry_after_latest_child_birth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)  
    df_output['Need_for_Support_Low_Medium'] = df_input['Need for Support'].isin(['Low', 'Medium']).astype(int)  
    df_output['Relationship_with_newborn_Good'] = (df_input['Relationship with the newborn'] == 'Good').astype(int)  
    df_output['Relationship_father_newborn_Neutral_Good'] = df_input['Relationship between father and newborn'].isin(['Neutral', 'Good']).astype(int)  
    df_output['Age_of_newborn_0_6_6_12_months'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year']).astype(int)  
    df_output['Monthly_income_before_pregnancy_No_Less5000_5000_10000'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'Less than 5000', '5000 to 10000']).astype(int)  
    df_output['Addiction_No'] = (df_input['Addiction'] == 'No').astype(int)  
    df_output['Number_latest_pregnancy_le_2'] = (df_input['Number of the latest pregnancy'] <= 2).astype(int)  
    df_output['Age_22_30'] = df_input['Age'].between(22, 30).astype(int)  
    df_output['Mode_of_delivery_Normal_Caesarean'] = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section']).astype(int)  
    return df_output

