def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Debt_ge_5000'] = (df_input['Debt'] >= 5000).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Initial_limit_le_1500'] = (df_input['Initial limit'] <= 1500).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['INCOME_lt_1000'] = (df_input['INCOME'] < 1000).astype(int)
    df_output['Credit_history_rating_in_C_D_E'] = df_input['Credit history rating'].isin(['C1', 'C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_gt_0_35'] = (df_input['PDN'] > 0.35).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 2).astype(int)
    df_output['FAMILYSTATUS_le_1'] = (df_input['FAMILYSTATUS'] <= 1).astype(int)
    df_output['LV_AREA_in_selected'] = df_input['LV_AREA'].str.replace("'", "").str.strip().isin(['Brestskaja oblast', "Gomel'skaja oblast", 'Vitebskaja oblast']).astype(int)
    return df_output

