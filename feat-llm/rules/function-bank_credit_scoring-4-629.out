def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Debt_gt_5000'] = (df_input['Debt'] > 5000).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Initial_limit_lt_2000'] = (df_input['Initial limit'] < 2000).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['Credit_history_rating_in_D_E'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['INCOME_lt_1000'] = (df_input['INCOME'] < 1000).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 2).astype(int)
    df_output['TERM_gt_48'] = (df_input['TERM'] > 48).astype(int)
    df_output['SEX_is_Male'] = (df_input['SEX'] == 'Male').astype(int)
    return df_output

