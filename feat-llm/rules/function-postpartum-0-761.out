def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].isin(['Happy']).astype(int)
    df_output['Received_Support'] = df_input['Recieved Support'].isin(['High']).astype(int)
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['No', 'Low']).astype(int)
    df_output['Trust_and_share_feelings'] = df_input['Trust and share feelings'].isin(['Yes']).astype(int)
    df_output['Relationship_with_newborn'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Age_of_newborn'] = df_input['Age of newborn'].isin(['Older than 1.5 year', '1 year to 1.5 year']).astype(int)
    df_output['Regular_checkups'] = df_input['Regular checkups'].isin(['Yes']).astype(int)
    df_output['Addiction'] = df_input['Addiction'].isin(['No']).astype(int)
    df_output['Abuse'] = df_input['Abuse'].isin(['No']).astype(int)
    return df_output

