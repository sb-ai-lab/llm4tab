def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband_bad_poor'] = df_input['Relationship with husband'].isin(['Bad', 'Poor']).astype(int)
    df_output['Feeling_about_motherhood_sad_neutral'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Received_Support_low_medium'] = df_input['Recieved Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Need_for_Support_high_medium'] = df_input['Need for Support'].isin(['High', 'Medium']).astype(int)
    df_output['Trust_and_share_feelings_no'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['History_of_pregnancy_loss_miscarriage_stillborn'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Abuse_yes'] = (df_input['Abuse'] == 'Yes').astype(int)
    df_output['Angry_after_latest_childbirth_yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Feeling_for_regular_activities_worried_tired_afraid'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Worry_about_newborn_yes'] = (df_input['Worry about newborn'] == 'Yes').astype(int)
    return df_output

