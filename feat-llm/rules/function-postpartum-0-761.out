def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Age'] = df_input['Age'].apply(lambda x: 1 if 25 <= x <= 40 else 0)
    df_output['Marital status'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Married' else 0)
    df_output['Recieved Support'] = df_input['Recieved Support'].apply(lambda x: 1 if x in ['High', 'Medium'] else 0)
    df_output['Relationship with husband'] = df_input['Relationship with husband'].apply(lambda x: 1 if x in ['Good', 'Friendly'] else 0)
    df_output['Feeling about motherhood'] = df_input['Feeling about motherhood'].apply(lambda x: 1 if x == 'Happy' else 0)
    df_output['Addiction'] = df_input['Addiction'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Pregnancy plan'] = df_input['Pregnancy plan'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Regular checkups'] = df_input['Regular checkups'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Abuse'] = df_input['Abuse'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Relationship with the newborn'] = df_input['Relationship with the newborn'].apply(lambda x: 1 if x in ['Good', 'Very good'] else 0)
    return df_output

