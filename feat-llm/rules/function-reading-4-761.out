def extracting_features_0(df_input):
    freq_order = ['Less than once a year', 'Once or twice a year', 'A few times a month', 'A few times a week', 'On everyday basis']
    def freq_leq(val, threshold):
        if val not in freq_order or threshold not in freq_order:
            return 0
        return int(freq_order.index(val) <= freq_order.index(threshold))
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Favorite_books_for_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] <= 1).astype(int)
    df_output['Department'] = df_input['Department'].isin(['English', 'BBA', 'JMC', 'Textile', 'NFE', 'Others']).astype(int)
    df_output['Number_of_ebooks_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_printed_books_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Friends', 'Parents']).astype(int)
    df_output['Frequency_of_reading_books_leq_A_few_times_a_month'] = df_input['Frequency of reading books'].apply(lambda x: freq_leq(x, 'A few times a month'))
    df_output['Format_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['E-books', 'Others']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Often'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Department_Selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'CIS']).astype(int)
    df_output['Time_Reading_1hr_or_more'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Ebooks_Read_Many'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_Read_Many'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Influenced_Teachers_Self'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    df_output['Format_Printed_Both'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Language_English'] = (df_input['Which language books do you like to read'] == 'English').astype(int)
    return df_output

