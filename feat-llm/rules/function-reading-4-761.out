def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['freq_reading_condition'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['reason_reading_condition'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'Keep me informative', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['favorite_books_condition'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Others']).astype(int)
    df_output['time_spent_reading_condition'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['department_condition'] = df_input['Department'].isin(['BBA', 'English', 'NFE', 'JMC', 'Textile', 'Civil', 'Others']).astype(int)
    df_output['ebooks_read_condition'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['printed_books_read_condition'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['change_after_reading_condition'] = df_input['What is the change that you fell after reading books'].isin(['Feel Relax', 'Increase Creative Thinking']).astype(int)
    cond_freq = df_input['Frequency of reading books'] == 'A few times a month'
    cond_reason = df_input['Reason for reading books'] != 'Academic Purpose'
    df_output['freq_reason_condition'] = (cond_freq & cond_reason).astype(int)
    freq_order = ['Less than once a year', 'Once or twice a year', 'A few times a month', 'A few times a week', 'On everyday basis']
    freq_map = {k: v for v, k in enumerate(freq_order)}
    freq_values = df_input['Frequency of reading books'].map(freq_map)
    cond_format = df_input['The format that you used for reading books'].isin(['Printed', 'Others'])
    cond_freq_less = freq_values < freq_map['A few times a week']
    df_output['format_freq_condition'] = (cond_format & cond_freq_less).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Reason_for_reading_books'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Department'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'MCT', 'CIS']).astype(int)
    df_output['Number_of_e_books_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_after_reading_books'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Where_do_you_read_printed_books'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    df_output['Format_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['E-books', 'Both']).astype(int)
    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    return df_output

