def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_Never'] = df_input['social_connection_frequency'].isin(['Never']).astype(int)
    df_output['gathering_size_preference_Small_gatherings'] = df_input['gathering_size_preference'].isin(['Small gatherings']).astype(int)
    df_output['valued_friendship_traits_Honesty'] = df_input['valued_friendship_traits'].isin(['Honesty']).astype(int)
    df_output['conflict_resolution_style_Avoid_conflict_Let_time_fix_it'] = df_input['conflict_resolution_style'].isin(['Avoid conflict', 'Let time fix it']).astype(int)
    df_output['family_support_level_Yes'] = df_input['family_support_level'].isin(['Yes']).astype(int)
    df_output['social_battery_recharge_Alone_time_None_of_the_above'] = df_input['social_battery_recharge'].isin(['Alone time', 'None of the above']).astype(int)
    df_output['social_orientation_type_Introvert_Not_sure'] = df_input['social_orientation_type'].isin(['Introvert', 'Not sure']).astype(int)
    df_output['social_anxiety_level_Nervous_Avoid_it'] = df_input['social_anxiety_level'].isin(['Nervous', 'Avoid it']).astype(int)
    df_output['emotional_expression_method_Stay_silent_Other'] = df_input['emotional_expression_method'].isin(['Stay silent', 'Other']).astype(int)
    cond = (
        (df_input['social_connection_frequency'].isin(['Monthly'])) &
        (df_input['gathering_size_preference'].isin(['Never'])) &
        (df_input['valued_friendship_traits'].isin(['Support'])) &
        (df_input['family_support_level'].isin(['Sometimes']))
    )
    df_output['combined_condition'] = cond.astype(int)
    return df_output

