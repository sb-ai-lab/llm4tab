def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_of_reading_books_in_On_everyday_basis_or_A_few_times_a_week'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_gte_2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number_of_e_books_you_read_last_two_years_in_More_than_20_or_16_20'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20']).astype(int)
