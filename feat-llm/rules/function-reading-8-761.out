def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason for reading books is Academic Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency of reading books is in [On everyday basis, A few times a week]'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Amount of time spent reading books per day >= 2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['What is the change that you felt after reading books is in [Increase Academic Performance, Increase Problem Solving Skill]'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Department is in [CSE, SWE, Pharmacy, Civil, EEE]'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'Civil', 'EEE']).astype(int)
    df_output['Number of e-books you read last two years is in [More than 20, 16-20]'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20']).astype(int)
    df_output['Number of printed books you read last two years is in [More than 20, 16-20, 11-15, 6-10]'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15', '6-10']).astype(int)
    df_output['The format that you used for reading books is in [Both, Printed]'] = df_input['The format that you used for reading books'].isin(['Both', 'Printed']).astype(int)
    df_output['Who influenced you to read books is in [Teachers, Self-Decision]'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    df_output['Which language books you like to read is English'] = (df_input['Which language books do you like to read'] == 'English').astype(int)
    return df_output

