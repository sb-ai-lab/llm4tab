    df_output['What_is_the_change_that_you_fell_after_reading_books_in_Increase_Academic_Performance_or_Increase_Problem_Solving_Skill'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Department_in_CSE_SWE_EEE_Pharmacy_Civil_MCT_CIS_Textile'] = df_input['Department'].isin(['CSE', 'SWE', 'EEE', 'Pharmacy', 'Civil', 'MCT', 'CIS', 'Textile']).astype(int)
    df_output['The_format_that_you_used_for_reading_books_in_Both_E_books'] = df_input['The format that you used for reading books'].isin(['Both', 'E-books']).astype(int)
