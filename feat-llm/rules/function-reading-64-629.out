def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_of_reading_books_in_On_everyday_basis_Most_days'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'Most days']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_gte_2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_6-10_11-15_16-20_More_than_20'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_ebooks_read_last_two_years_in_6-10_11-15_16-20_More_than_20'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['What_is_the_change_after_reading_books_in_Increase_Academic_Performance_Increase_Knowledge'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Knowledge']).astype(int)
    df_output['Department_in_CSE_SWE_Pharmacy_EEE_Civil_Textile_CIS_MCT'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'Textile', 'CIS', 'MCT']).astype(int)
    df_output['Favorite_books_for_leisure_in_Non-Fiction_Biography'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Frequency_of_reading_books_is_On_everyday_basis'] = (df_input['Frequency of reading books'] == 'On everyday basis').astype(int)
    df_output['How_to_manage_books_for_reading_in_Buy_Borrow_Used-all'] = df_input['How to manage books for reading'].isin(['Buy', 'Borrow', 'Used-all']).astype(int)
    return df_output

