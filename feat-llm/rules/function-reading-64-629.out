def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'CIS']).astype(int)
    df_output['Time_spent_reading_>=1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Printed_books_in_selected'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['E_books_in_selected'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Favorite_books_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Politics']).astype(int)
    df_output['Frequency_in_selected'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Manage_books_in_selected'] = df_input['How to manage books for reading'].isin(['Buy', 'Borrow']).astype(int)
    df_output['Change_after_reading_in_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Creative Thinking']).astype(int)
    df_output['Format_used_Both'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    return df_output