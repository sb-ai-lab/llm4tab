def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_On_everyday_basis'] = (df_input['Frequency of reading books'] == 'On everyday basis').astype(int)
    df_output['Time_spent_reading_ge_1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Ebooks_read_in_range'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read_in_range'] = df_input['Number of printed books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_in_list'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'Textile', 'CIS']).astype(int)
    df_output['Favorite_books_in_list'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Manage_books_in_list'] = df_input['How to manage books for reading'].isin(['Borrow', 'Buy', 'Used-all', 'E-books']).astype(int)
    freq_map = {
        'On everyday basis': 7,
        'A few times a week': 3,
        'A few times a month': 1,
        'Once or twice a year': 0,
        'Less than once a year': 0
    }
    freq_values = df_input['Frequency of reading books'].map(freq_map).fillna(0)
    df_output['Frequency_at_least_once_a_week'] = (freq_values >= 1).astype(int)
    return df_output

