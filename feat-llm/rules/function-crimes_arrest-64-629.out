def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
  
    possession_manufacture_domestic_desc = [  
        'POSSESS - CRACK', 'POSSESS - CANNABIS 30 GRAMS OR LESS', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS',  
        'DOMESTIC BATTERY SIMPLE', 'VIOLATION OF CIVIL NO CONTACT ORDER', 'LIQUOR LICENSE VIOLATION', 'FOUND SUSPECT NARCOTICS'  
    ]  
  
    primary_type_set = {'NARCOTICS', 'BATTERY', 'LIQUOR LAW VIOLATION', 'OTHER OFFENSE'}  
    location_desc_set = {'ALLEY', 'BAR OR TAVERN', 'TAVERN / LIQUOR STORE', 'SIDEWALK', 'VEHICLE NON-COMMERCIAL', 'RESIDENCE'}  
    fbi_code_set = {'08B', '18', '22', '26'}  
    district_set = {1, 6, 8, 9, 15}  
  
    # Convert Date to datetime  
    df_input['Date_dt'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')  
  
    # Condition 1: Primary Type in set and Description related to possession, manufacture, or domestic battery  
    cond1 = (df_input['Primary Type'].isin(primary_type_set)) & (df_input['Description'].isin(possession_manufacture_domestic_desc))  
    df_output['cond1'] = cond1.astype(int)  
  
    # Condition 2: Description in list  
    cond2 = df_input['Description'].isin(possession_manufacture_domestic_desc)  
    df_output['cond2'] = cond2.astype(int)  
  
    # Condition 3: Location Description in list and Primary Type in NARCOTICS or BATTERY or LIQUOR LAW VIOLATION  
    cond3 = (df_input['Location Description'].isin(location_desc_set)) & (df_input['Primary Type'].isin({'NARCOTICS', 'BATTERY', 'LIQUOR LAW VIOLATION'}))  
    df_output['cond3'] = cond3.astype(int)  
  
    # Condition 4: Domestic=1 and Primary Type is BATTERY or OTHER OFFENSE  
    cond4 = (df_input['Domestic'] == 1) & (df_input['Primary Type'].isin({'BATTERY', 'OTHER OFFENSE'}))  
    df_output['cond4'] = cond4.astype(int)  
  
    # Condition 5: FBI Code in list and Description indicates possession, manufacture, or domestic violence  
    cond5 = (df_input['FBI Code'].isin(fbi_code_set)) & (df_input['Description'].isin(possession_manufacture_domestic_desc))  
    df_output['cond5'] = cond5.astype(int)  
  
    # Condition 6: Beat in range [500, 1000] and Primary Type is NARCOTICS or BATTERY  
    cond6 = (df_input['Beat'].between(500, 1000)) & (df_input['Primary Type'].isin({'NARCOTICS', 'BATTERY'}))  
    df_output['cond6'] = cond6.astype(int)  
  
    # Condition 7: District in list and Description related to narcotics or domestic battery  
    narcotics_domestic_desc = possession_manufacture_domestic_desc  
    cond7 = (df_input['District'].isin(district_set)) & (df_input['Description'].isin(narcotics_domestic_desc))  
    df_output['cond7'] = cond7.astype(int)  
  
    # Condition 8: Ward in range [3, 29] and Primary Type is NARCOTICS or BATTERY or LIQUOR LAW VIOLATION  
    cond8 = (df_input['Ward'].between(3, 29)) & (df_input['Primary Type'].isin({'NARCOTICS', 'BATTERY', 'LIQUOR LAW VIOLATION'}))  
    df_output['cond8'] = cond8.astype(int)  
  
    # Condition 9: Community Area in range [25, 71] and Primary Type is NARCOTICS or BATTERY  
    cond9 = (df_input['Community Area'].between(25, 71)) & (df_input['Primary Type'].isin({'NARCOTICS', 'BATTERY'}))  
    df_output['cond9'] = cond9.astype(int)  
  
    # Condition 10: Date in range and Primary Type is NARCOTICS or LIQUOR LAW VIOLATION or BATTERY with Domestic=1  
    start_date = pd.to_datetime('01/01/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')  
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')  
    date_in_range = df_input['Date_dt'].between(start_date, end_date)  
    cond10 = date_in_range & (  
        (df_input['Primary Type'].isin({'NARCOTICS', 'LIQUOR LAW VIOLATION'})) |  
        ((df_input['Primary Type'] == 'BATTERY') & (df_input['Domestic'] == 1))  
    )  
    df_output['cond10'] = cond10.astype(int)  
  
    df_output.index = df_input.index  
    return df_output