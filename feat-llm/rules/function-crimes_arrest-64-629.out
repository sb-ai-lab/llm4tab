def extracting_features_0(df_input):
    import pandas as pd
    df_output = pd.DataFrame(index=df_input.index)

    primary_type_cond = df_input['Primary Type'].isin([
        'THEFT', 'CRIMINAL DAMAGE', 'CRIMINAL TRESPASS', 'DECEPTIVE PRACTICE', 'MOTOR VEHICLE THEFT', 'OTHER OFFENSE'
    ]).astype(int)
    df_output['Primary Type Condition'] = primary_type_cond

    description_cond = df_input['Description'].isin([
        'TO PROPERTY', 'TO VEHICLE', 'TO RESIDENCE', '$500 AND UNDER', 'FROM BUILDING',
        'VEHICLE TITLE / REGISTRATION OFFENSE', 'FINANCIAL EXPLOITATION OF AN ELDERLY OR DISABLED PERSON'
    ]).astype(int)
    df_output['Description Condition'] = description_cond

    location_desc_cond = df_input['Location Description'].isin([
        'APARTMENT', 'STREET', 'COLLEGE / UNIVERSITY - GROUNDS', 'RESIDENCE', 'OTHER (SPECIFY)'
    ]).astype(int)
    df_output['Location Description Condition'] = location_desc_cond

    domestic_cond = (df_input['Domestic'] == 0).astype(int)
    df_output['Domestic Condition'] = domestic_cond

    fbi_code_cond = df_input['FBI Code'].isin(['06', '07', '11', '14', '26']).astype(int)
    df_output['FBI Code Condition'] = fbi_code_cond

    desc_lower = df_input['Description'].str.lower()
    narcotics_liquor = desc_lower.str.contains('narcotics') | (df_input['Primary Type'].isin(['NARCOTICS', 'LIQUOR LAW VIOLATION']))
    beat_cond = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2000) & (~narcotics_liquor)).astype(int)
    df_output['Beat Condition'] = beat_cond

    district_cond = (df_input['District'].isin([3,5,11,12,18,19]) & (~df_input['Primary Type'].isin(['NARCOTICS', 'BATTERY']))).astype(int)
    df_output['District Condition'] = district_cond

    ward_cond = ((df_input['Ward'] >= 4) & (df_input['Ward'] <= 46) & (~df_input['Primary Type'].isin(['LIQUOR LAW VIOLATION', 'NARCOTICS']))).astype(int)
    df_output['Ward Condition'] = ward_cond

    community_area_cond = ((df_input['Community Area'] >= 6) & (df_input['Community Area'] <= 53) & (~df_input['Primary Type'].isin(['NARCOTICS']))).astype(int)
    df_output['Community Area Condition'] = community_area_cond

    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    date_range_cond = ((date_parsed >= start_date) & (date_parsed <= end_date) & (~df_input['Primary Type'].isin(['NARCOTICS', 'LIQUOR LAW VIOLATION']))).astype(int)
    df_output['Date Condition'] = date_range_cond

    return df_output

