def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'MOTOR VEHICLE THEFT', 'CRIMINAL DAMAGE', 'CRIMINAL TRESPASS', 'DECEPTIVE PRACTICE', 'OTHER OFFENSE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['$500 AND UNDER', 'FROM BUILDING', 'TO RESIDENCE', 'TO VEHICLE', 'FINANCIAL EXPLOITATION OF AN ELDERLY OR DISABLED PERSON', 'VEHICLE TITLE / REGISTRATION OFFENSE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'APARTMENT', 'COLLEGE / UNIVERSITY - GROUNDS', 'RESIDENCE', 'OTHER (SPECIFY)']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '07', '11', '14', '26']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 100) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District'] = ((df_input['District'] >= 1) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 1) & (df_input['Ward'] <= 50)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 70)).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/31/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    return df_output

