def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['NARCOTICS', 'LIQUOR LAW VIOLATION', 'BATTERY', 'OTHER OFFENSE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['POSSESS - CRACK', 'POSSESS - CANNABIS 30 GRAMS OR LESS', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'DOMESTIC BATTERY SIMPLE', 'VIOLATION OF CIVIL NO CONTACT ORDER', 'FOUND SUSPECT NARCOTICS', 'LIQUOR LICENSE VIOLATION']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['ALLEY', 'BAR OR TAVERN', 'TAVERN / LIQUOR STORE', 'RESIDENCE', 'SIDEWALK', 'VEHICLE NON-COMMERCIAL']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].apply(lambda x: 1 if x==1 else 0)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '18', '22', '26']).astype(int)
    df_output['Beat'] = df_input['Beat'].between(500, 1600).astype(int)
    df_output['District'] = df_input['District'].between(5, 19).astype(int)
    df_output['Ward'] = df_input['Ward'].between(3, 42).astype(int)
    df_output['Community Area'] = df_input['Community Area'].between(6, 70).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/31/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = df_input['Date'].between(start_date, end_date).astype(int)
    return df_output

