def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G8III', 'G7III', 'K1III', 'A2III', 'B9III/IV']).astype(int)
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)
    df_output['B_V_ge_0_7'] = (df_input['B-V'] >= 0.7).astype(int)
    df_output['Vmag_le_8'] = (df_input['Vmag'] <= 8).astype(int)
    df_output['Plx_lt_10'] = (df_input['Plx'] < 10).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 14.0) & (df_input['Amag'] <= 16.0)).astype(int)
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III', na=False).astype(int)
    df_output['B_V_in_range'] = ((df_input['B-V'] >= 0.8) & (df_input['B-V'] <= 1.3)).astype(int)
    df_output['Vmag_in_range'] = ((df_input['Vmag'] >= 4.0) & (df_input['Vmag'] <= 8.0)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 1.5) & (df_input['Plx'] <= 8.0)).astype(int)
    return df_output

