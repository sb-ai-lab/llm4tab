def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_III_or_III_IV'] = df_input['SpType'].str.contains('III') | df_input['SpType'].str.contains('III/IV')
    df_output['Amag_lt_16_5'] = (df_input['Amag'] < 16.5).astype(int)
    df_output['B_V_ge_0_9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Vmag_lt_7_0'] = (df_input['Vmag'] < 7.0).astype(int)
    df_output['Plx_lt_10_0'] = (df_input['Plx'] < 10.0).astype(int)
    df_output['Amag_in_14_0_16_5'] = ((df_input['Amag'] >= 14.0) & (df_input['Amag'] <= 16.5)).astype(int)
    df_output['B_V_gt_1_0'] = (df_input['B-V'] > 1.0).astype(int)
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III').astype(int)
    df_output['Plx_le_10_and_B_V_ge_0_9'] = ((df_input['Plx'] <= 10) & (df_input['B-V'] >= 0.9)).astype(int)
    df_output['Vmag_le_7_and_Amag_lt_16_5'] = ((df_input['Vmag'] <= 7.0) & (df_input['Amag'] < 16.5)).astype(int)
    return df_output

