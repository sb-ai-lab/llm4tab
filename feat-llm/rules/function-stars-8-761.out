    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['B_V_in_range'] = ((df_input['B-V'] >= 0.0) & (df_input['B-V'] <= 0.7)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 3.0) & (df_input['Plx'] <= 15.0)).astype(int)
    df_output['Vmag_in_range'] = ((df_input['Vmag'] >= 5.5) & (df_input['Vmag'] <= 10.0)).astype(int)
    return df_output

