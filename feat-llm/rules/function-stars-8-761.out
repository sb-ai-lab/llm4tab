def extracting_features_0(df_input):
    giant_classes = ['III', 'IV', 'III/IV', 'II', 'Ib', 'Ia', 'Iab', 'Ib/II', 'IIb', 'IIIb']
    def is_giant(sp):
        for gc in giant_classes:
            if gc in sp:
                return True
        return False

    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'A1V', 'F5V', 'G3V', 'K5V', 'B8V', 'B9V']).astype(int)
    df_output['Amag_gt_17'] = (df_input['Amag'] > 17).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)
    df_output['Vmag_le_8'] = (df_input['Vmag'] <= 8).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 0.0) & (df_input['B-V'] <= 0.7)).astype(int)
    df_output['e_Plx_le_1'] = (df_input['e_Plx'] <= 1.0).astype(int)
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['Amag_in_range_and_not_giant'] = (((df_input['Amag'] >= 15) & (df_input['Amag'] <= 20)) & (~df_input['SpType'].apply(is_giant))).astype(int)
    df_output['Plx_in_range_and_Vmag_le_8'] = (((df_input['Plx'] >= 5) & (df_input['Plx'] <= 20)) & (df_input['Vmag'] <= 8)).astype(int)
    df_output['B-V_lt_0.7_and_not_giant'] = ((df_input['B-V'] < 0.7) & (~df_input['SpType'].apply(is_giant))).astype(int)
    return df_output

