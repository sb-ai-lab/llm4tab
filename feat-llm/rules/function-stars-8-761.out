def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['A2III', 'G8III', 'G7III', 'K1III', 'B9III/IV']).astype(int)
    df_output['Amag_le_16'] = (df_input['Amag'] <= 16).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['Vmag_gt_6'] = (df_input['Vmag'] > 6).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 0.7) & (df_input['B-V'] <= 1.3)).astype(int)
    df_output['e_Plx_gt_0.7'] = (df_input['e_Plx'] > 0.7).astype(int)
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III|III/IV', regex=True).astype(int)
    df_output['Amag_14_16_and_giant'] = (((df_input['Amag'] >= 14) & (df_input['Amag'] <= 16)) & df_input['SpType'].str.contains('III|III/IV', regex=True)).astype(int)
    df_output['Plx_1_5_and_Vmag_gt_6'] = (((df_input['Plx'] >= 1) & (df_input['Plx'] <= 5)) & (df_input['Vmag'] > 6)).astype(int)
    df_output['B-V_gt_0.7_and_giant'] = ((df_input['B-V'] > 0.7) & df_input['SpType'].str.contains('III|III/IV', regex=True)).astype(int)
    return df_output

