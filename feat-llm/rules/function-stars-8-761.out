def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['Amag_ge_15_7'] = (df_input['Amag'] >= 15.7).astype(int)
    df_output['B_V_le_0_7'] = (df_input['B-V'] <= 0.7).astype(int)
    df_output['Vmag_ge_6_5'] = (df_input['Vmag'] >= 6.5).astype(int)
    df_output['Plx_ge_7_5'] = (df_input['Plx'] >= 7.5).astype(int)
    df_output['Amag_in_15_7_20'] = ((df_input['Amag'] >= 15.7) & (df_input['Amag'] <= 20)).astype(int)
    df_output['B_V_lt_0_9'] = (df_input['B-V'] < 0.9).astype(int)
    df_output['SpType_not_contains_III_IV'] = (~df_input['SpType'].str.contains('III|IV')).astype(int)
    df_output['Plx_gt_3_0_Amag_ge_16_0'] = ((df_input['Plx'] > 3.0) & (df_input['Amag'] >= 16.0)).astype(int)
    df_output['Vmag_gt_6_0_B_V_lt_0_8'] = ((df_input['Vmag'] > 6.0) & (df_input['B-V'] < 0.8)).astype(int)
    return df_output

