def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_condition'] = df_input['The_reason_of_the_call'].apply(
        lambda x: 1 if x in ['Vaccination', 'Inquiries', 'Medical_Consultation'] else 0)
    high_rating_reasons = df_input['The_reason_of_the_call'] == 'Complaints'
    high_ratings = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0) & \
                   (df_input['Satisfaction_with_the_doctors_response'] >= 3.0) & \
                   (df_input['How_often_do_you_receive_call_center_news'] >= 3.0)
    df_output['The_reason_of_the_call_condition'] = df_output['The_reason_of_the_call_condition'] | (high_rating_reasons & high_ratings)
    df_output['Call_center_employee_communication_skills_evaluation'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3.0).astype(int)
    df_output['Call_151'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['Education'] = df_input['Education'].apply(lambda x: 1 if x in ['High school', 'Diploma', 'Other'] else 0)
    df_output['Age'] = df_input['Age'].apply(lambda x: 1 if x in ['Under 18', '18-24', '40-49'] else 0)
    df_output['Gender'] = (df_input['Gender'] == 'Female').astype(int)
    df_output['Marital_Status'] = df_input['Marital_Status'].apply(lambda x: 1 if x in ['Single', 'Widow'] else 0)
    return df_output

