def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_reading_books_condition'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Reason_reading_books_condition'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'Keep me informative', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Amount_time_reading_books_condition'] = (df_input['Amount of time spent reading books per day'] <= 1).astype(int)
    df_output['Printed_books_condition'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['E_books_condition'] = df_input['Number of e-books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['Department_condition'] = df_input['Department'].isin(['BBA', 'Textile', 'Others']).astype(int)
    df_output['Format_reading_books_condition'] = (df_input['The format that you used for reading books'] == 'E-books').astype(int)
    df_output['Favorite_books_condition'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Others']).astype(int)
    df_output['Influenced_reading_books_condition'] = df_input['Who influenced you to read books'].isin(['Friends', 'Parents']).astype(int)
    df_output['Freq_reason_condition'] = ((df_input['Frequency of reading books'] == 'A few times a week') & (df_input['Reason for reading books'] != 'Academic Purpose')).astype(int)
    return df_output

