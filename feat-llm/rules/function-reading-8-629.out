def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_of_reading_books_in_selected'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number_of_e_books_read_last_two_years_in_selected'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_selected'] = df_input['Number of printed books you read last two years'].isin(['1-5', '6-10', 'More than 20']).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'NFE', 'English', 'JMC']).astype(int)
    df_output['Format_used_for_reading_books_in_selected'] = df_input['The format that you used for reading books'].isin(['Both', 'Printed']).astype(int)
    df_output['Change_after_reading_books_in_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Who_influenced_you_to_read_books_in_selected'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Teachers']).astype(int)
    df_output['Which_language_books_do_you_like_to_read_is_English'] = (df_input['Which language books do you like to read'] == 'English').astype(int)
    return df_output

