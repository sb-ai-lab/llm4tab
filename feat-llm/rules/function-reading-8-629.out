def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Reading_High'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Time_Spent_Reading_3plus'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Ebooks_Read_High'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '11-15', '16-20']).astype(int)
    df_output['Printed_Books_Read_High'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '11-15', '16-20']).astype(int)
    df_output['Favorite_Books_Selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography', 'Fiction']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Influenced_Self_Decision'] = (df_input['Who influenced you to read books'] == 'Self-Decision').astype(int)
    df_output['Language_English'] = (df_input['Which language books do you like to read'] == 'English').astype(int)
    df_output['Format_Printed_Both'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    return df_output

