def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_OnEverydayOrFewTimesWeek'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Amount_Time_Reading_GTE_3'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Num_eBooks_11_15_16_20_More20'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Num_printedBooks_6_10_11_15_16_20_More20'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15', '6-10']).astype(int)
    df_output['Department_Selected'] = df_input['Department'].isin(['CSE', 'English', 'NFE', 'JMC']).astype(int)
    df_output['Change_IncreaseAcadPerf_ProbSolv'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Format_Printed_Both'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Influenced_SelfDecision'] = (df_input['Who influenced you to read books'] == 'Self-Decision').astype(int)
    df_output['Freq_OnEveryday_And_Reason_Academic'] = ((df_input['Frequency of reading books'] == 'On everyday basis') & (df_input['Reason for reading books'] == 'Academic Purpose')).astype(int)
    return df_output

