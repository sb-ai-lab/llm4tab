def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_reading_books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Reason_reading_books'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Time_spent_reading'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Number_ebooks_read'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '11-15', '16-20']).astype(int)
    df_output['Number_printed_books_read'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', 'More than 20', '16-20']).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['CSE', 'English', 'Pharmacy', 'JMC', 'NFE']).astype(int)
    df_output['Format_used'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Favorite_books_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Change_after_reading'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Influenced_to_read'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Teachers']).astype(int)
    return df_output

