def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_in_low'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Reason_entertainment_or_vocab'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Time_spent_leq_1'] = (df_input['Amount of time spent reading books per day'] <= 1).astype(int)
    df_output['Ebooks_read_low'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Printed_books_read_low'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['BBA', 'Textile', 'Others', 'SWE']).astype(int)
    df_output['Format_ebooks'] = df_input['The format that you used for reading books'].isin(['E-books']).astype(int)
    df_output['Freq_entertainment'] = ((df_input['Frequency of reading books'] == 'A few times a month') & (df_input['Reason for reading books'] == 'Entertainment Purpose')).astype(int)
    df_output['Influenced_parents_friends_freq'] = ((df_input['Who influenced you to read books'].isin(['Parents', 'Friends'])) & (df_input['Frequency of reading books'].isin(['A few times a week', 'A few times a month']))).astype(int)
    df_output['Favorite_books_fiction_others'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Others']).astype(int)
    return df_output

