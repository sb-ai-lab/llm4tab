def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['To increase my English vocabulary knowledge', 'Entertainment Purpose']).astype(int)
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] <= 1).astype(int)
    df_output['Favorite_books_for_reading_to_spend_leisure_time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Non-Fiction', 'Others']).astype(int)
    df_output['Number_of_e_books_you_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_printed_books_you_read_last_two_years'] = df_input['Number of printed books you read last two years'].isna().astype(int)
    df_output['The_format_that_you_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['E-books']).astype(int)
    df_output['Department'] = df_input['Department'].isin(['BBA', 'Textile', 'SWE']).astype(int)
    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Parents', 'Friends']).astype(int)
    df_output['What_is_the_change_that_you_fell_after_reading_books'] = df_input['What is the change that you fell after reading books'].isin(['Feel Relax', 'Increase Creative Thinking']).astype(int)
    return df_output

