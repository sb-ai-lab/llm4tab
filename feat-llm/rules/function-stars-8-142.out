def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G8III', 'G2III', 'B9.5III', 'K1IIICN']).astype(int)  
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)  
    df_output['B-V_ge_0.7'] = (df_input['B-V'] >= 0.7).astype(int)  
    df_output['Vmag_le_7'] = (df_input['Vmag'] <= 7).astype(int)  
    df_output['Plx_le_10'] = (df_input['Plx'] <= 10).astype(int)  
    df_output['e_Plx_le_1.3'] = (df_input['e_Plx'] <= 1.3).astype(int)  
    df_output['SpType_contains_III_or_II'] = df_input['SpType'].str.contains('III|II', regex=True).astype(int)  
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 13) & (df_input['Amag'] < 16)).astype(int)  
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 0.7) & (df_input['B-V'] <= 1.3)).astype(int)  
    df_output['Vmag_in_range'] = ((df_input['Vmag'] >= 1) & (df_input['Vmag'] <= 7)).astype(int)  
    return df_output

