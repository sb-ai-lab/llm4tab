def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['household_6_to_8'] = df_input['Number of household members'].apply(lambda x: 1 if 6 <= x <= 8 else 0)
    df_output['household_9_or_more'] = df_input['Number of household members'].apply(lambda x: 1 if x >= 9 else 0)
    df_output['education_university_college_highschool'] = df_input['Education Level'].apply(lambda x: 1 if x in ['University', 'College', 'High School'] else 0)
    df_output['relax_sleep_no'] = df_input['Relax/sleep when the newborn is asleep'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['marital_status_married'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Married' else 0)
    df_output['breastfeed_no'] = df_input['Breastfeed'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['breastfeed_yes'] = df_input['Breastfeed'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['addiction_no'] = df_input['Addiction'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['disease_before_pregnancy_chronic_no'] = df_input['Disease before pregnancy'].apply(lambda x: 1 if x in ['Chronic Disease', 'No'] else 0)
    df_output['fear_of_pregnancy_yes_no'] = df_input['Fear of pregnancy'].apply(lambda x: 1 if x in ['Yes', 'No'] else 0)
    df_output['worry_about_newborn_yes_no'] = df_input['Worry about newborn'].apply(lambda x: 1 if x in ['Yes', 'No'] else 0)
    df_output['pregnancy_length_9_10_months'] = df_input['Pregnancy length'].apply(lambda x: 1 if x in ['9 months', '10 months'] else 0)
    return df_output

