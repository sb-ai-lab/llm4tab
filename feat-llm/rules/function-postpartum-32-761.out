def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Trust and share feelings is Yes'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['Angry after latest child birth is No'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['History of pregnancy loss is No'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Diseases during pregnancy is No'] = (df_input['Diseases during pregnancy'] == 'No').astype(int)
    df_output['Relationship between father and newborn is Good or Very good'] = df_input['Relationship between father and newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Pregnancy plan is Yes'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)
    df_output['Family type is Nuclear'] = (df_input['Family type'] == 'Nuclear').astype(int)
    df_output['Addiction is No'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Age of newborn is Older than 1.5 year'] = (df_input['Age of newborn'] == 'Older than 1.5 year').astype(int)
    df_output['Monthly income before latest pregnancy is in [10000 to 20000, 20000 to 30000, More than 30000]'] = df_input['Monthly income before latest pregnancy'].isin(['10000 to 20000', '20000 to 30000', 'More than 30000']).astype(int)
    return df_output

