def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Birth compliancy_No'] = (df_input['Birth compliancy'] == 'No').astype(int)
    df_output['Feeling about motherhood_Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Received Support_High_Medium'] = df_input['Recieved Support'].isin(['High', 'Medium']).astype(int)
    df_output['Need for Support_No_Low'] = df_input['Need for Support'].isin(['No', 'Low']).astype(int)
    df_output['Relax/sleep when newborn is tended_Yes'] = (df_input['Relax/sleep when newborn is tended'] == 'Yes').astype(int)
    df_output['Number of household members_2_to_5'] = df_input['Number of household members'].between(2,5).astype(int)
    df_output['Monthly income before latest pregnancy_range'] = df_input['Monthly income before latest pregnancy'].isin(['More than 30000', '20000 to 30000', '10000 to 20000']).astype(int)
    df_output['Education Level_University_College'] = df_input['Education Level'].isin(['University', 'College']).astype(int)
    df_output['Residence_City'] = (df_input['Residence'] == 'City').astype(int)
    cond = (
        (df_input['Birth compliancy'] == 'Yes') &
        (df_input['Feeling about motherhood'] == 'Happy') &
        (df_input['Recieved Support'] == 'Medium') &
        (df_input['Need for Support'] == 'No') &
        (df_input['Relax/sleep when newborn is tended'] == 'Yes')
    )
    df_output['Combined_condition'] = cond.astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Received_Support_Low'] = (df_input['Recieved Support'] == 'Low').astype(int)
    df_output['Need_for_Support_Low_Medium_High'] = df_input['Need for Support'].isin(['Low', 'Medium', 'High']).astype(int)
    cond1 = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral'])
    cond2 = (df_input['Feeling about motherhood'] == 'Happy') & (df_input['Recieved Support'] == 'Low')
    df_output['Feeling_about_motherhood_Sad_Neutral_or_Happy_and_Recieved_Support_Low'] = (cond1 | cond2).astype(int)
    df_output['Relax_sleep_when_newborn_is_tended_No'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Number_of_household_members_6_to_8_or_9_or_more'] = df_input['Number of household members'].isin(['6 to 8', '9 or more']).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_No_or_Less_than_5000'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'Less than 5000']).astype(int)
    df_output['Birth_compliancy_Yes_and_Recieved_Support_Low'] = ((df_input['Birth compliancy'] == 'Yes') & (df_input['Recieved Support'] == 'Low')).astype(int)
    df_output['Education_Level_High_School_or_Primary_School'] = df_input['Education Level'].isin(['High School', 'Primary School']).astype(int)
    df_output['Residence_Village_and_Recieved_Support_Low'] = ((df_input['Residence'] == 'Village') & (df_input['Recieved Support'] == 'Low')).astype(int)
    df_output['Feeling_about_motherhood_Happy_and_Recieved_Support_Low_and_Need_for_Support_No'] = ((df_input['Feeling about motherhood'] == 'Happy') & (df_input['Recieved Support'] == 'Low') & (df_input['Need for Support'] == 'No')).astype(int)
    return df_output

