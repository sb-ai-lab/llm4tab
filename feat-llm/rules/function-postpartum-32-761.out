def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Trust_and_share_feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Angry_after_latest_child_birth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['History_of_pregnancy_loss_in'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery', 'Still-born delivery']).astype(int)
    df_output['Diseases_during_pregnancy_in'] = df_input['Diseases during pregnancy'].str.lower().isin(['chronic disease', 'non-chronic disease']).astype(int)
    df_output['Relationship_between_father_and_newborn_in'] = df_input['Relationship between father and newborn'].isin(['Bad', 'Neutral']).astype(int)
    df_output['Pregnancy_plan_No'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Family_type_Joint'] = (df_input['Family type'] == 'Joint').astype(int)
    df_output['Age_of_newborn_in'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year', '1 year to 1.5 year']).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_in'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'Less than 5000']).astype(int)
    df_output['Addiction_No'] = (df_input['Addiction'] == 'No').astype(int)
    return df_output

