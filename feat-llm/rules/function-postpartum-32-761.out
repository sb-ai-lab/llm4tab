def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Need for Support is Low'] = (df_input['Need for Support'] == 'Low').astype(int)
    df_output['Abuse is No'] = (df_input['Abuse'] == 'No').astype(int)
    df_output['Received Support is Low'] = (df_input['Recieved Support'] == 'Low').astype(int)
    df_output['History of pregnancy loss is Miscarriage'] = (df_input['History of pregnancy loss'] == 'Miscarriage').astype(int)
    df_output['Breastfeed is No'] = (df_input['Breastfeed'] == 'No').astype(int)
    df_output['Family type is in [Joint, Nuclear]'] = df_input['Family type'].isin(['Joint', 'Nuclear']).astype(int)
    df_output['Birth compliancy is in [Yes, No]'] = df_input['Birth compliancy'].isin(['Yes', 'No']).astype(int)
    df_output['Marital status is Married'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Pregnancy length is in [9 months, 10 months]'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    df_output['Residence is City'] = (df_input['Residence'] == 'City').astype(int)
    return df_output