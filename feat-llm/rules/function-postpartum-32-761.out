def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['household_members_2_to_5'] = df_input['Number of household members'].apply(lambda x: 1 if 2 <= x <= 5 else 0)
    df_output['education_level_university_highschool'] = df_input['Education Level'].apply(lambda x: 1 if x in ['University', 'High School'] else 0)
    df_output['relax_sleep_newborn_yes'] = df_input['Relax/sleep when the newborn is asleep'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['marital_status_married'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Married' else 0)
    df_output['breastfeed_yes'] = df_input['Breastfeed'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['addiction_no'] = df_input['Addiction'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['disease_before_pregnancy_no_non_chronic'] = df_input['Disease before pregnancy'].apply(lambda x: 1 if x in ['No', 'Non-Chronic Disease'] else 0)
    df_output['fear_of_pregnancy_no_yes'] = df_input['Fear of pregnancy'].apply(lambda x: 1 if x in ['No', 'Yes'] else 0)
    df_output['worry_about_newborn_no_yes'] = df_input['Worry about newborn'].apply(lambda x: 1 if x in ['No', 'Yes'] else 0)
    df_output['pregnancy_length_9_10_months'] = df_input['Pregnancy length'].apply(lambda x: 1 if x in ['9 months', '10 months'] else 0)
    return df_output

