def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Major changes or losses during pregnancy'] = df_input['Major changes or losses during pregnancy'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Relax/sleep when the newborn is asleep'] = df_input['Relax/sleep when the newborn is asleep'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Need for Support'] = df_input['Recieved Support'].apply(lambda x: 1 if x in ['Medium', 'High'] else 0)
    df_output['Relationship with the newborn'] = df_input['Relationship with husband'].apply(lambda x: 1 if x in ['Neutral', 'Bad'] else 0)
    df_output['Pregnancy plan'] = df_input['Pregnancy plan'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Marital status'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Divorced' else 0)
    df_output['Husband’s monthly income'] = df_input['Husband’s monthly income'].apply(lambda x: 1 if x in ['No', 'Less than 5000', '5000 to 10000'] else 0)
    df_output['Husband\'s education level'] = df_input['Husband\'s education level'].apply(lambda x: 1 if x in ['No', 'Primary School', 'Primary school'] else 0)
    df_output['Disease before pregnancy'] = df_input['Disease before pregnancy'].apply(lambda x: 1 if x in ['Chronic Disease', 'Non-Chronic Disease'] else 0)
    df_output['Total children'] = df_input['Total children'].apply(lambda x: 1 if x in ['More than two', 'More than Two'] else 0)
    return df_output

