def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Received Support'] = df_input['Recieved Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Feeling for regular activities'] = df_input['Feeling for regular activities'].isin(['Tired', 'Worried', 'Afraid']).astype(int)
    df_output['Relationship with husband'] = df_input['Relationship with husband'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    df_output['Relax/sleep when the newborn is asleep'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    df_output['Addiction'] = df_input['Addiction'].isin(['Smoking', 'Drinking', 'Drugs']).astype(int)
    df_output['Pregnancy plan'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Regular checkups'] = (df_input['Regular checkups'] == 'No').astype(int)
    df_output['Disease before pregnancy'] = df_input['Disease before pregnancy'].isin(['Chronic Disease', 'Non-Chronic Disease']).astype(int)
    df_output['Number of household members'] = (df_input['Number of household members'] == '2 to 5').astype(int)
    df_output['Gender of newborn'] = df_input['Gender of newborn'].isin(['Boy', 'Girl']).astype(int)
    return df_output