def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Received_Support_Low_or_Medium'] = df_input['Recieved Support'].isin(['Low', 'Medium']).astype(int)  
    df_output['Feeling_for_regular_activities_in_list'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)  
    df_output['Number_of_latest_pregnancy_ge_2'] = (df_input['Number of the latest pregnancy'] >= 2).astype(int)  
    df_output['Newborn_illness_Yes'] = (df_input['Newborn illness'] == 'Yes').astype(int)  
    df_output['Disease_before_pregnancy_Chronic_Disease'] = (df_input['Disease before pregnancy'] == 'Chronic Disease').astype(int)  
    df_output['Mode_of_delivery_Caesarean_Section'] = (df_input['Mode of delivery'] == 'Caesarean Section').astype(int)  
    df_output['Number_of_household_members_2_to_5'] = (df_input['Number of household members'] == '2 to 5').astype(int)  
    df_output['Age_of_immediate_older_children_No'] = (df_input['Age of immediate older children'] == 'No').astype(int)  
    df_output['Age_in_30_to_40'] = ((df_input['Age'] >= 30) & (df_input['Age'] <= 40)).astype(int)  
