def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Time_spent_reading_>=1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency_reading_books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Ebooks_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']).astype(int)
    df_output['Change_after_reading'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Format_used'] = df_input['The format that you used for reading books'].isin(['E-books', 'Both']).astype(int)
    df_output['Influenced_by'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Academic Mentor']).astype(int)
    df_output['Language_preference'] = (df_input['Which language books do you like to read'] == 'English').astype(int)
    return df_output

