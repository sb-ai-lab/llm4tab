def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_less_0_5'] = (df_input['Amount of time spent reading books per day'] < 0.5).astype(int)
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Favorite_books_for_reading_leisure_time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics']).astype(int)
    df_output['Number_of_e_books_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_printed_books_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Department'] = df_input['Department'].isin(['BBA', 'English', 'JMC', 'Others']).astype(int)
    df_output['Change_after_reading_books'] = df_input['What is the change that you fell after reading books'].isin(['Feel Relax', 'Increase Vocabulary', 'Increase Knowledge']).astype(int)
    df_output['Who_influenced_to_read_books'] = df_input['Who influenced you to read books'].isin(['Family', 'Friends', 'None']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_range'] = ((df_input['Amount of time spent reading books per day'] >= 0) & (df_input['Amount of time spent reading books per day'] <= 0.5)).astype(int)
    return df_output

