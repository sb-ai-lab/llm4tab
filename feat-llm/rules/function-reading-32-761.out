def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_gte_1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency_of_reading_books_in_selected'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'Once or twice a year']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_selected'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_ebooks_read_last_two_years_in_selected'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'Textile']).astype(int)
    df_output['Change_after_reading_is_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Who_influenced_you_to_read_books_is_Teachers'] = (df_input['Who influenced you to read books'] == 'Teachers').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_in_range_1_5'] = ((df_input['Amount of time spent reading books per day'] >= 1) & (df_input['Amount of time spent reading books per day'] <= 5)).astype(int)
    df_output['Favorite_books_for_leisure_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Others']).astype(int)
    return df_output

