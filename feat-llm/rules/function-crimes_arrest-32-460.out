def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'NARCOTICS', 'ASSAULT', 'CRIMINAL TRESPASS']).astype(int)
    desc_condition = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'POSSESS - CRACK', 'POSSESS - CANNABIS 30 GRAMS OR LESS', 'FOUND SUSPECT NARCOTICS', 'AGGRAVATED - OTHER DANGEROUS WEAPON', 'TO LAND'])
    simple_domestic = ((df_input['Description'] == 'SIMPLE') & (df_input['Domestic'] == 1))
    df_output['Description'] = (desc_condition | simple_domestic).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'APARTMENT', 'SMALL RETAIL STORE', 'CHA APARTMENT']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['15', '18', '04A', '26', '08A']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2500)).astype(int)
    df_output['District'] = ((df_input['District'] >= 1) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 3) & (df_input['Ward'] <= 47)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 33)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)).astype(int)
    return df_output

