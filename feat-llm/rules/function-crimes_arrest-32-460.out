def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Primary Type'] = df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'NARCOTICS', 'ASSAULT', 'CRIMINAL TRESPASS']).astype(int)  
    df_output['Description'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'POSSESS - CRACK', 'SIMPLE', 'FOUND SUSPECT NARCOTICS', 'AGGRAVATED - OTHER DANGEROUS WEAPON', 'POSSESS - CANNABIS 30 GRAMS OR LESS', 'TO LAND']).astype(int)  
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'APARTMENT', 'SIDEWALK', 'SMALL RETAIL STORE']).astype(int)  
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)  
    df_output['FBI Code'] = df_input['FBI Code'].isin(['15', '18', '08A', '26', '04A']).astype(int)  
    df_output['Beat'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2500)).astype(int)  
    df_output['District'] = ((df_input['District'] >= 10) & (df_input['District'] <= 25)).astype(int)  
    df_output['Ward'] = ((df_input['Ward'] >= 22) & (df_input['Ward'] <= 40)).astype(int)  
    df_output['Community Area'] = ((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 36)).astype(int)  
    df_output['Year'] = (df_input['Year'] == 2025).astype(int)  
    return df_output