def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['ASSAULT', 'WEAPONS VIOLATION', 'NARCOTICS', 'CRIMINAL TRESPASS']).astype(int)
    desc_cond = df_input['Description'].isin(['AGGRAVATED - OTHER DANGEROUS WEAPON', 'UNLAWFUL POSSESSION - HANDGUN', 'POSSESS - CANNABIS 30 GRAMS OR LESS', 'FOUND SUSPECT NARCOTICS', 'TO LAND']).astype(int)
    desc_simple_domestic = ((df_input['Description'] == 'SIMPLE') & (df_input['Domestic'] == 1)).astype(int)
    df_output['Description_in_list'] = (desc_cond | desc_simple_domestic).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'APARTMENT', 'SMALL RETAIL STORE', 'SIDEWALK', 'CHA APARTMENT']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['04A', '15', '18', '26', '08A']).astype(int)
    narc_possess_crack = ((df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'] == 'POSSESS - CRACK')).astype(int)
    df_output['Primary_Narcotics_Description_Possess_Crack'] = narc_possess_crack
    df_output['Beat_in_range'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2500)).astype(int)
    df_output['District_in_range'] = ((df_input['District'] >= 10) & (df_input['District'] <= 24)).astype(int)
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 22) & (df_input['Ward'] <= 40)).astype(int)
    df_output['Community_Area_in_range'] = ((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 33)).astype(int)
    return df_output

