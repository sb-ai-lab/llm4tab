def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type in list'] = df_input['Primary Type'].isin(['THEFT', 'BATTERY', 'DECEPTIVE PRACTICE', 'CRIMINAL DAMAGE', 'OTHER OFFENSE']).astype(int)
    df_output['Description in list'] = df_input['Description'].isin(['$500 AND UNDER', 'SIMPLE', 'TO PROPERTY', 'VIOLATE ORDER OF PROTECTION', 'FORGERY']).astype(int)
    df_output['Location Description in list'] = df_input['Location Description'].isin(['APARTMENT', 'STREET', 'RESIDENCE', 'VEHICLE NON-COMMERCIAL', 'OTHER (SPECIFY)']).astype(int)
    df_output['Domestic is 1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code in list'] = df_input['FBI Code'].isin(['06', '08A', '10', '14', '26']).astype(int)
    df_output['Primary Type THEFT and Description ATTEMPT THEFT'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'ATTEMPT THEFT')).astype(int)
    df_output['Beat in range'] = ((df_input['Beat'] >= 200) & (df_input['Beat'] <= 1800)).astype(int)
    df_output['District in range'] = ((df_input['District'] >= 5) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward in range'] = ((df_input['Ward'] >= 3) & (df_input['Ward'] <= 44)).astype(int)
    df_output['Community Area in range'] = ((df_input['Community Area'] >= 6) & (df_input['Community Area'] <= 49)).astype(int)
    return df_output

