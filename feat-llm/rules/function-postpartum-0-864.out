def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Age'] = ((df_input['Age'] >= 25) & (df_input['Age'] <= 40)).astype(int)
    df_output['Residence'] = (df_input['Residence'] == 'City').astype(int)
    df_output['Education Level'] = df_input['Education Level'].isin(['University', 'College']).astype(int)
    df_output['Marital status'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Relationship with husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Feeling about motherhood'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Recieved Support'] = (df_input['Recieved Support'] == 'High').astype(int)
    df_output['Trust and share feelings'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['Regular checkups'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    df_output['Breastfeed'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    return df_output

