def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband_condition'] = df_input['Relationship with husband'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    df_output['Feeling_about_motherhood_condition'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Received_Support_condition'] = (df_input['Recieved Support'] == 'Low').astype(int)
    df_output['Need_for_Support_condition'] = df_input['Need for Support'].isin(['High', 'Medium']).astype(int)
    df_output['Abuse_condition'] = (df_input['Abuse'] == 'Yes').astype(int)
    df_output['Trust_and_share_feelings_condition'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['History_of_pregnancy_loss_condition'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_condition'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Feeling_for_regular_activities_condition'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Relax_sleep_when_newborn_is_asleep_condition'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    return df_output

