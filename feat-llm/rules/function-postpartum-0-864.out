def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['History_of_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Abuse'] = (df_input['Abuse'] == 'Yes').astype(int)
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Bad', 'Poor']).astype(int)
    df_output['Received_Support'] = df_input['Recieved Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['High', 'Medium']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Angry_after_latest_childbirth'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Relax_sleep_when_newborn_is_asleep'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    df_output['Worry_about_newborn'] = (df_input['Worry about newborn'] == 'Yes').astype(int)
    return df_output

