def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly', 'Monthly', 'Never'])) & 
                           (df_input['social_battery_recharge'].isin(['None of the above', 'Alone time']))).astype(int)
    df_output['cond_2'] = df_input['gathering_size_preference'].isin(['Large events', 'Never']).astype(int)
    df_output['cond_3'] = (df_input['valued_friendship_traits'] == 'Honesty').astype(int)
    df_output['cond_4'] = df_input['conflict_resolution_style'].isin(['Avoid conflict', 'Let time fix it']).astype(int)
    df_output['cond_5'] = df_input['family_support_level'].str.capitalize().isin(['No', 'Never']).astype(int)
    df_output['cond_6'] = df_input['social_orientation_type'].isin(['Introvert', 'Not sure']).astype(int)
    df_output['cond_7'] = df_input['social_anxiety_level'].isin(['Nervous', 'Avoid it']).astype(int)
    df_output['cond_8'] = df_input['emotional_expression_method'].isin(['Stay silent', 'Other']).astype(int)
    df_output['cond_9'] = ((df_input['social_connection_frequency'].str.capitalize() == 'Daily') & 
                           (df_input['social_battery_recharge'] == 'None of the above')).astype(int)
    df_output['cond_10'] = ((df_input['social_connection_frequency'].str.capitalize() == 'Never') & 
                            (df_input['gathering_size_preference'] == 'Large events')).astype(int)
    return df_output

