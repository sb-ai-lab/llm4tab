def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_in_list'] = df_input['social_connection_frequency'].str.lower().isin(['daily', 'weekly', 'monthly']).astype(int)
    df_output['social_battery_recharge_in_list'] = df_input['social_battery_recharge'].str.lower().isin(['talking to someone', 'social media']).astype(int)
    df_output['gathering_size_preference_in_list'] = df_input['gathering_size_preference'].str.lower().isin(['small gatherings', 'both']).astype(int)
    df_output['valued_friendship_traits_in_list'] = df_input['valued_friendship_traits'].str.lower().isin(['support', 'loyalty', 'all', 'all the three and trust', 'understanding person']).astype(int)
    df_output['conflict_resolution_style_in_list'] = df_input['conflict_resolution_style'].str.lower().isin(['talk it out', 'apologize first']).astype(int)
    df_output['family_support_level_in_list'] = df_input['family_support_level'].str.lower().isin(['yes', 'sometimes']).astype(int)
    df_output['social_orientation_type_in_list'] = df_input['social_orientation_type'].str.lower().isin(['extrovert', 'ambivert']).astype(int)
    df_output['social_anxiety_level_in_list'] = df_input['social_anxiety_level'].str.lower().isin(['excited', 'neutral']).astype(int)
    df_output['emotional_expression_method_in_list'] = df_input['emotional_expression_method'].str.lower().isin(['talk openly', 'express emotion strongly']).astype(int)
    df_output['social_connection_and_emotion'] = ((df_input['social_connection_frequency'].str.lower().isin(['weekly', 'daily'])) & (df_input['emotional_expression_method'].str.lower() == 'talk openly')).astype(int)
    df_output['gathering_and_conflict'] = ((df_input['gathering_size_preference'].str.lower() == 'both') & (df_input['conflict_resolution_style'].str.lower() == 'apologize first')).astype(int)
    return df_output

