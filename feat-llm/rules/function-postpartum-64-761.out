def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Current_monthly_income_in_range'] = df_input['Current monthly income'].isin(['No', 'Less than 5000', '5000 to 10000']).astype(int)
    df_output['Husband_monthly_income_in_range'] = df_input["Husband’s monthly income"].isin(['More than 30000', '10000 to 20000']).astype(int)
    df_output['Household_members_in_range'] = df_input['Number of household members'].isin(['2 to 5', '6 to 8']).astype(int)
    df_output['Relationship_with_newborn_in_range'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Major_changes_or_losses_No'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Breastfeed_Yes_or_No'] = df_input['Breastfeed'].isin(['Yes', 'No']).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_in_range'] = df_input['Monthly income before latest pregnancy'].isin(['No', '5000 to 10000', 'More than 30000']).astype(int)
    df_output['Pregnancy_length_in_range'] = df_input['Pregnancy length'].isin(['9 months', '10 months', '7 months', '6 months']).astype(int)
    df_output['Age_in_range'] = ((df_input['Age'] >= 26) & (df_input['Age'] <= 37)).astype(int)
    df_output['Gender_of_newborn_in_range'] = df_input['Gender of newborn'].isin(['Boy', 'Girl']).astype(int)
    return df_output

