def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_child_birth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Feeling_about_motherhood_Sad_or_Happy'] = df_input['Feeling about motherhood'].isin(['Sad', 'Happy']).astype(int)
    df_output['Relax_sleep_when_newborn_is_tended_No'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Monthly_income_before_latest_pregnancy_No'] = (df_input['Monthly income before latest pregnancy'] == 'No').astype(int)
    df_output['History_of_pregnancy_loss_Miscarriage_or_No'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'No']).astype(int)
    df_output['Pregnancy_plan_Yes_or_No'] = df_input['Pregnancy plan'].isin(['Yes', 'No']).astype(int)
    df_output['Pregnancy_length_9_or_10_months'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    df_output['Residence_City_or_Village'] = df_input['Residence'].isin(['City', 'Village']).astype(int)
    df_output['Breastfeed_Yes_or_No'] = df_input['Breastfeed'].isin(['Yes', 'No']).astype(int)
    df_output['Gender_of_newborn_Girl'] = (df_input['Gender of newborn'] == 'Girl').astype(int)
    return df_output