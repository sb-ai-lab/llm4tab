def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Current monthly income is No'] = (df_input['Current monthly income'] == 'No').astype(int)  
    df_output['Husband’s monthly income in [More than 30000, 20000 to 30000]'] = df_input['Husband’s monthly income'].isin(['More than 30000', '20000 to 30000']).astype(int)  
    df_output['Number of household members in [2 to 5, 6 to 8, 9 or more]'] = df_input['Number of household members'].isin(['2 to 5', '6 to 8', '9 or more']).astype(int)  
    df_output['Relationship with the newborn is Good'] = (df_input['Relationship with the newborn'] == 'Good').astype(int)  
    df_output['Major changes or losses during pregnancy is Yes or No'] = df_input['Major changes or losses during pregnancy'].isin(['Yes', 'No']).astype(int)  
    df_output['Breastfeed is Yes'] = (df_input['Breastfeed'] == 'Yes').astype(int)  
    df_output['Monthly income before latest pregnancy is No or More than 30000'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'More than 30000']).astype(int)  
    df_output['Pregnancy length in [9 months, 10 months]'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)  
    df_output['Age in [22, 32]'] = ((df_input['Age'] >= 22) & (df_input['Age'] <= 32)).astype(int)  
    df_output['Gender of newborn is Girl'] = (df_input['Gender of newborn'] == 'Girl').astype(int)  
    return df_output

