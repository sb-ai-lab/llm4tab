    df_output['Description'] = df_input['Description'].isin(['RETAIL THEFT', 'UNLAWFUL POSSESSION - HANDGUN', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY', 'DOMESTIC BATTERY SIMPLE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'DEPARTMENT STORE', 'CTA BUS STOP', 'PARKING LOT', 'ALLEY']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '15', '08B', '04']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 400) & (df_input['Beat'] <= 2500)).astype(int)
    df_output['District'] = ((df_input['District'] >= 10) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 30) & (df_input['Ward'] <= 50)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 40) & (df_input['Community Area'] <= 80)).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/16/2025')
    end_date = pd.to_datetime('01/31/2025')
    df_output['Date'] = ((df_input['Date_parsed'] >= start_date) & (df_input['Date_parsed'] <= end_date)).astype(int)
    df_output = df_output.drop(columns=[])
    return df_output

