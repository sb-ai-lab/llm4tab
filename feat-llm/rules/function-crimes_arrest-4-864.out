def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['PUBLIC PEACE VIOLATION', 'OTHER OFFENSE', 'NON-CRIMINAL', 'LIQUOR LAW VIOLATION', 'INTERFERENCE WITH PUBLIC OFFICER']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['TIRE DEFLATION DEVICE DEPLOYMENT', 'HARASSMENT BY TELEPHONE', 'SIMPLE', 'POSS: CANNABIS 30GMS OR LESS']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['APARTMENT', 'RESIDENCE', 'NURSING / RETIREMENT HOME', 'HOSPITAL BUILDING']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].astype(str).isin(['24', '26', '28', '29']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 100) & (df_input['Beat'] <= 200)).astype(int)
    df_output['District'] = ((df_input['District'] >= 1) & (df_input['District'] <= 5)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 20) & (df_input['Ward'] <= 30)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 10) & (df_input['Community Area'] <= 30)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025', format='%m/%d/%Y')
    end_date = pd.to_datetime('01/15/2025', format='%m/%d/%Y')
    df_output['Date'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)).astype(int)
    return df_output

