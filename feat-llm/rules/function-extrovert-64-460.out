def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.title().isin(['Both', 'Small Gatherings']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.title().isin(['Honesty', 'Loyalty']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.title().isin(['Let Time Fix It', 'Avoid Conflict']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.capitalize().isin(['Yes', 'Sometimes']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.title().isin(['Alone Time', 'None Of The Above']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.title().isin(['Ambivert', 'Introvert']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.capitalize().isin(['Nervous', 'Excited']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.title().isin(['Talk Openly', 'Other']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.title().isin(['Unnecessary Criticism', 'Selfishness']).astype(int)
    return df_output

