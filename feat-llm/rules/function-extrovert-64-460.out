    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly', 'Monthly'])) & 
                           (df_input['gathering_size_preference'].str.capitalize().isin(['Large events', 'Both']))) * 1
    df_output['cond_2'] = ((df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly'])) & 
                           (df_input['conflict_resolution_style'].str.capitalize().isin(['Apologize first', 'Let time fix it']))) * 1
    df_output['cond_3'] = ((df_input['valued_friendship_traits'].str.capitalize().isin(['Loyalty', 'Honesty'])) & 
                           (df_input['family_support_level'].str.capitalize().isin(['Never', 'No']))) * 1
    df_output['cond_4'] = (df_input['social_battery_recharge'].str.capitalize().isin(['Alone time', 'None of the above'])) * 1
    df_output['cond_5'] = ((df_input['social_orientation_type'].str.capitalize().isin(['Introvert', 'Not sure'])) & 
                           (df_input['social_anxiety_level'].str.capitalize().isin(['Nervous', 'Avoid it']))) * 1
    df_output['cond_6'] = ((df_input['emotional_expression_method'].str.capitalize().isin(['Talk openly'])) & 
                           (df_input['primary_anger_sources'].str.capitalize().isin(['Unnecessary criticism']))) * 1
    df_output['cond_7'] = ((df_input['social_connection_frequency'].str.capitalize().isin(['Daily'])) & 
                           (df_input['gathering_size_preference'].str.capitalize().isin(['Large events']))) * 1
    df_output['cond_8'] = ((df_input['conflict_resolution_style'].str.capitalize().isin(['Apologize first', 'Let time fix it'])) & 
                           (df_input['valued_friendship_traits'].str.capitalize().isin(['Loyalty']))) * 1
    df_output['cond_9'] = ((df_input['social_battery_recharge'].str.capitalize().isin(['Social media'])) & 
                           (df_input['social_orientation_type'].str.capitalize().isin(['Not sure']))) * 1
    df_output['cond_10'] = ((df_input['family_support_level'].str.capitalize().isin(['Yes'])) & 
                            (df_input['social_connection_frequency'].str.capitalize().isin(['Daily'])) & 
                            (df_input['emotional_expression_method'].str.capitalize().isin(['Talk openly']))) * 1
    return df_output

