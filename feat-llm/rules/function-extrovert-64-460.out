def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Weekly', 'Never'])) & 
                           (df_input['gathering_size_preference'].str.strip().str.capitalize() == 'Small gatherings')).astype(int)
    df_output['cond_2'] = ((df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Weekly', 'Never'])) & 
                           (df_input['social_battery_recharge'].str.strip().str.capitalize() == 'Talking to someone')).astype(int)
    df_output['cond_3'] = ((df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Ambivert', 'Extrovert'])) & 
                           (df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Neutral', 'Excited']))).astype(int)
    df_output['cond_4'] = ((df_input['emotional_expression_method'].str.strip().str.capitalize().isin(['Stay silent', 'Other'])) & 
                           (df_input['valued_friendship_traits'].str.strip().str.capitalize().isin(['Honesty', 'Loyalty']))).astype(int)
    df_output['cond_5'] = ((df_input['family_support_level'].str.strip().str.capitalize().isin(['Yes', 'Sometimes'])) & 
                           (df_input['conflict_resolution_style'].str.strip().str.capitalize().isin(['Avoid conflict', 'Talk it out']))).astype(int)
    df_output['cond_6'] = ((df_input['social_connection_frequency'].str.strip().str.capitalize() == 'Weekly') & 
                           (df_input['gathering_size_preference'].str.strip().str.capitalize() == 'Small gatherings') & 
                           (df_input['social_battery_recharge'].str.strip().str.capitalize() == 'Social media')).astype(int)
    df_output['cond_7'] = ((df_input['social_connection_frequency'].str.strip().str.capitalize() == 'Daily') & 
                           (df_input['gathering_size_preference'].str.strip().str.capitalize().isin(['Small gatherings', 'Both'])) & 
                           (df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Extrovert', 'Ambivert']))).astype(int)
    df_output['cond_8'] = ((df_input['conflict_resolution_style'].str.strip().str.capitalize() == 'Talk it out') & 
                           (df_input['emotional_expression_method'].str.strip().str.capitalize().isin(['Stay silent', 'Other']))).astype(int)
    df_output['cond_9'] = ((df_input['social_connection_frequency'].str.strip().str.capitalize() == 'Never') & 
                           (df_input['family_support_level'].str.strip().str.capitalize() == 'Yes') & 
                           (df_input['social_orientation_type'].str.strip().str.capitalize() == 'Not sure')).astype(int)
    df_output['cond_10'] = ((df_input['social_battery_recharge'].str.strip().str.capitalize() == 'None of the above') & 
                            (df_input['social_connection_frequency'].str.strip().str.capitalize() == 'Daily') & 
                            (df_input['valued_friendship_traits'].str.strip().str.capitalize() == 'Support')).astype(int)
    return df_output

