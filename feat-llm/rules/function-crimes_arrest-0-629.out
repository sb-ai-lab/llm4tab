def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'ROBBERY', 'CRIM SEXUAL ASSAULT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY', 'OVER $500']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['RESIDENCE', 'APARTMENT', 'NURSING / RETIREMENT HOME']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '06']).astype(int)
    df_output['Year'] = (df_input['Year'] >= 2024).astype(int)
    df_output['Beat'] = df_input['Beat'].between(200, 300).astype(int)
    df_output['Ward'] = df_input['Ward'].between(10, 20).astype(int)
    date_format = "%m/%d/%Y %I:%M:%S %p"
    date_start = pd.to_datetime("01/04/2025 10:00:00 PM", format=date_format)
    date_end = pd.to_datetime("01/10/2025 11:00:00 PM", format=date_format)
    dates = pd.to_datetime(df_input['Date'], format=date_format, errors='coerce')
    df_output['Date'] = ((dates >= date_start) & (dates <= date_end)).astype(int)
    df_output['Y Coordinate'] = df_input['Y Coordinate'].between(2150000, 2200000).astype(int)
    return df_output

