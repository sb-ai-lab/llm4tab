def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'DECEPTIVE PRACTICE', 'MOTOR VEHICLE THEFT', 'NARCOTICS', 'LIQUOR LAW VIOLATION']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['OVER $500', 'UNDER $500', 'SIMPLE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['NURSING / RETIREMENT HOME', 'APARTMENT', 'RESIDENCE', 'PARKING LOT/GARAGE(NON RESID.)', 'SCHOOL - PUBLIC', 'HOSPITAL BUILDING/ GROUNDS']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '23', '22']).astype(int)
    df_output['Year'] = (df_input['Year'] <= 2023).astype(int)
    df_output['Beat'] = df_input['Beat'].between(100, 300).astype(int)
    df_output['Ward'] = df_input['Ward'].between(30, 50).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/22/2025 08:00:00 PM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    df_output['X Coordinate'] = df_input['X Coordinate'].between(1150000, 1170000).astype(int)
    return df_output

