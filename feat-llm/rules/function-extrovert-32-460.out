def extracting_features_0(df_input):
    conditions = {
        'social_connection_frequency': ['Daily', 'Weekly', 'Monthly'],
        'gathering_size_preference': ['Never'],
        'valued_friendship_traits': ['Honesty', 'Loyalty', 'Support'],
        'conflict_resolution_style': ['Talk it out', 'Let time fix it', 'Apologize first'],
        'family_support_level': ['Yes', 'Sometimes'],
        'social_battery_recharge': ['Alone time', 'Social media', 'None of the above'],
        'social_orientation_type': ['Introvert', 'Extrovert', 'Ambivert', 'Not sure'],
        'social_anxiety_level': ['Nervous', 'Neutral'],
        'emotional_expression_method': ['Stay silent', 'Other', 'Express emotion strongly'],
        'primary_anger_sources': ['Unnecessary criticism', 'Being interrupted', 'Injustice']
    }
    df_output = pd.DataFrame()
    for col, valid_vals in conditions.items():
        df_output[col] = df_input[col].apply(lambda x: 1 if x in valid_vals else 0)
    return df_output

