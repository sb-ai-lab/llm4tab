def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_contains_III_II_III/IV_II/III_III+'] = df_input['SpType'].str.contains(r'III|II|III/IV|II/III|III\+', regex=True).astype(int)  
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)  
    df_output['B-V_ge_1.0'] = (df_input['B-V'] >= 1.0).astype(int)  
    df_output['Plx_le_3'] = (df_input['Plx'] <= 3).astype(int)  
    df_output['Vmag_between_7_9.5'] = ((df_input['Vmag'] >= 7) & (df_input['Vmag'] <= 9.5)).astype(int)  
    df_output['SpType_contains_III_II_IV'] = df_input['SpType'].str.contains(r'III|II|IV', regex=True).astype(int)  
    df_output['Amag_in_11_16'] = ((df_input['Amag'] >= 11) & (df_input['Amag'] <= 16)).astype(int)  
    df_output['B-V_gt_1.1'] = (df_input['B-V'] > 1.1).astype(int)  
    df_output['Plx_lt_5_and_Amag_lt_16'] = ((df_input['Plx'] < 5) & (df_input['Amag'] < 16)).astype(int)  
