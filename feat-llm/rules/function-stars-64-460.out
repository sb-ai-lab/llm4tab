def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_III_II_II/III_III/IV'] = df_input['SpType'].str.contains(r'III|II|II/III|III/IV', regex=True).astype(int)
    df_output['Amag_lt_17'] = (df_input['Amag'] < 17).astype(int)
    df_output['B-V_ge_1.1'] = (df_input['B-V'] >= 1.1).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['Vmag_lt_9'] = (df_input['Vmag'] < 9).astype(int)
    df_output['Amag_in_11_17'] = df_input['Amag'].between(11, 17).astype(int)
    df_output['B-V_in_1.0_1.4'] = df_input['B-V'].between(1.0, 1.4).astype(int)
    df_output['Plx_in_0.5_3'] = df_input['Plx'].between(0.5, 3).astype(int)
    df_output['SpType_III_II_II/III'] = df_input['SpType'].str.contains(r'III|II|II/III', regex=True).astype(int)
    df_output['Vmag_le_8.9'] = (df_input['Vmag'] <= 8.9).astype(int)
    return df_output