def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 2).astype(int)
    df_output['Favorite_books_for_reading_to_spend_leisure_time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics']).astype(int)
    df_output['Number_of_printed_books_you_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['Number_of_e_books_you_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['Department'] = df_input['Department'].isin(['Textile', 'BBA', 'English', 'JMC', 'Others']).astype(int)
    df_output['The_format_that_you_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['Printed']).astype(int)
    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Friends']).astype(int)
    df_output['What_is_the_change_that_you_felt_after_reading_books'] = df_input['What is the change that you fell after reading books'].isin(['Feel Relax', 'Increase Creative Thinking']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Reading_Books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Time_Spent_Reading'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Printed_Books_High'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20']).astype(int)
    df_output['Ebooks_Books_High'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Department_Selected'] = df_input['Department'].isin(['Pharmacy', 'CSE', 'SWE', 'EEE', 'CIS', 'MCT']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Influenced_Teachers_Parents'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Parents']).astype(int)
    df_output['Format_Both_Ebooks'] = df_input['The format that you used for reading books'].isin(['Both', 'E-books']).astype(int)
    df_output['Read_Location_Library_Home'] = df_input['Where do you read printed books'].isin(['Library', 'Home']).astype(int)
    return df_output

