def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_of_reading_books_in_On_everyday_basis_or_A_few_times_a_week'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_gte_2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_high_range'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Change_after_reading_books_in_academic_or_problem_solving'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Who_influenced_you_to_read_books_in_Teachers_or_Parents'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Parents']).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['Pharmacy', 'CSE', 'Textile', 'SWE', 'CIS', 'Civil']).astype(int)
    df_output['Format_used_for_reading_books_in_Printed_or_Both'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Where_do_you_read_printed_books_is_Library'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    df_output['Favorite_books_for_leisure_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Biography', 'Non-Fiction', 'Politics']).astype(int)
    return df_output

