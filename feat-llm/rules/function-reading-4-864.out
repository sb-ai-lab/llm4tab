def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Reason_for_reading_books'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number_of_printed_books_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Number_of_ebooks_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Department'] = df_input['Department'].isin(['Pharmacy', 'CSE', 'Textile', 'SWE', 'Civil', 'MCT', 'EEE']).astype(int)
    df_output['Change_after_reading_books'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Format_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Parents', 'Self-Decision']).astype(int)
    df_output['Where_do_you_read_printed_books'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    return df_output