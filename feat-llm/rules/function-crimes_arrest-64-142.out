def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['BATTERY', 'CRIMINAL DAMAGE', 'OFFENSE INVOLVING CHILDREN', 'ASSAULT', 'OTHER OFFENSE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['SIMPLE', 'TO PROPERTY', 'AGGRAVATED SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER', 'DOMESTIC BATTERY SIMPLE', 'TELEPHONE THREAT']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['APARTMENT', 'RESIDENCE', 'ALLEY', 'NURSING / RETIREMENT HOME', 'HOMELESS SHELTER']).astype(int)
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['08B', '14', '02', '08A']).astype(int)
    df_output['Primary_Type_BATTERY_and_Domestic_1'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Domestic'] == 1)).astype(int)
    df_output['Primary_Type_CRIMINAL_DAMAGE_and_Description_TO_PROPERTY'] = ((df_input['Primary Type'] == 'CRIMINAL DAMAGE') & (df_input['Description'] == 'TO PROPERTY')).astype(int)
    df_output['Primary_Type_OFFENSE_INVOLVING_CHILDREN_and_Location_Description_RESIDENCE'] = ((df_input['Primary Type'] == 'OFFENSE INVOLVING CHILDREN') & (df_input['Location Description'] == 'RESIDENCE')).astype(int)
    df_output['Primary_Type_ASSAULT_and_Description_SIMPLE_and_Domestic_1'] = ((df_input['Primary Type'] == 'ASSAULT') & (df_input['Description'] == 'SIMPLE') & (df_input['Domestic'] == 1)).astype(int)
    df_output['Location_Description_in_APARTMENT_HOME_RESIDENCE_and_Primary_Type_OTHER_OFFENSE'] = ((df_input['Location Description'].isin(['APARTMENT', 'HOME', 'RESIDENCE'])) & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
    return df_output

