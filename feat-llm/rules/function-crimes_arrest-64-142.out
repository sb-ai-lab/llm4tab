def extracting_features_1(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'INTERFERENCE WITH PUBLIC OFFICER', 'THEFT', 'BATTERY', 'OTHER OFFENSE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['POSSESS - HEROIN (WHITE)', 'UNLAWFUL POSSESSION - HANDGUN', 'OBSTRUCTING JUSTICE', 'RETAIL THEFT', 'SIMPLE', 'OTHER VEHICLE OFFENSE', 'MANUFACTURE / DELIVER - CANNABIS 10 GRAMS OR LESS']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'BAR OR TAVERN', 'GROCERY FOOD STORE']).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '08A', '08B', '15', '18', '24', '26']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 300) & (df_input['Beat'] <= 1200)).astype(int)
    df_output['District'] = ((df_input['District'] >= 3) & (df_input['District'] <= 18)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 6) & (df_input['Ward'] <= 42)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 49)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)).astype(int)
    return df_output