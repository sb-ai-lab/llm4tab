def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'THEFT', 'INTERFERENCE WITH PUBLIC OFFICER', 'OTHER OFFENSE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['POSSESS - HEROIN (WHITE)', 'MANUFACTURE / DELIVER - CANNABIS 10 GRAMS OR LESS', 'UNLAWFUL POSSESSION - HANDGUN', 'RETAIL THEFT', 'OBSTRUCTING JUSTICE', 'OTHER VEHICLE OFFENSE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'GROCERY FOOD STORE', 'CTA BUS STOP', 'BAR OR TAVERN']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['06', '15', '18', '24', '26']).astype(int)
    df_output['Primary_NARCOTICS_and_Description_contains_POSSESS_or_MANUFACTURE'] = ((df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'].str.contains('POSSESS|MANUFACTURE / DELIVER', regex=True))).astype(int)
    df_output['Primary_WEAPONS_and_Description_UNLAWFUL_POSSESSION_HANDGUN'] = ((df_input['Primary Type'] == 'WEAPONS VIOLATION') & (df_input['Description'] == 'UNLAWFUL POSSESSION - HANDGUN')).astype(int)
    df_output['Primary_THEFT_and_Description_RETAIL_THEFT_and_Location_GROCERY_FOOD_STORE'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT') & (df_input['Location Description'] == 'GROCERY FOOD STORE')).astype(int)
    df_output['Primary_INTERFERENCE_and_Description_OBSTRUCTING_JUSTICE'] = ((df_input['Primary Type'] == 'INTERFERENCE WITH PUBLIC OFFICER') & (df_input['Description'] == 'OBSTRUCTING JUSTICE')).astype(int)
    df_output['Location_STREET_and_Primary_in_list'] = ((df_input['Location Description'] == 'STREET') & (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'OTHER OFFENSE']))).astype(int)
    return df_output

