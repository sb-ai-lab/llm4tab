def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'CRIMINAL DAMAGE', 'OFFENSE INVOLVING CHILDREN', 'ASSAULT', 'OTHER OFFENSE', 'THEFT']).astype(int)  
    df_output['Description'] = df_input['Description'].isin(['DOMESTIC BATTERY SIMPLE', 'TO PROPERTY', 'TELEPHONE THREAT', 'AGGRAVATED SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER', 'SIMPLE']).astype(int)  
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)  
    df_output['Location Description'] = df_input['Location Description'].isin(['APARTMENT', 'RESIDENCE', 'ALLEY']).astype(int)  
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08A', '08B', '14', '02', '06']).astype(int)  
    df_output['Beat'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 1300)).astype(int)  
    df_output['District'] = ((df_input['District'] >= 10) & (df_input['District'] <= 12)).astype(int)  
    df_output['Ward'] = ((df_input['Ward'] >= 23) & (df_input['Ward'] <= 28)).astype(int)  
    df_output['Community Area'] = ((df_input['Community Area'] >= 23) & (df_input['Community Area'] <= 31)).astype(int)  
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')  
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')  
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')  
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)  
    return df_output

