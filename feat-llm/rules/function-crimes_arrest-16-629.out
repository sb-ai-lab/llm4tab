def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'CRIMINAL TRESPASS', 'OTHER OFFENSE', 'WEAPONS VIOLATION']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['$500 AND UNDER', 'TO RESIDENCE', 'VEHICLE TITLE / REGISTRATION OFFENSE', 'RECKLESS FIREARM DISCHARGE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['RESIDENCE - PORCH / HALLWAY', 'APARTMENT', 'SMALL RETAIL STORE', 'STREET']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '26', '15']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 800) & (df_input['Beat'] <= 1900)).astype(int)
    df_output['District'] = ((df_input['District'] >= 3) & (df_input['District'] <= 18)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 6) & (df_input['Ward'] <= 42)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 6) & (df_input['Community Area'] <= 69)).astype(int)
    dates = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025', format='%m/%d/%Y')
    end_date = pd.to_datetime('01/29/2025', format='%m/%d/%Y')
    df_output['Date'] = ((dates >= start_date) & (dates <= end_date)).astype(int)
    return df_output

