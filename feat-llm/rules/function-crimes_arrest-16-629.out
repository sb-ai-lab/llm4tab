def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)
    cond1 = (df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'DOMESTIC BATTERY SIMPLE') & (df_input['Domestic'] == 1)
    df_output['Battery_Domestic_Battery_Simple_Domestic_1'] = cond1.astype(int)
    cond2 = (df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'].isin(['MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'FOUND SUSPECT NARCOTICS']))
    df_output['Narcotics_Description_in_List'] = cond2.astype(int)
    cond3 = (df_input['Primary Type'] == 'CRIMINAL DAMAGE') & (df_input['Domestic'] == 1)
    df_output['Criminal_Damage_Domestic_1'] = cond3.astype(int)
    cond4 = (df_input['Primary Type'] == 'OTHER OFFENSE') & (df_input['Description'] == 'VIOLATE ORDER OF PROTECTION') & (df_input['Domestic'] == 1)
    df_output['Other_Offense_Violate_Order_Protection_Domestic_1'] = cond4.astype(int)
    cond5 = (df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY')
    df_output['Battery_Aggravated_PO_No_Minor_Injury'] = cond5.astype(int)
    cond6 = ((df_input['Location Description'].isin(['RESIDENCE', 'APARTMENT', 'SIDEWALK'])) & (df_input['Domestic'] == 1)) | (df_input['Primary Type'] == 'NARCOTICS')
    df_output['Location_Desc_in_List_Domestic_1_or_Narcotics'] = cond6.astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/31/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    cond7 = (df_input['Date_parsed'] >= start_date) & (df_input['Date_parsed'] <= end_date) & (df_input['Primary Type'] == 'BATTERY') & (df_input['Domestic'] == 1)
    df_output['Date_in_Jan_2025_Battery_Domestic_1'] = cond7.astype(int)
    cond8 = (df_input['FBI Code'].isin(['08B', '18', '14', '26'])) & (df_input['Domestic'] == 1) | (df_input['Primary Type'] == 'NARCOTICS')
    df_output['FBI_Code_in_List_Domestic_1_or_Narcotics'] = cond8.astype(int)
    cond9 = (df_input['Beat'].between(1000, 2000)) & (df_input['Domestic'] == 1) & (df_input['Primary Type'].isin(['BATTERY', 'CRIMINAL DAMAGE', 'OTHER OFFENSE']))
    df_output['Beat_1000_2000_Domestic_1_Primary_Type_in_List'] = cond9.astype(int)
    df_output.drop(columns=['Date_parsed'], inplace=True)
    return df_output