def extracting_features_1(df_input):  
    import pandas as pd  
    from datetime import datetime  
  
    df_output = pd.DataFrame()  
  
    df_output['Overdue_days_0'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['PDN_lt_0_3'] = (df_input['PDN'] < 0.3).astype(int)  
    df_output['Credit_history_rating_in'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)  
    df_output['Debt_gt_5000'] = (df_input['Debt'] > 5000).astype(int)  
    df_output['INCOME_gte_1300'] = (df_input['INCOME'] >= 1300).astype(int)  
    df_output['Initial_limit_gte_5000'] = (df_input['Initial limit'] >= 5000).astype(int)  
    df_output['EDU_in'] = df_input['EDU'].isin(['College', 'University']).astype(int)  
    df_output['TERM_lte_60'] = (df_input['TERM'] <= 60).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT_0'] = (df_input['UNDERAGECHILDRENCOUNT'] == 0).astype(int)  
  
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')  
    cutoff_date = pd.Timestamp('1984-01-01')  
    df_output['Age_gte_40'] = (birthdates < cutoff_date).astype(int)  
  
    return df_output