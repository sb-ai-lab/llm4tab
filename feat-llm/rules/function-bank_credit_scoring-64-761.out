def extracting_features_0(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame()

    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Credit_history_rating_in_C_D_E'] = df_input['Credit history rating'].isin(['C3', 'C2', 'C1', 'D3', 'D2', 'D1', 'E3', 'E2', 'E1']).astype(int)
    df_output['Debt_in_900_7000'] = ((df_input['Debt'] >= 900) & (df_input['Debt'] <= 7000)).astype(int)
    df_output['INCOME_lt_1300'] = (df_input['INCOME'] < 1300).astype(int)
    df_output['Initial_limit_le_4000'] = (df_input['Initial limit'] <= 4000).astype(int)
    df_output['EDU_in_unstable'] = df_input['EDU'].isin(['High school', 'Incomplete', 'University']).astype(int)
    df_output['TERM_ge_36'] = (df_input['TERM'] >= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_1'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)

    today = pd.to_datetime('today')
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    ages = (today - birthdates).dt.days // 365
    df_output['Age_le_35'] = (ages <= 35).astype(int)

    return df_output

