def extracting_features_1(df_input):  
    import pandas as pd  
    from datetime import datetime  
  
    df_output = pd.DataFrame()  
  
    df_output['Credit_history_rating_condition'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)  
    df_output['PDN_condition'] = (df_input['PDN'] < 0.2).astype(int)  
    df_output['INCOME_condition'] = (df_input['INCOME'] >= 1500).astype(int)  
    df_output['Initial_limit_condition'] = (df_input['Initial limit'] >= 5000).astype(int)  
    df_output['Overdue_days_condition'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['EDU_condition'] = df_input['EDU'].isin(['University', 'College']).astype(int)  
    df_output['Debt_and_Income_condition'] = ((df_input['Debt'] >= 5000) & (df_input['Debt'] <= 20000) & (df_input['INCOME'] >= 1500)).astype(int)  
    df_output['TERM_and_Income_condition'] = ((df_input['TERM'] <= 60) & (df_input['INCOME'] >= 2000)).astype(int)  
  
    today = pd.to_datetime('today')  
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')  
    age = (today - birthdates).dt.days // 365  
    df_output['Age_condition'] = (age >= 35).astype(int)  
  
    df_output['INDUSTRYNAME_condition'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Medicine and healthcare', 'Science and Education']).astype(int)  
  
    return df_output

