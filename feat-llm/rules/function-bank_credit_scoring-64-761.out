def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['Overdue days'] == 0) & 
                           (df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']))).astype(int)
    df_output['cond_2'] = (df_input['PDN'] < 0.2).astype(int)
    df_output['cond_3'] = (df_input['Initial limit'] >= 4000).astype(int)
    df_output['cond_4'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['cond_5'] = (df_input['EDU'].isin(['University', 'College'])).astype(int)
    df_output['cond_6'] = ((df_input['Debt'] >= 4000) & 
                           (df_input['Overdue days'] == 0) & 
                           (df_input['PDN'] < 0.25)).astype(int)
    df_output['cond_7'] = ((df_input['TERM'] <= 60) & 
                           (df_input['Credit history rating'].isin(['A1', 'A2', 'A3']))).astype(int)
    df_output['cond_8'] = (df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Science and Education', 'Medicine and healthcare'])).astype(int)
    df_output['cond_9'] = ((df_input['FAMILYSTATUS'].isin([1, 2])) & 
                           (df_input['PDN'] < 0.3)).astype(int)
    df_output['cond_10'] = ((df_input['SEX'] == 'Male') & 
                            (df_input['INCOME'] > 1000) & 
                            (df_input['Credit history rating'].isin(['B1', 'B2', 'B3']))).astype(int)
    return df_output

