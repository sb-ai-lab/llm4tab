def extracting_features_1(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame()

    df_output['Overdue_days_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Credit_history_rating_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_lt_0_2'] = (df_input['PDN'] < 0.2).astype(int)
    df_output['Initial_limit_gte_4000'] = (df_input['Initial limit'] >= 4000).astype(int)
    df_output['Income_gte_1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['Debt_gt_5000_and_PDN_lt_0_25'] = ((df_input['Debt'] > 5000) & (df_input['PDN'] < 0.25)).astype(int)
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM_gte_24_and_PDN_lt_0_2'] = ((df_input['TERM'] >= 24) & (df_input['PDN'] < 0.2)).astype(int)

    def calculate_age(birthdate_str):
        birthdate = pd.to_datetime(birthdate_str, errors='coerce')
        if pd.isna(birthdate):
            return None
        today = pd.Timestamp('today')
        age = today.year - birthdate.year - ((today.month, today.day) < (birthdate.month, birthdate.day))
        return age

    ages = df_input['BIRTHDATE'].apply(calculate_age)
    df_output['Age_gt_40'] = (ages > 40).astype(int)

    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Science and Education', 'Medicine and healthcare']).astype(int)

    return df_output

