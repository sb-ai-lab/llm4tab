def extracting_features_0(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame()
    df_output['Overdue days'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['C1', 'C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt'] = (df_input['Debt'] < 7000).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['Incomplete', 'High school']).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] <= 3500).astype(int)
    df_output['TERM'] = (df_input['TERM'] >= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)

    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    current_year = 2023
    ages = current_year - birthdates.dt.year
    df_output['Age'] = (ages <= 40).astype(int)

    return df_output

