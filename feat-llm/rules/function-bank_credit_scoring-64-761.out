def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_C_D_E'] = df_input['Credit history rating'].isin(['C1', 'C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Initial_limit_le_3500'] = (df_input['Initial limit'] <= 3500).astype(int)
    df_output['Income_lt_1500'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['Debt_in_900_4000_and_Overdue_days_gt_0'] = ((df_input['Debt'].between(900, 4000)) & (df_input['Overdue days'] > 0)).astype(int)
    df_output['EDU_in_Incomplete_High_school'] = df_input['EDU'].isin(['Incomplete', 'High school']).astype(int)
    df_output['TERM_ge_36_and_PDN_ge_0_2'] = ((df_input['TERM'] >= 36) & (df_input['PDN'] >= 0.2)).astype(int)
    df_output['Credit_history_rating_C3_and_PDN_gt_0_35'] = ((df_input['Credit history rating'] == 'C3') & (df_input['PDN'] > 0.35)).astype(int)
    df_output['SEX_Female_and_PDN_ge_0_3'] = ((df_input['SEX'] == 'Female') & (df_input['PDN'] >= 0.3)).astype(int)
    return df_output

