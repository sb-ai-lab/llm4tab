def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_CDE'] = df_input['Credit history rating'].isin(['C3', 'C2', 'C1', 'D3', 'D2', 'D1', 'E3', 'E2', 'E1']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_in_range_and_Overdue_days_gt_0'] = ((df_input['Debt'] >= 900) & (df_input['Debt'] <= 20000) & (df_input['Overdue days'] > 0)).astype(int)
    df_output['Initial_limit_le_3500'] = (df_input['Initial limit'] <= 3500).astype(int)
    df_output['INCOME_lt_1500'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_ge_36_and_Credit_history_rating_not_in_AB'] = ((df_input['TERM'] >= 36) & (~df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']))).astype(int)
    df_output['INDUSTRYNAME_in_Trade_Agriculture_Retired_and_Credit_history_rating_in_C3_E2'] = (df_input['INDUSTRYNAME'].isin(['Trade', 'Agriculture', 'Retired']) & df_input['Credit history rating'].isin(['C3', 'E2'])).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2_and_PDN_ge_0_3'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 2) & (df_input['PDN'] >= 0.3)).astype(int)
    return df_output

