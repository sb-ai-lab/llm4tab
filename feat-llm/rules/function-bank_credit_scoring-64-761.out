def extracting_features_0(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame()

    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)

    credit_hist_set = {'C3', 'C1', 'D3', 'D2', 'D1', 'E1', 'E2', 'E3'}
    df_output['Credit_history_in_set'] = df_input['Credit history rating'].isin(credit_hist_set).astype(int)

    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)

    debt_cond = (df_input['Debt'] >= 2000) & (df_input['Debt'] <= 20000)
    income_cond = df_input['INCOME'] < 2000
    df_output['Debt_in_range_and_Income_lt_2000'] = (debt_cond & income_cond).astype(int)

    df_output['Initial_limit_le_3500'] = (df_input['Initial limit'] <= 3500).astype(int)

    edu_set = {'High school', 'Incomplete'}
    df_output['EDU_in_set'] = df_input['EDU'].isin(edu_set).astype(int)

    term_cond = df_input['TERM'] >= 36
    income_cond_2 = df_input['INCOME'] < 1500
    df_output['TERM_ge_36_and_Income_lt_1500'] = (term_cond & income_cond_2).astype(int)

    df_output['UNDERAGECHILDRENCOUNT_ge_2'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 2).astype(int)

    today = pd.to_datetime('today')
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    age = (today - birthdates).dt.days // 365
    df_output['Age_lt_35'] = (age < 35).astype(int)

    sex_male = df_input['SEX'] == 'Male'
    credit_hist_c3_c1 = df_input['Credit history rating'].isin({'C3', 'C1'})
    df_output['SEX_Male_and_Credit_history_C3_C1'] = (sex_male & credit_hist_c3_c1).astype(int)

    return df_output

