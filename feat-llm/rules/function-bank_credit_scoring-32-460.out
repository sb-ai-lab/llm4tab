def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A1_A2_A3_B1_B2_B3_C1_C3'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1', 'C3']).astype(int)
    df_output['PDN_less_than_0_3'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['INCOME_greater_equal_1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['Initial_limit_greater_equal_1500'] = (df_input['Initial limit'] >= 1500).astype(int)
    df_output['Overdue_days_equal_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['Debt_in_900_18000_and_Overdue_days_0'] = ((df_input['Debt'] >= 900) & (df_input['Debt'] <= 18000) & (df_input['Overdue days'] == 0)).astype(int)
    df_output['FAMILYSTATUS_1_or_2'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)
    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Production', 'Agriculture', 'Public services', 'Construction', 'Trade']).astype(int)
    df_output['SEX_Female_and_Credit_history_rating_in_B1_B2_C3'] = ((df_input['SEX'] == 'Female') & (df_input['Credit history rating'].isin(['B1', 'B2', 'C3']))).astype(int)
    return df_output

