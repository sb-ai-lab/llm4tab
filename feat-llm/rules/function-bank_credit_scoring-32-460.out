def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_D_E'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_in_range_and_Overdue_days_gt_0'] = ((df_input['Debt'] >= 1500) & (df_input['Debt'] <= 18000) & (df_input['Overdue days'] > 0)).astype(int)
    df_output['INCOME_lt_1500'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['Initial_limit_lt_3000'] = (df_input['Initial limit'] < 3000).astype(int)
    df_output['TERM_24_60_and_PDN_ge_0_3'] = ((df_input['TERM'] >= 24) & (df_input['TERM'] <= 60) & (df_input['PDN'] >= 0.3)).astype(int)
    df_output['SEX_Male_and_Credit_history_in_C2_D1_D2'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(['C2', 'D1', 'D2']))).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_0_and_PDN_ge_0_3'] = ((df_input['UNDERAGECHILDRENCOUNT'] == 0) & (df_input['PDN'] >= 0.3)).astype(int)
    return df_output

