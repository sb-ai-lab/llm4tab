def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Debt_ge_8000'] = (df_input['Debt'] >= 8000).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_DE'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_4'] = (df_input['PDN'] >= 0.4).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['INCOME_le_2000'] = (df_input['INCOME'] <= 2000).astype(int)
    df_output['Initial_limit_le_9000'] = (df_input['Initial limit'] <= 9000).astype(int)
    df_output['TERM_ge_60'] = (df_input['TERM'] >= 60).astype(int)
    lv_area_list = ['Brestskaja oblast', "Gomel'skaja oblast", 'Grodnenskaja oblast']
    df_output['LV_AREA_in_selected'] = df_input['LV_AREA'].str.strip().isin(lv_area_list).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_1'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    return df_output

