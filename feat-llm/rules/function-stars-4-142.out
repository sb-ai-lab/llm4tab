def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'F5V', 'K5V', 'B8V', 'B9V']).astype(int)
    df_output['Amag_gt_15'] = (df_input['Amag'] > 15).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)
    df_output['B_V_lt_0_7'] = (df_input['B-V'] < 0.7).astype(int)
    df_output['Vmag_gt_7'] = (df_input['Vmag'] > 7).astype(int)
    df_output['Amag_in_16_20'] = df_input['Amag'].between(16, 20).astype(int)
    df_output['Plx_in_5_15'] = df_input['Plx'].between(5, 15).astype(int)
    df_output['e_Plx_lt_1_5'] = (df_input['e_Plx'] < 1.5).astype(int)
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['B_V_le_0_5'] = (df_input['B-V'] <= 0.5).astype(int)
    return df_output

