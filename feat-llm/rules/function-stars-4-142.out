def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K1IIICN', 'G8III', 'B9III/IV']).astype(int)
    df_output['Amag_le_15'] = (df_input['Amag'] <= 15).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['B_V_ge_0_8'] = (df_input['B-V'] >= 0.8).astype(int)
    df_output['Vmag_le_7_5'] = (df_input['Vmag'] <= 7.5).astype(int)
    df_output['Amag_in_10_15'] = df_input['Amag'].between(10, 15).astype(int)
    df_output['Plx_in_0_5'] = df_input['Plx'].between(0, 5).astype(int)
    df_output['e_Plx_ge_0_5'] = (df_input['e_Plx'] >= 0.5).astype(int)
    df_output['SpType_contains_III_or_II'] = df_input['SpType'].str.contains('III|II', regex=True).astype(int)
    df_output['B_V_gt_1_0'] = (df_input['B-V'] > 1.0).astype(int)
    return df_output

