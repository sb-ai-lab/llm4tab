def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'F5V', 'F0V', 'K5V']).astype(int)  
    df_output['Amag_ge_16'] = (df_input['Amag'] >= 16).astype(int)  
    df_output['B-V_le_0.6'] = (df_input['B-V'] <= 0.6).astype(int)  
    df_output['Vmag_gt_7'] = (df_input['Vmag'] > 7).astype(int)  
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)  
    df_output['e_Plx_le_1'] = (df_input['e_Plx'] <= 1).astype(int)  
    df_output['Amag_in_range_16_20'] = ((df_input['Amag'] >= 16) & (df_input['Amag'] <= 20)).astype(int)  
    df_output['B-V_in_range_0.3_0.6'] = ((df_input['B-V'] >= 0.3) & (df_input['B-V'] <= 0.6)).astype(int)  
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)  
    df_output['Amag_gt_15'] = (df_input['Amag'] > 15).astype(int)  
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_contains_III_or_IIICN_or_III_IV'] = df_input['SpType'].str.contains('III|IIICN|III/IV', regex=True).astype(int)
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)
    df_output['B_V_gt_0_9'] = (df_input['B-V'] > 0.9).astype(int)
    df_output['Vmag_lte_7_5'] = (df_input['Vmag'] <= 7.5).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['e_Plx_gte_0_5'] = (df_input['e_Plx'] >= 0.5).astype(int)
    df_output['Amag_in_13_16'] = ((df_input['Amag'] >= 13) & (df_input['Amag'] <= 16)).astype(int)
    df_output['B_V_in_0_9_1_3'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.3)).astype(int)
    df_output['SpType_endswith_III_or_II'] = df_input['SpType'].str.endswith(('III', 'II')).astype(int)
    df_output['Amag_lt_15'] = (df_input['Amag'] < 15).astype(int)
    return df_output