

---VERSION---

def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'F5V', 'K5V', 'B8V', 'B9V']).astype(int)
    df_output['Amag_ge_17'] = (df_input['Amag'] >= 17).astype(int)
    df_output['Vmag_gt_7'] = (df_input['Vmag'] > 7).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)
    df_output['B_V_le_0_5'] = (df_input['B-V'] <= 0.5).astype(int)
    df_output['SpType_main_sequence'] = ((df_input['SpType'].str.contains('V')) & 
                                        (~df_input['SpType'].str.contains('III')) & 
                                        (~df_input['SpType'].str.contains('II'))).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 17) & (df_input['Amag'] <= 20)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 5) & (df_input['Plx'] <= 10)).astype(int)
    df_output['Vmag_ge_7_and_B_V_le_0_6'] = ((df_input['Vmag'] >= 7) & (df_input['B-V'] <= 0.6)).astype(int)
    df_output['e_Plx_lt_1_5_and_SpType_ends_V'] = ((df_input['e_Plx'] < 1.5) & (df_input['SpType'].str.endswith('V'))).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G8III', 'K1IIICN', 'B9III/IV', 'K1III', 'G5III']).astype(int)
    df_output['Amag_lt_17'] = (df_input['Amag'] < 17).astype(int)
    df_output['Vmag_le_7'] = (df_input['Vmag'] <= 7).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['B_V_gt_0_8'] = (df_input['B-V'] > 0.8).astype(int)
    df_output['SpType_contains_III_or_II'] = df_input['SpType'].str.contains('III|II', regex=True).astype(int)
    df_output['Amag_in_13_17'] = df_input['Amag'].between(13, 17).astype(int)
    df_output['Plx_in_0_5'] = df_input['Plx'].between(0, 5).astype(int)
    df_output['Vmag_lt_7_and_B_V_ge_1_0'] = ((df_input['Vmag'] < 7) & (df_input['B-V'] >= 1.0)).astype(int)
    df_output['e_Plx_lt_1_and_SpType_contains_III'] = ((df_input['e_Plx'] < 1.0) & (df_input['SpType'].str.contains('III'))).astype(int)
    return df_output

