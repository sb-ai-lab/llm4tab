def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.lower().isin(['daily', 'weekly', 'monthly']).astype(int)  
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.lower().isin(['small gatherings', 'both']).astype(int)  
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.lower().isin(['support', 'loyalty', 'honesty', 'all', 'all the three and trust', 'understanding person']).astype(int)  
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.lower().isin(['talk it out', 'apologize first']).astype(int)  
    df_output['family_support_level'] = df_input['family_support_level'].str.lower().isin(['yes', 'sometimes']).astype(int)  
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.lower().isin(['talking to someone']).astype(int)  
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.lower().isin(['extrovert', 'ambivert']).astype(int)  
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.lower().isin(['neutral', 'excited']).astype(int)  
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.lower().isin(['talk openly', 'express emotion strongly']).astype(int)  
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.lower().isin(['injustice', 'being interrupted']).astype(int)  
    return df_output