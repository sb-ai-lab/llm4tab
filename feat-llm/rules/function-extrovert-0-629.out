def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.lower().isin(['never', 'rarely']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.lower().isin(['never', 'large events']).astype(int)
    # For valued_friendship_traits, humor is not listed, so pick traits less related to deep connection.
    # Assuming 'Humor' is not present, so pick traits not related to deep connection: exclude Support, Loyalty, Honesty, All, All the three and trust, Understanding person
    # So if valued_friendship_traits is not in ['Support', 'Loyalty', 'Honesty', 'All', 'All the three and trust', 'Understanding person'], mark 1
    deep_traits = ['support', 'loyalty', 'honesty', 'all', 'all the three and trust', 'understanding person']
    df_output['valued_friendship_traits'] = (~df_input['valued_friendship_traits'].str.lower().isin(deep_traits)).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.lower().isin(['alone time', 'none of the above', 'social media']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.lower().isin(['introvert', 'not sure']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.lower().isin(['avoid it', 'nervous']).astype(int)
    # emotional_expression_method: [Stay silent, Other (if implies less verbal communication)]
    # So mark 1 if 'stay silent' or 'other' (case insensitive)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.lower().isin(['selfishness', 'unnecessary criticism']).astype(int)
    return df_output

