def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason for reading books is Academic Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency of reading books is On everyday basis'] = (df_input['Frequency of reading books'] == 'On everyday basis').astype(int)
    df_output['Amount of time spent reading books per day >= 3'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Number of printed books you read last two years in [More than 20, 16-20]'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20']).astype(int)
    df_output['Department in [Pharmacy, CIS, MCT, EEE]'] = df_input['Department'].isin(['Pharmacy', 'CIS', 'MCT', 'EEE']).astype(int)
    df_output['What is the change that you felt after reading books in [Increase Academic Performance, Increase Problem Solving Skill]'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['The format that you used for reading books in [Both, Printed]'] = df_input['The format that you used for reading books'].isin(['Both', 'Printed']).astype(int)
    df_output['Who influenced you to read books in [Teachers, Self-Decision]'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    df_output['Number of e-books you read last two years in [11-15, 16-20, More than 20]'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Where do you read printed books in [Home, Library]'] = df_input['Where do you read printed books'].isin(['Home', 'Library']).astype(int)
    return df_output

