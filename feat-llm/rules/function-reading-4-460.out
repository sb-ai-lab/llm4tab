def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Reading_Books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Time_Spent_Reading'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Printed_Books_Read'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Ebooks_Read'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_After_Reading'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Department_Selected'] = df_input['Department'].isin(['Pharmacy', 'EEE', 'Civil', 'Textile', 'MCT', 'CIS']).astype(int)
    df_output['Format_Both'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    df_output['Influenced_By'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    df_output['Language_and_Location'] = ((df_input['Which language books do you like to read'] == 'English') & (df_input['Where do you read printed books'].isin(['Library', 'Home']))).astype(int)
    return df_output

