def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_reading_books'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Frequency_reading_books'] = df_input['Frequency of reading books'].isin(['A few times a week', 'A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Favorite_books_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics']).astype(int)
    df_output['Time_spent_reading_less_3'] = (df_input['Amount of time spent reading books per day'] < 3).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['BBA', 'English', 'JMC', 'Textile', 'Civil', 'Others', 'NFE']).astype(int)
    df_output['Printed_books_1_5_or_nan'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Ebooks_1_5_or_nan'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Format_used_ebooks'] = df_input['The format that you used for reading books'].isin(['E-books']).astype(int)
    df_output['Read_newspaper'] = df_input['Do you read Newspaper'].isin(['Yes', 'No']).astype(int)
    df_output['Influenced_by_friends_parents'] = df_input['Who influenced you to read books'].isin(['Friends', 'Parents']).astype(int)
    return df_output

