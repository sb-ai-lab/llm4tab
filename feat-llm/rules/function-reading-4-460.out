def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_On_everyday_basis'] = (df_input['Frequency of reading books'] == 'On everyday basis').astype(int)
    df_output['Amount_time_reading_ge_3'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['Pharmacy', 'CSE', 'SWE', 'CIS', 'MCT', 'EEE']).astype(int)
    df_output['Printed_books_in_selected'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['E_books_in_selected'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Format_in_Both_Printed'] = df_input['The format that you used for reading books'].isin(['Both', 'Printed']).astype(int)
    df_output['Influenced_in_selected'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    df_output['Favorite_books_Others'] = (df_input['Favorite books for reading to spend leisure time'] == 'Others').astype(int)
    return df_output

