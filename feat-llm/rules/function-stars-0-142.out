def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_contains_III_or_IV'] = df_input['SpType'].str.contains('III|III/IV|IV', regex=True).astype(int)
    df_output['Amag_leq_2'] = (df_input['Amag'] <= 2.0).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= -5.0) & (df_input['Amag'] <= 2.0)).astype(int)
    df_output['B_V_geq_1'] = (df_input['B-V'] >= 1.0).astype(int)
    df_output['Vmag_leq_6_and_Plx_leq_5'] = ((df_input['Vmag'] <= 6.0) & (df_input['Plx'] <= 5.0)).astype(int)
    df_output['Plx_lt_5_and_Amag_leq_2_5'] = ((df_input['Plx'] < 5.0) & (df_input['Amag'] <= 2.5)).astype(int)
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G5III', 'K0III', 'M0III', 'B9III/IV']).astype(int)
    df_output['Amag_leq_1_and_B_V_geq_0_9'] = ((df_input['Amag'] <= 1.0) & (df_input['B-V'] >= 0.9)).astype(int)
    df_output['Vmag_leq_7_and_Amag_leq_3'] = ((df_input['Vmag'] <= 7.0) & (df_input['Amag'] <= 3.0)).astype(int)
    df_output['e_Plx_leq_1_and_Amag_leq_2'] = ((df_input['e_Plx'] <= 1.0) & (df_input['Amag'] <= 2.0)).astype(int)
    return df_output

