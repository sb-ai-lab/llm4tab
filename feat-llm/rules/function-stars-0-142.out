    df_output['B_V_le_0_8'] = (df_input['B-V'] <= 0.8).astype(int)
    df_output['Vmag_gt_8'] = (df_input['Vmag'] > 8.0).astype(int)
    df_output['Plx_ge_10'] = (df_input['Plx'] >= 10.0).astype(int)
    df_output['Vmag_ge_6_and_Plx_ge_5'] = ((df_input['Vmag'] >= 6.0) & (df_input['Plx'] >= 5.0)).astype(int)
    df_output['Amag_ge_5_and_B_V_le_1'] = ((df_input['Amag'] >= 5.0) & (df_input['B-V'] <= 1.0)).astype(int)
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['e_Plx_le_0_5_and_Amag_ge_4'] = ((df_input['e_Plx'] <= 0.5) & (df_input['Amag'] >= 4.0)).astype(int)
    return df_output

