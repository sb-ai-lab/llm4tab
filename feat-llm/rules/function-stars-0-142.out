def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_III_IV'] = df_input['SpType'].str.contains('III|IV').astype(int)
    df_output['Amag_le_2'] = (df_input['Amag'] <= 2.0).astype(int)
    df_output['B_V_ge_1'] = (df_input['B-V'] >= 1.0).astype(int)
    df_output['Plx_lt_10_Vmag_le_6'] = ((df_input['Plx'] < 10) & (df_input['Vmag'] <= 6.0)).astype(int)
    df_output['Amag_range'] = ((df_input['Amag'] >= -5.0) & (df_input['Amag'] <= 2.0)).astype(int)
    df_output['SpType_contains_III_IV'] = df_input['SpType'].str.contains('III|IV').astype(int)
    df_output['e_Plx_le_2_Amag_le_2_5'] = ((df_input['e_Plx'] <= 2.0) & (df_input['Amag'] <= 2.5)).astype(int)
    df_output['B_V_range_Amag_le_1_5'] = ((df_input['B-V'] >= 1.0) & (df_input['B-V'] <= 2.0) & (df_input['Amag'] <= 1.5)).astype(int)
    df_output['Vmag_le_5_Amag_le_0'] = ((df_input['Vmag'] <= 5.0) & (df_input['Amag'] <= 0.0)).astype(int)
    df_output['Plx_ge_5_Amag_le_1_SpType_ends_III_IV'] = ((df_input['Plx'] >= 5) & (df_input['Amag'] <= 1.0) & (df_input['SpType'].str.endswith('III') | df_input['SpType'].str.endswith('IV'))).astype(int)
    return df_output

