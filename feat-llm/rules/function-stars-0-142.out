def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_lumV'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['Amag_ge_4'] = (df_input['Amag'] >= 4.0).astype(int)
    df_output['B_V_le_1'] = (df_input['B-V'] <= 1.0).astype(int)
    df_output['Vmag_gt_8_Plx_lt_10'] = ((df_input['Vmag'] > 8.0) & (df_input['Plx'] < 10)).astype(int)
    df_output['Amag_in_4_10'] = ((df_input['Amag'] >= 4.0) & (df_input['Amag'] <= 10.0)).astype(int)
    df_output['SpType_no_III_IV'] = (~df_input['SpType'].str.contains('III|IV')).astype(int)
    df_output['Plx_ge_10_Amag_ge_5'] = ((df_input['Plx'] >= 10) & (df_input['Amag'] >= 5.0)).astype(int)
    df_output['e_Plx_le_1_Amag_ge_4_5'] = ((df_input['e_Plx'] <= 1.0) & (df_input['Amag'] >= 4.5)).astype(int)
    df_output['B_V_in_0_3_1_0_Amag_ge_3_5'] = (((df_input['B-V'] >= 0.3) & (df_input['B-V'] <= 1.0)) & (df_input['Amag'] >= 3.5)).astype(int)
    df_output['Vmag_ge_6_Amag_ge_3_5_SpType_end_V'] = ((df_input['Vmag'] >= 6.0) & (df_input['Amag'] >= 3.5) & (df_input['SpType'].str.endswith('V'))).astype(int)
    return df_output

