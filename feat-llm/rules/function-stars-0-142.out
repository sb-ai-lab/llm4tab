    df_output['Vmag_lt_6_and_Plx_lt_10'] = ((df_input['Vmag'] < 6.0) & (df_input['Plx'] < 10.0)).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= -2.0) & (df_input['Amag'] <= 2.0)).astype(int)
    df_output['SpType_lum_class_III_IV'] = df_input['SpType'].str.contains(r'III|IV').astype(int)
