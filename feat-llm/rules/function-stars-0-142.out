def extracting_features_1(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['SpType_in_1'] = df_input['SpType'].isin(['G8III', 'K1III', 'K5III', 'B9III/IV', 'G5III']).astype(int)
    df_output['Amag_le_2'] = (df_input['Amag'] <= 2.0).astype(int)
    df_output['B-V_ge_1'] = (df_input['B-V'] >= 1.0).astype(int)
    df_output['Vmag_lt_6'] = (df_input['Vmag'] < 6.0).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5.0).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= -5.0) & (df_input['Amag'] <= 2.0)).astype(int)
    df_output['SpType_in_2'] = df_input['SpType'].isin(['K3III', 'M0III', 'G7III']).astype(int)
    df_output['B-V_gt_0.9_Amag_lt_1.5'] = ((df_input['B-V'] > 0.9) & (df_input['Amag'] < 1.5)).astype(int)
    df_output['Plx_lt_3_Amag_lt_0'] = ((df_input['Plx'] < 3.0) & (df_input['Amag'] < 0.0)).astype(int)
    df_output['e_Plx_lt_1_Amag_le_2'] = ((df_input['e_Plx'] < 1.0) & (df_input['Amag'] <= 2.0)).astype(int)
    return df_output