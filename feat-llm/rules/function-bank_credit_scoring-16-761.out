def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_low'] = df_input['Credit history rating'].isin(['E1', 'E2', 'E3', 'D1', 'D2', 'D3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_range_and_Initial_limit'] = ((df_input['Debt'] >= 5000) & (df_input['Debt'] <= 20000) & (df_input['Initial limit'] <= 15000)).astype(int)
    df_output['INCOME_lt_1800'] = (df_input['INCOME'] < 1800).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_ge_36_and_INCOME_lt_2000'] = ((df_input['TERM'] >= 36) & (df_input['INCOME'] < 2000)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 2).astype(int)
    low_credit = ['C2', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']
    df_output['FAMILYSTATUS_2_and_low_credit'] = ((df_input['FAMILYSTATUS'] == 2) & (df_input['Credit history rating'].isin(low_credit))).astype(int)
    df_output['SEX_Male_and_Credit_history_E1_D3'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(['E1', 'D3']))).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Credit_history_rating_in_A1_A2_A3_B1_B2'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2']).astype(int)  
    df_output['PDN_less_than_0_2'] = (df_input['PDN'] < 0.2).astype(int)  
    df_output['Income_ge_1700_and_Debt_le_half_Initial_limit'] = ((df_input['INCOME'] >= 1700) & (df_input['Debt'] <= df_input['Initial limit'] * 0.5)).astype(int)  
    df_output['Initial_limit_ge_6000'] = (df_input['Initial limit'] >= 6000).astype(int)  
    df_output['Overdue_days_0_and_Income_ge_1500'] = ((df_input['Overdue days'] == 0) & (df_input['INCOME'] >= 1500)).astype(int)  
    df_output['EDU_in_University_College_and_Income_ge_1600'] = (df_input['EDU'].isin(['University', 'College']) & (df_input['INCOME'] >= 1600)).astype(int)  
    df_output['TERM_le_60_and_Credit_history_in_A1_B1'] = ((df_input['TERM'] <= 60) & (df_input['Credit history rating'].isin(['A1', 'B1']))).astype(int)  
    df_output['INDUSTRYNAME_in_Finance_Insurance_Production_Agriculture'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Production', 'Agriculture']).astype(int)  
    df_output['FAMILYSTATUS_1_and_PDN_lt_0_3'] = ((df_input['FAMILYSTATUS'] == 1) & (df_input['PDN'] < 0.3)).astype(int)  
    df_output['Debt_le_5000_and_Overdue_days_0_and_Credit_history_B2_or_better'] = ((df_input['Debt'] <= 5000) & (df_input['Overdue days'] == 0) & (df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2']))).astype(int)  
    return df_output