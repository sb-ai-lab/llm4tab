def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Credit_history_rating_in_A1_A2_A3_B1_B2_B3'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)  
    df_output['PDN_less_than_0_2'] = (df_input['PDN'] < 0.2).astype(int)  
    df_output['Initial_limit_gte_3500'] = (df_input['Initial limit'] >= 3500).astype(int)  
    df_output['INCOME_gte_1700'] = (df_input['INCOME'] >= 1700).astype(int)  
    df_output['EDU_is_University'] = (df_input['EDU'] == 'University').astype(int)  
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['Debt_gte_1800_and_Credit_history_rating_in_A1_B2_B3'] = ((df_input['Debt'] >= 1800) & (df_input['Credit history rating'].isin(['A1', 'B2', 'B3']))).astype(int)  
    df_output['TERM_lte_60_and_Credit_history_rating_in_A1_B1_B2'] = ((df_input['TERM'] <= 60) & (df_input['Credit history rating'].isin(['A1', 'B1', 'B2']))).astype(int)  
    df_output['INDUSTRYNAME_in_Finance_Insurance_Production_Transport_Logistic'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Production', 'Transport/Logistic']).astype(int)  
    df_output['LV_AREA_is_g_Minsk_and_Credit_history_rating_in_A1_B2_B3'] = ((df_input['LV_AREA'] == 'g. Minsk') & (df_input['Credit history rating'].isin(['A1', 'B2', 'B3']))).astype(int)  
    return df_output

