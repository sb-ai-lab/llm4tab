def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue days > 0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit history rating in D or E'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN >= 0.30'] = (df_input['PDN'] >= 0.30).astype(int)
    df_output['Debt >= 7000'] = (df_input['Debt'] >= 7000).astype(int)
    df_output['Initial limit <= 10000'] = (df_input['Initial limit'] <= 10000).astype(int)
    df_output['INCOME <= 1800'] = (df_input['INCOME'] <= 1800).astype(int)
    df_output['EDU in High school or Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM between 36 and 60'] = ((df_input['TERM'] >= 36) & (df_input['TERM'] <= 60)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT >= 2'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 2).astype(int)
    df_output['LV_AREA in selected oblasts'] = df_input['LV_AREA'].isin(['Vitebskaja oblast', "Gomel'skaja oblast", 'Mogilevskaja oblast']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_condition'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_condition'] = (df_input['PDN'] < 0.20).astype(int)
    df_output['Initial_limit_condition'] = (df_input['Initial limit'] >= 3500).astype(int)
    df_output['INCOME_condition'] = (df_input['INCOME'] > 1700).astype(int)
    df_output['Debt_condition'] = ((df_input['Debt'] >= 1800) & (df_input['Debt'] <= 20000)).astype(int)
    df_output['EDU_condition'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM_condition'] = ((df_input['TERM'] <= 60) & (df_input['TERM'] >= 24)).astype(int)
    df_output['Overdue_days_condition'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['INDUSTRYNAME_condition'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Production', 'Transport/Logistic']).astype(int)
    df_output['FAMILYSTATUS_condition'] = (df_input['FAMILYSTATUS'] == 1).astype(int)
    return df_output

---VERSION---

def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_C1_to_E3'] = df_input['Credit history rating'].isin(['C1', 'C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Initial_limit_le_2500'] = (df_input['Initial limit'] <= 2500).astype(int)
    df_output['INCOME_lt_1800'] = (df_input['INCOME'] < 1800).astype(int)
    df_output['EDU_in_selected'] = df_input['EDU'].isin(['High school', 'College', 'Incomplete']).astype(int)
    df_output['Debt_in_900_14000'] = df_input['Debt'].between(900, 14000).astype(int)
    df_output['TERM_ge_36_and_Credit_history_in'] = ((df_input['TERM'] >= 36) & (df_input['Credit history rating'].isin(['C2', 'C3', 'D1', 'E1']))).astype(int)
    df_output['SEX_Male_and_Credit_history_in'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(['C2', 'D3', 'E1']))).astype(int)
    df_output['LV_AREA_not_g_Minsk_and_Credit_history_in'] = ((df_input['LV_AREA'] != 'g. Minsk') & (df_input['Credit history rating'].isin(['C2', 'D3', 'E1']))).astype(int)
    return df_output

