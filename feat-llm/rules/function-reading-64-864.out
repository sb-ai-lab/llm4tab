def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge', 'Keep me informative']).astype(int)
    df_output['Department'] = df_input['Department'].isin(['BBA', 'English', 'JMC', 'Textile', 'NFE', 'Others']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['Once a week', 'A few times a week', 'Rarely']).astype(int)
    df_output['Favorite_books_for_reading_to_spend_leisure_time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['Number_of_e_books_you_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_printed_books_you_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['What_is_the_change_that_you_felt_after_reading_books'] = df_input['What is the change that you fell after reading books'].isin(['Increase Creative Thinking', 'Increase Vocabulary Knowledge']).astype(int)
    df_output['How_to_manage_books_for_reading'] = df_input['How to manage books for reading'].isin(['Borrow', 'Others']).astype(int)
    df_output['The_format_that_you_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['Printed only', 'Others']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Time_spent_reading_>=1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency_reading_books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']).astype(int)
    df_output['Ebooks_read_last_2yrs'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read_last_2yrs'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_after_reading'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Manage_books_method'] = df_input['How to manage books for reading'].isin(['E-books', 'Buy', 'Used-all']).astype(int)
    df_output['Format_used_reading'] = df_input['The format that you used for reading books'].isin(['E-books', 'Both']).astype(int)
    df_output['Influenced_by'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Teachers', 'Parents']).astype(int)
    return df_output

