def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge', 'Keep me informative']).astype(int)
    df_output['Frequency_of_reading_books_1'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Rarely', 'Once a month']).astype(int)
    df_output['Favorite_books_for_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] <= 1).astype(int)
    df_output['Number_of_printed_books_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_ebooks_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Department'] = df_input['Department'].isin(['BBA', 'English', 'JMC', 'Others']).astype(int)
    df_output['Change_after_reading_books'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    df_output['How_to_manage_books'] = df_input['How to manage books for reading'].isin(['Borrow', 'Others']).astype(int)
    freq_map = {
        'On everyday basis': 7,
        'A few times a week': 3,
        'A few times a month': 1,
        'Less than once a year': 0,
        'Once or twice a year': 0,
        'Rarely': 0,
        'Once a month': 1
    }
    freq_values = df_input['Frequency of reading books'].map(freq_map)
    df_output['Frequency_less_than_3_times_a_week'] = (freq_values < 3).astype(int)
    return df_output

