def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_of_reading_books_in_On_everyday_basis_or_A_few_times_a_week'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_6_10_11_15_16_20_More_than_20'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_ebooks_read_last_two_years_in_6_10_11_15_16_20_More_than_20'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_in_CSE_SWE_Pharmacy_EEE_Civil_MCT_Textile_CIS'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'Textile', 'CIS']).astype(int)
    df_output['Change_after_reading_books_is_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['How_to_manage_books_in_Buy_Used_all_E_books'] = df_input['How to manage books for reading'].isin(['Buy', 'Used-all', 'E-books']).astype(int)
    df_output['Favorite_books_in_Non_Fiction_Biography'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    freq_map = {
        'On everyday basis': 7,
        'A few times a week': 3,
        'A few times a month': 0.75,
        'Less than once a year': 0,
        'Once or twice a year': 0
    }
    freq_num = df_input['Frequency of reading books'].map(freq_map).fillna(0)
    df_output['Frequency_of_reading_books_ge_3_times_a_week'] = (freq_num >= 3).astype(int)
    return df_output

