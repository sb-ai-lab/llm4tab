def extracting_features_1(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'NARCOTICS', 'BATTERY', 'THEFT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'POSSESS - PCP', 'AGGRAVATED - HANDGUN', 'RETAIL THEFT']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'DEPARTMENT STORE', 'CTA BUS STOP', 'VEHICLE NON-COMMERCIAL']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['04B', '15', '18', '06']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 400) & (df_input['Beat'] <= 1200)).astype(int)
    df_output['District'] = ((df_input['District'] >= 2) & (df_input['District'] <= 11)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 3) & (df_input['Ward'] <= 44)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 6) & (df_input['Community Area'] <= 46)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    date_cond = (df_input['Date'] >= pd.to_datetime('01/01/2025 12:00:00 AM')) & (df_input['Date'] <= pd.to_datetime('01/29/2025 11:59:59 PM'))
    time_cond = (df_input['Date'].dt.hour >= 17) & (df_input['Date'].dt.hour <= 23)
    df_output['Date'] = (date_cond & time_cond).astype(int)
    return df_output

