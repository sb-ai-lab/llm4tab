def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'NARCOTICS', 'CRIMINAL SEXUAL ASSAULT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['AGGRAVATED', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'ALLEY']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '22', '04']).astype(int)
    df_output['Year'] = (df_input['Year'] == 2025).astype(int)
    df_output['Beat'] = df_input['Beat'].between(10, 90).astype(int)
    df_output['Ward'] = df_input['Ward'].between(5, 15).astype(int)
    date_format = "%m/%d/%Y %I:%M:%S %p"
    date_start = pd.to_datetime("01/04/2025 10:00:00 PM", format=date_format)
    date_end = pd.to_datetime("01/10/2025 11:00:00 PM", format=date_format)
    df_dates = pd.to_datetime(df_input['Date'], format=date_format, errors='coerce')
    df_output['Date'] = ((df_dates >= date_start) & (df_dates <= date_end)).astype(int)
    df_output['Y Coordinate'] = df_input['Y Coordinate'].between(1900000, 1920000).astype(int)
    return df_output

