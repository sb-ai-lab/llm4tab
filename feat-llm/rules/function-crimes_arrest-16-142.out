def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'MOTOR VEHICLE THEFT', 'ROBBERY', 'OTHER OFFENSE', 'CRIMINAL DAMAGE', 'OFFENSE INVOLVING CHILDREN', 'BATTERY']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['RETAIL THEFT', 'AUTOMOBILE', 'ARMED - HANDGUN', 'VEHICLE TITLE / REGISTRATION OFFENSE', 'TO PROPERTY', 'AGGRAVATED SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER', 'HARASSMENT BY ELECTRONIC MEANS', 'DOMESTIC BATTERY SIMPLE', 'TO VEHICLE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['APARTMENT', 'RESIDENCE', 'STREET', 'SIDEWALK']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['02', '03', '06', '07', '08B', '14', '26']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 400) & (df_input['Beat'] <= 700)).astype(int)
    df_output['District'] = df_input['District'].isin([4, 6, 8, 12, 15, 25]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([7, 23, 26, 27, 37, 42]).astype(int)
    df_output['Community Area'] = df_input['Community Area'].isin([23, 25, 28, 32, 43, 56]).astype(int)
    df_output['Year'] = (df_input['Year'] == 2025).astype(int)
    return df_output

