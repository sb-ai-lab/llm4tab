def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'CONCEALED CARRY LICENSE VIOLATION', 'BATTERY', 'OTHER OFFENSE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['POSSESS - HEROIN (WHITE)', 'MANUFACTURE / DELIVER - COCAINE', 'UNLAWFUL POSSESSION - HANDGUN', 'PROHIBITED PLACES', 'SIMPLE', 'OTHER VEHICLE OFFENSE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'CTA BUS', 'AIRPORT TERMINAL UPPER LEVEL - SECURE AREA', 'SMALL RETAIL STORE']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].astype(str).isin(['15', '18', '08B', '26']).astype(int)
    df_output['Beat_in_range'] = df_input['Beat'].between(800, 1800).astype(int)
    df_output['District_in_list'] = df_input['District'].isin([1, 3, 8, 11, 15, 16, 18, 25]).astype(int)
    df_output['Ward_in_list'] = df_input['Ward'].isin([4, 8, 12, 13, 28, 37, 38, 42]).astype(int)
    df_output['Community_Area_in_list'] = df_input['Community Area'].isin([23, 25, 27, 32, 43, 56, 58, 76]).astype(int)
    df_output['Year_is_2025'] = (df_input['Year'] == 2025).astype(int)
    return df_output

