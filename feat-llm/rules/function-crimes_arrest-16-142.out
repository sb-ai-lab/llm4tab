def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'NARCOTICS', 'CONCEALED CARRY LICENSE VIOLATION', 'BATTERY', 'OTHER OFFENSE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'POSSESS - HEROIN (WHITE)', 'MANUFACTURE / DELIVER - COCAINE', 'PROHIBITED PLACES', 'SIMPLE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'CTA BUS', 'AIRPORT TERMINAL UPPER LEVEL - SECURE AREA', 'SMALL RETAIL STORE']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['15', '18', '03', '26', '08B']).astype(int)
    df_output['Primary_Type_BATTERY_and_Description_SIMPLE'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'SIMPLE')).astype(int)
    df_output['Beat_in_range'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District_in_range'] = ((df_input['District'] >= 15) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 12) & (df_input['Ward'] <= 42)).astype(int)
    df_output['Community_Area_in_range'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 76)).astype(int)
    return df_output

