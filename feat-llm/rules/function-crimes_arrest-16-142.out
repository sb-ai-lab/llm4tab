def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['THEFT', 'MOTOR VEHICLE THEFT', 'CRIMINAL DAMAGE', 'OFFENSE INVOLVING CHILDREN']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['RETAIL THEFT', 'SIMPLE', 'TO PROPERTY', 'AGGRAVATED SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['RESIDENCE', 'DRUG STORE', 'APARTMENT']).astype(int)
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['06', '08B', '14', '02']).astype(int)
    df_output['Primary_Type_BATTERY_and_Description_DOMESTIC_BATTERY_SIMPLE'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'DOMESTIC BATTERY SIMPLE')).astype(int)
    df_output['Beat_in_range'] = ((df_input['Beat'] >= 800) & (df_input['Beat'] <= 900)).astype(int)
    df_output['District_in_range'] = ((df_input['District'] >= 8) & (df_input['District'] <= 12)).astype(int)
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 23) & (df_input['Ward'] <= 27)).astype(int)
    df_output['Community_Area_in_range'] = ((df_input['Community Area'] >= 23) & (df_input['Community Area'] <= 28)).astype(int)
    return df_output

