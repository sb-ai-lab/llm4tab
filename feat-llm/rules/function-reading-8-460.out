def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Often'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Time_spent_2_or_more'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Printed_books_many'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['E_books_many'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['Pharmacy', 'SWE', 'CSE', 'CIS']).astype(int)
    df_output['Format_and_Frequency'] = ((df_input['The format that you used for reading books'].isin(['Both', 'Printed'])) & (df_input['Frequency of reading books'] == 'On everyday basis')).astype(int)
    df_output['Influenced_and_Reason'] = ((df_input['Who influenced you to read books'].isin(['Self-Decision', 'Teachers'])) & (df_input['Reason for reading books'] == 'Academic Purpose')).astype(int)
    df_output['Read_location_Library'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    return df_output

