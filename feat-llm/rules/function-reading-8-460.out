def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_condition'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Reason_condition'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Time_spent_condition'] = (df_input['Amount of time spent reading books per day'] < 2).astype(int)
    df_output['Printed_books_condition'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Ebooks_condition'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Favorite_books_condition'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics']).astype(int)
    df_output['Department_condition'] = df_input['Department'].isin(['BBA', 'NFE', 'Others', 'JMC', 'Textile', 'Civil']).astype(int)
    df_output['Freq_Reason_condition'] = ((df_input['Frequency of reading books'] == 'A few times a week') & (df_input['Reason for reading books'] != 'Academic Purpose')).astype(int)
    df_output['Format_Freq_condition'] = ((df_input['The format that you used for reading books'].isin(['E-books', 'Printed'])) & (df_input['Frequency of reading books'] != 'On everyday basis')).astype(int)
    df_output['Influence_Reason_condition'] = ((df_input['Who influenced you to read books'].isin(['Parents', 'Friends'])) & (df_input['Reason for reading books'] != 'Academic Purpose')).astype(int)
    return df_output

