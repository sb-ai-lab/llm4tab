def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Credit_history_rating_in_D_E'] = df_input['Credit history rating'].isin(['D3', 'E2', 'E3', 'D2', 'D1', 'E1']).astype(int)
    df_output['INCOME_le_2000'] = (df_input['INCOME'] <= 2000).astype(int)
    df_output['Initial_limit_le_7000'] = (df_input['Initial limit'] <= 7000).astype(int)
    df_output['Debt_ge_5000'] = (df_input['Debt'] >= 5000).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['SEX_Female_and_INCOME_le_1000'] = ((df_input['SEX'] == 'Female') & (df_input['INCOME'] <= 1000)).astype(int)
    df_output['TERM_ge_36_and_INCOME_le_1500'] = ((df_input['TERM'] >= 36) & (df_input['INCOME'] <= 1500)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_1_and_PDN_ge_0_35'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 1) & (df_input['PDN'] >= 0.35)).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['PDN_le_0.1'] = (df_input['PDN'] <= 0.1).astype(int)
    df_output['Credit_history_rating_in'] = df_input['Credit history rating'].isin(['A1', 'A2', 'B1', 'B2', 'B3']).astype(int)
    df_output['INCOME_ge_2500'] = (df_input['INCOME'] >= 2500).astype(int)
    df_output['Initial_limit_ge_10000'] = (df_input['Initial limit'] >= 10000).astype(int)
    df_output['Debt_controlled'] = ((df_input['Debt'] >= 1000) & (df_input['Debt'] <= df_input['Initial limit'])).astype(int)
    df_output['EDU_in'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM_le_60_and_INCOME_ge_1800'] = ((df_input['TERM'] <= 60) & (df_input['INCOME'] >= 1800)).astype(int)
    df_output['SEX_Male_and_INCOME_ge_2000'] = ((df_input['SEX'] == 'Male') & (df_input['INCOME'] >= 2000)).astype(int)
    df_output['INDUSTRYNAME_in'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Construction', 'Trade', 'Science and Education']).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_le_1_and_PDN_lt_0.2'] = ((df_input['UNDERAGECHILDRENCOUNT'] <= 1) & (df_input['PDN'] < 0.2)).astype(int)
    return df_output

