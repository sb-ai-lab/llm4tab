def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Department'] = df_input['Department'].isin(['English', 'BBA', 'JMC', 'Others', 'Textile']).astype(int)
    df_output['Reason for reading books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'Keep me informative', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Amount of time spent reading books per day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Frequency of reading books'] = df_input['Frequency of reading books'].isin(['Less than once a year', 'Once or twice a year', 'A few times a month']).astype(int)
    df_output['Favorite books for reading to spend leisure time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics']).astype(int)
    df_output['Number of printed books you read last two years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number of e-books you read last two years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['The format that you used for reading books'] = df_input['The format that you used for reading books'].isin(['E-books']).astype(int)
    df_output['Who influenced you to read books'] = df_input['Who influenced you to read books'].isin(['Friends', 'Parents']).astype(int)
    df_output['What is the change that you felt after reading books'] = df_input['What is the change that you felt after reading books'].isin(['Feel Relax', 'Increase Creative Thinking']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Department'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']).astype(int)
    df_output['Reason for reading books'] = df_input['Reason for reading books'].isin(['Academic Purpose']).astype(int)
    df_output['Amount of time spent reading books per day'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Frequency of reading books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Favorite books for reading to spend leisure time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Number of printed books you read last two years'] = df_input['Number of printed books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number of e-books you read last two years'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['The format that you used for reading books'] = df_input['The format that you used for reading books'].isin(['Both', 'Printed']).astype(int)
    df_output['What is the change that you fell after reading books'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Who influenced you to read books'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    return df_output

