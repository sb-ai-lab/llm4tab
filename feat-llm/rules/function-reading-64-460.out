def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    freq_map = {
        'On everyday basis': 'Daily',
        'A few times a week': 'Several times a week',
        'A few times a month': 'Once a week',
        'Less than once a year': 'Less than once a year',
        'Once or twice a year': 'Once or twice a year'
    }
    freq_values = ['Daily', 'Several times a week', 'Once a week']
    freq_mapped = df_input['Frequency of reading books'].map(freq_map)
    df_output['Frequency_of_reading_books_in_selected'] = freq_mapped.isin(freq_values).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    printed_books_vals = ['6-10', '11-15', '16-20', 'More than 20']
    df_output['Number_of_printed_books_read_last_two_years_in_selected'] = df_input['Number of printed books you read last two years'].isin(printed_books_vals).astype(int)
    ebooks_vals = ['6-10', '11-15', '16-20', 'More than 20']
    df_output['Number_of_ebooks_read_last_two_years_in_selected'] = df_input['Number of e-books you read last two years'].isin(ebooks_vals).astype(int)
    fav_books_vals = ['Non-Fiction', 'Biography']
    df_output['Favorite_books_for_leisure_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(fav_books_vals).astype(int)
    dept_vals = ['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']
    df_output['Department_in_selected'] = df_input['Department'].isin(dept_vals).astype(int)
    df_output['Change_after_reading_is_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Where_do_you_read_printed_books_is_Library'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    format_vals = ['Both', 'E-books', 'Printed']
    df_output['Format_used_for_reading_in_selected'] = df_input['The format that you used for reading books'].isin(format_vals).astype(int)
    return df_output

