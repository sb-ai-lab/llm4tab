def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['PDN'] = (df_input['PDN'] >= 0.24).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] <= 2000).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] <= 3300).astype(int)
    df_output['Debt'] = (df_input['Debt'] <= 3000).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM'] = ((df_input['TERM'] >= 36) & (df_input['TERM'] <= 60)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['LV_AREA'] = df_input['LV_AREA'].isin(['BRESTSKAJa', 'GOMEL\'SKAJa', 'MOGILEVSKAJa']).astype(int)
    df_output['SEX_and_INCOME'] = ((df_input['SEX'] == 'Female') & (df_input['INCOME'] <= 1600)).astype(int)
    return df_output

