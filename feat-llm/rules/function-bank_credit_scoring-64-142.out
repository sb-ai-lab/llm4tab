def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Debt'] = (df_input['Debt'] >= 9000).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] >= 10000).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM'] = (df_input['TERM'] <= 60).astype(int)
    df_output['INDUSTRYNAME'] = df_input['INDUSTRYNAME'].isin(['Information Technology', 'Construction', 'Medicine and healthcare', 'Ministry of Internal Affairs/Ministry of Emergency Situations/Ministry of Defense', 'Public services']).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] == 0).astype(int)
    df_output['FAMILYSTATUS'] = (df_input['FAMILYSTATUS'] >= 1).astype(int)
    return df_output