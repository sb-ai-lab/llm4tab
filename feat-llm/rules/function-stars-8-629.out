def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K5III', 'K2III', 'K3III']).astype(int)  
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III|III/IV', regex=True).astype(int)  
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)  
    df_output['Amag_in_14_16'] = df_input['Amag'].between(14, 16).astype(int)  
    df_output['B-V_gt_1.2'] = (df_input['B-V'] > 1.2).astype(int)  
    df_output['B-V_in_1.2_1.6'] = df_input['B-V'].between(1.2, 1.6).astype(int)  
    df_output['Plx_lt_6'] = (df_input['Plx'] < 6).astype(int)  
    df_output['Plx_in_2_6'] = df_input['Plx'].between(2, 6).astype(int)  
    df_output['Vmag_lt_8'] = (df_input['Vmag'] < 8).astype(int)  
    df_output['Vmag_in_5_8'] = df_input['Vmag'].between(5, 8).astype(int)  
    return df_output

