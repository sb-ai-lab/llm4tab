    df_output['Call_151_No_And_The_reason_Complaints_And_Satisfaction_ge_3'] = (
        (df_input['Call_151'] == 'No') & 
        (df_input['The_reason_of_the_call'] == 'Complaints') & 
        (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)
    ).astype(int)
    df_output['How_often_do_you_receive_call_center_news_ge_4'] = (df_input['How_often_do_you_receive_call_center_news'] >= 4.0).astype(int)
    df_output['Age_in_selected_And_Communication_skills_ge_4'] = (
        df_input['Age'].isin(['18-24', '30-39']) & 
        (df_input['Call_center_employee_communication_skills_evaluation'] >= 4.0)
    ).astype(int)
    df_output['Education_in_selected_And_Satisfaction_ge_3_5'] = (
        df_input['Education'].isin(['High school', 'Diploma']) & 
        (df_input['Satisfaction_with_the_doctors_response'] >= 3.5)
    ).astype(int)
    df_output['Aware_151_No_And_Satisfaction_ge_3'] = (
        (df_input['Aware_151'] == 'No') & 
        (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)
    ).astype(int)
    df_output['Gender_Female_And_Communication_skills_ge_4'] = (
