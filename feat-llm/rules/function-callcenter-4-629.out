        (df_input['Satisfaction_with_the_doctors_response'] >= 3.5)
    ).astype(int)
    df_output['Nationality_Kuwaiti_and_communication_skills_ge_4'] = (
        (df_input['Nationality'] == 'Kuwaiti') &
        (df_input['Call_center_employee_communication_skills_evaluation'] >= 4.0)
    ).astype(int)
    return df_output

