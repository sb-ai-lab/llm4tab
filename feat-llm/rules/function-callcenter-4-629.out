        df_input['Age'].isin(['18-24', '50-59', '60 and above']) &
        (df_input['Satisfaction_with_the_doctors_response'] >= 4.0)
    ).astype(int)
    df_output['Aware_151_No_and_communication_skills_ge_3'] = (
        (df_input['Aware_151'] == 'No') &
        (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)
    ).astype(int)
    df_output['Education_in_selected_and_Satisfaction_ge_3_5'] = (
