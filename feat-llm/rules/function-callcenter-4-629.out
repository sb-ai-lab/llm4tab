    df_output['Call_center_employee_communication_skills_evaluation_ge_4'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 4.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_ge_4'] = (df_input['Satisfaction_with_the_doctors_response'] >= 4.0).astype(int)
