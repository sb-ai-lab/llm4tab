def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities'] = df_input['Feeling for regular activities'].isin(['No', 'Worried']).astype(int)
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['No', 'Low']).astype(int)
    df_output['Received_Support'] = df_input['Received Support'].isin(['High', 'Medium']).astype(int)
    df_output['Relax_sleep_when_newborn_asleep'] = (df_input['Relax/sleep when the newborn is asleep'] == 'Yes').astype(int)
    df_output['Relationship_with_newborn'] = df_input['Relationship between father and newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Fear_of_pregnancy'] = (df_input['Fear of pregnancy'] == 'No').astype(int)
    df_output['Major_changes_or_losses_during_pregnancy'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].isin(['More than 30000', '10000 to 20000', '20000 to 30000']).astype(int)
    df_output['Total_children'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Mode_of_delivery'] = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section']).astype(int)
    return df_output

