def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Need for Support Low'] = (df_input['Need for Support'] == 'Low').astype(int)
    df_output['Number of household members 2 to 5'] = (df_input['Number of household members'] == '2 to 5').astype(int)
    df_output['History of pregnancy loss No'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Relationship between father and newborn Good'] = (df_input['Relationship between father and newborn'] == 'Good').astype(int)
    df_output['Age of newborn in range'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year', '1 year to 1.5 year']).astype(int)
    df_output['Mode of delivery Normal or Caesarean'] = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section']).astype(int)
    df_output['Fear of pregnancy Yes'] = (df_input['Fear of pregnancy'] == 'Yes').astype(int)
    df_output['Pregnancy length in range'] = df_input['Pregnancy length'].isin(['Less than 5 months', '9 months', '10 months']).astype(int)
    df_output['Breastfeed Yes or No'] = df_input['Breastfeed'].isin(['Yes', 'No']).astype(int)
    df_output['Relationship with the in-laws in range'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    return df_output