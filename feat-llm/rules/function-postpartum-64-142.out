def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities'] = df_input['Feeling for regular activities'].isin(['Tired', 'Afraid', 'Worried']).astype(int)
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['Low', 'Medium', 'High']).astype(int)
    df_output['Received_Support'] = df_input['Received Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Relax_sleep_when_newborn_asleep'] = df_input['Relax/sleep when the newborn is asleep'].isin(['No', 'Yes']).astype(int)
    df_output['Relationship_with_newborn'] = (df_input['Relationship between father and newborn'] == 'Good').astype(int)
    df_output['Fear_of_pregnancy'] = (df_input['Fear of pregnancy'] == 'Yes').astype(int)
    df_output['Major_changes_or_losses_during_pregnancy'] = df_input['Major changes or losses during pregnancy'].isin(['Yes', 'No']).astype(int)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].isin(['No', '5000 to 10000', '10000 to 20000']).astype(int)
    df_output['Total_children'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Mode_of_delivery'] = df_input['Mode of delivery'].isin(['Caesarean Section', 'Normal Delivery']).astype(int)
    return df_output

