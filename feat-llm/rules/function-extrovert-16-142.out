def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['cond_1'] = ((df_input['social_connection_frequency'].str.capitalize().isin(['Weekly', 'Daily', 'Monthly'])) & (df_input['social_battery_recharge'] == 'Social media')).astype(int)  
    df_output['cond_2'] = ((df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly'])) & (df_input['conflict_resolution_style'] == 'Avoid conflict')).astype(int)  
    df_output['cond_3'] = (df_input['gathering_size_preference'].str.capitalize().isin(['Large events', 'Never'])).astype(int)  
    df_output['cond_4'] = (df_input['family_support_level'].str.capitalize().isin(['No', 'Never'])).astype(int)  
    df_output['cond_5'] = (df_input['social_orientation_type'] == 'Introvert').astype(int)  
    df_output['cond_6'] = (df_input['emotional_expression_method'] == 'Stay silent').astype(int)  
    df_output['cond_7'] = ((df_input['social_connection_frequency'].str.capitalize() == 'Weekly') & (df_input['valued_friendship_traits'] == 'Honesty')).astype(int)  
    df_output['cond_8'] = (df_input['conflict_resolution_style'] == 'Avoid conflict').astype(int)  
    df_output['cond_9'] = (df_input['social_anxiety_level'].isin(['Nervous', 'Avoid it'])).astype(int)  
    df_output['cond_10'] = (df_input['social_battery_recharge'] == 'Alone time').astype(int)  
    return df_output

