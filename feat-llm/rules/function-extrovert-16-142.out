def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Weekly', 'Monthly', 'Never']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.strip().str.title().isin(['Both', 'Large Events']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.strip().str.capitalize().isin(['Loyalty', 'Honesty']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.strip().str.title().isin(['Apologize First', 'Avoid Conflict']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.strip().str.capitalize().isin(['No', 'Never']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.strip().str.title().isin(['Alone Time', 'Social Media']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Introvert', 'Not sure']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.strip().str.capitalize().isin(['Selfishness', 'Unnecessary Criticism']).astype(int)

    # social_anxiety_level combined with other conditions
    sa_cond = df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Nervous', 'Excited'])
    df_output['social_anxiety_level'] = sa_cond.astype(int)

    # emotional_expression_method mostly when paired with low social connection frequency
    eem_vals = ['Express emotion strongly', 'Talk openly', 'Stay silent']
    eem_cond = df_input['emotional_expression_method'].str.strip().str.title().isin([v.title() for v in eem_vals])
    low_social_conn = df_output['social_connection_frequency'] == 0
    df_output['emotional_expression_method'] = (eem_cond & low_social_conn).astype(int)

    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Daily']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.strip().str.title().isin(['Small Gatherings']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.strip().str.capitalize().isin(['Loyalty', 'Support', 'Honesty']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.strip().str.title().isin(['Talk It Out', 'Apologize First']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.strip().str.capitalize().isin(['Yes', 'Sometimes']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.strip().str.title().isin(['Talking To Someone']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Extrovert', 'Ambivert', 'Not sure']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Neutral', 'Excited']).astype(int)
    emotional_mask = df_input['emotional_expression_method'].str.strip().str.title().isin(['Talk Openly', 'Stay Silent'])
    positive_conditions = (
        df_output['social_connection_frequency'] &
        df_output['gathering_size_preference'] &
        df_output['valued_friendship_traits'] &
        df_output['conflict_resolution_style'] &
        df_output['family_support_level'] &
        df_output['social_battery_recharge'] &
        df_output['social_orientation_type'] &
        df_output['social_anxiety_level']
    )
    df_output['emotional_expression_method'] = (emotional_mask & positive_conditions).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.strip().str.title().isin(['Unnecessary Criticism', 'Selfishness', 'Injustice']).astype(int)
    return df_output

