def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_and_battery'] = ((df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly', 'Monthly'])) & (df_input['social_battery_recharge'] == 'Talking to someone')).astype(int)
    df_output['gathering_size_preference'] = (df_input['gathering_size_preference'] == 'Small gatherings').astype(int)
    df_output['valued_friendship_traits'] = (df_input['valued_friendship_traits'].isin(['Loyalty', 'Support', 'All', 'All the three and trust'])).astype(int)
    df_output['conflict_resolution_style'] = (df_input['conflict_resolution_style'].isin(['Talk it out', 'Apologize first'])).astype(int)
    df_output['family_support_level'] = (df_input['family_support_level'].str.capitalize().isin(['Yes', 'Sometimes'])).astype(int)
    df_output['social_orientation_type'] = (df_input['social_orientation_type'].isin(['Extrovert', 'Ambivert', 'Not sure'])).astype(int)
    df_output['emotional_expression_method'] = (df_input['emotional_expression_method'] == 'Talk openly').astype(int)
    df_output['social_anxiety_level'] = (df_input['social_anxiety_level'] == 'Excited').astype(int)
    df_output['connection_and_gathering'] = ((df_input['social_connection_frequency'].str.capitalize() == 'Daily') & (df_input['gathering_size_preference'] == 'Small gatherings')).astype(int)
    df_output['battery_connection_emotion'] = ((df_input['social_battery_recharge'] == 'Alone time') & (df_input['social_connection_frequency'].str.capitalize() == 'Daily') & (df_input['emotional_expression_method'] == 'Talk openly')).astype(int)
    return df_output

