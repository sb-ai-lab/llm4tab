def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.lower().isin(['never', 'large events']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.lower().isin(['honesty']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)
    cond_battery = (df_input['social_battery_recharge'].str.lower() == 'talking to someone') & (df_output['social_connection_frequency'] == 1)
    df_output['social_battery_recharge'] = cond_battery.astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.lower().isin(['introvert', 'not sure']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.lower().isin(['nervous', 'avoid it']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.lower().isin(['unnecessary criticism', 'being interrupted']).astype(int)
    return df_output

