def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_leq_0_35'] = (df_input['PDN'] <= 0.35).astype(int)
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Debt_in_range'] = ((df_input['Debt'] >= 600) & (df_input['Debt'] <= 11000)).astype(int)
    df_output['Initial_limit_geq_4000'] = (df_input['Initial limit'] >= 4000).astype(int)
    df_output['INCOME_geq_1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['EDU_in_College_University'] = df_input['EDU'].isin(['College', 'University']).astype(int)
    df_output['TERM_leq_36'] = (df_input['TERM'] <= 36).astype(int)
    cond_fam = ((df_input['FAMILYSTATUS'].isin([1, 2])) & (df_input['UNDERAGECHILDRENCOUNT'] <= 2) & (df_input['PDN'] < 0.3))
    df_output['FAMILYSTATUS_1_2_and_CHILDREN_leq_2_and_PDN_lt_0_3'] = cond_fam.astype(int)
    birth_year = pd.to_datetime(df_input['BIRTHDATE']).dt.year
    cond_age_income = ((birth_year <= 1994) & (df_input['INCOME'] > 800))
    df_output['AGE_geq_30_and_INCOME_gt_800'] = cond_age_income.astype(int)
    return df_output

