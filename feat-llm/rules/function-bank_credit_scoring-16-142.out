def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Initial_limit_ge_8000'] = (df_input['Initial limit'] >= 8000).astype(int)  
    df_output['Debt_ge_3000_Overdue_0'] = ((df_input['Debt'] >= 3000) & (df_input['Overdue days'] == 0)).astype(int)  
    df_output['Credit_history_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)  
    df_output['Income_ge_1500_PDN_lt_0_4'] = ((df_input['INCOME'] >= 1500) & (df_input['PDN'] < 0.4)).astype(int)  
    df_output['EDU_College_University_Income_ge_1500'] = (df_input['EDU'].isin(['College', 'University']) & (df_input['INCOME'] >= 1500)).astype(int)  
    df_output['TERM_le_36_Initial_limit_ge_4000'] = ((df_input['TERM'] <= 36) & (df_input['Initial limit'] >= 4000)).astype(int)  
    df_output['SEX_Male_Income_ge_1500'] = ((df_input['SEX'] == 'Male') & (df_input['INCOME'] >= 1500)).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT_0_PDN_lt_0_35'] = ((df_input['UNDERAGECHILDRENCOUNT'] == 0) & (df_input['PDN'] < 0.35)).astype(int)  
    df_output['LV_AREA_in_list_Credit_history_in_list'] = (df_input['LV_AREA'].isin(['g. Minsk', 'Minskaja oblast', 'Brestskaja oblast']) & df_input['Credit history rating'].isin(['A3', 'B1', 'B3'])).astype(int)  
    df_output['FAMILYSTATUS_in_1_2_Income_ge_1500_PDN_lt_0_4'] = ((df_input['FAMILYSTATUS'].isin([1, 2])) & (df_input['INCOME'] >= 1500) & (df_input['PDN'] < 0.4)).astype(int)  
    return df_output

