def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['Debt_gt_8000'] = (df_input['Debt'] > 8000).astype(int)  
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)  
    df_output['Initial_limit_lt_5000'] = (df_input['Initial limit'] < 5000).astype(int)  
    df_output['INCOME_lt_2000'] = (df_input['INCOME'] < 2000).astype(int)  
    df_output['Credit_history_rating_in'] = df_input['Credit history rating'].isin(['C3', 'C2', 'E1', 'E2', 'E3', 'D1', 'D2', 'D3']).astype(int)  
    df_output['PDN_ge_0_27'] = (df_input['PDN'] >= 0.27).astype(int)  
    df_output['EDU_in'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)  
    df_output['TERM_ge_60'] = (df_input['TERM'] >= 60).astype(int)  
