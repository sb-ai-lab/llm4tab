def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_D_E'] = df_input['Credit history rating'].isin(['E1', 'E2', 'E3', 'D1', 'D2', 'D3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Debt_in_range'] = ((df_input['Debt'] >= 8000) & (df_input['Debt'] <= 21000)).astype(int)
    df_output['Initial_limit_le_2300'] = (df_input['Initial limit'] <= 2300).astype(int)
    df_output['INCOME_le_1600'] = (df_input['INCOME'] <= 1600).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_ge_60'] = (df_input['TERM'] >= 60).astype(int)
    df_output['SEX_Female_low_income'] = ((df_input['SEX'] == 'Female') & (df_input['INCOME'] < 1500)).astype(int)
    df_output['FAMILYSTATUS_2_children_PDN'] = ((df_input['FAMILYSTATUS'] == 2) & (df_input['UNDERAGECHILDRENCOUNT'] >= 1) & (df_input['PDN'] > 0.25)).astype(int)
    return df_output

