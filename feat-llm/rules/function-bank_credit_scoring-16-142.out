def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['Debt_ge_1000'] = (df_input['Debt'] >= 1000).astype(int)  
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)  
    df_output['Initial_limit_le_2000'] = (df_input['Initial limit'] <= 2000).astype(int)  
    df_output['INCOME_lt_1500'] = (df_input['INCOME'] < 1500).astype(int)  
    df_output['Credit_history_rating_in'] = df_input['Credit history rating'].isin(['C3', 'C2', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)  
    df_output['PDN_ge_0_27'] = (df_input['PDN'] >= 0.27).astype(int)  
    df_output['EDU_in'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)  
    df_output['TERM_ge_60_and_INCOME_lt_2000'] = ((df_input['TERM'] >= 60) & (df_input['INCOME'] < 2000)).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT_ge_1_and_PDN_ge_0_3'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 1) & (df_input['PDN'] >= 0.3)).astype(int)  
    df_output['SEX_Female_and_INCOME_lt_1000'] = ((df_input['SEX'] == 'Female') & (df_input['INCOME'] < 1000)).astype(int)  
    return df_output

