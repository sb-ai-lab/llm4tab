def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Regular checkups_No'] = (df_input['Regular checkups'] == 'No').astype(int)
    df_output['Feeling about motherhood_Neutral_or_Sad'] = df_input['Feeling about motherhood'].isin(['Neutral', 'Sad']).astype(int)
    df_output['Need for Support_Medium_or_High'] = df_input['Need for Support'].isin(['Medium', 'High']).astype(int)
    df_output['Pregnancy plan_No'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Trust and share feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Husband\'s education level_low'] = df_input['Husband\'s education level'].str.lower().isin(['no', 'primary school', 'high school']).astype(int)
    df_output['Current monthly income_low'] = df_input['Current monthly income'].isin(['No', 'Less than 5000', '5000 to 10000']).astype(int)
    df_output['Total children_two_or_more'] = df_input['Total children'].str.lower().isin(['two', 'more than two']).astype(int)
    df_output['Education Level_low'] = df_input['Education Level'].str.lower().isin(['no', 'primary school', 'high school']).astype(int)
    df_output['History of pregnancy loss_yes'] = df_input['History of pregnancy loss'].str.lower().isin(['miscarriage', 'still-born delivery']).astype(int)
    return df_output

