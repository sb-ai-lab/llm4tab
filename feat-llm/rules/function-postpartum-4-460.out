def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].apply(lambda x: 1 if x == 'Happy' else 0)
    df_output['Relationship_with_newborn'] = df_input['Relationship with the newborn'].apply(lambda x: 1 if x in ['Good', 'Very good'] else 0)
    df_output['Pregnancy_plan'] = df_input['Pregnancy plan'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Number_of_household_members'] = df_input['Number of household members'].apply(lambda x: 1 if x in ['6 to 8', '9 or more'] else 0)
    df_output['Relationship_between_father_and_newborn'] = df_input['Relationship between father and newborn'].apply(lambda x: 1 if x in ['Good', 'Very good'] else 0)
    df_output['Marital_status'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Married' else 0)
    df_output['Breastfeed'] = df_input['Breastfeed'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Mode_of_delivery'] = df_input['Mode of delivery'].apply(lambda x: 1 if x == 'Normal Delivery' else 0)
    df_output['Number_of_latest_pregnancy'] = df_input['Number of the latest pregnancy'].apply(lambda x: 1 if pd.to_numeric(x, errors='coerce') is not None and pd.to_numeric(x, errors='coerce') >= 2 else 0)
    df_output['Occupation_before_latest_pregnancy'] = df_input['Occupation before latest pregnancy'].apply(lambda x: 1 if x in ['Teacher', 'Doctor', 'Business'] else 0)
    return df_output

