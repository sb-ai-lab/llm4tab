    df_output['Occupation_before_latest_pregnancy_in_Housewife_House_wife_Student_Other'] = df_input['Occupation before latest pregnancy'].apply(lambda x: 1 if x in ['Housewife', 'House wife', 'Student', 'Other'] else 0)
