def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.capitalize().isin(['Large events', 'Both']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.capitalize().isin(['Support', 'Loyalty', 'All', 'All the three and trust']).astype(int)
    cond_conflict = df_input['conflict_resolution_style'].str.capitalize().isin(['Talk it out', 'Apologize first'])
    cond_social_freq = df_input['social_connection_frequency'].str.capitalize().isin(['Daily', 'Weekly'])
    df_output['conflict_resolution_style'] = (cond_conflict & cond_social_freq).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.capitalize().isin(['No', 'Sometimes']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.capitalize().isin(['Talking to someone', 'Social media']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.capitalize().isin(['Extrovert', 'Ambivert']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.capitalize().isin(['Neutral', 'Excited']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.capitalize().isin(['Talk openly', 'Express emotion strongly']).astype(int)
    cond_gathering_never = df_input['gathering_size_preference'].str.capitalize() == 'Never'
    cond_social_monthly = df_input['social_connection_frequency'].str.capitalize() == 'Monthly'
    df_output['gathering_never_social_monthly'] = (cond_gathering_never & cond_social_monthly).astype(int)
    return df_output

