def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['The_reason_of_the_call'].isin(['Complaints', 'Inquiries', 'Medical_Consultation'])) & 
                           (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_2'] = ((df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_3'] = ((df_input['How_often_do_you_receive_call_center_news'] >= 2.0) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_4'] = ((df_input['Call_151'].isin(['No'])) & 
                           (df_input['The_reason_of_the_call'].isin(['Complaints'])) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_5'] = ((df_input['Nationality'].isin(['Unspecified', 'Other nationality'])) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_6'] = ((df_input['Age'].isin(['18-24', '30-39'])) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_7'] = ((df_input['Marital_Status'].isin(['Widow', 'Widower'])) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_8'] = ((df_input['Governorate'].isin(['Jahra', 'Capital'])) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    df_output['cond_9'] = ((df_input['Gender'].isin(['Female'])) & 
                           (df_input['Satisfaction_with_the_doctors_response'] >= 2.8)).astype(int)
    df_output['cond_10'] = ((df_input['Education'].isin(['High school', 'Diploma', 'Bachelor'])) & 
                            (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)
    return df_output