def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'CRIMINAL DAMAGE', 'MOTOR VEHICLE THEFT', 'THEFT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'TO VEHICLE', 'THEFT / RECOVERY - AUTOMOBILE', 'RETAIL THEFT']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'APARTMENT', 'DEPARTMENT STORE']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['15', '14', '07', '06']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 400) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District'] = df_input['District'].isin([4, 10, 15, 18]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([10, 25, 29, 42]).astype(int)
    df_output['Community Area'] = df_input['Community Area'].isin([8, 25, 29, 46]).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/31/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    return df_output

