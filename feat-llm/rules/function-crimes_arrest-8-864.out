def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['OTHER OFFENSE', 'PUBLIC PEACE VIOLATION', 'NARCOTICS', 'LIQUOR LAW VIOLATION']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['HARASSMENT BY TELEPHONE', 'VEHICLE TITLE / REGISTRATION OFFENSE', 'SIMPLE', 'TIRE DEFLATION DEVICE DEPLOYMENT']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['APARTMENT', 'STREET', 'RESIDENCE']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['24', '26']).astype(int)
    df_output['Primary_Type_THEFT_and_Description_in_list'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'].isin(['OVER $500', '$500 AND UNDER']))).astype(int)
    df_output['Beat_in_range_and_Location_Description_DEPARTMENT_STORE'] = ((df_input['Beat'] >= 1800) & (df_input['Beat'] <= 1900) & (df_input['Location Description'] == 'DEPARTMENT STORE')).astype(int)
    df_output['District_in_list_and_Primary_Type_OTHER_OFFENSE'] = (df_input['District'].isin([18, 25]) & (df_input['Primary Type'] == 'OTHER OFFENSE')).astype(int)
    df_output['Ward_in_range_and_Description_VEHICLE_TITLE_REGISTRATION_OFFENSE'] = ((df_input['Ward'] >= 36) & (df_input['Ward'] <= 44) & (df_input['Description'] == 'VEHICLE TITLE / REGISTRATION OFFENSE')).astype(int)
    df_output['Community_Area_in_range_and_Primary_Type_THEFT'] = ((df_input['Community Area'] >= 6) & (df_input['Community Area'] <= 19) & (df_input['Primary Type'] == 'THEFT')).astype(int)
    return df_output

