def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_condition'] = df_input['Primary Type'].isin(['THEFT', 'MOTOR VEHICLE THEFT', 'CRIMINAL DAMAGE', 'WEAPONS VIOLATION']).astype(int)
    df_output['Description_condition'] = df_input['Description'].isin(['RETAIL THEFT', 'THEFT / RECOVERY - AUTOMOBILE', 'TO VEHICLE', 'UNLAWFUL POSSESSION - HANDGUN']).astype(int)
    df_output['Location_Description_condition'] = df_input['Location Description'].isin(['APARTMENT', 'DEPARTMENT STORE', 'STREET']).astype(int)
    df_output['Domestic_condition'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI_Code_condition'] = df_input['FBI Code'].isin(['06', '07', '14', '15']).astype(int)
    df_output['Beat_condition'] = (((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 1600)) & (df_input['Primary Type'].isin(['CRIMINAL DAMAGE', 'MOTOR VEHICLE THEFT']))).astype(int)
    df_output['District_condition'] = (df_input['District'].isin([4, 10, 15, 18]) & df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'THEFT'])).astype(int)
    df_output['Ward_condition'] = ((df_input['Ward'] >= 10) & (df_input['Ward'] <= 29) & df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'RETAIL THEFT'])).astype(int)
    df_output['Community_Area_condition'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 29) & df_input['Primary Type'].isin(['THEFT', 'CRIMINAL DAMAGE'])).astype(int)
    df_output['Year_condition'] = ((df_input['Year'] == 2025) & df_input['Primary Type'].isin(['THEFT', 'MOTOR VEHICLE THEFT', 'CRIMINAL DAMAGE', 'WEAPONS VIOLATION'])).astype(int)
    return df_output