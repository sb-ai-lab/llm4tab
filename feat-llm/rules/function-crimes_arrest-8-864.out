def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['Primary Type'] = df_input['Primary Type'].isin(['PUBLIC PEACE VIOLATION', 'OTHER OFFENSE', 'THEFT']).astype(int)  
    df_output['Description'] = df_input['Description'].isin(['HARASSMENT BY TELEPHONE', 'VEHICLE TITLE / REGISTRATION OFFENSE', 'SIMPLE']).astype(int)  
    df_output['Location Description'] = df_input['Location Description'].isin(['APARTMENT', 'STREET']).astype(int)  
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)  
    df_output['FBI Code'] = df_input['FBI Code'].isin(['24', '26', '06']).astype(int)  
    df_output['Beat'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2000)).astype(int)  
    df_output['District'] = df_input['District'].isin([1, 18, 19]).astype(int)  
    df_output['Ward'] = df_input['Ward'].isin([28, 36, 42, 44]).astype(int)  
    df_output['Community Area'] = df_input['Community Area'].isin([6, 8, 19, 28]).astype(int)  
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')  
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')  
    end_date = pd.to_datetime('01/15/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')  
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)  
    return df_output

