def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'THEFT', 'MOTOR VEHICLE THEFT', 'CRIMINAL DAMAGE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['UNLAWFUL POSSESSION - HANDGUN', 'RETAIL THEFT', 'THEFT / RECOVERY - AUTOMOBILE', 'TO VEHICLE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'APARTMENT', 'DEPARTMENT STORE']).astype(int)
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['06', '07', '14', '15']).astype(int)
    df_output['Beat_in_range'] = ((df_input['Beat'] >= 1500) & (df_input['Beat'] <= 1900)).astype(int)
    df_output['District_in_range'] = ((df_input['District'] >= 10) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 10) & (df_input['Ward'] <= 44)).astype(int)
    df_output['Community_Area_in_range'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 46)).astype(int)
    df_output['Primary_Type_THEFT_and_Description_RETAIL_THEFT'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT')).astype(int)
    return df_output

