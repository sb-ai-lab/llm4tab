def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type in list'] = df_input['Primary Type'].isin(['OTHER OFFENSE', 'PUBLIC PEACE VIOLATION', 'BATTERY', 'NARCOTICS']).astype(int)
    df_output['Description in list'] = df_input['Description'].isin(['VEHICLE TITLE / REGISTRATION OFFENSE', 'HARASSMENT BY TELEPHONE', 'SIMPLE', 'TIRE DEFLATION DEVICE DEPLOYMENT']).astype(int)
    df_output['Location Description in list'] = df_input['Location Description'].isin(['STREET', 'APARTMENT', 'SIDEWALK']).astype(int)
    df_output['Domestic is 0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code in list'] = df_input['FBI Code'].isin(['24', '26', '08B']).astype(int)
    df_output['Primary Type THEFT and Description OVER $500'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'OVER $500')).astype(int)
    df_output['Beat in range'] = ((df_input['Beat'] >= 1200) & (df_input['Beat'] <= 1300)).astype(int)
    df_output['District in range'] = ((df_input['District'] >= 1) & (df_input['District'] <= 5)).astype(int)
    df_output['Ward in range'] = ((df_input['Ward'] >= 28) & (df_input['Ward'] <= 36)).astype(int)
    df_output['Community Area in range'] = ((df_input['Community Area'] >= 6) & (df_input['Community Area'] <= 30)).astype(int)
    return df_output

