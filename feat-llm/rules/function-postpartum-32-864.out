def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood_Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Angry_after_latest_child_birth_No'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['Monthly_income_in_selected'] = df_input['Monthly income before latest pregnancy'].isin(['No', '10000 to 20000', 'More than 30000', '5000 to 10000']).astype(int)
    df_output['Newborn_illness_No'] = (df_input['Newborn illness'] == 'No').astype(int)
    df_output['Birth_compliancy_in_selected'] = df_input['Birth compliancy'].isin(['Yes', 'No']).astype(int)
    df_output['Relationship_father_newborn_good'] = df_input['Relationship between father and newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Age_of_newborn_in_range'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year', '1 year to 1.5 year']).astype(int)
    df_output['Number_latest_pregnancy_le_2'] = (df_input['Number of the latest pregnancy'] <= 2).astype(int)
    df_output['Education_Level_in_selected'] = df_input['Education Level'].isin(['University', 'College', 'High School']).astype(int)
    df_output['Regular_checkups_Yes'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    return df_output

