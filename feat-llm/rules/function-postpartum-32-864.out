def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood_Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Relax_sleep_newborn_asleep_Yes'] = (df_input['Relax/sleep when the newborn is asleep'] == 'Yes').astype(int)
    df_output['Relationship_inlaws_Good_Friendly'] = df_input['Relationship with the in-laws'].isin(['Good', 'Friendly']).astype(int)
    income_categories = ['5000 to 10000', '10000 to 20000', 'More than 30000', '20000 to 30000']
    df_output['Monthly_income_before_latest_pregnancy_in_range'] = df_input['Monthly income before latest pregnancy'].isin(income_categories).astype(int)
    df_output['Current_monthly_income_in_range'] = df_input['Husband’s monthly income'].isin(income_categories).astype(int)
    df_output['Family_type_Joint_Nuclear'] = df_input['Family type'].isin(['Joint', 'Nuclear']).astype(int)
    df_output['Breastfeed_Yes'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    df_output['Fear_of_pregnancy_No'] = (df_input['Fear of pregnancy'] == 'No').astype(int)
    df_output['Mode_of_delivery_Normal_Caesarean'] = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section']).astype(int)
    df_output['Number_latest_pregnancy_1_to_3'] = df_input['Number of the latest pregnancy'].between(1,3).astype(int)
    return df_output

