def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Feeling_about_motherhood_Neutral_or_Sad'] = df_input['Feeling about motherhood'].isin(['Neutral', 'Sad']).astype(int)  
    df_output['Angry_after_latest_child_birth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)  
    df_output['Monthly_income_low_or_no'] = df_input['Husband’s monthly income'].isin(['No', 'Less than 5000', '10000 to 20000']).astype(int)  
    df_output['Newborn_illness_No_or_Yes'] = df_input['Newborn illness'].isin(['No', 'Yes']).astype(int)  
    df_output['Birth_compliancy_No_or_Yes'] = df_input['Birth compliancy'].isin(['No', 'Yes']).astype(int)  
    df_output['Relationship_father_newborn_Good_or_Neutral'] = df_input['Relationship between father and newborn'].isin(['Good', 'Neutral']).astype(int)  
    df_output['Age_newborn_in_range'] = df_input['Age of newborn'].isin(['0 to 6 months', '1 year to 1.5 year', 'Older than 1.5 year']).astype(int)  
    df_output['Number_latest_pregnancy_ge_1'] = (df_input['Number of the latest pregnancy'] >= 1).astype(int)  
    df_output['Education_Level_University_or_College'] = df_input['Education Level'].isin(['University', 'College']).astype(int)  
    df_output['Regular_checkups_Yes'] = (df_input['Regular checkups'] == 'Yes').astype(int)  
    return df_output

