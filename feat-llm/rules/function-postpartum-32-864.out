def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood_in_Neutral_Sad'] = df_input['Feeling about motherhood'].isin(['Neutral', 'Sad']).astype(int)
    df_output['Relax_sleep_when_newborn_asleep_No'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    df_output['Relationship_with_inlaws_in_Neutral_Bad_Poor'] = df_input['Relationship with the in-laws'].isin(['Neutral', 'Bad', 'Poor']).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_in_No_Less_than_5000'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'Less than 5000']).astype(int)
    df_output['Current_monthly_income_in_No_Less_than_5000'] = df_input['Current monthly income'].isin(['No', 'Less than 5000']).astype(int)
    df_output['Family_type_Nuclear'] = (df_input['Family type'] == 'Nuclear').astype(int)
    df_output['Breastfeed_No'] = (df_input['Breastfeed'] == 'No').astype(int)
    df_output['Fear_of_pregnancy_Yes'] = (df_input['Fear of pregnancy'] == 'Yes').astype(int)
    df_output['Mode_of_delivery_in_Caesarean_Section_Normal_Delivery'] = df_input['Mode of delivery'].isin(['Caesarean Section', 'Normal Delivery']).astype(int)
    df_output['Number_of_latest_pregnancy_in_1_3'] = df_input['Number of the latest pregnancy'].between(1,3).astype(int)
    return df_output