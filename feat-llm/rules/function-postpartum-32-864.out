    df_output['Feeling_regular_activities'] = (df_input['Feeling for regular activities'] == 'No').astype(int)
    df_output['Breastfeed'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    df_output['Total_children'] = (df_input['Total children'].isin(['Two', 'More than two'])).astype(int)
    df_output['Residence'] = (df_input['Residence'] == 'City').astype(int)
