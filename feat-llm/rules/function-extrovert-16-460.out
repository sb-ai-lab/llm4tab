def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_Monthly_Never'] = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never']).astype(int)
    df_output['gathering_size_preference_Large_events'] = df_input['gathering_size_preference'].str.lower().eq('large events').astype(int)
    df_output['valued_friendship_traits_Support'] = df_input['valued_friendship_traits'].str.lower().eq('support').astype(int)
    df_output['conflict_resolution_style_Apologize_first_Avoid_conflict'] = df_input['conflict_resolution_style'].str.lower().isin(['apologize first', 'avoid conflict']).astype(int)
    df_output['family_support_level_No_Never'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)
    df_output['social_battery_recharge_Alone_time_None_of_the_above'] = df_input['social_battery_recharge'].str.lower().isin(['alone time', 'none of the above']).astype(int)
    df_output['social_orientation_type_Introvert'] = df_input['social_orientation_type'].str.lower().eq('introvert').astype(int)
    df_output['social_anxiety_level_Nervous_Avoid_it'] = df_input['social_anxiety_level'].str.lower().isin(['nervous', 'avoid it']).astype(int)
    df_output['emotional_expression_method_Stay_silent_Other'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    df_output['social_connection_frequency_Daily_and_social_battery_recharge_Alone_time'] = ((df_input['social_connection_frequency'].str.lower() == 'daily') & (df_input['social_battery_recharge'].str.lower() == 'alone time')).astype(int)
    return df_output

