def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_condition'] = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Weekly', 'Monthly', 'Daily']).astype(int)
    df_output['gathering_size_preference_condition'] = df_input['gathering_size_preference'].str.strip().str.capitalize().isin(['Both', 'Large events']) | ((df_input['gathering_size_preference'].str.strip().str.capitalize() == 'Never') & (df_output['social_connection_frequency_condition'] == 1))
    df_output['gathering_size_preference_condition'] = df_output['gathering_size_preference_condition'].astype(int)
    df_output['valued_friendship_traits_condition'] = df_input['valued_friendship_traits'].str.strip().str.capitalize().isin(['Loyalty', 'Support']).astype(int)
    df_output['conflict_resolution_style_condition'] = df_input['conflict_resolution_style'].str.strip().str.capitalize().isin(['Talk it out', 'Apologize first']).astype(int)
    df_output['family_support_level_condition'] = df_input['family_support_level'].str.strip().str.capitalize().isin(['Yes', 'Sometimes']).astype(int)
    df_output['social_battery_recharge_condition'] = df_input['social_battery_recharge'].str.strip().str.capitalize().isin(['Talking to someone', 'Social media']).astype(int)
    df_output['social_orientation_type_condition'] = df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Extrovert', 'Ambivert', 'Not sure']).astype(int)
    df_output['social_anxiety_level_condition'] = df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Excited', 'Neutral']).astype(int)
    df_output['emotional_expression_method_condition'] = df_input['emotional_expression_method'].str.strip().str.capitalize().isin(['Talk openly', 'Express emotion strongly']).astype(int)
    df_output['combined_condition'] = ((df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Monthly', 'Weekly'])) & 
                                       (df_input['social_battery_recharge'].str.strip().str.capitalize().isin(['Talking to someone', 'Social media'])) & 
                                       (df_input['family_support_level'].str.strip().str.capitalize().isin(['Yes', 'Sometimes']))).astype(int)
    return df_output

