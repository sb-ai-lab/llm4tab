def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['social_connection_frequency_weekly_never'] = df_input['social_connection_frequency'].str.lower().isin(['weekly', 'never']).astype(int)  
    df_output['gathering_size_preference_never_both'] = df_input['gathering_size_preference'].str.lower().isin(['never', 'both']).astype(int)  
    df_output['valued_friendship_traits_honesty_loyalty'] = df_input['valued_friendship_traits'].str.lower().isin(['honesty', 'loyalty']).astype(int)  
    df_output['conflict_resolution_style_talk_it_out'] = df_input['conflict_resolution_style'].str.lower().eq('talk it out').astype(int)  
    df_output['family_support_level_yes_sometimes'] = df_input['family_support_level'].str.lower().isin(['yes', 'sometimes']).astype(int)  
    df_output['social_battery_recharge_talking_social_media'] = df_input['social_battery_recharge'].str.lower().isin(['talking to someone', 'social media']).astype(int)  
    df_output['social_orientation_type_extrovert_ambivert_not_sure'] = df_input['social_orientation_type'].str.lower().isin(['extrovert', 'ambivert', 'not sure']).astype(int)  
    df_output['social_anxiety_level_excited_neutral'] = df_input['social_anxiety_level'].str.lower().isin(['excited', 'neutral']).astype(int)  
    df_output['emotional_expression_method_talk_openly_express_strongly'] = df_input['emotional_expression_method'].str.lower().isin(['talk openly', 'express emotion strongly']).astype(int)  
    cond = (df_input['social_connection_frequency'].str.lower() == 'weekly') & (df_input['emotional_expression_method'].str.lower() == 'stay silent')  
    df_output['social_connection_weekly_and_emotional_expression_stay_silent'] = cond.astype(int)  
    return df_output

