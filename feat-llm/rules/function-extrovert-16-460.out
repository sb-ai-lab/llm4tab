def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].isin(['Never', 'Monthly']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].isin(['Never', 'Small gatherings']).astype(int)
    df_output['valued_friendship_traits'] = ((df_input['valued_friendship_traits'].isin(['Honesty', 'Support'])) & (~df_input['valued_friendship_traits'].isin(['Loyalty']))).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].isin(['Avoid conflict', 'Let time fix it']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].isin(['No', 'Never']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].isin(['Alone time', 'None of the above']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].isin(['Introvert']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].isin(['Avoid it', 'Nervous']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].isin(['Stay silent', 'Other']).astype(int)
    df_output['combined_condition'] = ((df_input['social_connection_frequency'] == 'Weekly') & 
                                      (df_input['gathering_size_preference'] == 'Never') & 
                                      (df_input['social_battery_recharge'] == 'None of the above')).astype(int)
    return df_output

