def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    freq_condition_1 = df_input['Frequency of reading books'].isin(['A few times a month', 'Rarely'])
    freq_condition_2 = df_input['Frequency of reading books'].isin(['Less than once a year', 'Once or twice a year'])
    freq_condition_3 = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week'])
    df_output['Frequency_of_reading_books'] = (freq_condition_1 | freq_condition_2).astype(int)
    df_output['Number_of_printed_books_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_e_books_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Department'] = df_input['Department'].isin(['BBA', 'NFE', 'Textile', 'Civil', 'JMC', 'Others']).astype(int)
    df_output['Favorite_books_for_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['Change_after_reading_books'] = (~df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill'])).astype(int)
    df_output['How_to_manage_books'] = df_input['How to manage books for reading'].isin(['Others', 'Used-all']).astype(int)
    df_output['Frequency_of_reading_books_leq_1_per_week'] = df_input['Frequency of reading books'].isin(['Less than once a year', 'Once or twice a year', 'A few times a month', 'Rarely']).astype(int)
    return df_output

