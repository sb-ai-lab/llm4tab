def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Rarely']).astype(int)
    df_output['Favorite_books_for_reading_to_spend_leisure_time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics']).astype(int)
    df_output['Number_of_e_books_you_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_printed_books_you_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Department'] = df_input['Department'].isin(['BBA', 'English', 'JMC', 'NFE']).astype(int)
    df_output['What_is_the_change_that_you_felt_after_reading_books'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    df_output['How_to_manage_books_for_reading'] = df_input['How to manage books for reading'].isin(['Others', 'Used-all']).astype(int)
    cond_format = df_input['The format that you used for reading books'].isin(['Printed', 'Others'])
    cond_freq = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year', 'Rarely'])
    df_output['The_format_that_you_used_for_reading_books'] = (cond_format & cond_freq).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Time_spent_reading_>=1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency_high'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Ebooks_read_high'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read_high'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['CSE', 'Pharmacy', 'Civil', 'SWE', 'EEE', 'MCT', 'CIS', 'Textile']).astype(int)
    df_output['Manage_books_selected'] = df_input['How to manage books for reading'].isin(['E-books', 'Borrow', 'Buy']).astype(int)
    df_output['Format_high_freq'] = ((df_input['The format that you used for reading books'].isin(['E-books', 'Printed'])) & (df_output['Frequency_high'] == 1)).astype(int)
    df_output['Influenced_Self_or_Teacher'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Teachers']).astype(int)
    return df_output

