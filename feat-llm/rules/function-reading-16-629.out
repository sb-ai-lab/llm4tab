def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Frequency_of_reading_books_in_selected'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_selected'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_ebooks_read_last_two_years_in_selected'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'English', 'Pharmacy', 'EEE', 'CIS', 'MCT']).astype(int)
    df_output['Favorite_books_for_leisure_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Change_after_reading_in_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['How_to_manage_books_in_selected'] = df_input['How to manage books for reading'].isin(['Buy', 'Borrow', 'E-books']).astype(int)
    df_output['Age_in_range_20_25'] = ((df_input['Age'] >= 20) & (df_input['Age'] <= 25)).astype(int)
    return df_output