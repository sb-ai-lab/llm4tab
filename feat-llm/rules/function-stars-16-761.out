def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    sp_types_1 = ['G1V', 'F3V', 'F5V', 'A1V', 'G3/G5V', 'F0V', 'A9V', 'G3V', 'B1V:nn', 'F0V', 'A1V', 'G2V', 'K5V']
    sp_types_2 = ['A1V', 'F0V', 'G3V', 'K5V']
    df_output['SpType_in_list_1'] = df_input['SpType'].isin(sp_types_1).astype(int)
    df_output['Amag_ge_15_5'] = (df_input['Amag'] >= 15.5).astype(int)
    df_output['B_V_in_0_0_0_7'] = ((df_input['B-V'] >= 0.0) & (df_input['B-V'] <= 0.7)).astype(int)
    df_output['Plx_ge_3_0'] = (df_input['Plx'] >= 3.0).astype(int)
    df_output['Vmag_ge_5_5'] = (df_input['Vmag'] >= 5.5).astype(int)
    df_output['e_Plx_le_1_1'] = (df_input['e_Plx'] <= 1.1).astype(int)
    df_output['Amag_between_16_0_19_5'] = ((df_input['Amag'] >= 16.0) & (df_input['Amag'] <= 19.5)).astype(int)
    df_output['B_V_le_0_7'] = (df_input['B-V'] <= 0.7).astype(int)
    df_output['SpType_in_list_2'] = df_input['SpType'].isin(sp_types_2).astype(int)
    df_output['Plx_in_3_0_20_0'] = ((df_input['Plx'] >= 3.0) & (df_input['Plx'] <= 20.0)).astype(int)
    return df_output

