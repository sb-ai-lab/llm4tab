def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K1III', 'K0III', 'B7II', 'G8III', 'B1Ib/II', 'G7III', 'K2/K3III', 'A2III']).astype(int)
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16.0).astype(int)
    df_output['B-V_ge_0.9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5.0).astype(int)
    df_output['Vmag_lt_8'] = (df_input['Vmag'] < 8.0).astype(int)
    df_output['SpType_contains_III_or_II'] = df_input['SpType'].str.contains('III|II', regex=True).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.3)).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 13.0) & (df_input['Amag'] <= 16.0)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 0.5) & (df_input['Plx'] <= 5.0)).astype(int)
    df_output['Vmag_in_range'] = ((df_input['Vmag'] >= 4.0) & (df_input['Vmag'] <= 8.0)).astype(int)
    return df_output