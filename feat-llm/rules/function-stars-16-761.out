def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['Amag_gt_15'] = (df_input['Amag'] > 15).astype(int)
    df_output['Plx_gt_5'] = (df_input['Plx'] > 5).astype(int)
    df_output['B_V_lt_0_7'] = (df_input['B-V'] < 0.7).astype(int)
    df_output['Vmag_ge_5'] = (df_input['Vmag'] >= 5).astype(int)
    df_output['Amag_in_16_20'] = df_input['Amag'].between(16, 20).astype(int)
    df_output['Plx_in_5_20'] = df_input['Plx'].between(5, 20).astype(int)
    df_output['e_Plx_le_1_1'] = (df_input['e_Plx'] <= 1.1).astype(int)
    df_output['B_V_in_0_1_0_7'] = df_input['B-V'].between(0.1, 0.7).astype(int)
    exclude_classes = ['III', 'II', 'Ib', 'Ib/II', 'III/IV']
    def not_in_luminosity_classes(sptype):
        for excl in exclude_classes:
            if excl in sptype:
                return 0
        return 1
    df_output['SpType_not_in_excluded_classes'] = df_input['SpType'].apply(not_in_luminosity_classes)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_contains_III_II_Ib_Ib/II'] = df_input['SpType'].str.contains('III|II|Ib|Ib/II', regex=True).astype(int)  
    df_output['Amag_leq_16'] = (df_input['Amag'] <= 16).astype(int)  
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)  
    df_output['B-V_gt_0.7'] = (df_input['B-V'] > 0.7).astype(int)  
    df_output['Vmag_lt_9'] = (df_input['Vmag'] < 9).astype(int)  
    df_output['Amag_in_13_16'] = df_input['Amag'].between(13, 16).astype(int)  
    df_output['Plx_in_0_5'] = df_input['Plx'].between(0, 5).astype(int)  
    df_output['e_Plx_leq_1.2'] = (df_input['e_Plx'] <= 1.2).astype(int)  
    df_output['B-V_in_0.8_1.3'] = df_input['B-V'].between(0.8, 1.3).astype(int)  
    df_output['SpType_not_in_V'] = (~df_input['SpType'].str.contains('V', regex=False)).astype(int)  
    return df_output

