    df_output['Vmag_le_8.5'] = (df_input['Vmag'] <= 8.5).astype(int)
    df_output['e_Plx_le_1.2'] = (df_input['e_Plx'] <= 1.2).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 13.0) & (df_input['Amag'] <= 16.0)).astype(int)
