    df_output['Primary Type in [BATTERY, ASSAULT, CRIMINAL SEXUAL ASSAULT, ROBBERY]'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'CRIMINAL SEXUAL ASSAULT', 'ROBBERY']).astype(int)
    df_output['Description in [AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY, AGGRAVATED]'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY', 'AGGRAVATED']).astype(int)
    df_output['Location Description in [STREET, CTA BUS STOP, ALLEY]'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'ALLEY']).astype(int)
    df_output['Domestic == 1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code in [08B, 06]'] = df_input['FBI Code'].isin(['08B', '06']).astype(int)
    df_output['Year >= 2025'] = (df_input['Year'] >= 2025).astype(int)
    df_output['Date in [01/29/2025 01:41:00 AM]'] = (df_input['Date'] == '01/29/2025 01:41:00 AM').astype(int)
    df_output['Beat in range [100, 150]'] = ((df_input['Beat'] >= 100) & (df_input['Beat'] <= 150)).astype(int)
    df_output['Ward in range [1, 20]'] = ((df_input['Ward'] >= 1) & (df_input['Ward'] <= 20)).astype(int)
    df_output['Primary Type in [HOMICIDE, SEX OFFENSE]'] = df_input['Primary Type'].isin(['HOMICIDE', 'SEX OFFENSE']).astype(int)
    return df_output

