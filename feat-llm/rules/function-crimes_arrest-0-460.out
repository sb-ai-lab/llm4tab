def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'CRIMINAL SEXUAL ASSAULT', 'ROBBERY']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY', 'AGGRAVATED', 'ATTEMPT ARSON']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'ALLEY']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '04A']).astype(int)
    time_series = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce').dt.time
    night_condition = time_series.apply(lambda t: (t >= pd.to_datetime('20:00:00').time()) or (t <= pd.to_datetime('04:00:00').time()))
    df_output['Date'] = night_condition.astype(int)
    df_output['Beat'] = df_input['Beat'].between(100, 700).astype(int)
    df_output['Ward'] = df_input['Ward'].between(5, 15).astype(int)
    df_output['Year'] = (df_input['Year'] >= 2024).astype(int)
    df_output['Longitude'] = df_input['Longitude'].between(-87.65, -87.60).astype(int)
    return df_output

