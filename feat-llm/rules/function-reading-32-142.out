def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason for reading books is Academic Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount of time spent reading books per day >= 1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency of reading books is in [On everyday basis, A few times a week]'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Number of e-books you read last two years is in [6-10, 11-15, 16-20, More than 20]'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number of printed books you read last two years is in [6-10, 11-15, 16-20, More than 20]'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['What is the change that you fell after reading books is Increase Academic Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Department is in [CSE, SWE, Pharmacy, EEE, Civil, CIS, MCT]'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']).astype(int)
    df_output['Who influenced you to read books is Self-Decision'] = (df_input['Who influenced you to read books'] == 'Self-Decision').astype(int)
    df_output['The format that you used for reading books is Both'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    df_output['Favorite books for reading to spend leisure time is in [Non-Fiction, Biography]'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    return df_output

---VERSION---

