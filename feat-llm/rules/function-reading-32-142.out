    df_output['Printed_books_read_selected'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Favorite_books_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Frequency_On_everyday_basis'] = (df_input['Frequency of reading books'] == 'On everyday basis').astype(int)
    df_output['Change_after_reading_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Manage_books_selected'] = df_input['How to manage books for reading'].isin(['E-books', 'Buy', 'Used-all']).astype(int)
    df_output['Influenced_by_selected'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Academic mentors']).astype(int)
    return df_output

