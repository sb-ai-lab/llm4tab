    df_output = pd.DataFrame()
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'CIS', 'Textile']).astype(int)
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Time_spent_reading_3_or_more'] = (df_input['Amount of time spent reading books per day'] >= 3).astype(int)
