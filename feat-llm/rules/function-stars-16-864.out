    df_output['Amag_in_16_19'] = ((df_input['Amag'] >= 16) & (df_input['Amag'] <= 19)).astype(int)
    df_output['B_V_lt_1_0'] = (df_input['B-V'] < 1.0).astype(int)
    df_output['Plx_in_4_13'] = ((df_input['Plx'] >= 4) & (df_input['Plx'] <= 13)).astype(int)
