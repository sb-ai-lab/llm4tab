def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'A5V', 'A1V', 'G8V', 'B5V', 'B2IV-V', 'G6IV:']).astype(int)  
    df_output['SpType_contains_V_not_III_IV'] = df_input['SpType'].apply(lambda x: int(('V' in x) and ('III' not in x) and ('IV' not in x)))  
    df_output['Amag_gt_15'] = (df_input['Amag'] > 15).astype(int)  
    df_output['Amag_in_16_20'] = df_input['Amag'].between(16, 20).astype(int)  
    df_output['Plx_gt_4'] = (df_input['Plx'] > 4).astype(int)  
    df_output['Vmag_lt_9'] = (df_input['Vmag'] < 9).astype(int)  
    df_output['B-V_in_-0.2_0.5'] = df_input['B-V'].between(-0.2, 0.5).astype(int)  
    df_output['e_Plx_lt_1.5'] = (df_input['e_Plx'] < 1.5).astype(int)  
    df_output['Plx_in_4_13'] = df_input['Plx'].between(4, 13).astype(int)  
    df_output['B-V_lt_1.0'] = (df_input['B-V'] < 1.0).astype(int)  
    return df_output

