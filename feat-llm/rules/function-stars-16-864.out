def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K0/K1III:', 'K0III', 'K1III', 'B2III', 'G8/K0III', 'G8III', 'F3III']).astype(int)
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III', na=False).astype(int)
    df_output['Amag_less_16'] = (df_input['Amag'] < 16).astype(int)
    df_output['Amag_in_12_16'] = df_input['Amag'].between(12, 16).astype(int)
    df_output['Plx_less_4'] = (df_input['Plx'] < 4).astype(int)
    df_output['B_V_greater_0_9'] = (df_input['B-V'] > 0.9).astype(int)
    df_output['Vmag_greater_7'] = (df_input['Vmag'] > 7).astype(int)
    df_output['e_Plx_less_1_5'] = (df_input['e_Plx'] < 1.5).astype(int)
    df_output['Plx_in_0_5_3_9'] = df_input['Plx'].between(0.5, 3.9).astype(int)
    df_output['B_V_in_0_9_1_4'] = df_input['B-V'].between(0.9, 1.4).astype(int)
    return df_output

