def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['F3III', 'B2III', 'K0III', 'K1III', 'K0/K1III', 'G8III', 'G8/K0III']).astype(int)
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)
    df_output['Vmag_lt_8'] = (df_input['Vmag'] < 8).astype(int)
    df_output['Plx_lt_4'] = (df_input['Plx'] < 4).astype(int)
    df_output['B_V_ge_0_9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Amag_in_12_16'] = ((df_input['Amag'] >= 12) & (df_input['Amag'] <= 16)).astype(int)
    df_output['Vmag_lt_8_and_SpType_contains_III'] = ((df_input['Vmag'] < 8) & (df_input['SpType'].str.contains('III'))).astype(int)
    df_output['Plx_ge_1_le_4_and_SpType_contains_III'] = ((df_input['Plx'] >= 1) & (df_input['Plx'] <= 4) & (df_input['SpType'].str.contains('III'))).astype(int)
    df_output['B_V_ge_1_and_SpType_contains_III'] = ((df_input['B-V'] >= 1.0) & (df_input['SpType'].str.contains('III'))).astype(int)
    df_output['Amag_lt_15_and_B_V_ge_0_9'] = ((df_input['Amag'] < 15) & (df_input['B-V'] >= 0.9)).astype(int)
    return df_output