def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].apply(lambda x: 1 if x == 'Happy' else 0)
    df_output['Feeling_for_regular_activities'] = df_input['Feeling for regular activities'].apply(lambda x: 1 if x in ['No', 'Tired'] else 0)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].apply(lambda x: 1 if x in ['Good', 'Friendly'] else 0)
    df_output['Relationship_with_inlaws'] = df_input['Relationship with the in-laws'].apply(lambda x: 1 if x in ['Good', 'Friendly', 'Neutral'] else 0)
    df_output['Fear_of_pregnancy'] = df_input['Fear of pregnancy'].apply(lambda x: 1 if x in ['Yes', 'No'] else 0)
    df_output['Major_changes_or_losses_during_pregnancy'] = df_input['Major changes or losses during pregnancy'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Family_type'] = df_input['Family type'].apply(lambda x: 1 if x in ['Nuclear', 'Joint'] else 0)
    df_output['Residence'] = df_input['Residence'].apply(lambda x: 1 if x in ['City', 'Village'] else 0)
    df_output['Education_Level'] = df_input['Education Level'].apply(lambda x: 1 if x in ['Primary School', 'High School', 'University'] else 0)
    df_output['Occupation_After_Your_Latest_Childbirth'] = df_input['Occupation After Your Latest Childbirth'].apply(lambda x: 1 if x in ['Housewife', 'Service', 'Doctor'] else 0)
    return df_output

