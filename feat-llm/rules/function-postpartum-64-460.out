def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Major changes or losses during pregnancy'] = df_input['Major changes or losses during pregnancy'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Angry after latest child birth'] = df_input['Angry after latest child birth'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Need for Support'] = df_input['Need for Support'].apply(lambda x: 1 if x in ['Low', 'No'] else 0)
    df_output['Fear of pregnancy'] = df_input['Fear of pregnancy'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Relationship with the in-laws'] = df_input['Relationship with the in-laws'].apply(lambda x: 1 if x in ['Good', 'Neutral', 'Friendly'] else 0)
    df_output['Education Level'] = df_input['Education Level'].apply(lambda x: 1 if x in ['University', 'High School', 'College'] else 0)
    def income_check(val):
        if isinstance(val, str):
            if val == 'More than 30000':
                return 1
            try:
                val_num = int(val)
                if 10000 <= val_num <= 20000 or 20000 < val_num <= 30000:
                    return 1
            except:
                return 0
        elif isinstance(val, (int, float)):
            if 10000 <= val <= 20000 or 20000 < val <= 30000:
                return 1
        return 0
    df_output["Husband’s monthly income"] = df_input["Husband’s monthly income"].apply(income_check)
    df_output['Pregnancy length'] = df_input['Pregnancy length'].apply(lambda x: 1 if x in ['8 months', '9 months', '10 months'] else 0)
    df_output['Age'] = df_input['Age'].apply(lambda x: 1 if 22 <= x <= 33 else 0)
    df_output['Gender of newborn'] = df_input['Gender of newborn'].apply(lambda x: 1 if x in ['Boy', 'Girl'] else 0)
    return df_output

---DIVIDER---

