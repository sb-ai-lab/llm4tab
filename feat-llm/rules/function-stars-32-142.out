def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'F0V', 'F5V', 'F6V', 'A1V', 'F5/F6V']).astype(int)  
    df_output['SpType_contains_V_only'] = df_input['SpType'].apply(lambda x: ('V' in x) and all(c not in x for c in ['III', 'II', 'Ib'])).astype(int)  
    df_output['Amag_ge_17'] = (df_input['Amag'] >= 17).astype(int)  
    df_output['Plx_ge_4'] = (df_input['Plx'] >= 4).astype(int)  
    df_output['B_V_le_0_6'] = (df_input['B-V'] <= 0.6).astype(int)  
    df_output['Vmag_ge_7_5'] = (df_input['Vmag'] >= 7.5).astype(int)  
    df_output['Amag_in_17_19'] = df_input['Amag'].between(17, 19).astype(int)  
    df_output['Plx_in_5_20'] = df_input['Plx'].between(5, 20).astype(int)  
    df_output['B_V_in_0_3_0_6'] = df_input['B-V'].between(0.3, 0.6).astype(int)  
    df_output['SpType_no_giant_supergiant'] = df_input['SpType'].apply(lambda x: all(c not in x for c in ['III', 'II', 'Ib'])).astype(int)  
    return df_output

