def extracting_features_0(df_input):
    conditions = {
        'SpType_in_list': df_input['SpType'].isin(['G1V', 'F3V', 'F0V', 'F5V', 'F6V', 'A1V', 'B8V', 'B9V', 'F5/F6V', 'F3V']).astype(int),
        'Amag_gt_16_4': (df_input['Amag'] > 16.4).astype(int),
        'Amag_ge_17': (df_input['Amag'] >= 17).astype(int),
        'Plx_ge_5': (df_input['Plx'] >= 5).astype(int),
        'Plx_gt_7': (df_input['Plx'] > 7).astype(int),
        'B_V_lt_0_6': (df_input['B-V'] < 0.6).astype(int),
        'B_V_le_0_5': (df_input['B-V'] <= 0.5).astype(int),
        'Vmag_gt_7': (df_input['Vmag'] > 7).astype(int),
        'Vmag_ge_7_4': (df_input['Vmag'] >= 7.4).astype(int),
        'e_Plx_lt_1_2': (df_input['e_Plx'] < 1.2).astype(int)
    }
    df_output = df_input.copy()
    for key, val in conditions.items():
        df_output[key] = val
    return df_output[conditions.keys()]

