def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['F2III/IV', 'B1Ib/II', 'K5/M0III', 'K0III', 'G8III', 'K3III', 'K3/K4III', 'K2III:', 'B8II/III']).astype(int)  
    df_output['Amag_lt_16.5'] = (df_input['Amag'] < 16.5).astype(int)  
    df_output['Amag_le_15.7'] = (df_input['Amag'] <= 15.7).astype(int)  
    df_output['Plx_lt_4'] = (df_input['Plx'] < 4).astype(int)  
    df_output['Plx_le_3.5'] = (df_input['Plx'] <= 3.5).astype(int)  
    df_output['B-V_ge_0.85'] = (df_input['B-V'] >= 0.85).astype(int)  
    df_output['B-V_gt_1.0'] = (df_input['B-V'] > 1.0).astype(int)  
    df_output['Vmag_lt_8.5'] = (df_input['Vmag'] < 8.5).astype(int)  
    df_output['e_Plx_ge_0.7'] = (df_input['e_Plx'] >= 0.7).astype(int)  
    df_output['e_Plx_gt_0.8'] = (df_input['e_Plx'] > 0.8).astype(int)  
    return df_output