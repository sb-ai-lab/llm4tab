def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    main_sequence_types = ['G1V', 'F3V', 'F0V', 'F5V', 'F6V', 'A1V', 'B8V', 'B9V', 'F5/F6V', 'F2V']
    df_output['SpType_in_main_sequence'] = df_input['SpType'].isin(main_sequence_types).astype(int)
    df_output['Amag_ge_16.4'] = (df_input['Amag'] >= 16.4).astype(int)
    df_output['Plx_ge_4.5'] = (df_input['Plx'] >= 4.5).astype(int)
    df_output['B-V_le_0.6'] = (df_input['B-V'] <= 0.6).astype(int)
    df_output['Vmag_le_9.0'] = (df_input['Vmag'] <= 9.0).astype(int)
    df_output['e_Plx_le_1.1'] = (df_input['e_Plx'] <= 1.1).astype(int)
    df_output['SpType_no_III_II_Ib'] = (~df_input['SpType'].str.contains('III|II|Ib', regex=True)).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 16.4) & (df_input['Amag'] <= 19.0)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 4.5) & (df_input['Plx'] <= 20)).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= -0.05) & (df_input['B-V'] <= 0.6)).astype(int)
    return df_output

