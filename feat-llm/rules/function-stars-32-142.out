def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_contains_III_II_Ib'] = df_input['SpType'].str.contains('III|II|Ib', regex=True).astype(int)
    df_output['Amag_lt_17'] = (df_input['Amag'] < 17).astype(int)
    df_output['Plx_lt_4'] = (df_input['Plx'] < 4).astype(int)
    df_output['B_V_gt_0_8'] = (df_input['B-V'] > 0.8).astype(int)
    df_output['Vmag_lt_8_5'] = (df_input['Vmag'] < 8.5).astype(int)
    df_output['Amag_in_13_16_5'] = df_input['Amag'].between(13, 16.5).astype(int)
    df_output['Plx_in_0_8_4'] = df_input['Plx'].between(0.8, 4).astype(int)
    df_output['B_V_in_1_0_1_7'] = df_input['B-V'].between(1.0, 1.7).astype(int)
    sptype_list = ['K3III', 'K5/M0III', 'K3/K4III', 'G8III', 'K0III', 'K2III:']
    df_output['SpType_in_list'] = df_input['SpType'].isin(sptype_list).astype(int)
    df_output['SpType_contains_giant_classes'] = df_input['SpType'].str.contains('III|II|Ib', regex=True).astype(int)
    return df_output

