def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K3III', 'K0III', 'K2III:', 'K3/K4III', 'K5/M0III', 'G8III', 'B8II/III', 'B1Ib/II', 'F2III/IV']).astype(int)
    df_output['Amag_le_16'] = (df_input['Amag'] <= 16.0).astype(int)
    df_output['Plx_le_4'] = (df_input['Plx'] <= 4.0).astype(int)
    df_output['B-V_ge_0.85'] = (df_input['B-V'] >= 0.85).astype(int)
    df_output['Vmag_ge_6'] = (df_input['Vmag'] >= 6.0).astype(int)
    df_output['e_Plx_ge_0.7'] = (df_input['e_Plx'] >= 0.7).astype(int)
    df_output['SpType_contains_III_II_Ib'] = df_input['SpType'].str.contains('III|II|Ib', regex=True).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 13.0) & (df_input['Amag'] <= 16.0)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 0.8) & (df_input['Plx'] <= 4.0)).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 0.85) & (df_input['B-V'] <= 1.65)).astype(int)
    return df_output

