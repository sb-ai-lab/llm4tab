def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['OTHER OFFENSE', 'WEAPONS VIOLATION', 'LIQUOR LAW VIOLATION', 'MOTOR VEHICLE THEFT']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['VEHICLE TITLE / REGISTRATION OFFENSE', 'RECKLESS FIREARM DISCHARGE', 'SIMPLE', 'UNLAWFUL USE OF WEAPON']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'ALLEY']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['26', '15', '08B']).astype(int)
    df_output['Beat_in_range_and_District_in_list'] = ((df_input['Beat'] >= 300) & (df_input['Beat'] <= 3500) & (df_input['District'].isin([3,6,18]))).astype(int)
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 1) & (df_input['Ward'] <= 20)).astype(int)
    df_output['Community_Area_in_range'] = ((df_input['Community Area'] >= 40) & (df_input['Community Area'] <= 80)).astype(int)
    times = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p').dt.time
    df_output['Date_in_evening'] = times.apply(lambda x: (x >= pd.to_datetime('18:00:00').time()) and (x <= pd.to_datetime('23:59:59').time())).astype(int)
    df_output['Primary_Theft_and_Description_in_list'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'].isin(['OVER $500', '$500 AND UNDER']))).astype(int)
    return df_output

