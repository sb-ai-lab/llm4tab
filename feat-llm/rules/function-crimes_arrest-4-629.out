def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type in list'] = df_input['Primary Type'].isin(['NARCOTICS', 'CRIMINAL DAMAGE', 'BATTERY', 'ASSAULT']).astype(int)
    df_output['Description in list'] = df_input['Description'].isin(['MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'TO VEHICLE', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY']).astype(int)
    df_output['Location Description in list'] = df_input['Location Description'].isin(['APARTMENT', 'SIDEWALK', 'RESIDENCE']).astype(int)
    df_output['Domestic is 1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code in list'] = df_input['FBI Code'].isin(['14', '18', '08A']).astype(int)
    df_output['Beat in range and District in list'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2000) & df_input['District'].isin([10, 15])).astype(int)
    df_output['Ward in range'] = ((df_input['Ward'] >= 20) & (df_input['Ward'] <= 50)).astype(int)
    df_output['Community Area in range'] = ((df_input['Community Area'] >= 10) & (df_input['Community Area'] <= 40)).astype(int)
    times = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p').dt.time
    df_output['Date between 06:00 AM and 06:00 PM'] = times.apply(lambda x: 6 <= x.hour < 18).astype(int)
    cond = (df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'].str.contains('DELIVER') | df_input['Description'].str.contains('MANUFACTURE'))
    df_output['Primary Type NARCOTICS and Description contains DELIVER or MANUFACTURE'] = cond.astype(int)
    return df_output

