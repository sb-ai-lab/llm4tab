def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['Amag_gt_10'] = (df_input['Amag'] > 10).astype(int)
    df_output['Amag_in_15_20'] = df_input['Amag'].between(15, 20).astype(int)
    df_output['B-V_lt_0.3'] = (df_input['B-V'] < 0.3).astype(int)
    df_output['Vmag_gt_7'] = (df_input['Vmag'] > 7).astype(int)
    df_output['Plx_gt_5'] = (df_input['Plx'] > 5).astype(int)
    df_output['e_Plx_lt_1'] = (df_input['e_Plx'] < 1.0).astype(int)
    df_output['B-V_in_-0.2_0.5'] = df_input['B-V'].between(-0.2, 0.5).astype(int)
    df_output['Plx_in_5_15'] = df_input['Plx'].between(5, 15).astype(int)
    df_output['Vmag_in_4.5_9'] = df_input['Vmag'].between(4.5, 9).astype(int)
    return df_output

