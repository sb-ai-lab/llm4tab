def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_condition'] = df_input['SpType'].str.contains('III') | df_input['SpType'].str.contains('III/IV') | df_input['SpType'].str.contains('IV')
    df_output['SpType_condition'] = df_output['SpType_condition'].astype(int)
    df_output['Amag_less_15'] = (df_input['Amag'] < 15).astype(int)
    df_output['Amag_in_10_15'] = ((df_input['Amag'] >= 10) & (df_input['Amag'] <= 15)).astype(int)
    df_output['B_V_greater_0_5'] = (df_input['B-V'] > 0.5).astype(int)
    df_output['Vmag_less_7'] = (df_input['Vmag'] < 7).astype(int)
    df_output['Plx_less_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['e_Plx_greater_0_5'] = (df_input['e_Plx'] > 0.5).astype(int)
    df_output['B_V_in_0_5_1_5'] = ((df_input['B-V'] >= 0.5) & (df_input['B-V'] <= 1.5)).astype(int)
    df_output['Plx_in_1_5'] = ((df_input['Plx'] >= 1) & (df_input['Plx'] <= 5)).astype(int)
    df_output['Vmag_in_4_7'] = ((df_input['Vmag'] >= 4) & (df_input['Vmag'] <= 7)).astype(int)
    return df_output

