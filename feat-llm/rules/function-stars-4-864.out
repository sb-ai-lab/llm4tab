def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_III_or_III_IV'] = df_input['SpType'].str.endswith('III') | df_input['SpType'].str.endswith('III/IV')
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)
    df_output['B_V_gt_0_5'] = (df_input['B-V'] > 0.5).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['Vmag_lt_7'] = (df_input['Vmag'] < 7).astype(int)
    df_output['Amag_in_10_16'] = ((df_input['Amag'] >= 10) & (df_input['Amag'] <= 16)).astype(int)
    df_output['B_V_in_0_5_1_5'] = ((df_input['B-V'] >= 0.5) & (df_input['B-V'] <= 1.5)).astype(int)
    df_output['Plx_in_0_5'] = ((df_input['Plx'] >= 0) & (df_input['Plx'] <= 5)).astype(int)
    df_output['e_Plx_ge_0_5'] = (df_input['e_Plx'] >= 0.5).astype(int)
    df_output['Vmag_in_3_7'] = ((df_input['Vmag'] >= 3) & (df_input['Vmag'] <= 7)).astype(int)
    return df_output