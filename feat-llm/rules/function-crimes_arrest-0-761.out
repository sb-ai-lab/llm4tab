def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'ROBBERY', 'CRIM SEXUAL ASSAULT']).astype(int)  
    df_output['Description_in_list'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, SERIOUS INJURY', 'AGGRAVATED BATTERY']).astype(int)  
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'CTA BUS STOP', 'ALLEY']).astype(int)  
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)  
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['08B', '04A', '03']).astype(int)  
    df_output['Primary_Type_THEFT_and_Description_OVER_500'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'OVER $500')).astype(int)  
    df_output['Beat_in_range'] = ((df_input['Beat'] >= 200) & (df_input['Beat'] <= 300)).astype(int)  
    df_output['District_in_range'] = ((df_input['District'] >= 1) & (df_input['District'] <= 10)).astype(int)  
    df_output['Ward_in_range'] = ((df_input['Ward'] >= 10) & (df_input['Ward'] <= 20)).astype(int)  
    df_output['Date_in_list'] = df_input['Date'].isin(['01/04/2025 10:00:00 PM', '01/10/2025 11:00:00 PM']).astype(int)  
    return df_output

