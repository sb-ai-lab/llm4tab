def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_1'] = df_input['SpType'].isin(['G8III', 'K3III', 'B9III/IV', 'K0III', 'M0III']).astype(int)
    df_output['Amag_lt_2'] = (df_input['Amag'] < 2.0).astype(int)
    df_output['Amag_le_1_5'] = (df_input['Amag'] <= 1.5).astype(int)
    df_output['B_V_gt_1'] = (df_input['B-V'] > 1.0).astype(int)
    df_output['B_V_in_range'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.8)).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5.0).astype(int)
    df_output['Vmag_lt_6_and_Amag_lt_2'] = ((df_input['Vmag'] < 6.0) & (df_input['Amag'] < 2.0)).astype(int)
    df_output['SpType_in_2'] = df_input['SpType'].isin(['K1III', 'G5III', 'M2III']).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= -2.0) & (df_input['Amag'] <= 2.0)).astype(int)
    df_output['B_V_gt_0_8_and_Amag_lt_2_5'] = ((df_input['B-V'] > 0.8) & (df_input['Amag'] < 2.5)).astype(int)
    return df_output

