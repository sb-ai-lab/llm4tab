def extracting_features_0(df_input):
    conditions = {
        'SpType_in_G1V_F3V_K5V_B8V_B9V': df_input['SpType'].isin(['G1V', 'F3V', 'K5V', 'B8V', 'B9V']).astype(int),
        'Amag_gt_3.0': (df_input['Amag'] > 3.0).astype(int),
        'Amag_gte_4.0': (df_input['Amag'] >= 4.0).astype(int),
        'B_V_lt_0.6': (df_input['B-V'] < 0.6).astype(int),
        'B_V_in_0.0_0.8': ((df_input['B-V'] >= 0.0) & (df_input['B-V'] <= 0.8)).astype(int),
        'Plx_gte_10': (df_input['Plx'] >= 10).astype(int),
        'Vmag_gt_8.0': (df_input['Vmag'] > 8.0).astype(int),
        'SpType_in_A0V_F5V_G0V': df_input['SpType'].isin(['A0V', 'F5V', 'G0V']).astype(int),
        'Amag_in_4.0_10.0': ((df_input['Amag'] >= 4.0) & (df_input['Amag'] <= 10.0)).astype(int),
        'Plx_gt_5.0_and_Amag_gt_3.0': ((df_input['Plx'] > 5.0) & (df_input['Amag'] > 3.0)).astype(int)
    }
    df_output = pd.DataFrame(conditions)
    return df_output

