    df_output['PrimaryType_THEFT_Description_$500_AND_UNDER'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == '$500 AND UNDER')).astype(int)  
  
    df_output['PrimaryType_THEFT_Description_RETAIL_THEFT_LocationDescription_SMALL_RETAIL_STORE'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT') & (df_input['Location Description'] == 'SMALL RETAIL STORE')).astype(int)  
  
    df_output['PrimaryType_CRIMINAL_DAMAGE_Description_TO_VEHICLE_TO_PROPERTY'] = ((df_input['Primary Type'] == 'CRIMINAL DAMAGE') & (df_input['Description'].isin(['TO VEHICLE', 'TO PROPERTY']))).astype(int)  
  
    df_output['PrimaryType_BURGLARY_Description_FORCIBLE_ENTRY'] = ((df_input['Primary Type'] == 'BURGLARY') & (df_input['Description'] == 'FORCIBLE ENTRY')).astype(int)  
  
    df_output['PrimaryType_BATTERY_Description_SIMPLE_LocationDescription_SIDEWALK_SCHOOL_PUBLIC_BUILDING'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'SIMPLE') & (df_input['Location Description'].isin(['SIDEWALK', 'SCHOOL - PUBLIC BUILDING']))).astype(int)  
  
    df_output['PrimaryType_BATTERY_Description_DOMESTIC_BATTERY_SIMPLE_Domestic_1_no_arrest'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'DOMESTIC BATTERY SIMPLE') & (df_input['Domestic'] == 1) & (df_input.get('Arrest', pd.Series(0, index=df_input.index)) == 0)).astype(int)  
  
    df_output['FBI_Code_08B_PrimaryType_BATTERY_Domestic_0'] = ((df_input['FBI Code'] == '08B') & (df_input['Primary Type'] == 'BATTERY') & (df_input['Domestic'] == 0)).astype(int)  
  
    df_output['LocationDescription_STREET_SIDEWALK_PrimaryType_THEFT_BATTERY_no_arrest'] = ((df_input['Location Description'].isin(['STREET', 'SIDEWALK'])) & (df_input['Primary Type'].isin(['THEFT', 'BATTERY'])) & (df_input.get('Arrest', pd.Series(0, index=df_input.index)) == 0)).astype(int)  
  
    df_output['Year_2025_PrimaryType_THEFT_CRIMINAL_DAMAGE_BATTERY_Description_SIMPLE_or_$500_AND_UNDER'] = ((df_input['Year'] == 2025) & (df_input['Primary Type'].isin(['THEFT', 'CRIMINAL DAMAGE', 'BATTERY'])) & (df_input['Description'].isin(['SIMPLE', '$500 AND UNDER']))).astype(int)  
  
    return df_output

