def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['Primary Type'] == 'WEAPONS VIOLATION') & 
                           (df_input['Description'] == 'UNLAWFUL POSSESSION - HANDGUN')).astype(int)
    df_output['cond_2'] = ((df_input['Primary Type'] == 'NARCOTICS') & 
                           (df_input['Description'].str.contains('POSSESS|FOUND SUSPECT NARCOTICS', na=False))).astype(int)
    df_output['cond_3'] = ((df_input['Primary Type'] == 'BATTERY') & 
                           (df_input['Description'] == 'DOMESTIC BATTERY SIMPLE') & 
                           (df_input['Domestic'] == 1)).astype(int)
    df_output['cond_4'] = ((df_input['Primary Type'] == 'CRIMINAL TRESPASS') & 
                           (df_input['Description'] == 'TO LAND')).astype(int)
    df_output['cond_5'] = ((df_input['Primary Type'] == 'CONCEALED CARRY LICENSE VIOLATION') & 
                           (df_input['Description'] == 'PROHIBITED PLACES')).astype(int)
    df_output['cond_6'] = (df_input['FBI Code'].isin(['15', '18', '26'])).astype(int)
    df_output['cond_7'] = ((df_input['Location Description'].isin(['RESIDENCE', 'APARTMENT', 'AIRPORT TERMINAL UPPER LEVEL - SECURE AREA'])) & 
                           (df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'NARCOTICS', 'CONCEALED CARRY LICENSE VIOLATION']))).astype(int)
    df_output['cond_8'] = ((df_input['Primary Type'] == 'THEFT') & 
                           (df_input['Description'] == 'RETAIL THEFT') & 
                           (df_input['Location Description'].isin(['DEPARTMENT STORE', 'SMALL RETAIL STORE'])) & 
                           (df_input.get('Arrest', pd.Series(0, index=df_input.index)) == 1)).astype(int)
    df_output['cond_9'] = ((df_input['Primary Type'] == 'NARCOTICS') & 
                           (df_input['Description'] == 'POSSESS - HEROIN (WHITE)')).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/09/2025 05:00:00 PM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:00:00 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['cond_10'] = ((df_input['Date_parsed'] >= start_date) & 
                            (df_input['Date_parsed'] <= end_date) & 
                            (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'CRIMINAL TRESPASS'])) & 
                            (df_input.get('Arrest', pd.Series(0, index=df_input.index)) == 1)).astype(int)
    df_output.drop(columns=['Date_parsed'], inplace=True)
    return df_output

