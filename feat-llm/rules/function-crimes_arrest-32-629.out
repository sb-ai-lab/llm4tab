def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'NARCOTICS']).astype(int)
    df_output['Description'] = df_input['Description'].isin([
        'SIMPLE', 'DOMESTIC BATTERY SIMPLE', 'FOUND SUSPECT NARCOTICS',
        'POSSESS - CANNABIS 30 GRAMS OR LESS', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS',
        'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY'
    ]).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '18']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin([
        'APARTMENT', 'RESTAURANT', 'STREET', 'TAVERN / LIQUOR STORE',
        'VEHICLE NON-COMMERCIAL', 'ALLEY'
    ]).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1300) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District'] = ((df_input['District'] >= 1) & (df_input['District'] <= 19)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 3) & (df_input['Ward'] <= 44)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 6) & (df_input['Community Area'] <= 43)).astype(int)
    dt = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    df_output['Date'] = dt.dt.hour.between(18, 23).astype(int)
    return df_output

