def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['BATTERY', 'NARCOTICS', 'THEFT']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin([
        'SIMPLE',
        'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY',
        'AGGRAVATED - HANDGUN',
        'DOMESTIC BATTERY SIMPLE',
        'RETAIL THEFT',
        'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS',
        'FOUND SUSPECT NARCOTICS',
        'POSSESS - CANNABIS 30 GRAMS OR LESS'
    ]).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin([
        'STREET',
        'TAVERN / LIQUOR STORE',
        'RESTAURANT',
        'APARTMENT',
        'DEPARTMENT STORE'
    ]).astype(int)
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['08B', '04B', '18']).astype(int)
    df_output['Primary_NARCOTICS_Description_MANUFACTURE'] = (
        (df_input['Primary Type'] == 'NARCOTICS') &
        (df_input['Description'] == 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS')
    ).astype(int)
    df_output['Primary_BATTERY_Description_SIMPLE_Location_STREET'] = (
        (df_input['Primary Type'] == 'BATTERY') &
        (df_input['Description'] == 'SIMPLE') &
        (df_input['Location Description'] == 'STREET')
    ).astype(int)
    df_output['Primary_BATTERY_Description_AGGRAVATED_P_O_Hands_Location_ALLEY'] = (
        (df_input['Primary Type'] == 'BATTERY') &
        (df_input['Description'] == 'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY') &
        (df_input['Location Description'] == 'ALLEY')
    ).astype(int)
    df_output['Primary_THEFT_Description_RETAIL_Location_DEPARTMENT_STORE'] = (
        (df_input['Primary Type'] == 'THEFT') &
        (df_input['Description'] == 'RETAIL THEFT') &
        (df_input['Location Description'] == 'DEPARTMENT STORE')
    ).astype(int)
    df_output['Primary_BATTERY_Description_DOMESTIC_BATTERY_SIMPLE_Domestic_1'] = (
        (df_input['Primary Type'] == 'BATTERY') &
        (df_input['Description'] == 'DOMESTIC BATTERY SIMPLE') &
        (df_input['Domestic'] == 1)
    ).astype(int)
    return df_output