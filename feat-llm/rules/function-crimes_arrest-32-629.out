def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'NARCOTICS', 'THEFT']).astype(int)
    df_output['Description'] = df_input['Description'].isin([
        'SIMPLE', 'RETAIL THEFT', 'DOMESTIC BATTERY SIMPLE', 'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY',
        'AGGRAVATED - HANDGUN', 'FOUND SUSPECT NARCOTICS', 'POSSESS - CANNABIS 30 GRAMS OR LESS',
        'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS'
    ]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '18', '06']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin([
        'STREET', 'APARTMENT', 'DEPARTMENT STORE', 'TAVERN / LIQUOR STORE',
        'VEHICLE NON-COMMERCIAL', 'ALLEY', 'RESTAURANT', 'SIDEWALK'
    ]).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2500)).astype(int)
    df_output['District'] = ((df_input['District'] >= 1) & (df_input['District'] <= 24)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 3) & (df_input['Ward'] <= 49)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 43)).astype(int)
    dt = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    df_output['Date'] = dt.dt.hour.isin([0,1,2,3,4,5]).astype(int)
    return df_output

