    df_output['Primary_NARCOTICS_and_Description_POSSESS_CANNABIS'] = ((df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'] == 'POSSESS - CANNABIS 30 GRAMS OR LESS')).astype(int)
    df_output['Primary_BATTERY_and_Description_AGGRAVATED_PO'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY')).astype(int)
