def extracting_features_0(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'MOTOR VEHICLE THEFT', 'CRIMINAL TRESPASS', 'CRIMINAL DAMAGE', 'LIQUOR LAW VIOLATION']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['$500 AND UNDER', 'TO RESIDENCE', 'TO PROPERTY', 'AUTOMOBILE']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '07', '14', '22', '26']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'OTHER (SPECIFY)', 'RESIDENCE - PORCH / HALLWAY', 'ALLEY']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 200) & (df_input['Beat'] <= 900)).astype(int)
    df_output['District'] = ((df_input['District'] >= 2) & (df_input['District'] <= 10)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 4) & (df_input['Ward'] <= 27)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 1) & (df_input['Community Area'] <= 69)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    date_in_range = (df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)
    hour = df_input['Date'].dt.hour
    not_late_night = ~((hour >= 22) | (hour < 4))
    df_output['Date'] = (date_in_range & not_late_night).astype(int)
    return df_output

