def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'CRIMINAL DAMAGE', 'CRIMINAL TRESPASS', 'MOTOR VEHICLE THEFT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['OVER $500', 'TO PROPERTY', 'TO RESIDENCE', '$500 AND UNDER']).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '07', '14', '26']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['RESTAURANT', 'ALLEY', 'APARTMENT', 'STREET', 'RESIDENCE - PORCH / HALLWAY', 'OTHER (SPECIFY)']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 800) & (df_input['Beat'] <= 1900)).astype(int)
    df_output['District'] = ((df_input['District'] >= 8) & (df_input['District'] <= 18)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 13) & (df_input['Ward'] <= 39)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 62)).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    date_condition = (date_parsed >= pd.Timestamp('2025-01-01 00:00:00')) & (date_parsed <= pd.Timestamp('2025-01-29 23:59:59'))
    time_condition = (date_parsed.dt.hour >= 6) & (date_parsed.dt.hour <= 23)
    df_output['Date'] = (date_condition & time_condition).astype(int)
    return df_output

