    df_output['Debt'] = (df_input['Debt'] <= 1000).astype(int)
    df_output['Overdue days'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] >= 5000).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 3000).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2']).astype(int)
