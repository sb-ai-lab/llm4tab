def extracting_features_0(df_input):
    import pandas as pd
    df_output = pd.DataFrame(index=df_input.index)
    df_output['Primary_Type_CRIMINAL_DAMAGE'] = (df_input['Primary Type'] == 'CRIMINAL DAMAGE').astype(int)
    df_output['Primary_Type_THEFT_Description_500_AND_UNDER_or_THEFT_OF_LOST'] = (
        (df_input['Primary Type'] == 'THEFT') & 
        (df_input['Description'].isin(['$500 AND UNDER', 'THEFT OF LOST / MISLAID PROPERTY']))
    ).astype(int)
    df_output['Primary_Type_BATTERY_Description_DOMESTIC_BATTERY_SIMPLE_Domestic_1'] = (
        (df_input['Primary Type'] == 'BATTERY') & 
        (df_input['Description'] == 'DOMESTIC BATTERY SIMPLE') & 
        (df_input['Domestic'] == 1)
    ).astype(int)
    df_output['Primary_Type_BURGLARY'] = (df_input['Primary Type'] == 'BURGLARY').astype(int)
    df_output['Primary_Type_MOTOR_VEHICLE_THEFT'] = (df_input['Primary Type'] == 'MOTOR VEHICLE THEFT').astype(int)
    df_output['Primary_Type_BATTERY_Description_AGGRAVATED_HANDGUN_Location_VEHICLE_NON_COMMERCIAL'] = (
        (df_input['Primary Type'] == 'BATTERY') & 
        (df_input['Description'] == 'AGGRAVATED - HANDGUN') & 
        (df_input['Location Description'] == 'VEHICLE NON-COMMERCIAL')
    ).astype(int)
    df_output['FBI_Code_14'] = (df_input['FBI Code'] == '14').astype(int)
    df_output['Location_Description_in_ALLEY_RESIDENCE_PORCH_HALLWAY_RESIDENCE_GARAGE'] = (
        df_input['Location Description'].isin(['ALLEY', 'RESIDENCE - PORCH / HALLWAY', 'RESIDENCE - GARAGE'])
    ).astype(int)
    df_output['Domestic_1_and_Primary_Type_BATTERY'] = (
        (df_input['Domestic'] == 1) & (df_input['Primary Type'] == 'BATTERY')
    ).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025')
    end_date = pd.to_datetime('01/29/2025')
    df_output['Date_in_range_and_Primary_Type_CRIMINAL_DAMAGE_and_Description_TO_PROPERTY'] = (
        (df_input['Date_parsed'] >= start_date) & 
        (df_input['Date_parsed'] <= end_date) & 
        (df_input['Primary Type'] == 'CRIMINAL DAMAGE') & 
        (df_input['Description'] == 'TO PROPERTY')
    ).astype(int)
    df_output = df_output.drop(columns=['Date_parsed'], errors='ignore')
    return df_output

