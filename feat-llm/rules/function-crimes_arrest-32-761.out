def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'CRIMINAL DAMAGE', 'BATTERY', 'BURGLARY', 'MOTOR VEHICLE THEFT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['SIMPLE', '$500 AND UNDER', 'TO PROPERTY', 'FORCIBLE ENTRY', 'AGGRAVATED - HANDGUN', 'DOMESTIC BATTERY SIMPLE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['RESIDENCE - PORCH / HALLWAY', 'ALLEY', 'APARTMENT', 'RESIDENCE - GARAGE', 'STREET']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '14', '08B', '05', '07']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 1800)).astype(int)
    df_output['District'] = ((df_input['District'] >= 10) & (df_input['District'] <= 17)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 20) & (df_input['Ward'] <= 40)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 10) & (df_input['Community Area'] <= 40)).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)).astype(int)
    return df_output

