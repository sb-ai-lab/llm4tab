def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_WeaponsViolation_Description_UnlawfulPossessionHandgun'] = ((df_input['Primary Type'] == 'WEAPONS VIOLATION') & (df_input['Description'] == 'UNLAWFUL POSSESSION - HANDGUN')).astype(int)
    df_output['Primary_Narcotics'] = (df_input['Primary Type'] == 'NARCOTICS').astype(int)
    df_output['Primary_Assault_Description_Simple'] = ((df_input['Primary Type'] == 'ASSAULT') & (df_input['Description'] == 'SIMPLE')).astype(int)
    df_output['Primary_DeceptivePractice_Description_TheftLostMislaid'] = ((df_input['Primary Type'] == 'DECEPTIVE PRACTICE') & (df_input['Description'] == 'THEFT OF LOST / MISLAID PROPERTY')).astype(int)
    df_output['Primary_Theft_Description_RetailTheft'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT')).astype(int)
    df_output['Primary_LiquorLawViolation'] = (df_input['Primary Type'] == 'LIQUOR LAW VIOLATION').astype(int)
    df_output['FBI_Code_Selected'] = df_input['FBI Code'].isin(['15', '18', '08A', '11', '22']).astype(int)
    df_output['LocationDescription_Selected'] = df_input['Location Description'].isin(['STREET', 'DEPARTMENT STORE', 'SIDEWALK', 'BAR OR TAVERN']).astype(int)
    df_output['Domestic0_Primary_WeaponsViolation'] = ((df_input['Domestic'] == 0) & (df_input['Primary Type'] == 'WEAPONS VIOLATION')).astype(int)
    df_output['BeatRange_Primary_Narcotics'] = ((df_input['Beat'] >= 300) & (df_input['Beat'] <= 1700) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)
    return df_output