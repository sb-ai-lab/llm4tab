def extracting_features_1(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT (retail)', 'NARCOTICS', 'WEAPONS VIOLATION', 'ASSAULT', 'LIQUOR LAW VIOLATION', 'DECEPTIVE PRACTICE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['RETAIL THEFT', 'POSSESS - PCP', 'UNLAWFUL POSSESSION - HANDGUN', 'MANUFACTURE / DELIVER - COCAINE', 'SIMPLE (assault)', 'LIQUOR LICENSE VIOLATION', 'THEFT OF LOST / MISLAID PROPERTY']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['DEPARTMENT STORE', 'STREET', 'SIDEWALK', 'BAR OR TAVERN', 'RESIDENCE - YARD (FRONT / BACK)']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '18', '15', '08A', '22', '11']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 300) & (df_input['Beat'] <= 1700)).astype(int)
    df_output['District'] = df_input['District'].isin([3, 4, 9, 11, 14, 16, 24]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([1, 5, 10, 15, 20, 38, 49]).astype(int)
    df_output['Community Area'] = df_input['Community Area'].isin([1, 22, 25, 38, 42, 46, 61, 69, 76]).astype(int)
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/21/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date)).astype(int)
    return df_output

