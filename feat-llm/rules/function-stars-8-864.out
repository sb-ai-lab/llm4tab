def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K1III', 'K0III', 'G8III', 'F3III']).astype(int)
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III', na=False).astype(int)
    df_output['Amag_le_16'] = (df_input['Amag'] <= 16).astype(int)
    df_output['B-V_ge_1'] = (df_input['B-V'] >= 1.0).astype(int)
    df_output['Plx_le_4'] = (df_input['Plx'] <= 4).astype(int)
    df_output['Vmag_le_8'] = (df_input['Vmag'] <= 8).astype(int)
    df_output['Amag_in_13_16'] = ((df_input['Amag'] >= 13) & (df_input['Amag'] <= 16)).astype(int)
    df_output['B-V_in_1_1.5'] = ((df_input['B-V'] >= 1.0) & (df_input['B-V'] <= 1.5)).astype(int)
    df_output['Plx_in_1_4'] = ((df_input['Plx'] >= 1) & (df_input['Plx'] <= 4)).astype(int)
    df_output['e_Plx_ge_0.8'] = (df_input['e_Plx'] >= 0.8).astype(int)
    return df_output