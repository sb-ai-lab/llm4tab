def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'B5V', 'G3V', 'B2IV-V', 'F0IV']).astype(int)
    df_output['Amag_gt_15'] = (df_input['Amag'] > 15).astype(int)
    df_output['B_V_lt_0_5'] = (df_input['B-V'] < 0.5).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)
    df_output['Vmag_ge_6'] = (df_input['Vmag'] >= 6).astype(int)
    df_output['e_Plx_le_1'] = (df_input['e_Plx'] <= 1.0).astype(int)
    df_output['Amag_in_16_20'] = df_input['Amag'].between(16, 20).astype(int)
    df_output['SpType_contains_V_only'] = df_input['SpType'].apply(lambda x: ('V' in x) and ('III' not in x) and ('IV' not in x)).astype(int)
    df_output['B_V_in_range'] = df_input['B-V'].between(-0.2, 0.5).astype(int)
    df_output['Plx_in_range'] = df_input['Plx'].between(5, 15).astype(int)
    return df_output

