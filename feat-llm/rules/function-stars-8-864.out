def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['F3III', 'K1III', 'G8III', 'K0III']).astype(int)  
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III', na=False).astype(int)  
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)  
    df_output['B-V_ge_1'] = (df_input['B-V'] >= 1.0).astype(int)  
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)  
    df_output['Vmag_in_range'] = ((df_input['Vmag'] >= 4.5) & (df_input['Vmag'] <= 8.0)).astype(int)  
    df_output['e_Plx_ge_0.7'] = (df_input['e_Plx'] >= 0.7).astype(int)  
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 1.0) & (df_input['B-V'] <= 1.4)).astype(int)  
    df_output['Amag_in_range_and_SpType_III'] = (((df_input['Amag'] >= 13) & (df_input['Amag'] <= 16)) & df_input['SpType'].str.contains('III', na=False)).astype(int)  
    df_output['Plx_in_range_and_SpType_III'] = (((df_input['Plx'] >= 2) & (df_input['Plx'] <= 4)) & df_input['SpType'].str.contains('III', na=False)).astype(int)  
    return df_output

