def extracting_features_0(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    sp = df_input['SpType'].astype(str)
    cond1 = sp.str.contains('V') & ~sp.str.contains('III') & ~sp.str.contains('IV') & ~sp.str.contains('IV-V')
    cond2 = sp.str.contains('IV-V')
    df_output['SpType_V_not_III_IV'] = cond1.astype(int)
    df_output['SpType_IV_V'] = cond2.astype(int)
    df_output['Amag_ge_12_5'] = (df_input['Amag'] >= 12.5).astype(int)
    df_output['B_V_le_0_4'] = (df_input['B-V'] <= 0.4).astype(int)
    df_output['Plx_ge_9_0'] = (df_input['Plx'] >= 9.0).astype(int)
    df_output['Vmag_between_4_7_8_2'] = ((df_input['Vmag'] >= 4.7) & (df_input['Vmag'] <= 8.2)).astype(int)
    df_output['e_Plx_le_1_1'] = (df_input['e_Plx'] <= 1.1).astype(int)
    df_output['B_V_between_-0_1_0_4'] = ((df_input['B-V'] >= -0.1) & (df_input['B-V'] <= 0.4)).astype(int)
    df_output['Plx_between_9_0_13_0'] = ((df_input['Plx'] >= 9.0) & (df_input['Plx'] <= 13.0)).astype(int)
    df_output['Amag_between_12_5_19_0'] = ((df_input['Amag'] >= 12.5) & (df_input['Amag'] <= 19.0)).astype(int)
    return df_output

