def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'B5V', 'G3V', 'B2IV-V', 'F0IV']).astype(int)
    df_output['SpType_main_sequence'] = ((df_input['SpType'].str.contains('V')) & 
                                        (~df_input['SpType'].str.contains('III')) & 
                                        (~df_input['SpType'].str.contains('IV'))).astype(int)
    df_output['Amag_gt_16'] = (df_input['Amag'] > 16).astype(int)
    df_output['B_V_lt_0_5'] = (df_input['B-V'] < 0.5).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)
    df_output['Vmag_between_4_5_and_8_5'] = ((df_input['Vmag'] >= 4.5) & (df_input['Vmag'] <= 8.5)).astype(int)
    df_output['e_Plx_le_1'] = (df_input['e_Plx'] <= 1.0).astype(int)
    df_output['B_V_in_range'] = ((df_input['B-V'] >= -0.2) & (df_input['B-V'] <= 0.5)).astype(int)
    df_output['Amag_in_range_and_SpType'] = (((df_input['Amag'] >= 12) & (df_input['Amag'] <= 20)) & 
                                            (df_input['SpType'].str.contains('V') | df_input['SpType'].str.contains('IV-V'))).astype(int)
    df_output['Plx_in_range_and_SpType'] = (((df_input['Plx'] >= 5) & (df_input['Plx'] <= 15)) & 
                                           (~df_input['SpType'].str.contains('III'))).astype(int)
    return df_output

