    df_output['B-V_in_1_0_1_4'] = ((df_input['B-V'] >= 1.0) & (df_input['B-V'] <= 1.4)).astype(int)
    df_output['Plx_in_2_0_4_0'] = ((df_input['Plx'] >= 2.0) & (df_input['Plx'] <= 4.0)).astype(int)
