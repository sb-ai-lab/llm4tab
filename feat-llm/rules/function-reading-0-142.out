def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Department'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'Textile', 'MCT', 'CIS']).astype(int)
    df_output['Reason for reading books'] = df_input['Reason for reading books'].isin(['Academic Purpose']).astype(int)
    df_output['Frequency of reading books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Amount of time spent reading books per day'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number of e-books you read last two years'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20']).astype(int)
    df_output['Number of printed books you read last two years'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['What is the change that you fell after reading books'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Who influenced you to read books'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    df_output['The format that you used for reading books'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Where do you read printed books'] = df_input['Where do you read printed books'].isin(['Library', 'Home']).astype(int)
    return df_output

