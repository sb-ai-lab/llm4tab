def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_Academic_Purpose'] = df_input['Reason for reading books'].isin(['Academic Purpose']).astype(int)
    df_output['Frequency_of_reading_books_Frequent'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Department_Selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'Textile', 'MCT', 'CIS']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_2_or_more'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Number_of_printed_books_last_two_years_High'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Number_of_ebooks_last_two_years_High'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Change_after_reading_Increase_Academic_or_Problem_Solving'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Format_used_Both_or_Ebooks'] = df_input['The format that you used for reading books'].isin(['Both', 'E-books']).astype(int)
    df_output['Language_books_English'] = df_input['Which language books do you like to read'].isin(['English']).astype(int)
    df_output['Where_read_printed_books_Library_or_Home'] = df_input['Where do you read printed books'].isin(['Library', 'Home']).astype(int)
    return df_output

