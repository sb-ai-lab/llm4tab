def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Monthly', 'Never']).astype(int)  
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.strip().str.title().isin(['Large Events', 'Never']).astype(int)  
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.strip().str.capitalize() == 'Loyalty'  
    df_output['valued_friendship_traits'] = df_output['valued_friendship_traits'].astype(int)  
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.strip().str.title().isin(['Avoid Conflict', 'Let Time Fix It']).astype(int)  
    df_output['family_support_level'] = df_input['family_support_level'].str.strip().str.capitalize().isin(['No', 'Never']).astype(int)  
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.strip().str.title() == 'Talking To Someone'  
    df_output['social_battery_recharge'] = df_output['social_battery_recharge'].astype(int)  
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Not Sure', 'Introvert']).astype(int)  
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Neutral', 'Avoid It']).astype(int)  
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.strip().str.title().isin(['Express Emotion Strongly', 'Stay Silent']).astype(int)  
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.strip().str.title() == 'Being Interrupted'  
    df_output['primary_anger_sources'] = df_output['primary_anger_sources'].astype(int)  
    return df_output

