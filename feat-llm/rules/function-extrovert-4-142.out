def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_monthly_or_never'] = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never']).astype(int)
    df_output['gathering_size_preference_large_or_never'] = df_input['gathering_size_preference'].str.lower().isin(['large events', 'never']).astype(int)
    cond_valued_traits = df_input['valued_friendship_traits'].str.lower().isin(['loyalty', 'honesty'])
    cond_social_freq = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never'])
    df_output['valued_friendship_traits_loyalty_honesty_and_social_freq_monthly_or_less'] = (cond_valued_traits & cond_social_freq).astype(int)
    df_output['conflict_resolution_style_avoid_or_let_time'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)
    df_output['family_support_level_no_or_never'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)
    df_output['social_battery_recharge_alone_social_none'] = df_input['social_battery_recharge'].str.lower().isin(['alone time', 'social media', 'none of the above']).astype(int)
    df_output['social_orientation_type_introvert_or_not_sure'] = df_input['social_orientation_type'].str.lower().isin(['introvert', 'not sure']).astype(int)
    df_output['social_anxiety_level_avoid_or_nervous'] = df_input['social_anxiety_level'].str.lower().isin(['avoid it', 'nervous']).astype(int)
    df_output['emotional_expression_method_silent_or_other'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    cond_social_weekly = df_input['social_connection_frequency'].str.lower() == 'weekly'
    cond_conflict_avoid = df_input['conflict_resolution_style'].str.lower() == 'avoid conflict'
    cond_family_no = df_input['family_support_level'].str.lower() == 'no'
    df_output['social_weekly_and_conflict_avoid_and_family_no'] = (cond_social_weekly & cond_conflict_avoid & cond_family_no).astype(int)
    return df_output

