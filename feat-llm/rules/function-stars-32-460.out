def extracting_features_0(df_input):
    import pandas as pd
    def suffix_V_only(sptype):
        if isinstance(sptype, str):
            parts = sptype.split('/')
            for part in parts:
                if not part.endswith('V'):
                    return 0
            return 1
        return 0

    def suffix_IV_V_like(sptype):
        if isinstance(sptype, str):
            if '/' in sptype:
                suffixes = sptype.split('/')[-1]
                if 'IV' in suffixes or 'V' in suffixes:
                    return 1
            return 0
        return 0

    df_output = pd.DataFrame()
    df_output['SpType_V_only'] = df_input['SpType'].apply(suffix_V_only)
    df_output['SpType_IV_V_like'] = df_input['SpType'].apply(suffix_IV_V_like)
    df_output['Amag_ge_17'] = (df_input['Amag'] >= 17).astype(int)
    df_output['Amag_in_17_21'] = ((df_input['Amag'] >= 17) & (df_input['Amag'] <= 21)).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)
    df_output['B_V_in_0_0_8'] = ((df_input['B-V'] >= 0) & (df_input['B-V'] <= 0.8)).astype(int)
    df_output['Vmag_ge_7'] = (df_input['Vmag'] >= 7).astype(int)
    df_output['e_Plx_le_1_5'] = (df_input['e_Plx'] <= 1.5).astype(int)
    df_output['B_V_le_0_7'] = (df_input['B-V'] <= 0.7).astype(int)
    df_output['Plx_in_5_20'] = ((df_input['Plx'] >= 5) & (df_input['Plx'] <= 20)).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):  
    import pandas as pd  
    df_output = pd.DataFrame()  
    df_output['SpType_III'] = df_input['SpType'].str.contains(r'III(\+|/IV|)?$', regex=True).astype(int)  
    df_output['Amag_lt_17'] = (df_input['Amag'] < 17).astype(int)  
    df_output['Amag_11_16_7'] = df_input['Amag'].between(11, 16.7).astype(int)  
    df_output['Plx_le_9_5'] = (df_input['Plx'] <= 9.5).astype(int)  
    df_output['B-V_ge_1_0'] = (df_input['B-V'] >= 1.0).astype(int)  
    df_output['B-V_1_0_1_5'] = df_input['B-V'].between(1.0, 1.5).astype(int)  
    df_output['Vmag_le_8_9'] = (df_input['Vmag'] <= 8.9).astype(int)  
    df_output['e_Plx_le_1_5'] = (df_input['e_Plx'] <= 1.5).astype(int)  
    df_output['Plx_0_7_9_5'] = df_input['Plx'].between(0.7, 9.5).astype(int)  
    df_output['B-V_ge_0_1'] = (df_input['B-V'] >= 0.1).astype(int)  
    return df_output

