def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_1'] = df_input['SpType'].isin(['G1V', 'F3V', 'F5V', 'G6V', 'G8V', 'A0V', 'B5V', 'K5V', 'B8/B9V', 'G6/G8IV/V']).astype(int)
    df_output['Amag_ge_16'] = (df_input['Amag'] >= 16).astype(int)
    df_output['B-V_le_0.82'] = (df_input['B-V'] <= 0.82).astype(int)
    df_output['Plx_ge_2'] = (df_input['Plx'] >= 2).astype(int)
    df_output['Vmag_ge_7'] = (df_input['Vmag'] >= 7).astype(int)
    df_output['e_Plx_le_1.2'] = (df_input['e_Plx'] <= 1.2).astype(int)
    df_output['SpType_in_2'] = df_input['SpType'].isin(['A0V', 'B5V', 'G8V']).astype(int)
    df_output['Amag_in_16_20'] = ((df_input['Amag'] >= 16) & (df_input['Amag'] <= 20)).astype(int)
    df_output['B-V_in_0_0.8'] = ((df_input['B-V'] >= 0.0) & (df_input['B-V'] <= 0.8)).astype(int)
    df_output['Plx_in_2_15'] = ((df_input['Plx'] >= 2) & (df_input['Plx'] <= 15)).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_1'] = df_input['SpType'].isin(['K1/K2III+', 'B3III', 'A3III', 'K2III', 'F3III', 'K0III', 'K3III', 'G8III']).astype(int)
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)
    df_output['B-V_ge_0.7'] = (df_input['B-V'] >= 0.7).astype(int)
    df_output['Plx_le_10'] = (df_input['Plx'] <= 10).astype(int)
    df_output['Vmag_le_8.9'] = (df_input['Vmag'] <= 8.9).astype(int)
    df_output['e_Plx_le_1.5'] = (df_input['e_Plx'] <= 1.5).astype(int)
    df_output['SpType_in_2'] = df_input['SpType'].isin(['K2III', 'F3III', 'K0III']).astype(int)
    df_output['Amag_in_11_16'] = ((df_input['Amag'] >= 11) & (df_input['Amag'] <= 16)).astype(int)
    df_output['B-V_in_0.7_1.4'] = ((df_input['B-V'] >= 0.7) & (df_input['B-V'] <= 1.4)).astype(int)
    df_output['Plx_in_0.7_11.5'] = ((df_input['Plx'] >= 0.7) & (df_input['Plx'] <= 11.5)).astype(int)
    return df_output

