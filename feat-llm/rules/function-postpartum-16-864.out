def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities'] = df_input['Feeling for regular activities'].isin(['Tired', 'Worried', 'Afraid']).astype(int)
    df_output['Received_Support'] = df_input['Recieved Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Monthly_income_before_latest_pregnancy'] = df_input['Monthly income before latest pregnancy'].isin(['Less than 5000', '5000 to 10000', '10000 to 20000']).astype(int)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Neutral', 'Bad', 'Poor']).astype(int)
    df_output['History_of_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Relationship_with_inlaws'] = df_input['Relationship with the in-laws'].isin(['Neutral', 'Bad', 'Poor']).astype(int)
    df_output['Age'] = (df_input['Age'] <= 28).astype(int)
    df_output['Number_of_household_members'] = df_input['Number of household members'].isin(['2 to 5']).astype(int)
    df_output['Age_of_immediate_older_children'] = df_input['Age of immediate older children'].isin(['No', '1yr to 3yr', '4yr to 6yr']).astype(int)
    df_output['Pregnancy_length'] = df_input['Pregnancy length'].isin(['8 months', '7 months', '6 months', 'Less than 5 months']).astype(int)
    return df_output