def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Birth_compliancy'] = df_input['Birth compliancy'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Major_changes_or_losses_during_pregnancy'] = df_input['Major changes or losses during pregnancy'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Fear_of_pregnancy'] = df_input['Fear of pregnancy'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Relationship_between_father_and_newborn'] = df_input['Relationship between father and newborn'].apply(lambda x: 1 if x in ['Good', 'Neutral'] else 0)
    df_output['Worry_about_newborn'] = df_input['Worry about newborn'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Trust_and_share_feelings'] = df_input['Trust and share feelings'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Total_children'] = df_input['Total children'].apply(lambda x: 1 if x in ['One', 'More than Two'] else 0)
    df_output['Addiction'] = df_input['Addiction'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Pregnancy_length'] = df_input['Pregnancy length'].apply(lambda x: 1 if x in ['8 months', '9 months', '10 months'] else 0)
    df_output['Number_of_latest_pregnancy'] = df_input['Number of the latest pregnancy'].apply(lambda x: 1 if pd.to_numeric(x, errors='coerce') >= 1 else 0)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Birth_compliancy_No'] = (df_input['Birth compliancy'] == 'No').astype(int)  
    df_output['Major_changes_or_losses_No_Yes'] = df_input['Major changes or losses during pregnancy'].isin(['No', 'Yes']).astype(int)  
    df_output['Fear_of_pregnancy_Yes_No'] = df_input['Fear of pregnancy'].isin(['Yes', 'No']).astype(int)  
    df_output['Relationship_father_newborn_Good_Neutral'] = df_input['Relationship between father and newborn'].isin(['Good', 'Neutral']).astype(int)  
    df_output['Worry_about_newborn_No'] = (df_input['Worry about newborn'] == 'No').astype(int)  
    df_output['Trust_and_share_feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)  
    df_output['Total_children_One_Two'] = df_input['Total children'].isin(['One', 'Two']).astype(int)  
    df_output['Addiction_No'] = (df_input['Addiction'] == 'No').astype(int)  
    df_output['Pregnancy_length_9_10_months'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)  
    df_output['Number_latest_pregnancy_le_2'] = (pd.to_numeric(df_input['Number of the latest pregnancy'], errors='coerce') <= 2).astype(int)  
    return df_output

