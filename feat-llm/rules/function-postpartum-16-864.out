def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Major_changes_or_losses_during_pregnancy_No'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Relax_sleep_when_newborn_asleep_Yes'] = (df_input['Relax/sleep when the newborn is asleep'] == 'Yes').astype(int)
    df_output['Monthly_income_before_latest_pregnancy_No'] = (df_input['Monthly income before latest pregnancy'] == 'No').astype(int)
    df_output['History_of_pregnancy_loss_No'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Pregnancy_length_in_8_9_10_months'] = df_input['Pregnancy length'].isin(['8 months', '9 months', '10 months']).astype(int)
    df_output['Occupation_After_Your_Latest_Childbirth_in_Housewife_Student'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'Student']).astype(int)
    df_output['Number_of_the_latest_pregnancy_1_to_3'] = ((df_input['Number of the latest pregnancy'] >= 1) & (df_input['Number of the latest pregnancy'] <= 3)).astype(int)
    df_output['Breastfeed_Yes'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    df_output['Marital_status_Married'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Gender_of_newborn_in_Boy_Girl_and_Relax_sleep_when_newborn_asleep_Yes'] = ((df_input['Gender of newborn'].isin(['Boy', 'Girl'])) & (df_input['Relax/sleep when the newborn is asleep'] == 'Yes')).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relax_sleep_when_newborn_asleep_No'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    df_output['Monthly_income_in_range'] = df_input['Monthly income before latest pregnancy'].isin(['Less than 5000', '5000 to 10000', '10000 to 20000', '20000 to 30000']).astype(int)
    df_output['History_of_pregnancy_loss_Miscarriage'] = (df_input['History of pregnancy loss'] == 'Miscarriage').astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_Yes'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Number_of_latest_pregnancy_1_to_3'] = ((df_input['Number of the latest pregnancy'] >= 1) & (df_input['Number of the latest pregnancy'] <= 3)).astype(int)
    df_output['Occupation_after_latest_childbirth_in'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'Student']).astype(int)
    df_output['Pregnancy_length_9_or_10_months'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    df_output['Breastfeed_Yes'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    df_output['Marital_status_Married'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Gender_newborn_Boy_or_Girl_and_Relax_No'] = ((df_input['Gender of newborn'].isin(['Boy', 'Girl'])) & (df_input['Relax/sleep when the newborn is asleep'] == 'No')).astype(int)
    return df_output

