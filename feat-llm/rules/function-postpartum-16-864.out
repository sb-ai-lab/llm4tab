def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship with husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Feeling for regular activities'] = (df_input['Feeling for regular activities'] == 'No').astype(int)
    df_output['Received Support'] = df_input['Recieved Support'].isin(['High']).astype(int)
    df_output['History of pregnancy loss'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Relationship with the in-laws'] = df_input['Relationship with the in-laws'].isin(['Good', 'Neutral', 'Friendly']).astype(int)
    df_output['Pregnancy length'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    df_output['Monthly income before latest pregnancy'] = df_input['Monthly income before latest pregnancy'].isin(['More than 30000', '20000 to 30000', 'No']).astype(int)
    df_output['Number of household members'] = df_input['Number of household members'].isin(['6 to 8', '9 or more']).astype(int)
    df_output['Age of immediate older children'] = df_input['Age of immediate older children'].isin(['No', '7yr to 12yr', '13yr or more']).astype(int)
    df_output['Age'] = (df_input['Age'] >= 20).astype(int)
    return df_output

