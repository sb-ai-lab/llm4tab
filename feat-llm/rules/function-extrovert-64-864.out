    df_output['social_connection_frequency_Never'] = df_input['social_connection_frequency'].isin(['Never']).astype(int)
    df_output['gathering_size_preference_Never_or_Small'] = df_input['gathering_size_preference'].isin(['Never', 'Small gatherings']).astype(int)
    cond_valued_friendship_traits = (df_input['valued_friendship_traits'].isin(['Support', 'Honesty'])) & (df_input['social_connection_frequency'].isin(['Never']))
