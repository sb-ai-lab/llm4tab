def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_Monthly_or_Never'] = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Monthly', 'Never']).astype(int)
    df_output['gathering_size_preference_Small_or_Never'] = df_input['gathering_size_preference'].str.strip().str.capitalize().isin(['Small gatherings', 'Never']).astype(int)
    cond_valued = df_input['valued_friendship_traits'].str.strip().str.capitalize().isin(['Loyalty', 'Honesty', 'Support'])
    cond_social_conn = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Monthly', 'Never'])
    df_output['valued_friendship_traits_selected_and_social_conn_Monthly_or_Never'] = (cond_valued & cond_social_conn).astype(int)
    df_output['conflict_resolution_style_selected'] = df_input['conflict_resolution_style'].str.strip().str.capitalize().isin(['Avoid conflict', 'Let time fix it']).astype(int)
    df_output['family_support_level_No_or_Never'] = df_input['family_support_level'].str.strip().str.capitalize().isin(['No', 'Never']).astype(int)
    df_output['social_battery_recharge_Alone_or_None'] = df_input['social_battery_recharge'].str.strip().str.capitalize().isin(['Alone time', 'None of the above']).astype(int)
    df_output['social_orientation_type_Introvert_or_Not_sure'] = df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Introvert', 'Not sure']).astype(int)
    df_output['social_anxiety_level_Nervous_or_Avoid_it'] = df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Nervous', 'Avoid it']).astype(int)
    df_output['emotional_expression_method_Stay_silent_or_Other'] = df_input['emotional_expression_method'].str.strip().str.capitalize().isin(['Stay silent', 'Other']).astype(int)
    cond1 = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Daily', 'Weekly'])
    cond2 = df_input['gathering_size_preference'].str.strip().str.capitalize() == 'Small gatherings'
    cond3 = df_input['social_battery_recharge'].str.strip().str.capitalize() == 'Alone time'
    df_output['social_conn_Daily_or_Weekly_and_gathering_Small_and_battery_Alone'] = (cond1 & cond2 & cond3).astype(int)
    return df_output

