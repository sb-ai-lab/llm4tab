def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['social_connection_frequency'].str.lower().isin(['weekly', 'daily'])) & 
                           (df_input['gathering_size_preference'].str.lower().isin(['large events', 'both'])))
    df_output['cond_2'] = df_input['conflict_resolution_style'].str.lower().isin(['talk it out', 'apologize first'])
    df_output['cond_3'] = df_input['social_battery_recharge'].str.lower() == 'talking to someone'
    df_output['cond_4'] = df_input['social_orientation_type'].str.lower().isin(['extrovert', 'ambivert'])
    df_output['cond_5'] = df_input['emotional_expression_method'].str.lower().isin(['talk openly', 'express emotion strongly'])
    df_output['cond_6'] = df_input['family_support_level'].str.lower().isin(['yes', 'sometimes'])
    df_output['cond_7'] = ((df_input['social_connection_frequency'].str.lower() == 'monthly') & 
                           (df_input['social_battery_recharge'].str.lower() == 'talking to someone') & 
                           (df_input['emotional_expression_method'].str.lower() == 'talk openly'))
    df_output['cond_8'] = ((df_input['social_connection_frequency'].str.lower() == 'never') & 
                           (df_input['social_battery_recharge'].str.lower() == 'social media') & 
                           (df_input['emotional_expression_method'].str.lower() == 'talk openly'))
    df_output['cond_9'] = ((df_input['valued_friendship_traits'].str.lower().isin(['loyalty', 'support', 'honesty'])) & 
                           (df_input['social_connection_frequency'].str.lower().isin(['weekly', 'monthly'])) & 
                           (df_input['conflict_resolution_style'].str.lower() == 'avoid conflict'))
    df_output['cond_10'] = ((df_input['social_anxiety_level'].str.lower().isin(['neutral', 'excited'])) & 
                            (df_input['social_connection_frequency'].str.lower().isin(['weekly', 'monthly'])))
    return df_output.astype(int)

