    df_output['family_support_level_No_or_Never'] = df_input['family_support_level'].isin(['No', 'Never']).astype(int)
    df_output['social_battery_recharge_Alone_or_None'] = df_input['social_battery_recharge'].isin(['Alone time', 'None of the above']).astype(int)
    df_output['social_orientation_type_Introvert_or_Not_sure'] = df_input['social_orientation_type'].isin(['Introvert', 'Not sure']).astype(int)
    df_output['social_anxiety_level_Nervous'] = df_input['social_anxiety_level'].isin(['Nervous']).astype(int)
