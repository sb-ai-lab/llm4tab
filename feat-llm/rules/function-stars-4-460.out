def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list_V'] = df_input['SpType'].apply(lambda x: 1 if (x.endswith('V') and any(x.startswith(prefix) for prefix in ['G1', 'F3', 'A0', 'F7', 'K5', 'B8', 'B9'])) else 0)
    df_output['Amag_gt_10'] = (df_input['Amag'] > 10).astype(int)
    df_output['B_V_lt_0_8'] = (df_input['B-V'] < 0.8).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)
    df_output['Vmag_lt_8'] = (df_input['Vmag'] < 8).astype(int)
    df_output['Amag_in_15_20'] = ((df_input['Amag'] >= 15) & (df_input['Amag'] <= 20)).astype(int)
    df_output['SpType_endswith_V'] = df_input['SpType'].apply(lambda x: 1 if x.endswith('V') else 0)
    df_output['B_V_in_0_0_7'] = ((df_input['B-V'] >= 0.0) & (df_input['B-V'] <= 0.7)).astype(int)
    df_output['Plx_in_5_25'] = ((df_input['Plx'] >= 5) & (df_input['Plx'] <= 25)).astype(int)
    df_output['e_Plx_lt_1'] = (df_input['e_Plx'] < 1).astype(int)
    return df_output

