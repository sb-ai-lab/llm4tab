def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K2III', 'K3III', 'G8III', 'B9III/IV', 'K1III', 'M0III']).astype(int)
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III|III/IV', regex=True).astype(int)
    df_output['Amag_le_15'] = (df_input['Amag'] <= 15).astype(int)
    df_output['Amag_in_10_16'] = df_input['Amag'].between(10, 16).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['Plx_in_0_5'] = df_input['Plx'].between(0, 5).astype(int)
    df_output['B-V_ge_1'] = (df_input['B-V'] >= 1.0).astype(int)
    df_output['B-V_in_1_1.5'] = df_input['B-V'].between(1.0, 1.5).astype(int)
    df_output['Vmag_le_8.9'] = (df_input['Vmag'] <= 8.9).astype(int)
    df_output['e_Plx_le_1'] = (df_input['e_Plx'] <= 1).astype(int)
    return df_output

