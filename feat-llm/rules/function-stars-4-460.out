def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['K2III', 'K3III', 'G8III', 'B9III/IV']).astype(int)
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III').astype(int)
