    df_output['Amag_le_16'] = (df_input['Amag'] <= 16).astype(int)
    df_output['Plx_le_3'] = (df_input['Plx'] <= 3).astype(int)
    df_output['Vmag_ge_7.5'] = (df_input['Vmag'] >= 7.5).astype(int)
    df_output['e_Plx_ge_0.8'] = (df_input['e_Plx'] >= 0.8).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 14) & (df_input['Amag'] <= 16)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 2) & (df_input['Plx'] <= 3)).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 1.0) & (df_input['B-V'] <= 1.5)).astype(int)
    return df_output

