    df_output['B-V_in_0_0_6'] = df_input['B-V'].between(0, 0.6).astype(int)  
    df_output['Vmag_ge_6'] = (df_input['Vmag'] >= 6).astype(int)  
    df_output['e_Plx_le_1'] = (df_input['e_Plx'] <= 1).astype(int)  
    return df_output

