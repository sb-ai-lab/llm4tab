def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_III_or_III_IV'] = df_input['SpType'].str.contains(r'III(/IV)?$', regex=True).astype(int)  
    df_output['Amag_lt_15'] = (df_input['Amag'] < 15).astype(int)  
    df_output['B_V_gt_1'] = (df_input['B-V'] > 1.0).astype(int)  
    df_output['Plx_lt_3'] = (df_input['Plx'] < 3).astype(int)  
    df_output['Vmag_gt_7'] = (df_input['Vmag'] > 7).astype(int)  
    df_output['Amag_in_10_16'] = df_input['Amag'].between(10,16).astype(int)  
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III').astype(int)  
    df_output['B_V_in_1_2'] = df_input['B-V'].between(1.0,2.0).astype(int)  
    df_output['Plx_in_0_4'] = df_input['Plx'].between(0,4).astype(int)  
    df_output['e_Plx_ge_0_8'] = (df_input['e_Plx'] >= 0.8).astype(int)  
    return df_output