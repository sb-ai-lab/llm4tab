def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A_B'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_lt_0_3'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['Debt_le_5000'] = (df_input['Debt'] <= 5000).astype(int)
    df_output['Initial_limit_gt_5000'] = (df_input['Initial limit'] > 5000).astype(int)
    df_output['INCOME_ge_1800'] = (df_input['INCOME'] >= 1800).astype(int)
    df_output['EDU_is_University'] = (df_input['EDU'] == 'University').astype(int)
    df_output['TERM_36_to_60_high_income_low_PDN'] = (((df_input['TERM'] >= 36) & (df_input['TERM'] <= 60)) & (df_input['INCOME'] >= 1800) & (df_input['PDN'] < 0.3)).astype(int)
    df_output['SEX_is_Female'] = (df_input['SEX'] == 'Female').astype(int)
    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Information Technology', 'Finance and Insurance', 'Medicine and healthcare']).astype(int)
    df_output['FAMILYSTATUS_eq_2'] = (df_input['FAMILYSTATUS'] == 2).astype(int)
    return df_output

