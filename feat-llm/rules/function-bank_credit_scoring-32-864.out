def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_flag'] = df_input['Credit history rating'].isin(['C1', 'C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_flag'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_flag'] = (df_input['Debt'] > 5000).astype(int)
    df_output['Initial_limit_flag'] = (df_input['Initial limit'] <= 5000).astype(int)
    df_output['INCOME_flag'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['EDU_flag'] = df_input['EDU'].isin(['College', 'Incomplete', 'High school']).astype(int)
    df_output['TERM_flag'] = ((df_input['TERM'] >= 36) & (df_input['TERM'] <= 60)).astype(int)
    df_output['Overdue_days_flag'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_flag'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['FAMILYSTATUS_flag'] = (df_input['FAMILYSTATUS'] == 1).astype(int)
    return df_output

