def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating'] = df_input['Credit history rating'].isin(['A1', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] < 0.35).astype(int)
    df_output['Initial_limit'] = (df_input['Initial limit'] >= 4000).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 1800).astype(int)
    df_output['Debt'] = (df_input['Debt'] <= df_input['Initial limit'] * 1.2).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['INDUSTRYNAME'] = df_input['INDUSTRYNAME'].isin(['Information Technology', 'Medicine and healthcare', 'Finance and Insurance', 'Production']).astype(int)
    df_output['SEX'] = (df_input['SEX'] == 'Female').astype(int)
    df_output['TERM'] = (df_input['TERM'] >= 60).astype(int)
    df_output['FAMILYSTATUS'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)
    return df_output

