def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 4).astype(int)
    df_output['Satisfaction_with_the_doctors_response'] = (df_input['Satisfaction_with_the_doctors_response'] >= 4).astype(int)
    df_output['The_reason_of_the_call'] = df_input['The_reason_of_the_call'].isin(['Vaccination', 'Inquiries', 'Medical_Consultation', 'Inquiries_COVID19']).astype(int)
    df_output['Call_151'] = (df_input['Call_151'] == 'Yes').astype(int)
    df_output['Aware_151'] = (df_input['Aware_151'] == 'Yes').astype(int)
    df_output['Age'] = df_input['Age'].isin(['50-59', '60 and above']).astype(int)
    df_output['Education'] = df_input['Education'].isin(['High school', 'Less than high school', 'Diploma', 'Other']).astype(int)
    df_output['Governorate'] = df_input['Governorate'].isin(['Capital', 'Farwaniya', 'AlAhmadi']).astype(int)
    df_output['How_often_do_you_receive_call_center_news'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3).astype(int)
    df_output['Marital_Status'] = df_input['Marital_Status'].isin(['Married', 'Widow', 'Widower']).astype(int)
    return df_output

