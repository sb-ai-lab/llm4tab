    df_output['Call_151_and_Satisfaction_condition'] = ((df_input['Call_151'].isin(['Yes'])) & (df_input['Satisfaction_with_the_doctors_response'] >= 4)).astype(int)
    df_output['Governorate_condition'] = df_input['Governorate'].isin(['Capital', 'AlAhmadi']).astype(int)
    df_output['Age_condition'] = df_input['Age'].isin(['50-59', '60 and above']).astype(int)
    df_output['Education_condition'] = df_input['Education'].isin(['Bachelor', 'Master', 'Doctor']).astype(int)
    df_output['How_often_do_you_receive_call_center_news_condition'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3).astype(int)
