def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call_Complaints_good_satisfaction'] = ((df_input['The_reason_of_the_call'] == 'Complaints') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0) & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)
    df_output['Call_151_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_No'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['How_often_do_you_receive_call_center_news_ge_2_8'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.8).astype(int)
    age_list = ['18-24', '30-39', '40-49', '50-59']
    df_output['Age_in_list_good_satisfaction'] = ((df_input['Age'].isin(age_list)) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0) & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)
    education_list = ['High school', 'Diploma', 'Bachelor']
    df_output['Education_in_list_good_satisfaction'] = ((df_input['Education'].isin(education_list)) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0) & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)
    df_output['Gender_Female'] = (df_input['Gender'] == 'Female').astype(int)
    nationality_list = ['Kuwaiti', 'Other nationality']
    df_output['Nationality_in_list_good_satisfaction'] = ((df_input['Nationality'].isin(nationality_list)) & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0) & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)
    return df_output

