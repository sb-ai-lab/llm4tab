def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Debt_gt_5000'] = (df_input['Debt'] > 5000).astype(int)
    df_output['Overdue_days_gt_30'] = (df_input['Overdue days'] > 30).astype(int)
    df_output['Initial_limit_le_1000'] = (df_input['Initial limit'] <= 1000).astype(int)
    df_output['INCOME_lt_1000'] = (df_input['INCOME'] < 1000).astype(int)
    df_output['Credit_history_rating_in_D'] = df_input['Credit history rating'].isin(['D3', 'D2', 'D1', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_gt_0_5'] = (df_input['PDN'] > 0.5).astype(int)
    df_output['TERM_gt_36'] = (df_input['TERM'] > 36).astype(int)
    df_output['EDU_in_Incomplete_High_school'] = df_input['EDU'].isin(['Incomplete', 'High school']).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_3'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 3).astype(int)
    df_output['FAMILYSTATUS_le_1'] = (df_input['FAMILYSTATUS'] <= 1).astype(int)
    return df_output

