def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_in_selected'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Frequency_in_selected'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Amount_time_lt_2'] = (df_input['Amount of time spent reading books per day'] < 2).astype(int)
    df_output['Printed_books_in_selected'] = df_input['Number of printed books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['Ebooks_in_selected'] = df_input['Number of e-books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['Favorite_books_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Others', 'Politics']).astype(int)
    df_output['Reason_not_Academic'] = (df_input['Reason for reading books'] != 'Academic Purpose').astype(int)
    cond_dept = df_input['Department'].isin(['Textile', 'MCT', 'Others'])
    cond_dept_cse_entertain = (df_input['Department'] == 'CSE') & (df_input['Reason for reading books'] == 'Entertainment Purpose')
    df_output['Department_in_selected'] = (cond_dept | cond_dept_cse_entertain).astype(int)
    df_output['Frequency_not_everyday'] = (df_input['Frequency of reading books'] != 'On everyday basis').astype(int)
    df_output['Format_in_selected'] = df_input['The format that you used for reading books'].isin(['Printed', 'E-books']).astype(int)
    return df_output

