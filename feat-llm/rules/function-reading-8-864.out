def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Reading_Books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Time_Spent_Reading'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Printed_Books_Read'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Ebooks_Read'] = df_input['Number of e-books you read last two years'].isin(['11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_Academic_Reason'] = ((df_input['Department'].isin(['BBA', 'Pharmacy', 'CSE', 'CIS', 'Civil', 'JMC'])) & (df_input['Reason for reading books'] == 'Academic Purpose')).astype(int)
    df_output['Change_Felt'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Format_Used'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    df_output['Influenced_By'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Parents', 'Self-Decision']).astype(int)
    df_output['Favorite_Books_Academic_Reason'] = ((df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography', 'Others'])) & (df_input['Reason for reading books'] == 'Academic Purpose')).astype(int)
    return df_output

