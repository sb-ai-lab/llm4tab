def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_non_academic'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Frequency_low'] = df_input['Frequency of reading books'].isin(['A few times a week', 'A few times a month', 'Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Time_spent_less_2'] = (df_input['Amount of time spent reading books per day'] < 2).astype(int)
    df_output['Favorite_books_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics', 'Others']).astype(int)
    df_output['Printed_books_low'] = df_input['Number of printed books you read last two years'].isin(['1-5', '6-10', np.nan]).astype(int)
    df_output['Ebooks_low'] = df_input['Number of e-books you read last two years'].isin(['1-5', '6-10', np.nan]).astype(int)
    df_output['Department_low_reading_or_non_academic'] = ((df_input['Department'].isin(['Textile', 'SWE', 'CSE', 'MCT', 'Others'])) & ((~df_input['Frequency of reading books'].isin(['On everyday basis'])) | (df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge'])))).astype(int)
    df_output['Format_non_academic'] = ((df_input['The format that you used for reading books'].isin(['E-books', 'Both'])) & (df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']))).astype(int)
    df_output['Influenced_by_self_friends'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Friends']).astype(int)
    df_output['Change_feel_relax_creative'] = df_input['What is the change that you fell after reading books'].isin(['Feel Relax', 'Increase Creative Thinking']).astype(int)
    return df_output

