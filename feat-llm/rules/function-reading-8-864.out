def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_in_selected'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Freq_in_selected_and_Reason_not_Academic'] = ((df_input['Frequency of reading books'].isin(['A few times a week', 'A few times a month'])) & (df_input['Reason for reading books'] != 'Academic Purpose')).astype(int)
    df_output['Time_spent_reading_<=2'] = (df_input['Amount of time spent reading books per day'] <= 2).astype(int)
