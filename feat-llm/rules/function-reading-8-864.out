def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_condition_1'] = df_input['Frequency of reading books'].isin(['A few times a month', 'Once or twice a year', 'Less than once a year']).astype(int)
    df_output['Reason_condition'] = df_input['Reason for reading books'].isin(['Keep me informative', 'Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Time_spent_condition'] = (df_input['Amount of time spent reading books per day'] < 2).astype(int)
    df_output['Printed_books_condition'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['E_books_condition'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Favorite_books_condition'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Others', 'Politics']).astype(int)
    df_output['Department_condition'] = df_input['Department'].isin(['MCT', 'BBA', 'English', 'JMC', 'Others']).astype(int)
    df_output['Format_condition'] = (df_input['The format that you used for reading books'] == 'E-books').astype(int)
    freq_cond = df_input['Frequency of reading books'] == 'A few times a week'
    reason_not_academic = df_input['Reason for reading books'] != 'Academic Purpose'
    df_output['Freq_reason_condition'] = (freq_cond & reason_not_academic).astype(int)
    df_output['Influenced_condition'] = df_input['Who influenced you to read books'].isin(['Friends', 'Parents']).astype(int)
    return df_output

