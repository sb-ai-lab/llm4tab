    df_output['E_books_in_selected'] = df_input['Number of e-books you read last two years'].isin(['1-5', '6-10', float('nan')]).astype(int)
    df_output['Dept_in_selected_and_Reason_not_Academic'] = ((df_input['Department'].isin(['Textile', 'MCT', 'SWE', 'Others'])) & (df_input['Reason for reading books'] != 'Academic Purpose')).astype(int)
    df_output['Favorite_books_in_selected_and_Reason_not_Academic'] = ((df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Others'])) & (df_input['Reason for reading books'] != 'Academic Purpose')).astype(int)
    df_output['Format_in_selected_not_Both'] = (df_input['The format that you used for reading books'].isin(['Printed', 'E-books'])).astype(int)
    df_output['Change_in_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Creative Thinking', 'Feel Relax']).astype(int)
    df_output['Freq_in_selected_and_Time_spent_<3'] = ((df_input['Frequency of reading books'].isin(['A few times a week', 'A few times a month'])) & (df_input['Amount of time spent reading books per day'] < 3)).astype(int)
    return df_output

