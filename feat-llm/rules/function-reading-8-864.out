def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Freq_Read_Academic'] = ((df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week'])) & 
                                       (df_input['Reason for reading books'] == 'Academic Purpose')).astype(int)
    df_output['Time_Spent_Reading_1hr_or_more'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Printed_Books_More_Than_10'] = (df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15'])).astype(int)
    df_output['Ebooks_Books_6_or_more'] = (df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20'])).astype(int)
    df_output['Dept_Academic'] = ((df_input['Department'].isin(['CSE', 'Pharmacy', 'BBA'])) & 
                                 (df_input['Reason for reading books'] == 'Academic Purpose')).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Format_Both'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    df_output['Influenced_Academic'] = ((df_input['Who influenced you to read books'].isin(['Self-Decision', 'Parents', 'Teachers'])) & 
                                       (df_input['Reason for reading books'] == 'Academic Purpose')).astype(int)
    freq_map = {'On everyday basis': 4, 'A few times a week': 3, 'A few times a month': 2, 'Once or twice a year': 1, 'Less than once a year': 0}
    freq_numeric = df_input['Frequency of reading books'].map(freq_map).fillna(0)
    df_output['Freq_At_Least_Monthly_Leisure'] = ((freq_numeric >= 2) & 
                                                  (df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']))).astype(int)
    return df_output