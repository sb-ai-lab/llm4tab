def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_Less_Once_Or_Twice_Year'] = df_input['Frequency of reading books'].isin(['Less than once a year', 'Once or twice a year']).astype(int)
    df_output['Reason_Entertainment_Or_Vocab'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Favorite_Leisure_Fiction_Politics'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics']).astype(int)
    df_output['Change_FeelRelax_IncreaseCreative'] = df_input['What is the change that you fell after reading books'].isin(['Feel Relax', 'Increase Creative Thinking']).astype(int)
    df_output['PrintedBooks_1_5_or_nan'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Ebooks_1_5_or_nan'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Time_Spent_Reading_Leq_0_5'] = (df_input['Amount of time spent reading books per day'] <= 0.5).astype(int)
    df_output['Department_BBA_JMC_English_Others'] = df_input['Department'].isin(['BBA', 'JMC', 'English', 'Others']).astype(int)
    df_output['Frequency_A_Few_Times_A_Month'] = df_input['Frequency of reading books'].isin(['A few times a month']).astype(int)
    df_output['Format_Printed'] = df_input['The format that you used for reading books'].isin(['Printed']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Reason_for_reading_books'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Number_of_printed_books'] = df_input['Number of printed books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Number_of_ebooks'] = df_input['Number of e-books you read last two years'].isin(['More than 20', '16-20', '11-15']).astype(int)
    df_output['Amount_of_time_spent_reading_books'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Department'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT', 'Textile']).astype(int)
    df_output['Change_after_reading_books'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill']).astype(int)
    df_output['Where_do_you_read_printed_books'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    df_output['Format_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['E-books', 'Both']).astype(int)
    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Self-Decision']).astype(int)
    return df_output

