def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_D_E'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_ge_0_9_Initial_limit'] = (df_input['Debt'] >= df_input['Initial limit'] * 0.9).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['INCOME_lt_1500'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['TERM_ge_36_and_Overdue_days_gt_0'] = ((df_input['TERM'] >= 36) & (df_input['Overdue days'] > 0)).astype(int)
    df_output['Credit_history_rating_in_C2_C3_and_PDN_ge_0_3'] = (df_input['Credit history rating'].isin(['C2', 'C3']) & (df_input['PDN'] >= 0.3)).astype(int)
    df_output['SEX_Male_and_Debt_gt_900_and_PDN_gt_0_15'] = ((df_input['SEX'] == 'Male') & (df_input['Debt'] > 900) & (df_input['PDN'] > 0.15)).astype(int)
    df_output['FAMILYSTATUS_1_and_PDN_gt_0_25'] = ((df_input['FAMILYSTATUS'] == 1) & (df_input['PDN'] > 0.25)).astype(int)
    return df_output

