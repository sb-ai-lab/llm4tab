def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Credit_history_rating_in_A_B_C1'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1']).astype(int)  
    df_output['PDN_less_0_3'] = (df_input['PDN'] < 0.3).astype(int)  
    df_output['Debt_leq_0_7_Initial_limit'] = (df_input['Debt'] <= df_input['Initial limit'] * 0.7).astype(int)  
    df_output['INCOME_geq_1500'] = (df_input['INCOME'] >= 1500).astype(int)  
    df_output['EDU_in_College_University'] = df_input['EDU'].isin(['College', 'University']).astype(int)  
    df_output['Overdue_days_eq_0'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['TERM_leq_36_and_PDN_less_0_3'] = ((df_input['TERM'] <= 36) & (df_input['PDN'] < 0.3)).astype(int)  
    df_output['INDUSTRYNAME_in_Finance_Construction_Trade_and_PDN_less_0_4'] = (df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Construction', 'Trade']) & (df_input['PDN'] < 0.4)).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT_leq_2_and_PDN_less_0_3'] = ((df_input['UNDERAGECHILDRENCOUNT'] <= 2) & (df_input['PDN'] < 0.3)).astype(int)  
    df_output['FAMILYSTATUS_in_2_3_and_PDN_less_0_35'] = (df_input['FAMILYSTATUS'].isin([2,3]) & (df_input['PDN'] < 0.35)).astype(int)  
    return df_output