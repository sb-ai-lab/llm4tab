def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_condition'] = df_input['Credit history rating'].isin(['C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_condition'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Overdue_days_condition'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Debt_condition'] = (df_input['Debt'] > 7000).astype(int)
    df_output['Initial_limit_condition'] = (df_input['Initial limit'] <= 3000).astype(int)
    df_output['INCOME_condition'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['EDU_condition'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_and_Debt_condition'] = ((df_input['TERM'] >= 60) & (df_input['Debt'] > 5000)).astype(int)
    df_output['SEX_and_Credit_history_condition'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'].isin(['D2', 'D3', 'E1']))).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_and_PDN_condition'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 2) & (df_input['PDN'] >= 0.3)).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_condition'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['PDN_condition'] = (df_input['PDN'] < 0.3).astype(int)
    df_output['Overdue_days_condition'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Initial_limit_condition'] = (df_input['Initial limit'] >= 4000).astype(int)
    df_output['INCOME_condition'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['Debt_condition'] = (df_input['Debt'] <= df_input['Initial limit'] * 1.5).astype(int)
    df_output['EDU_condition'] = df_input['EDU'].isin(['College', 'University']).astype(int)
    df_output['TERM_INCOME_condition'] = ((df_input['TERM'] <= 60) & (df_input['INCOME'] > 1000)).astype(int)
    df_output['INDUSTRYNAME_condition'] = df_input['INDUSTRYNAME'].isin(['Production', 'Science and Education', 'Information Technology', 'Medicine and healthcare']).astype(int)
    df_output['FAMILYSTATUS_UNDERAGECHILDRENCOUNT_condition'] = ((df_input['FAMILYSTATUS'].isin([1, 2])) & (df_input['UNDERAGECHILDRENCOUNT'] <= 1)).astype(int)
    return df_output

