def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_D_E'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_ge_5000'] = (df_input['Debt'] >= 5000).astype(int)
    df_output['Initial_limit_le_2000'] = (df_input['Initial limit'] <= 2000).astype(int)
    df_output['INCOME_le_1000'] = (df_input['INCOME'] <= 1000).astype(int)
    df_output['EDU_in_Highschool_Incomplete'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_le_36'] = (df_input['TERM'] <= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_1'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['FAMILYSTATUS_eq_1'] = (df_input['FAMILYSTATUS'] == 1).astype(int)
    return df_output

