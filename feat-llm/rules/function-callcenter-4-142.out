def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)  
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)  
    cond_reason = df_input['The_reason_of_the_call'].isin(['Complaints', 'Medical_Consultation'])  
    cond_satisfaction = df_input['Satisfaction_with_the_doctors_response'] >= 3.0  
    df_output['Reason_call_complaints_or_medical_and_high_satisfaction'] = (cond_reason & cond_satisfaction).astype(int)  
    df_output['Call_151_is_No'] = (df_input['Call_151'] == 'No').astype(int)  
    df_output['Aware_151_is_No'] = (df_input['Aware_151'] == 'No').astype(int)  
    cond_age = df_input['Age'].isin(['18-24', '30-39', '40-49'])  
    df_output['Age_in_selected_and_high_satisfaction'] = (cond_age & cond_satisfaction).astype(int)  
    df_output['Education_in_selected'] = df_input['Education'].isin(['Bachelor', 'Diploma', 'Master']).astype(int)  
    df_output['How_often_do_you_receive_call_center_news_ge_3'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3.0).astype(int)  
    cond_nationality = df_input['Nationality'] == 'Kuwaiti'  
    df_output['Nationality_Kuwaiti_and_high_satisfaction'] = (cond_nationality & cond_satisfaction).astype(int)  
    cond_marital = df_input['Marital_Status'].isin(['Single', 'Married'])  
    df_output['Marital_Status_Single_or_Married_and_high_satisfaction'] = (cond_marital & cond_satisfaction).astype(int)  
    return df_output

