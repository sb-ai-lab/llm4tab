def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Time_spent_reading_>=1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency_reading_books'] = df_input['Frequency of reading books'].isin(['A few times a week', 'On everyday basis']).astype(int)
    df_output['Ebooks_read_last_2_years'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read_last_2_years'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_after_reading'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['English', 'CSE', 'SWE', 'Pharmacy', 'EEE', 'CIS', 'NFE', 'MCT']).astype(int)
    df_output['Influenced_by_Teachers'] = (df_input['Who influenced you to read books'] == 'Teachers').astype(int)
    df_output['Format_used'] = df_input['The format that you used for reading books'].isin(['Printed', 'E-books', 'Both']).astype(int)
    df_output['Gender_valid'] = df_input['Gender'].isin(['Male', 'Female']).astype(int)
    return df_output

