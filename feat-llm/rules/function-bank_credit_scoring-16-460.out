def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_0'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['Credit_history_rating_good'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1', 'C2', 'C3']).astype(int)
    df_output['PDN_lt_0_2'] = (df_input['PDN'] < 0.2).astype(int)
    df_output['Debt_le_1500'] = (df_input['Debt'] <= 1500).astype(int)
    df_output['Initial_limit_ge_1500'] = (df_input['Initial limit'] >= 1500).astype(int)
    df_output['INCOME_ge_1500'] = (df_input['INCOME'] >= 1500).astype(int)
    df_output['EDU_college_university'] = df_input['EDU'].isin(['College', 'University']).astype(int)
    df_output['TERM_ge_48'] = (df_input['TERM'] >= 48).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_0_or_1'] = df_input['UNDERAGECHILDRENCOUNT'].isin([0,1]).astype(int)
    df_output['FAMILYSTATUS_eq_1'] = (df_input['FAMILYSTATUS'] == 1).astype(int)
    return df_output