def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Overdue_days_0'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['Credit_history_rating_good'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)  
    df_output['PDN_lt_0_3'] = (df_input['PDN'] < 0.3).astype(int)  
    df_output['Debt_le_7000'] = (df_input['Debt'] <= 7000).astype(int)  
    df_output['Initial_limit_ge_5000'] = (df_input['Initial limit'] >= 5000).astype(int)  
    df_output['INCOME_ge_1500'] = (df_input['INCOME'] >= 1500).astype(int)  
    df_output['EDU_in_University_College'] = df_input['EDU'].isin(['University', 'College']).astype(int)  
    df_output['TERM_ge_60'] = (df_input['TERM'] >= 60).astype(int)  
    df_output['UNDERAGECHILDRENCOUNT_0'] = (df_input['UNDERAGECHILDRENCOUNT'] == 0).astype(int)  
    df_output['FAMILYSTATUS_ge_2'] = (df_input['FAMILYSTATUS'] >= 2).astype(int)  
    return df_output

