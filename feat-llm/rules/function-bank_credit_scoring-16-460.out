def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue days'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['D3', 'D2', 'D1', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_vs_Initial_limit'] = (df_input['Debt'] >= df_input['Initial limit'] * 0.9).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] <= 1200).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM'] = (df_input['TERM'] <= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['FAMILYSTATUS'] = (df_input['FAMILYSTATUS'] == 2).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] <= 3000).astype(int)
    return df_output

