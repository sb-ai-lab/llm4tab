    df_output['FAMILYSTATUS_1'] = (df_input['FAMILYSTATUS'] == 1).astype(int)
    df_output['Debt_le_half_Initial_limit'] = (df_input['Debt'] <= df_input['Initial limit'] * 0.5).astype(int)
    return df_output

