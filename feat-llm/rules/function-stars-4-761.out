def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'F0V', 'K5V', 'B8V', 'B9V']).astype(int)  
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)  
    df_output['Amag_gte_15'] = (df_input['Amag'] >= 15).astype(int)  
    df_output['Amag_gt_14'] = (df_input['Amag'] > 14).astype(int)  
    df_output['B-V_lte_0_7'] = (df_input['B-V'] <= 0.7).astype(int)  
    df_output['B-V_lt_0_8'] = (df_input['B-V'] < 0.8).astype(int)  
    df_output['Plx_gte_5'] = (df_input['Plx'] >= 5).astype(int)  
    df_output['Plx_gt_8'] = (df_input['Plx'] > 8).astype(int)  
    df_output['Vmag_gt_6'] = (df_input['Vmag'] > 6).astype(int)  
    df_output['Vmag_gte_7'] = (df_input['Vmag'] >= 7).astype(int)  
    return df_output

