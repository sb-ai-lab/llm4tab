def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G8III', 'G7III', 'B9III/IV', 'K3III']).astype(int)
    df_output['SpType_contains_III_or_IV'] = df_input['SpType'].str.contains('III|IV', regex=True).astype(int)
    df_output['Amag_lt_16'] = (df_input['Amag'] < 16).astype(int)
    df_output['Amag_le_16'] = (df_input['Amag'] <= 16).astype(int)
    df_output['B-V_gt_0.8'] = (df_input['B-V'] > 0.8).astype(int)
    df_output['B-V_ge_0.9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['Plx_le_5'] = (df_input['Plx'] <= 5).astype(int)
    df_output['Vmag_lt_6'] = (df_input['Vmag'] < 6).astype(int)
    df_output['Vmag_le_5'] = (df_input['Vmag'] <= 5).astype(int)
    return df_output

