def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'Keep me informative', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Department'] = df_input['Department'].isin(['English', 'BBA', 'JMC', 'Others']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Number_of_e_books_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', '6-10', np.nan]).astype(int)
    df_output['Number_of_printed_books_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', np.nan]).astype(int)
    df_output['Favorite_books_for_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics', 'Others']).astype(int)
    df_output['Frequency_of_reading_books'] = (df_input['Frequency of reading books'] != 'On everyday basis').astype(int)
    df_output['Change_after_reading_books'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    df_output['How_to_manage_books'] = df_input['How to manage books for reading'].isin(['Buy', 'Others']).astype(int)
    cond_format = df_input['The format that you used for reading books'].isin(['E-books', 'Printed'])
    cond_freq_reason = (df_input['Frequency of reading books'] != 'On everyday basis') | (~df_input['Reason for reading books'].isin(['Academic Purpose']))
    df_output['Format_used_for_reading_books'] = (cond_format & cond_freq_reason).astype(int)
    return df_output

