def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_childbirth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Feeling_for_regular_activities_Worried_or_Afraid'] = df_input['Feeling for regular activities'].isin(['Worried', 'Afraid']).astype(int)
    df_output['Relationship_with_inlaws_Bad_or_Poor_and_Angry_Yes'] = ((df_input['Relationship with the in-laws'].isin(['Bad', 'Poor'])) & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_Yes_and_Angry_Yes'] = ((df_input['Major changes or losses during pregnancy'] == 'Yes') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    df_output['Abuse_No_and_Angry_Yes'] = ((df_input['Abuse'] == 'No') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    df_output['Feeling_for_regular_activities_Worried_and_Major_changes_Yes'] = ((df_input['Feeling for regular activities'] == 'Worried') & (df_input['Major changes or losses during pregnancy'] == 'Yes')).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_Less_than_5000_and_Angry_Yes'] = ((df_input['Monthly income before latest pregnancy'] == 'Less than 5000') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    df_output['Number_of_latest_pregnancy_1_to_2_and_Angry_Yes'] = ((df_input['Number of the latest pregnancy'] >= 1) & (df_input['Number of the latest pregnancy'] <= 2) & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    df_output['Fear_of_pregnancy_Yes_and_Angry_Yes'] = ((df_input['Fear of pregnancy'] == 'Yes') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    df_output['Feeling_Worried_and_Abuse_No_and_Angry_Yes'] = ((df_input['Feeling for regular activities'] == 'Worried') & (df_input['Abuse'] == 'No') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)
    return df_output

