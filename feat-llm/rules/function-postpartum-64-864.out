def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Regular checkups'] = df_input['Regular checkups'].apply(lambda x: 1 if x in ['No', 'Yes'] else 0)
    df_output['Education Level University'] = df_input['Education Level'].apply(lambda x: 1 if x == 'University' else 0)
    df_output['Residence City'] = df_input['Residence'].apply(lambda x: 1 if x == 'City' else 0)
    df_output['Breastfeed Yes'] = df_input['Breastfeed'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Relationship father newborn'] = df_input['Relationship between father and newborn'].apply(lambda x: 1 if x in ['Bad', 'Neutral', 'Good'] else 0)
    df_output['Fear of pregnancy'] = df_input['Fear of pregnancy'].apply(lambda x: 1 if x in ['Yes', 'No'] else 0)
    df_output['Relax sleep newborn'] = df_input['Relax/sleep when the newborn is asleep'].apply(lambda x: 1 if x in ['No', 'Yes'] else 0)
    df_output['Occupation after childbirth'] = df_input['Occupation After Your Latest Childbirth'].apply(lambda x: 1 if x in ['Student', 'Housewife', 'Teacher'] else 0)
    df_output['Received Support'] = df_input['Received Support'].apply(lambda x: 1 if x in ['Low', 'Medium'] else 0)
    df_output['Pregnancy plan'] = df_input['Pregnancy plan'].apply(lambda x: 1 if x in ['No', 'Yes'] else 0)
    return df_output

