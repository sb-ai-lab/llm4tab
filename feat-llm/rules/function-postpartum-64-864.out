def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_childbirth'] = df_input['Angry after latest child birth'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Need_for_Support'] = df_input['Need for Support'].apply(lambda x: 1 if x in ['Medium', 'High', 'Low'] else 0)
    df_output['Pregnancy_plan'] = df_input['Pregnancy plan'].apply(lambda x: 1 if x in ['No', 'Yes'] else 0)
    df_output['Husband_education_level'] = df_input["Husband's education level"].apply(lambda x: 1 if x == 'University' else 0)
    df_output['Relationship_with_newborn'] = df_input['Relationship between father and newborn'].apply(lambda x: 1 if x == 'Good' else 0)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].apply(lambda x: 1 if x in ['No', 'Less than 5000'] else 0)
    df_output['Husband_monthly_income'] = df_input["Husband's monthly income"].apply(lambda x: 1 if x in ['Less than 5000', '5000 to 10000', '20000 to 30000', 'More than 30000'] else 0)
    df_output['Total_children'] = df_input['Total children'].apply(lambda x: 1 if x in ['One', 'More than two'] else 0)
    df_output['Addiction'] = df_input['Addiction'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Gender_of_newborn'] = df_input['Gender of newborn'].apply(lambda x: 1 if x in ['Boy', 'Girl'] else 0)
    return df_output

