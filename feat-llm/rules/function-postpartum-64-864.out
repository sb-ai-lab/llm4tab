def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_childbirth_No'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['Feeling_for_regular_activities_No'] = (df_input['Feeling for regular activities'] == 'No').astype(int)
    df_output['Abuse_Yes_and_Angry_after_latest_childbirth_No'] = ((df_input['Abuse'] == 'Yes') & (df_input['Angry after latest child birth'] == 'No')).astype(int)
    df_output['History_of_pregnancy_loss_in_Miscarriage_Still-born_Delivery'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_No_and_Abuse_Yes'] = ((df_input['Major changes or losses during pregnancy'] == 'No') & (df_input['Abuse'] == 'Yes')).astype(int)
    df_output['Relationship_with_inlaws_in_Good_Friendly_and_Angry_after_latest_childbirth_No'] = (df_input['Relationship with the in-laws'].isin(['Good', 'Friendly']) & (df_input['Angry after latest child birth'] == 'No')).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_in_No_10000_to_20000_More_than_30000_and_Angry_after_latest_childbirth_No'] = (df_input['Monthly income before latest pregnancy'].isin(['No', '10000 to 20000', 'More than 30000']) & (df_input['Angry after latest child birth'] == 'No')).astype(int)
    df_output['Fear_of_pregnancy_Yes_and_Angry_after_latest_childbirth_No'] = ((df_input['Fear of pregnancy'] == 'Yes') & (df_input['Angry after latest child birth'] == 'No')).astype(int)
    df_output['Number_of_latest_pregnancy_gte_3_and_Angry_after_latest_childbirth_No'] = ((df_input['Number of the latest pregnancy'] >= 3) & (df_input['Angry after latest child birth'] == 'No')).astype(int)
    df_output['Feeling_for_regular_activities_Tired_and_Angry_after_latest_childbirth_No'] = ((df_input['Feeling for regular activities'] == 'Tired') & (df_input['Angry after latest child birth'] == 'No')).astype(int)
    return df_output

