def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['Medium', 'High']).astype(int)
    df_output['Relationship_between_father_and_newborn'] = df_input['Relationship between father and newborn'].isin(['Bad', 'Neutral']).astype(int)
    df_output['Trust_and_share_feelings'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Relationship_with_inlaws'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    df_output['Newborn_illness'] = (df_input['Newborn illness'] == 'Yes').astype(int)
    df_output['Occupation_After_Latest_Childbirth'] = (df_input['Occupation After Your Latest Childbirth'] == 'Student').astype(int)
    df_output['Husband_education_level'] = df_input["Husband's education level"].isin(['Primary School', 'No']).astype(int)
    df_output['Age'] = ((df_input['Age'] >= 18) & (df_input['Age'] <= 29)).astype(int)
    df_output['Number_of_latest_pregnancy'] = (df_input['Number of the latest pregnancy'] <= 3).astype(int)
    return df_output