def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_daily_weekly'] = df_input['social_connection_frequency'].isin(['Daily', 'Weekly']).astype(int)
    df_output['gathering_size_preference_large_both'] = df_input['gathering_size_preference'].isin(['Large events', 'Both']).astype(int)
    df_output['valued_friendship_traits_selected'] = df_input['valued_friendship_traits'].isin(['Honesty', 'All', 'All the three and trust', 'Support']).astype(int)
    df_output['conflict_resolution_style_selected'] = df_input['conflict_resolution_style'].isin(['Talk it out', 'Apologize first']).astype(int)
    df_output['family_support_level_yes_sometimes'] = df_input['family_support_level'].str.capitalize().isin(['Yes', 'Sometimes']).astype(int)
    df_output['social_battery_recharge_talking_social_media'] = df_input['social_battery_recharge'].isin(['Talking to someone', 'Social media']).astype(int)
    df_output['social_orientation_type_extrovert_ambivert'] = df_input['social_orientation_type'].isin(['Extrovert', 'Ambivert']).astype(int)
    df_output['social_anxiety_level_neutral_excited'] = df_input['social_anxiety_level'].isin(['Neutral', 'Excited']).astype(int)
    df_output['emotional_expression_method_talk_express'] = df_input['emotional_expression_method'].isin(['Talk openly', 'Express emotion strongly']).astype(int)
    cond = (df_input['social_connection_frequency'] == 'Monthly') & (df_input['social_battery_recharge'] == 'Talking to someone')
    df_output['monthly_connection_and_talking_recharge'] = cond.astype(int)
    return df_output

