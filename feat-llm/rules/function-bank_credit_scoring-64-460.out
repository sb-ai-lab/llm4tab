def extracting_features_0(df_input):  
    import pandas as pd  
    from datetime import datetime  
  
    df_output = pd.DataFrame()  
  
    df_output['Overdue days'] = (df_input['Overdue days'] > 0).astype(int)  
  
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)  
  
    df_output['PDN'] = (df_input['PDN'] >= 0.3).astype(int)  
  
    df_output['Debt'] = (df_input['Debt'] > 2000).astype(int)  
  
    df_output['Initial limit'] = (df_input['Initial limit'] < 3000).astype(int)  
  
    df_output['INCOME'] = (df_input['INCOME'] < 1500).astype(int)  
  
    df_output['EDU'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)  
  
    df_output['TERM'] = (df_input['TERM'] <= 36).astype(int)  
  
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)  
  
    today = pd.to_datetime('today')  
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')  
    ages = (today - birthdates).dt.days // 365  
    df_output['Age'] = (ages < 30).astype(int)  
  
    return df_output

