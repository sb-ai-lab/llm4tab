def extracting_features_1(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame()
    df_output['Credit_history_rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3']).astype(int)
    df_output['Overdue_days'] = (df_input['Overdue days'] == 0).astype(int)
    df_output['PDN'] = (df_input['PDN'] < 0.2).astype(int)
    df_output['Debt'] = (df_input['Debt'] <= 3500).astype(int)
    df_output['Initial_limit'] = (df_input['Initial limit'] >= 3500).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 1800).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['University', 'College']).astype(int)
    df_output['TERM'] = (df_input['TERM'] >= 48).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] == 0).astype(int)

    today = pd.to_datetime('today')
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    age = (today - birthdates).dt.days // 365
    df_output['Age'] = (age >= 30).astype(int)

    return df_output