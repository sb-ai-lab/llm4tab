def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue days > 0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit history rating in [D1, D2, D3, E1, E2, E3]'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN >= 0.35'] = (df_input['PDN'] >= 0.35).astype(int)
    df_output['Initial limit <= 3000'] = (df_input['Initial limit'] <= 3000).astype(int)
    df_output['INCOME < 1000'] = (df_input['INCOME'] < 1000).astype(int)
    df_output['Debt > 2000'] = (df_input['Debt'] > 2000).astype(int)
    df_output['EDU in [High school, Incomplete]'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM <= 36'] = (df_input['TERM'] <= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT >= 1'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['Credit history rating in [C2, C3] and PDN > 0.3'] = ((df_input['Credit history rating'].isin(['C2', 'C3'])) & (df_input['PDN'] > 0.3)).astype(int)
    return df_output

