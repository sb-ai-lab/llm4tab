def extracting_features_0(df_input):
    import pandas as pd
    from datetime import datetime

    df_output = pd.DataFrame()

    credit_history_set = {'C1', 'C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3'}
    edu_set = {'High school', 'Incomplete'}

    df_output['Credit_history_rating_condition'] = df_input['Credit history rating'].isin(credit_history_set).astype(int)
    df_output['Overdue_days_condition'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['PDN_condition'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_condition'] = (df_input['Debt'] > 2000).astype(int)
    df_output['Initial_limit_condition'] = (df_input['Initial limit'] < 3000).astype(int)
    df_output['INCOME_condition'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['EDU_condition'] = df_input['EDU'].isin(edu_set).astype(int)
    df_output['TERM_condition'] = (df_input['TERM'] <= 36).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_condition'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)

    today = pd.to_datetime('today')
    birthdates = pd.to_datetime(df_input['BIRTHDATE'], errors='coerce')
    ages = (today - birthdates).dt.days // 365
    df_output['Age_condition'] = (ages < 30).astype(int)

    return df_output

