def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly', 'Neutral']).astype(int)
    df_output['Received_Support'] = df_input['Received Support'].isin(['High', 'Medium']).astype(int)
    df_output['Relax_sleep_when_newborn_asleep'] = (df_input['Relax/sleep when the newborn is asleep'] == 'Yes').astype(int)
    df_output['Newborn_illness'] = (df_input['Newborn illness'] == 'No').astype(int)
    df_output['Relationship_with_inlaws'] = df_input['Relationship with the in-laws'].isin(['Good', 'Neutral', 'Friendly']).astype(int)
    df_output['Pregnancy_plan'] = df_input['Pregnancy plan'].isin(['Yes', 'No']).astype(int)
    df_output['Mode_of_delivery'] = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section']).astype(int)
    df_output['Number_of_latest_pregnancy'] = df_input['Number of the latest pregnancy'].between(1,4).astype(int)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].isin(['20000 to 30000', '10000 to 20000', '5000 to 10000', 'Less than 5000', 'More than 30000']).astype(int)
    df_output['Residence'] = df_input['Residence'].isin(['City', 'Village']).astype(int)
    return df_output

