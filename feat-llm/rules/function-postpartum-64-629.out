def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband_Bad_or_Neutral'] = df_input['Relationship with husband'].isin(['Bad', 'Neutral']).astype(int)
    df_output['Received_Support_Low_or_Medium'] = df_input['Received Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Relax_sleep_when_newborn_asleep_No_or_Yes'] = df_input['Relax/sleep when the newborn is asleep'].isin(['No', 'Yes']).astype(int)
    df_output['Newborn_illness_Yes_or_No'] = df_input['Newborn illness'].isin(['Yes', 'No']).astype(int)
    df_output['Relationship_with_inlaws_Bad_or_Poor'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor']).astype(int)
    df_output['Pregnancy_plan_No'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Mode_of_delivery_Normal_or_Caesarean'] = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section']).astype(int)
    df_output['Number_latest_pregnancy_1_or_2'] = df_input['Number of the latest pregnancy'].between(1, 2).astype(int)
    df_output['Current_monthly_income_No_or_Less_than_5000'] = df_input['Current monthly income'].isin(['No', 'Less than 5000']).astype(int)
    df_output['Residence_City_or_Village'] = df_input['Residence'].isin(['City', 'Village']).astype(int)
    return df_output

