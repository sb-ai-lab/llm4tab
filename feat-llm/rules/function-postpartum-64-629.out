def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Husband’s monthly income'] = df_input['Husband’s monthly income'].isin(['More than 30000', '20000 to 30000', '10000 to 20000']).astype(int)
    df_output['Relationship between father and newborn'] = df_input['Relationship between father and newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Regular checkups'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    df_output['History of pregnancy loss'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Relationship with husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Disease before pregnancy'] = df_input['Disease before pregnancy'].isin(['No', 'Non-Chronic Disease']).astype(int)
    df_output['Marital status'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Fear of pregnancy'] = (df_input['Fear of pregnancy'] == 'No').astype(int)
    df_output['Number of the latest pregnancy'] = ((df_input['Number of the latest pregnancy'] >= 1) & (df_input['Number of the latest pregnancy'] <= 4)).astype(int)
    df_output['Age'] = ((df_input['Age'] >= 19) & (df_input['Age'] <= 34)).astype(int)
    return df_output

