def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Husband_monthly_income'] = df_input['Husband’s monthly income'].isin(
        ['No', 'Less than 5000', '5000 to 10000', '10000 to 20000', '20000 to 30000', 'More than 30000']
    ).astype(int)
    df_output['Relationship_father_newborn'] = df_input['Relationship between father and newborn'].isin(['Bad', 'Neutral']).astype(int)
    df_output['Regular_checkups'] = df_input['Regular checkups'].isin(['No', 'Yes']).astype(int)
    df_output['History_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery', 'Still-born delivery']).astype(int)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    df_output['Disease_before_pregnancy'] = (df_input['Disease before pregnancy'] == 'No').astype(int)
    df_output['Marital_status'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Fear_of_pregnancy'] = (df_input['Fear of pregnancy'] == 'Yes').astype(int)
    df_output['Number_latest_pregnancy'] = df_input['Number of the latest pregnancy'].isin([1, 2]).astype(int)
    df_output['Age'] = ((df_input['Age'] >= 18) & (df_input['Age'] <= 31)).astype(int)
    return df_output