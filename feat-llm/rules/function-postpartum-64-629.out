def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Received_Support_Low_Medium'] = df_input['Received Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Feeling_for_regular_activities_Worried_Tired_Afraid'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Trust_and_share_feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Regular_checkups_No'] = (df_input['Regular checkups'] == 'No').astype(int)
    df_output['Family_type_Nuclear_Joint'] = df_input['Family type'].isin(['Nuclear', 'Joint']).astype(int)
    df_output['Newborn_illness_Yes_No'] = df_input['Newborn illness'].isin(['Yes', 'No']).astype(int)
    df_output['Breastfeed_Yes_No'] = df_input['Breastfeed'].isin(['Yes', 'No']).astype(int)
    df_output['Age_of_newborn_0_6_6_12_12_18_months'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year', '1 year to 1.5 year']).astype(int)
    df_output['Age_<=_30'] = (df_input['Age'] <= 30).astype(int)
    df_output['Monthly_income_before_latest_pregnancy'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'Less than 5000', '10000 to 20000']).astype(int)
    return df_output

