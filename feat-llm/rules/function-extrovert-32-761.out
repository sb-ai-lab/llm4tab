def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_Monthly_or_Never'] = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never']).astype(int)
    df_output['gathering_size_preference_Small_gatherings_or_Never'] = df_input['gathering_size_preference'].str.lower().isin(['small gatherings', 'never']).astype(int)
    df_output['valued_friendship_traits_Honesty'] = df_input['valued_friendship_traits'].str.lower().isin(['honesty']).astype(int)
    df_output['conflict_resolution_style_Avoid_or_Let_time_fix'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)
    df_output['family_support_level_No_or_Never'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)
    df_output['social_battery_recharge_Alone_or_None'] = df_input['social_battery_recharge'].str.lower().isin(['alone time', 'none of the above']).astype(int)
    df_output['social_orientation_type_Introvert_or_Not_sure'] = df_input['social_orientation_type'].str.lower().isin(['introvert', 'not sure']).astype(int)
    df_output['social_anxiety_level_Nervous_or_Avoid_it'] = df_input['social_anxiety_level'].str.lower().isin(['nervous', 'avoid it']).astype(int)
    df_output['emotional_expression_method_Stay_silent_or_Other'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    df_output['social_connection_Monthly_and_gathering_Small'] = ((df_input['social_connection_frequency'].str.lower() == 'monthly') & (df_input['gathering_size_preference'].str.lower() == 'small gatherings')).astype(int)
    return df_output

