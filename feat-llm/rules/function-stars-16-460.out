def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    sp_ends_v = df_input['SpType'].str.endswith('V')
    df_output['SpType_ends_with_V'] = sp_ends_v.astype(int)
    df_output['Amag_ge_14_4'] = (df_input['Amag'] >= 14.4).astype(int)
    cond_bv_range = ((df_input['B-V'] >= -0.15) & (df_input['B-V'] <= 0.5))
    cond_sp_bf = df_input['SpType'].str.startswith(('B','F')) & sp_ends_v
    df_output['B-V_in_range_for_BF_V'] = (cond_bv_range & cond_sp_bf).astype(int)
    cond_plx_range = (df_input['Plx'] >= 2.0) & (df_input['Plx'] <= 13.0)
    df_output['Plx_in_range_2_13_and_SpType_V_and_Amag_ge_14_4'] = (cond_plx_range & sp_ends_v & (df_input['Amag'] >= 14.4)).astype(int)
    df_output['Vmag_gt_6_and_SpType_V'] = ((df_input['Vmag'] > 6.0) & sp_ends_v).astype(int)
    df_output['Amag_ge_14_4_and_B-V_lt_0_5'] = ((df_input['Amag'] >= 14.4) & (df_input['B-V'] < 0.5)).astype(int)
    sptype_list = ['B5V', 'B9V', 'A0V', 'F0V', 'F3V', 'F5V', 'F7V', 'G6V', 'K5V']
    df_output['SpType_in_list'] = df_input['SpType'].isin(sptype_list).astype(int)
    df_output['B-V_le_0_5_and_Amag_ge_14_4'] = ((df_input['B-V'] <= 0.5) & (df_input['Amag'] >= 14.4)).astype(int)
    cond_plx_range_2_10 = (df_input['Plx'] >= 2.0) & (df_input['Plx'] <= 10.0)
    df_output['Plx_in_2_10_and_e_Plx_lt_1_2_and_SpType_V'] = (cond_plx_range_2_10 & (df_input['e_Plx'] < 1.2) & sp_ends_v).astype(int)
    cond_vmag_range = (df_input['Vmag'] >= 6.5) & (df_input['Vmag'] <= 10.0)
    df_output['Vmag_in_6_5_10_and_SpType_V_and_Amag_ge_14_4'] = (cond_vmag_range & sp_ends_v & (df_input['Amag'] >= 14.4)).astype(int)
    return df_output

