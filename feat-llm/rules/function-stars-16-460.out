def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    sp = df_input['SpType'].astype(str)
    amag = df_input['Amag']
    bv = df_input['B-V']
    plx = df_input['Plx']
    vmag = df_input['Vmag']

    cond1 = sp.str.endswith('III') | sp.str.endswith('II')
    cond2 = amag < 14.7
    cond3 = (bv >= 0.7) & (bv <= 1.4) & sp.str.endswith('III')
    cond4 = sp.isin(['K0III', 'K1III', 'K2III', 'K3III', 'F3III', 'A3III', 'B7II'])
    cond5 = (amag < 16.7) & (sp.str.endswith('III') | sp.str.endswith('II'))
    cond6 = (bv >= 0.7) & sp.str.endswith('III')
    cond7 = (plx >= 1.5) & (plx <= 12.0) & (sp.str.endswith('III') | sp.str.endswith('II'))
    cond8 = (vmag < 8.0) & (sp.str.endswith('III') | sp.str.endswith('II'))
    cond9 = (amag >= 13.8) & (amag <= 17.1) & (sp.str.endswith('III') | sp.str.endswith('II'))
    cond10 = (bv >= 1.0) & (bv <= 1.4) & sp.str.endswith('III')

    df_output['SpType_III_or_II'] = cond1.astype(int)
    df_output['Amag_lt_14_7'] = cond2.astype(int)
    df_output['B_V_0_7_1_4_KIII'] = cond3.astype(int)
    df_output['SpType_in_list'] = cond4.astype(int)
    df_output['Amag_lt_16_7_III_II'] = cond5.astype(int)
    df_output['B_V_gte_0_7_III'] = cond6.astype(int)
    df_output['Plx_1_5_12_0_III_II'] = cond7.astype(int)
    df_output['Vmag_lt_8_0_III_II'] = cond8.astype(int)
    df_output['Amag_13_8_17_1_III_II'] = cond9.astype(int)
    df_output['B_V_1_0_1_4_III'] = cond10.astype(int)

    return df_output

