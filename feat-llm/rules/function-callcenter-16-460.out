def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_condition'] = df_input['The_reason_of_the_call'].isin(['Inquiries', 'Medical_Consultation', 'Vaccination']).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_condition'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_condition'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['Call_151_condition'] = df_input['Call_151'].isin(['No', 'Yes']).astype(int)
    df_output['Aware_151_condition'] = df_input['Aware_151'].isin(['No', 'Yes']).astype(int)
    df_output['How_often_do_you_receive_call_center_news_condition'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.5).astype(int)
    df_output['Gender_condition'] = (df_input['Gender'] == 'Female').astype(int)
    df_output['Age_condition'] = df_input['Age'].isin(['30-39', '40-49', '50-59']).astype(int)
    df_output['Education_condition'] = df_input['Education'].isin(['Bachelor', 'Master', 'Diploma']).astype(int)
    df_output['Nationality_condition'] = (df_input['Nationality'] == 'Kuwaiti').astype(int)
    return df_output