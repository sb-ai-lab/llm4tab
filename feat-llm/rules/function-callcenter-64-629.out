def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call_in_Inquiries_Medical_Consultation'] = df_input['The_reason_of_the_call'].isin(['Inquiries', 'Medical_Consultation']).astype(int)
    df_output['Call_151_is_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_is_No'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['How_often_do_you_receive_call_center_news_gt_2'] = (df_input['How_often_do_you_receive_call_center_news'] > 2.0).astype(int)
    df_output['Age_18_24_and_communication_skills_eq_3_and_satisfaction_eq_3'] = (
        (df_input['Age'] == '18-24') &
        (df_input['Call_center_employee_communication_skills_evaluation'] == 3.0) &
        (df_input['Satisfaction_with_the_doctors_response'] == 3.0)
    ).astype(int)
    df_output['Education_in_High_school_Diploma_and_Call_151_No'] = (
        df_input['Education'].isin(['High school', 'Diploma']) &
        (df_input['Call_151'] == 'No')
    ).astype(int)
    df_output['Marital_Status_in_Single_Married_and_The_reason_of_the_call_Complaints_and_communication_skills_eq_3_and_satisfaction_eq_3'] = (
        df_input['Marital_Status'].isin(['Single', 'Married']) &
        (df_input['The_reason_of_the_call'] == 'Complaints') &
        (df_input['Call_center_employee_communication_skills_evaluation'] == 3.0) &
        (df_input['Satisfaction_with_the_doctors_response'] == 3.0)
    ).astype(int)
    df_output['Gender_Female_and_The_reason_of_the_call_in_Inquiries_Complaints_and_satisfaction_ge_3'] = (
        (df_input['Gender'] == 'Female') &
        df_input['The_reason_of_the_call'].isin(['Inquiries', 'Complaints']) &
        (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)
    ).astype(int)
    return df_output

