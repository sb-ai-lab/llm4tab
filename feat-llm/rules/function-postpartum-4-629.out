def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Received Support'] = df_input['Received Support'].isin(['High', 'Medium']).astype(int)
    df_output['Relationship with the in-laws'] = df_input['Relationship with the in-laws'].isin(['Good', 'Friendly', 'Neutral']).astype(int)
    df_output['Newborn illness'] = (df_input['Newborn illness'] == 'No').astype(int)
    df_output['Birth compliancy'] = (df_input['Birth compliancy'] == 'No').astype(int)
    df_output['Diseases during pregnancy'] = (df_input['Diseases during pregnancy'] == 'No').astype(int)
    df_output['Addiction'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Education Level'] = df_input['Education Level'].isin(['University', 'College']).astype(int)
    df_output['Occupation before latest pregnancy'] = df_input['Occupation before latest pregnancy'].isin(['Teacher', 'Doctor', 'Student', 'Service', 'Business']).astype(int)
    df_output['Family type'] = df_input['Family type'].isin(['Joint', 'Nuclear']).astype(int)
    df_output['Residence'] = df_input['Residence'].isin(['City', 'Village']).astype(int)
    return df_output

