def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['History of pregnancy loss'] = df_input['History of pregnancy loss'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Marital status'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Married' else 0)
    df_output['Need for Support'] = df_input['Need for Support'].apply(lambda x: 1 if x in ['No', 'Low'] else 0)
    df_output['Angry after latest child birth'] = df_input['Angry after latest child birth'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Recieved Support'] = df_input['Recieved Support'].apply(lambda x: 1 if x in ['High', 'Medium'] else 0)
    df_output['Education Level'] = df_input['Education Level'].apply(lambda x: 1 if x in ['University', 'College'] else 0)
    df_output['Regular checkups'] = df_input['Regular checkups'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Husband’s monthly income'] = df_input['Husband’s monthly income'].apply(lambda x: 1 if x in ['20000 to 30000', 'More than 30000'] else 0)
    df_output['Pregnancy length'] = df_input['Pregnancy length'].apply(lambda x: 1 if x in ['9 months', '10 months'] else 0)
    df_output['Occupation After Your Latest Childbirth'] = df_input['Occupation After Your Latest Childbirth'].apply(lambda x: 1 if x in ['Doctor', 'Teacher', 'Business'] else 0)
    return df_output

