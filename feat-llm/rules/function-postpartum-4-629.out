def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling for regular activities'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Relax/sleep when the newborn is asleep'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    df_output['Relationship with the newborn'] = df_input['Relationship with the newborn'].isin(['Bad', 'Neutral']).astype(int)
    df_output['Feeling about motherhood'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Angry after latest child birth'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Diseases during pregnancy'] = df_input['Diseases during pregnancy'].str.lower().isin(['chronic disease', 'non-chronic disease']).astype(int)
    df_output['Birth compliancy'] = (df_input['Birth compliancy'] == 'Yes').astype(int)
    df_output['Regular checkups'] = (df_input['Regular checkups'] == 'No').astype(int)
    df_output['Newborn illness'] = (df_input['Newborn illness'] == 'Yes').astype(int)
    df_output['Current monthly income'] = df_input['Current monthly income'].isin(['No', 'Less than 5000']).astype(int)
    return df_output