def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Received Support is Low'] = (df_input['Received Support'] == 'Low').astype(int)
    df_output['Relationship with the in-laws is in [Bad, Poor]'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor']).astype(int)
    df_output['Newborn illness is Yes'] = (df_input['Newborn illness'] == 'Yes').astype(int)
    df_output['Birth compliancy is Yes'] = (df_input['Birth compliancy'] == 'Yes').astype(int)
    df_output['Diseases during pregnancy is in [Chronic Disease, Non-Chronic Disease, Chronic disease, Non-chronic disease]'] = df_input['Diseases during pregnancy'].str.lower().isin(['chronic disease', 'non-chronic disease']).astype(int)
    df_output['Addiction is in [Smoking, Drinking, Drugs]'] = df_input['Addiction'].isin(['Smoking', 'Drinking', 'Drugs']).astype(int)
    df_output['Education Level is in [High School, Primary School, No]'] = df_input['Education Level'].isin(['High School', 'Primary School', 'No']).astype(int)
    df_output['Occupation before latest pregnancy is Housewife or House wife'] = df_input['Occupation before latest pregnancy'].isin(['Housewife', 'House wife']).astype(int)
    df_output['Family type is Joint'] = (df_input['Family type'] == 'Joint').astype(int)
    df_output['Residence is City'] = (df_input['Residence'] == 'City').astype(int)
    return df_output

