def extracting_features_0(df_input):
    conditions = {
        'social_connection_frequency': ['Never', 'Rarely', 'Monthly'],
        'gathering_size_preference': ['Never', 'Large events'],
        'valued_friendship_traits': ['Honesty'],
        'conflict_resolution_style': ['Avoid conflict', 'Let time fix it'],
        'family_support_level': ['No', 'Never'],
        'social_battery_recharge': ['Alone time', 'None of the above'],
        'social_orientation_type': ['Introvert', 'Not sure'],
        'social_anxiety_level': ['Avoid it', 'Nervous'],
        'emotional_expression_method': ['Stay silent', 'Other'],
        'primary_anger_sources': ['Unnecessary criticism']
    }
    df_output = pd.DataFrame()
    for col, valid_vals in conditions.items():
        df_output[col] = df_input[col].apply(lambda x: 1 if x in valid_vals else 0)
    return df_output

