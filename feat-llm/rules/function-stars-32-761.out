def extracting_features_0(df_input):
    conditions = {
        'SpType_in_list': df_input['SpType'].isin(['G1V', 'F3V', 'G3/G5V', 'A0IV/V', 'F5V', 'A1V', 'G3V', 'F0V', 'F6V', 'G3V']).astype(int),
        'Amag_gt_16': (df_input['Amag'] > 16.0).astype(int),
        'Amag_in_16_20': ((df_input['Amag'] >= 16.0) & (df_input['Amag'] <= 20.0)).astype(int),
        'B-V_in_0.1_0.7': ((df_input['B-V'] >= 0.1) & (df_input['B-V'] <= 0.7)).astype(int),
        'Plx_ge_3': (df_input['Plx'] >= 3.0).astype(int),
        'Vmag_ge_7': (df_input['Vmag'] >= 7.0).astype(int),
        'e_Plx_lt_1.5': (df_input['e_Plx'] < 1.5).astype(int),
        'B-V_lt_0.8': (df_input['B-V'] < 0.8).astype(int),
        'Plx_in_3_20': ((df_input['Plx'] >= 3.0) & (df_input['Plx'] <= 20.0)).astype(int),
        'Vmag_in_6.5_9.5': ((df_input['Vmag'] >= 6.5) & (df_input['Vmag'] <= 9.5)).astype(int)
    }
    df_output = df_input.copy()
    for key in conditions:
        df_output[key] = conditions[key]
    return df_output[conditions.keys()]

