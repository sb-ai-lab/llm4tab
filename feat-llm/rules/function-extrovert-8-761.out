def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].apply(lambda x: 1 if x == 'Daily' else 0)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].apply(lambda x: 1 if x == 'Small gatherings' else 0)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].apply(lambda x: 1 if x == 'Honesty' else 0)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].apply(lambda x: 1 if x == 'Talk it out' else 0)
    df_output['family_support_level'] = df_input['family_support_level'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].apply(lambda x: 1 if x == 'Alone time' else 0)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].apply(lambda x: 1 if x == 'Not sure' else 0)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].apply(lambda x: 1 if x == 'Neutral' else 0)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].apply(lambda x: 1 if x == 'Express emotion strongly' else 0)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].apply(lambda x: 1 if x == 'Unnecessary criticism' else 0)
    return df_output

