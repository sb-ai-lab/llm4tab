    df_output = pd.DataFrame()
    df_output['cond_1'] = ((df_input['social_connection_frequency'].str.lower().isin(['daily', 'weekly'])) & (df_input['gathering_size_preference'].str.lower() == 'both')).astype(int)
    df_output['cond_2'] = ((df_input['valued_friendship_traits'].str.lower() == 'support') & (df_input['conflict_resolution_style'].str.lower() == 'apologize first')).astype(int)
    df_output['cond_3'] = (df_input['social_battery_recharge'].str.lower().isin(['talking to someone', 'social media'])).astype(int)
    df_output['cond_4'] = (df_input['social_orientation_type'].str.lower().isin(['extrovert', 'ambivert'])).astype(int)
    df_output['cond_5'] = (df_input['social_anxiety_level'].str.lower() == 'excited').astype(int)
    df_output['cond_6'] = (df_input['emotional_expression_method'].str.lower() == 'talk openly').astype(int)
    df_output['cond_7'] = ((df_input['family_support_level'].str.lower().isin(['yes', 'sometimes'])) & (df_input['social_connection_frequency'].str.lower() == 'weekly')).astype(int)
    df_output['cond_8'] = ((df_input['gathering_size_preference'].str.lower() == 'large events') & (df_input['social_connection_frequency'].str.lower() == 'daily')).astype(int)
    df_output['cond_9'] = ((df_input['conflict_resolution_style'].str.lower() == 'apologize first') & (df_input['valued_friendship_traits'].str.lower() == 'support')).astype(int)
    df_output['cond_10'] = ((df_input['social_connection_frequency'].str.lower() == 'monthly') & (df_input['gathering_size_preference'].str.lower() == 'never') & (df_input['emotional_expression_method'].str.lower() == 'talk openly')).astype(int)
    return df_output

