def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_child_birth_No'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['Relationship_with_newborn_Good_or_Very_good'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Feeling_about_motherhood_Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Trust_and_share_feelings_Yes'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['History_of_pregnancy_loss_No'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Mode_of_delivery_Normal_Delivery'] = (df_input['Mode of delivery'] == 'Normal Delivery').astype(int)
    df_output['Number_of_household_members_6_to_8_or_9_or_more'] = df_input['Number of household members'].isin(['6 to 8', '9 or more']).astype(int)
    df_output['Education_Level_University_or_College'] = df_input['Education Level'].isin(['University', 'College']).astype(int)
    df_output['Pregnancy_length_9_or_10_months'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    combined_condition = ((df_input['Angry after latest child birth'] == 'Yes') & 
                          (df_input['Feeling about motherhood'] == 'Happy') & 
                          (df_input['Relationship with the newborn'] == 'Good'))
    df_output['Angry_Yes_Feel_Happy_Rel_Good'] = (~combined_condition).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_child_birth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Feeling_about_motherhood_Neutral_or_Sad'] = df_input['Feeling about motherhood'].isin(['Neutral', 'Sad']).astype(int)
    df_output['Trust_and_share_feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['History_of_pregnancy_loss_Miscarriage_or_Stillborn'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery', 'Still-born delivery']).astype(int)
    df_output['Relationship_with_newborn_Neutral_or_worse'] = df_input['Relationship with the newborn'].isin(['Neutral', 'Bad', 'Very bad']).astype(int)
    df_output['Mode_of_delivery_Caesarean_Section'] = (df_input['Mode of delivery'] == 'Caesarean Section').astype(int)
    df_output['Number_of_household_members_2_to_5'] = (df_input['Number of household members'] == '2 to 5').astype(int)
    df_output['Education_Level_Primary_College_HighSchool'] = df_input['Education Level'].isin(['Primary School', 'High School', 'College']).astype(int)
    df_output['Pregnancy_length_<=9_months'] = df_input['Pregnancy length'].isin(['9 months', '8 months']).astype(int)
    df_output['Angry_and_Feeling_Strong_Indicator'] = ((df_input['Angry after latest child birth'] == 'Yes') & (df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']))).astype(int)
    return df_output