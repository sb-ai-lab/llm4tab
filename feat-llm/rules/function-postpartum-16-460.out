def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood_Sad_or_Neutral'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Worry_about_newborn_Yes'] = df_input['Worry about newborn'].isin(['Yes']).astype(int)
    df_output['Diseases_during_pregnancy_Chronic_or_NonChronic'] = df_input['Diseases during pregnancy'].isin(['Chronic Disease', 'Non-Chronic Disease']).astype(int)
    df_output['Regular_checkups_No'] = df_input['Regular checkups'].isin(['No']).astype(int)
    df_output['Addiction_Smoking_Drinking_Drugs'] = df_input['Addiction'].isin(['Smoking', 'Drinking', 'Drugs']).astype(int)
    df_output['Husband_education_level_Primary_High_No'] = df_input["Husband's education level"].isin(['Primary School', 'High School', 'No']).astype(int)
    df_output['Occupation_After_Latest_Childbirth_Housewife_Housewife_Other'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'House wife', 'Other']).astype(int)
    df_output['Family_type_Joint'] = df_input['Family type'].isin(['Joint']).astype(int)
    df_output['Occupation_before_latest_pregnancy_Housewife_Housewife_Other'] = df_input['Occupation before latest pregnancy'].isin(['Housewife', 'House wife', 'Other']).astype(int)
    df_output['Pregnancy_length_Short'] = df_input['Pregnancy length'].isin(['Less than 5 months', '6 months', '7 months', '8 months']).astype(int)
    return df_output

