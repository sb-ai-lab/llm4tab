def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Good', 'Neutral', 'Friendly']).astype(int)
    df_output['Trust_and_share_feelings'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['Pregnancy_plan'] = df_input['Pregnancy plan'].isin(['Yes', 'No']).astype(int)
    df_output['Fear_of_pregnancy'] = df_input['Fear of pregnancy'].isin(['Yes', 'No']).astype(int)
    df_output['Breastfeed'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    df_output['Relax_sleep_when_newborn_asleep'] = (df_input['Relax/sleep when the newborn is asleep'] == 'Yes').astype(int)
    df_output['Major_changes_or_losses_during_pregnancy'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Husband_education_level'] = df_input["Husband's education level"].isin(['University', 'High School', 'College']).astype(int)
    df_output['Age_in_range'] = df_input['Age'].between(22, 34).astype(int)
    df_output['Gender_of_newborn'] = df_input['Gender of newborn'].isin(['Boy', 'Girl']).astype(int)
    return df_output

