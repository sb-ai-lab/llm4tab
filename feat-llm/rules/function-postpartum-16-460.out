def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood_Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Worry_about_newborn_No'] = (df_input['Worry about newborn'] == 'No').astype(int)
    df_output['Diseases_during_pregnancy_No'] = (df_input['Diseases during pregnancy'] == 'No').astype(int)
    df_output['Regular_checkups_Yes'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    df_output['Addiction_No'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Husband_education_level_University_College'] = df_input['Husband\'s education level'].isin(['University', 'College']).astype(int)
    df_output['Occupation_After_Your_Latest_Childbirth'] = df_input['Occupation After Your Latest Childbirth'].isin(['Doctor', 'Teacher', 'Service', 'Student', 'Business']).astype(int)
    df_output['Family_type_Nuclear'] = (df_input['Family type'] == 'Nuclear').astype(int)
    df_output['Occupation_before_latest_pregnancy'] = df_input['Occupation before latest pregnancy'].isin(['Doctor', 'Teacher', 'Student', 'Service', 'Business']).astype(int)
    df_output['Pregnancy_length_9_10_months'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    return df_output

