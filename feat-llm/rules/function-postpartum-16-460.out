def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Relationship_with_husband_good_neutral'] = df_input['Relationship with husband'].isin(['Good', 'Neutral']).astype(int)  
    df_output['Trust_and_share_feelings'] = df_input['Trust and share feelings'].isin(['No', 'Yes']).astype(int)  
    df_output['Pregnancy_plan_yes'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)  
    df_output['Fear_of_pregnancy_yes_no'] = df_input['Fear of pregnancy'].isin(['Yes', 'No']).astype(int)  
    df_output['Breastfeed_yes_no'] = df_input['Breastfeed'].isin(['No', 'Yes']).astype(int)  
    df_output['Relax_sleep_when_newborn_asleep_yes_no'] = df_input['Relax/sleep when the newborn is asleep'].isin(['No', 'Yes']).astype(int)  
    df_output['Major_changes_losses_during_pregnancy_yes_no'] = df_input['Major changes or losses during pregnancy'].isin(['Yes', 'No']).astype(int)  
    df_output['Husband_education_university_college'] = df_input['Husband\'s education level'].isin(['University', 'College']).astype(int)  
    df_output['Age_25_40'] = ((df_input['Age'] >= 25) & (df_input['Age'] <= 40)).astype(int)  
    df_output['Gender_of_newborn_girl'] = (df_input['Gender of newborn'] == 'Girl').astype(int)  
    return df_output

