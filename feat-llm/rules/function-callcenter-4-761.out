def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_condition'] = df_input['The_reason_of_the_call'].isin(['Vaccination', 'Inquiries', 'Inquiries_COVID19', 'Medical_Consultation']).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_condition'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 4.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_condition'] = (df_input['Satisfaction_with_the_doctors_response'] >= 4.0).astype(int)
    df_output['Call_151_condition'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_condition'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['Education_condition'] = df_input['Education'].isin(['High school', 'Less than high school', 'Diploma', 'Other']).astype(int)
    df_output['How_often_do_you_receive_call_center_news_condition'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.0).astype(int)
    df_output['Age_condition'] = df_input['Age'].isin(['18-24', '50-59', '60 and above']).astype(int)
    df_output['Gender_condition'] = (df_input['Gender'] == 'Male').astype(int)
    df_output['Governorate_condition'] = df_input['Governorate'].isin(['Jahra', 'Mubarak AlKabir']).astype(int)
    return df_output