def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relax_sleep_when_newborn_asleep_No'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    df_output['Trust_and_share_feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Abuse_Yes'] = (df_input['Abuse'] == 'Yes').astype(int)
    df_output['Pregnancy_plan_No'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Relationship_with_newborn_Neutral_Bad_Very_bad'] = df_input['Relationship with the newborn'].isin(['Neutral', 'Bad', 'Very bad']).astype(int)
    df_output['Worry_about_newborn_Yes'] = (df_input['Worry about newborn'] == 'Yes').astype(int)
    df_output['Birth_compliancy_Yes'] = (df_input['Birth compliancy'] == 'Yes').astype(int)
    df_output['Age_of_newborn_Older_than_1.5_year'] = (df_input['Age of newborn'] == 'Older than 1.5 year').astype(int)
    df_output['Mode_of_delivery_Normal_Delivery'] = (df_input['Mode of delivery'] == 'Normal Delivery').astype(int)
    age = pd.to_numeric(df_input['Age'], errors='coerce')
    df_output['Age_in_range_30_35_or_ge_30'] = (((age >= 30) & (age <= 35)) | (age >= 30)).astype(int)
    return df_output

