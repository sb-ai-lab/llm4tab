def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['rel_newborn_neutral_or_bad'] = df_input['Relationship with the newborn'].isin(['Neutral', 'Bad']).astype(int)
    df_output['major_changes_losses_pregnancy_yes'] = (df_input.get('Major changes or losses during pregnancy', '') == 'Yes').astype(int)
    df_output['fear_pregnancy_no'] = (df_input.get('Fear of pregnancy', '') == 'No').astype(int)
    df_output['history_preg_loss_mis_still'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['worry_newborn_yes'] = (df_input.get('Worry about newborn', '') == 'Yes').astype(int)
    df_output['disease_before_preg_chronic'] = (df_input.get('Disease before pregnancy', '') == 'Chronic Disease').astype(int)
    df_output['regular_checkups_yes_and_major_changes_yes'] = ((df_input.get('Regular checkups', '') == 'Yes') & (df_input.get('Major changes or losses during pregnancy', '') == 'Yes')).astype(int)
    df_output['total_children_one_and_fear_preg_no'] = ((df_input.get('Total children', '') == 'One') & (df_input.get('Fear of pregnancy', '') == 'No')).astype(int)
    df_output['rel_newborn_good_and_worry_newborn_yes'] = ((df_input['Relationship with the newborn'] == 'Good') & (df_input.get('Worry about newborn', '') == 'Yes')).astype(int)
    df_output['major_changes_yes_and_hist_preg_loss'] = ((df_input.get('Major changes or losses during pregnancy', '') == 'Yes') & (df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']))).astype(int)
    return df_output

---VERSION---

