def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].isin(['Happy', 'Neutral']).astype(int)
    df_output['Angry_after_latest_child_birth'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['Number_of_household_members'] = df_input['Number of household members'].isin(['2 to 5', '6 to 8']).astype(int)
    df_output['Disease_before_pregnancy'] = (df_input['Disease before pregnancy'] == 'No').astype(int)
    df_output['Occupation_before_latest_pregnancy'] = df_input['Occupation before latest pregnancy'].isin(['Student', 'Housewife', 'Other']).astype(int)
    df_output['Husband_education_level'] = df_input["Husband's education level"].isin(['University', 'College', 'High School']).astype(int)
    df_output['Age_of_newborn'] = df_input['Age of newborn'].isin(['Older than 1.5 year', '1 year to 1.5 year']).astype(int)
    df_output['Pregnancy_length'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    df_output['Relationship_with_inlaws'] = df_input['Relationship with the in-laws'].isin(['Good', 'Neutral', 'Friendly']).astype(int)
    df_output['Gender_of_newborn'] = df_input['Gender of newborn'].isin(['Boy', 'Girl']).astype(int)
    return df_output

