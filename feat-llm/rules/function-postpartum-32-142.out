def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities'] = df_input['Feeling for regular activities'].apply(lambda x: 1 if x in ['Afraid', 'Tired', 'Worried'] else 0)
    df_output['Feeling_for_regular_activities_Afraid_Tired'] = df_input['Feeling for regular activities'].apply(lambda x: 1 if x in ['Afraid', 'Tired'] else 0)
    df_output['Angry_after_latest_child_birth'] = df_input['Angry after latest child birth'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].apply(lambda x: 1 if x in ['Bad', 'Neutral'] else 0)
    df_output['Received_Support'] = df_input['Received Support'].apply(lambda x: 1 if x == 'Low' else 0)
    df_output['Need_for_Support'] = df_input['Need for Support'].apply(lambda x: 1 if x in ['Low', 'Medium'] else 0)
    df_output['Abuse'] = df_input['Abuse'].apply(lambda x: 1 if x == 'No' else 0)
    df_output['Family_type'] = df_input['Family type'].apply(lambda x: 1 if x == 'Nuclear' else 0)
    df_output['Number_of_household_members'] = df_input['Number of household members'].apply(lambda x: 1 if x in ['2 to 5', '6 to 8'] else 0)
    df_output['Regular_checkups'] = df_input['Regular checkups'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Mode_of_delivery'] = df_input['Mode of delivery'].apply(lambda x: 1 if x in ['Normal Delivery', 'Caesarean Section'] else 0)
    return df_output

