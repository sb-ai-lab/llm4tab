def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Bad', 'Neutral']).astype(int)
    df_output['Family_type'] = df_input['Family type'].isin(['Nuclear']).astype(int)
    df_output['Diseases_during_pregnancy'] = df_input['Diseases during pregnancy'].str.lower().isin(['chronic disease', 'non-chronic disease']).astype(int)
    df_output['Addiction'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].isin(['10000 to 20000', '5000 to 10000', '20000 to 30000']).astype(int)
    df_output['Trust_and_share_feelings'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Residence'] = df_input['Residence'].isin(['City', 'Village']).astype(int)
    df_output['Regular_checkups'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    df_output['Breastfeed'] = (df_input['Breastfeed'] == 'No').astype(int)
    df_output['Newborn_illness'] = (df_input['Newborn illness'] == 'Yes').astype(int)
    return df_output