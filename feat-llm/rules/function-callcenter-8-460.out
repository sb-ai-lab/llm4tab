def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation_gt_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] > 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_gt_3'] = (df_input['Satisfaction_with_the_doctors_response'] > 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news_gt_3'] = (df_input['How_often_do_you_receive_call_center_news'] > 3.0).astype(int)
    df_output['Gender_Female'] = (df_input['Gender'] == 'Female').astype(int)
    df_output['Age_18_24'] = (df_input['Age'] == '18-24').astype(int)
    df_output['The_reason_of_the_call_Complaints_and_high_eval'] = ((df_input['The_reason_of_the_call'] == 'Complaints') & 
                                                                    (df_input['Call_center_employee_communication_skills_evaluation'] > 3.0) & 
                                                                    (df_input['Satisfaction_with_the_doctors_response'] > 3.0)).astype(int)
    df_output['Aware_151_Yes'] = (df_input['Aware_151'] == 'Yes').astype(int)
    df_output['Call_151_Yes_or_No'] = df_input['Call_151'].isin(['Yes', 'No']).astype(int)
    df_output['Marital_Status_Single'] = (df_input['Marital_Status'] == 'Single').astype(int)
    df_output['Governorate_in_selected'] = df_input['Governorate'].isin(['AlAhmadi', 'Around', 'Capital']).astype(int)
    return df_output

