def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_le_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_le_3'] = (df_input['Satisfaction_with_the_doctors_response'] <= 3.0).astype(int)
    df_output['Gender_Male'] = (df_input['Gender'] == 'Male').astype(int)
    df_output['Age_in_18_24_25_29_30_39'] = df_input['Age'].isin(['18-24', '25-29', '30-39']).astype(int)
    df_output['Aware_151_No'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['Call_151_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Nationality_Kuwaiti'] = (df_input['Nationality'] == 'Kuwaiti').astype(int)
    df_output['How_often_do_you_receive_call_center_news_le_3'] = (df_input['How_often_do_you_receive_call_center_news'] <= 3.0).astype(int)
    df_output['Education_in_High_school_Bachelor'] = df_input['Education'].isin(['High school', 'Bachelor']).astype(int)
    return df_output

