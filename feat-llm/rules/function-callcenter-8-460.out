def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['Gender_Female_And_The_reason_of_the_call_Complaints'] = ((df_input['Gender'] == 'Female') & (df_input['The_reason_of_the_call'] == 'Complaints')).astype(int)
    df_output['How_often_do_you_receive_call_center_news'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.6).astype(int)
    df_output['Aware_151_Yes_And_Call_151_No'] = ((df_input['Aware_151'] == 'Yes') & (df_input['Call_151'] == 'No')).astype(int)
    df_output['Age_18_24_or_50_59_And_The_reason_of_the_call_Complaints'] = ((df_input['Age'].isin(['18-24', '50-59'])) & (df_input['The_reason_of_the_call'] == 'Complaints')).astype(int)
    df_output['Nationality_Kuwaiti_And_The_reason_of_the_call_Complaints'] = ((df_input['Nationality'] == 'Kuwaiti') & (df_input['The_reason_of_the_call'] == 'Complaints')).astype(int)
    df_output['Marital_Status_Widow_or_Married'] = (df_input['Marital_Status'].isin(['Widow', 'Married'])).astype(int)
    df_output['Education_Diploma_or_High_school'] = (df_input['Education'].isin(['Diploma', 'High school'])).astype(int)
    df_output['Governorate_Capital_or_Around'] = (df_input['Governorate'].isin(['Capital', 'Around'])).astype(int)
    return df_output

