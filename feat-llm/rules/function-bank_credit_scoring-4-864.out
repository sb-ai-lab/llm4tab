def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Debt'] = ((df_input['Debt'] >= 1500) & (df_input['Debt'] <= 5000)).astype(int)
    df_output['Overdue days'] = (df_input['Overdue days'] >= 1).astype(int)
    df_output['Initial limit'] = (df_input['Initial limit'] < 2500).astype(int)
    df_output['Credit history rating'] = df_input['Credit history rating'].isin(['C2', 'C3', 'D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] < 2000).astype(int)
    df_output['EDU'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM'] = (df_input['TERM'] >= 48).astype(int)
    df_output['UNDERAGECHILDRENCOUNT'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['LV_AREA'] = df_input['LV_AREA'].str.lower().str.replace("'", "").str.replace(".", "").str.strip()
    valid_areas = ['minskaja oblast', 'brestskaja oblast', 'gomelska oblast']
    df_output['LV_AREA'] = df_output['LV_AREA'].where(df_output['LV_AREA'].isin(valid_areas), 0)
    df_output['LV_AREA'] = df_input['LV_AREA'].str.lower().str.replace("'", "").str.replace(".", "").str.strip().isin(valid_areas).astype(int)
    return df_output

