def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    poor_ratings = ['D1', 'D2', 'D3', 'E1', 'E2', 'E3']
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_poor'] = df_input['Credit history rating'].isin(poor_ratings).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_in_range_and_poor_rating'] = ((df_input['Debt'].between(700, 2500)) & (df_input['Credit history rating'].isin(poor_ratings))).astype(int)
    df_output['INCOME_lt_1500'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['Initial_limit_le_2500'] = (df_input['Initial limit'] <= 2500).astype(int)
    df_output['EDU_in_list'] = df_input['EDU'].isin(['High school', 'Incomplete']).astype(int)
    df_output['TERM_le_36_and_poor_rating'] = ((df_input['TERM'] <= 36) & (df_input['Credit history rating'].isin(poor_ratings))).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2_and_PDN_ge_0_3'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 2) & (df_input['PDN'] >= 0.3)).astype(int)
    df_output['SEX_Male_and_D3_and_Overdue_days_gt_0'] = ((df_input['SEX'] == 'Male') & (df_input['Credit history rating'] == 'D3') & (df_input['Overdue days'] > 0)).astype(int)
    return df_output

