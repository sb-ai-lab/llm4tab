def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['Credit_history_rating_in_D_E'] = df_input['Credit history rating'].isin(['D1', 'D2', 'D3', 'E1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_in_range_and_Overdue_days_gt_0'] = ((df_input['Debt'] >= 900) & (df_input['Debt'] <= 2500) & (df_input['Overdue days'] > 0)).astype(int)
    df_output['INCOME_lt_1500'] = (df_input['INCOME'] < 1500).astype(int)
    df_output['Initial_limit_le_2500'] = (df_input['Initial limit'] <= 2500).astype(int)
    edu_cond = df_input['EDU'].isin(['High school', 'Incomplete'])
    edu_univ_low_income = (df_input['EDU'] == 'University') & (df_input['INCOME'] < 1500)
    df_output['EDU_condition'] = (edu_cond | edu_univ_low_income).astype(int)
    df_output['TERM_ge_24_and_PDN_ge_0_3'] = ((df_input['TERM'] >= 24) & (df_input['PDN'] >= 0.3)).astype(int)
    industry_cond = df_input['INDUSTRYNAME'].isin(['Trade', 'Public services', 'Agriculture'])
    df_output['INDUSTRYNAME_in_list_and_PDN_ge_0_3'] = (industry_cond & (df_input['PDN'] >= 0.3)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_2_and_low_income'] = ((df_input['UNDERAGECHILDRENCOUNT'] >= 2) & (df_input['INCOME'] < 1500)).astype(int)
    return df_output

