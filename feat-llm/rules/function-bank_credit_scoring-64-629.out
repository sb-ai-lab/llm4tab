def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_A_B_C1'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1']).astype(int)
