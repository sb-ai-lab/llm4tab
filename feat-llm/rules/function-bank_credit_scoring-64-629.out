def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Credit_history_rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1']).astype(int)  
    df_output['Overdue_days'] = (df_input['Overdue days'] == 0).astype(int)  
    df_output['PDN'] = (df_input['PDN'] < 0.3).astype(int)  
    df_output['Initial_limit'] = (df_input['Initial limit'] >= 3500).astype(int)  
    df_output['INCOME'] = (df_input['INCOME'] >= 2000).astype(int)  
    df_output['EDU'] = df_input['EDU'].isin(['College', 'University']).astype(int)  
    df_output['Debt'] = ((df_input['Debt'] >= 1000) & (df_input['Debt'] <= df_input['Initial limit'])).astype(int)  
    df_output['TERM_INCOME'] = ((df_input['TERM'] >= 24) & (df_input['INCOME'] >= 2000)).astype(int)  
    df_output['UNDERAGE_FAMILYSTATUS'] = ((df_input['UNDERAGECHILDRENCOUNT'] <= 1) & (df_input['FAMILYSTATUS'] == 1)).astype(int)  
    df_output['INDUSTRYNAME'] = df_input['INDUSTRYNAME'].isin(['Construction', 'Science and Education', 'Ministry of Internal Affairs/Ministry of Emergency Situations/Ministry of Defense', 'Production']).astype(int)  
    return df_output

