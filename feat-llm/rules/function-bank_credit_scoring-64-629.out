    df_output['Initial_limit_ge_3500'] = (df_input['Initial limit'] >= 3500).astype(int)
    df_output['Debt_ge_3000_and_Overdue_days_eq_0'] = ((df_input['Debt'] >= 3000) & (df_input['Overdue days'] == 0)).astype(int)
    df_output['INCOME_ge_2000'] = (df_input['INCOME'] >= 2000).astype(int)
    df_output['EDU_in_College_University_and_INCOME_ge_2000'] = (df_input['EDU'].isin(['College', 'University']) & (df_input['INCOME'] >= 2000)).astype(int)
    df_output['TERM_ge_36_and_PDN_less_0_3'] = ((df_input['TERM'] >= 36) & (df_input['PDN'] < 0.3)).astype(int)
    df_output['INDUSTRYNAME_in_selected'] = df_input['INDUSTRYNAME'].isin(['Science and Education', 'Ministry of Internal Affairs/Ministry of Emergency Situations/Ministry of Defense', 'Construction', 'Production']).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_le_1_and_FAMILYSTATUS_eq_1'] = ((df_input['UNDERAGECHILDRENCOUNT'] <= 1) & (df_input['FAMILYSTATUS'] == 1)).astype(int)
    return df_output

