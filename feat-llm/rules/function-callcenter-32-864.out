def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_condition'] = ((df_input['The_reason_of_the_call'].isin(['Complaints', 'Inquiries_COVID19'])) & 
                                                     (df_input['Satisfaction_with_the_doctors_response'] > df_input['Satisfaction_with_the_doctors_response'].median())).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_condition'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_condition'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news_condition'] = (df_input['How_often_do_you_receive_call_center_news'] <= 2.9).astype(int)
    df_output['Call_151_condition'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Age_condition'] = (df_input['Age'].isin(['18-24', '30-39'])).astype(int)
    df_output['Nationality_condition'] = (df_input['Nationality'] == 'Unspecified').astype(int)
    df_output['Marital_Status_condition'] = (df_input['Marital_Status'].isin(['Single', 'Married'])).astype(int)
    df_output['Education_condition'] = (df_input['Education'].isin(['Bachelor', 'Less than high school'])).astype(int)
    df_output['Governorate_condition'] = (df_input['Governorate'].isin(['Capital', 'Jahra', 'Farwaniya'])).astype(int)
    return df_output

