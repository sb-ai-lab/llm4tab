def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_condition'] = df_input['The_reason_of_the_call'].isin(['Inquiries_COVID19', 'Inquiries', 'Medical_Consultation']) | ((df_input['The_reason_of_the_call'] == 'Complaints') & ((df_input['Call_center_employee_communication_skills_evaluation'] > 3.0) & (df_input['Satisfaction_with_the_doctors_response'] > 3.0)))
    df_output['Call_center_employee_communication_skills_evaluation_condition'] = df_input['Call_center_employee_communication_skills_evaluation'] > 3.0
    df_output['Satisfaction_with_the_doctors_response_condition'] = df_input['Satisfaction_with_the_doctors_response'] > 3.0
    df_output['Gender_condition'] = df_input['Gender'] == 'Male'
    aware_counts = df_input['Aware_151'].value_counts()
    if 'Yes' in aware_counts and 'No' in aware_counts:
        df_output['Aware_151_condition'] = df_input['Aware_151'] == 'Yes'
    else:
        df_output['Aware_151_condition'] = df_input['Aware_151'].isin(['Yes', 'No'])
    call_counts = df_input['Call_151'].value_counts()
    if 'Yes' in call_counts and 'No' in call_counts:
        df_output['Call_151_condition'] = df_input['Call_151'] == 'No'
    else:
        df_output['Call_151_condition'] = df_input['Call_151'].isin(['Yes', 'No'])
    df_output['Age_condition'] = df_input['Age'].isin(['18-24', '30-39'])
    df_output['Education_condition'] = df_input['Education'].isin(['High school', 'Less than high school', 'Bachelor'])
    df_output['How_often_do_you_receive_call_center_news_condition'] = df_input['How_often_do_you_receive_call_center_news'] > 2.5
    df_output['Governorate_condition'] = df_input['Governorate'].isin(['Jahra', 'Capital', 'Farwaniya'])
    return df_output.astype(int)

