def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_leq_3_143'] = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.143).astype(int)
    df_output['Satisfaction_with_the_doctors_response_leq_3_0'] = (df_input['Satisfaction_with_the_doctors_response'] <= 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news_geq_2_6'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.6).astype(int)
    df_output['Call_151_Yes'] = (df_input['Call_151'] == 'Yes').astype(int)
    df_output['Age_Under18_18_24'] = df_input['Age'].isin(['Under 18', '18-24']).astype(int)
    df_output['Nationality_Kuwaiti_Other'] = df_input['Nationality'].isin(['Kuwaiti', 'Other nationality']).astype(int)
    df_output['Marital_Status_Single'] = (df_input['Marital_Status'] == 'Single').astype(int)
    df_output['Education_HighSchool_Bachelor'] = df_input['Education'].isin(['High school', 'Bachelor']).astype(int)
    df_output['Governorate_Jahra_Capital_Farwaniya'] = df_input['Governorate'].isin(['Jahra', 'Capital', 'Farwaniya']).astype(int)
    return df_output

