def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_contains_III'] = df_input['SpType'].str.contains('III').astype(int)
    df_output['SpType_contains_II'] = df_input['SpType'].str.contains('II').astype(int)
    df_output['Amag_lt_17'] = (df_input['Amag'] < 17).astype(int)
    df_output['B_V_ge_0_9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_lt_4_5'] = (df_input['Plx'] < 4.5).astype(int)
    df_output['Vmag_gt_7_4_and_SpType_III_or_II'] = ((df_input['Vmag'] > 7.4) & (df_input['SpType'].str.contains('III') | df_input['SpType'].str.contains('II'))).astype(int)
    df_output['Amag_in_10_17'] = ((df_input['Amag'] >= 10) & (df_input['Amag'] <= 17)).astype(int)
    df_output['B_V_in_0_9_1_6'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.6)).astype(int)
    df_output['Plx_in_0_1_4_5_and_B_V_gt_0_9'] = ((df_input['Plx'] >= 0.1) & (df_input['Plx'] <= 4.5) & (df_input['B-V'] > 0.9)).astype(int)
    sp_list = ['A9III', 'K3II/III', 'G8III', 'K5III', 'K1III', 'G6/G8III']
    df_output['SpType_in_list'] = df_input['SpType'].isin(sp_list).astype(int)
    return df_output

