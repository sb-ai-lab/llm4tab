def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_lum_class'] = df_input['SpType'].str.contains(r'(III$|III/IV$|II/III$)').astype(int)
    df_output['B-V_ge_0.9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_lt_6'] = (df_input['Plx'] < 6).astype(int)
    df_output['Amag_le_16'] = (df_input['Amag'] <= 16).astype(int)
    df_output['Vmag_gt_7.5'] = (df_input['Vmag'] > 7.5).astype(int)
    df_output['e_Plx_ge_1.0'] = (df_input['e_Plx'] >= 1.0).astype(int)
    sp_list = ['G8III/IV', 'K2III', 'K5III', 'G6/G8III', 'K1III', 'G8III', 'A9III', 'K3II/III', 'B3III/IV']
    df_output['SpType_in_list'] = df_input['SpType'].isin(sp_list).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 0.9) & (df_input['B-V'] <= 1.6)).astype(int)
    df_output['Plx_in_range'] = ((df_input['Plx'] >= 0.1) & (df_input['Plx'] <= 5.5)).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 10) & (df_input['Amag'] <= 16)).astype(int)
    return df_output