def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    sp_allowed = ['G1V', 'F3V', 'F6V', 'F8V', 'B8V', 'B9V', 'A0V', 'B9III/IV']
    df_output['SpType_in_list'] = df_input['SpType'].isin(sp_allowed).astype(int)
    df_output['Amag_ge_18'] = (df_input['Amag'] >= 18).astype(int)
    df_output['B_V_le_0_6'] = (df_input['B-V'] <= 0.6).astype(int)
    df_output['Plx_ge_4'] = (df_input['Plx'] >= 4.0).astype(int)
    df_output['Vmag_le_8_5_and_Plx_ge_4'] = ((df_input['Vmag'] <= 8.5) & (df_input['Plx'] >= 4.0)).astype(int)
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['Amag_in_18_21'] = ((df_input['Amag'] >= 18) & (df_input['Amag'] <= 21)).astype(int)
    df_output['B_V_lt_0_9_and_SpType_no_III_II'] = ((df_input['B-V'] < 0.9) & (~df_input['SpType'].str.contains('III|II'))).astype(int)
    df_output['Plx_in_4_35_and_Amag_ge_18'] = ((df_input['Plx'] >= 4) & (df_input['Plx'] <= 35) & (df_input['Amag'] >= 18)).astype(int)
    df_output['Vmag_lt_9_and_SpType_no_III_II'] = ((df_input['Vmag'] < 9) & (~df_input['SpType'].str.contains('III|II'))).astype(int)
    return df_output

