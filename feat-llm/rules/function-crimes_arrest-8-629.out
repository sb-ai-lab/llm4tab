def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['BATTERY', 'NARCOTICS', 'CRIMINAL DAMAGE']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET, NO / MINOR INJURY', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'TO VEHICLE', 'FOUND SUSPECT NARCOTICS']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['ALLEY', 'SIDEWALK', 'APARTMENT', 'STREET']).astype(int)
    df_output['Domestic_is_1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['08B', '18', '14']).astype(int)
    df_output['Primary_Type_NARCOTICS_and_Description_MANUFACTURE'] = ((df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'] == 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS')).astype(int)
    df_output['Location_STREET_and_Primary_NARCOTICS_and_FBI_18'] = ((df_input['Location Description'] == 'STREET') & (df_input['Primary Type'] == 'NARCOTICS') & (df_input['FBI Code'] == '18')).astype(int)
    df_output['Beat_in_range_and_District_15'] = ((df_input['Beat'] >= 1500) & (df_input['Beat'] <= 1550) & (df_input['District'] == 15)).astype(int)
    df_output['Ward_in_range_and_Community_in_range'] = ((df_input['Ward'] >= 25) & (df_input['Ward'] <= 30) & (df_input['Community Area'] >= 25) & (df_input['Community Area'] <= 29)).astype(int)
    date_format = "%m/%d/%Y %I:%M:%S %p"
    date_start = pd.to_datetime("01/14/2025 10:00:00 AM", format=date_format)
    date_end = pd.to_datetime("01/27/2025 05:00:00 PM", format=date_format)
    dates = pd.to_datetime(df_input['Date'], format=date_format, errors='coerce')
    df_output['Date_in_range_and_Primary_BATTERY_and_Description_AGGRAVATED'] = ((dates >= date_start) & (dates <= date_end) & (df_input['Primary Type'] == 'BATTERY') & (df_input['Description'].str.contains('AGGRAVATED P.O.'))).astype(int)
    return df_output

