def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['CRIMINAL DAMAGE', 'BATTERY', 'NARCOTICS', 'WEAPONS VIOLATION']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['AGGRAVATED P.O. - HANDS, FISTS, FEET', 'NO / MINOR INJURY', 'TO VEHICLE', 'FOUND SUSPECT NARCOTICS', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['ALLEY', 'STREET', 'APARTMENT', 'SIDEWALK']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].apply(lambda x: 1 if x==1 else 0)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08B', '14', '15', '18']).astype(int)
    df_output['Beat'] = df_input['Beat'].between(1000, 1600).astype(int)
    df_output['District'] = df_input['District'].isin([10, 15]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([25, 28, 29, 37]).astype(int)
    df_output['Community Area'] = df_input['Community Area'].isin([25, 28, 29]).astype(int)
    df_output['Year'] = (df_input['Year'] == 2025).astype(int)
    return df_output