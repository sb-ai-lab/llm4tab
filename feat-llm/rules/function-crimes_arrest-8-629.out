def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['THEFT', 'BATTERY', 'OTHER OFFENSE', 'LIQUOR LAW VIOLATION']).astype(int)  
    df_output['Description_in_list'] = df_input['Description'].isin(['$500 AND UNDER', 'SIMPLE', 'VEHICLE TITLE / REGISTRATION OFFENSE']).astype(int)  
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['RESIDENCE - PORCH / HALLWAY', 'NURSING / RETIREMENT HOME', 'CTA BUS STOP']).astype(int)  
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)  
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['06', '08B', '26']).astype(int)  
    df_output['Primary_Type_THEFT_and_Description_500_and_under'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == '$500 AND UNDER')).astype(int)  
    df_output['Location_STREET_and_Primary_WEAPONS_and_Description_RECKLESS'] = ((df_input['Location Description'] == 'STREET') & (df_input['Primary Type'] == 'WEAPONS VIOLATION') & (df_input['Description'] == 'RECKLESS FIREARM DISCHARGE')).astype(int)  
    df_output['Beat_in_range_and_District_3'] = ((df_input['Beat'] >= 320) & (df_input['Beat'] <= 330) & (df_input['District'] == 3)).astype(int)  
    df_output['Ward_in_range_and_Community_in_range'] = ((df_input['Ward'] >= 6) & (df_input['Ward'] <= 8) & (df_input['Community Area'] >= 40) & (df_input['Community Area'] <= 45)).astype(int)  
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')  
    start_date = pd.to_datetime('01/02/2025 12:00:00 PM', format='%m/%d/%Y %I:%M:%S %p')  
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')  
    df_output['Date_in_range_and_Primary_OTHER_and_FBI_26'] = ((date_parsed >= start_date) & (date_parsed <= end_date) & (df_input['Primary Type'] == 'OTHER OFFENSE') & (df_input['FBI Code'] == '26')).astype(int)  
    return df_output

