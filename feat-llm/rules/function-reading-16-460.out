def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Frequency_reading_books'] = df_input['Frequency of reading books'].isin(['A few times a week', 'Once a week', 'Rarely']).astype(int)
    df_output['Time_spent_reading_less_1'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Num_ebooks_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Num_printed_books_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Favorite_books_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Politics']).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['BBA', 'English', 'JMC', 'Others']).astype(int)
    df_output['Change_not_increase_academic'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    freq_low = df_input['Frequency of reading books'].isin(['A few times a week', 'Once a week', 'Rarely'])
    df_output['Format_used_low_freq'] = (df_input['The format that you used for reading books'].isin(['Others', 'Printed']) & freq_low).astype(int)
    df_output['Influenced_by_friends_family_low_freq'] = (df_input['Who influenced you to read books'].isin(['Friends', 'Family']) & freq_low).astype(int)
    return df_output

