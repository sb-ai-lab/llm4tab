def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_On_everyday_basis_or_Almost_every_day'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'Almost every day']).astype(int)
    df_output['Amount_time_reading_per_day_ge_1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Num_ebooks_6_10_11_15_16_20_More_than_20'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Num_printed_books_6_10_11_15_16_20_More_than_20'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'Pharmacy', 'EEE', 'SWE', 'CIS', 'Civil', 'Textile']).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Format_Both_or_Ebooks'] = df_input['The format that you used for reading books'].isin(['Both', 'E-books']).astype(int)
    df_output['Influenced_Self_or_Academic_Mentor'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Academic Mentor']).astype(int)
    cond_amount_freq = ((df_input['Amount of time spent reading books per day'] >= 1) & 
                        (df_input['Amount of time spent reading books per day'] <= 5) & 
                        (df_input['Frequency of reading books'] == 'On everyday basis'))
    df_output['Amount_1_5_and_Freq_On_everyday_basis'] = cond_amount_freq.astype(int)
    return df_output

