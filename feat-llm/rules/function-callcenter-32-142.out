def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_le_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_le_3'] = (df_input['Satisfaction_with_the_doctors_response'] <= 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news_le_2'] = (df_input['How_often_do_you_receive_call_center_news'] <= 2.0).astype(int)
    df_output['Call_151_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_No'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['Age_18_24_30_39_and_Complaints'] = ((df_input['Age'].isin(['18-24', '30-39'])) & (df_input['The_reason_of_the_call'] == 'Complaints')).astype(int)
    df_output['Education_High_school_Diploma_Bachelor_and_communication_le_3'] = ((df_input['Education'].isin(['High school', 'Diploma', 'Bachelor'])) & (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0)).astype(int)
    df_output['Nationality_Kuwaiti_and_satisfaction_le_3'] = ((df_input['Nationality'] == 'Kuwaiti') & (df_input['Satisfaction_with_the_doctors_response'] <= 3.0)).astype(int)
    df_output['Marital_Status_Single_Married_and_communication_le_3'] = ((df_input['Marital_Status'].isin(['Single', 'Married'])) & (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0)).astype(int)
    return df_output

