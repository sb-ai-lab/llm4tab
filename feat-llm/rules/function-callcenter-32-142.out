def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_le_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_le_3'] = (df_input['Satisfaction_with_the_doctors_response'] <= 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news_lt_2_5'] = (df_input['How_often_do_you_receive_call_center_news'] < 2.5).astype(int)
    df_output['Call_151_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_No'] = (df_input['Aware_151'] == 'No').astype(int)

    low_satisfaction = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0) & (df_input['Satisfaction_with_the_doctors_response'] <= 3.0)

    df_output['Age_in_group_low_satisfaction'] = ((df_input['Age'].isin(['18-24', '30-39', '40-49'])) & low_satisfaction).astype(int)
    df_output['Education_in_group_low_satisfaction'] = ((df_input['Education'].isin(['High school', 'Diploma', 'Bachelor'])) & low_satisfaction).astype(int)
    df_output['Gender_Male_low_satisfaction'] = ((df_input['Gender'] == 'Male') & low_satisfaction).astype(int)
    df_output['Governorate_in_group_low_satisfaction'] = ((df_input['Governorate'].isin(['Farwaniya', 'Capital'])) & low_satisfaction).astype(int)

    return df_output

