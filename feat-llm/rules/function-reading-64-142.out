def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_Selected'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'Once a week', 'Once a month']).astype(int)
    df_output['Time_spent_ge_1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Ebooks_read_selected'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read_selected'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'Textile', 'CIS', 'MCT']).astype(int)
    df_output['Read_location_Library'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    df_output['Change_felt_selected'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Creative Thinking']).astype(int)
    df_output['Influenced_by_Teachers'] = (df_input['Who influenced you to read books'] == 'Teachers').astype(int)
    df_output['Format_used_selected'] = df_input['The format that you used for reading books'].isin(['Printed', 'Both']).astype(int)
    return df_output

