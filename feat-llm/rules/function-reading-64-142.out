def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == "Academic Purpose").astype(int)
    df_output['Time_spent_reading_>=1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency_in_selected'] = df_input['Frequency of reading books'].isin(["On everyday basis", "A few times a week"]).astype(int)
    df_output['Printed_books_in_selected'] = df_input['Number of printed books you read last two years'].isin(["6-10", "11-15", "16-20", "More than 20"]).astype(int)
    df_output['Ebooks_in_selected'] = df_input['Number of e-books you read last two years'].isin(["6-10", "11-15", "16-20", "More than 20"]).astype(int)
    df_output['Change_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == "Increase Academic Performance").astype(int)
    df_output['Dept_in_selected_and_Reason_Academic'] = ((df_input['Department'].isin(["CSE", "SWE", "Pharmacy", "EEE", "Civil", "MCT", "CIS"])) & (df_input['Reason for reading books'] == "Academic Purpose")).astype(int)
    df_output['Manage_books_in_selected'] = df_input['How to manage books for reading'].isin(["E-books", "Borrow", "Buy", "Used-all"]).astype(int)
    df_output['Favorite_books_in_selected_and_Reason_Academic'] = ((df_input['Favorite books for reading to spend leisure time'].isin(["Non-Fiction", "Biography"])) & (df_input['Reason for reading books'] == "Academic Purpose")).astype(int)
    df_output['Time_>=1_and_Frequency_On_everyday'] = ((df_input['Amount of time spent reading books per day'] >= 1) & (df_input['Frequency of reading books'] == "On everyday basis")).astype(int)
    return df_output

