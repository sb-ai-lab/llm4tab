def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_reading_books_condition'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'Keep me informative', 'To increase my English vocabulary knowledge']).astype(int)
    df_output['Time_spent_reading_less_than_1'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Frequency_reading_condition'] = df_input['Frequency of reading books'].isin(['Once a week', 'Rarely', 'Never']).astype(int)
    df_output['Printed_books_condition'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Ebooks_condition'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Favorite_books_condition'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics']).astype(int)
    df_output['Change_after_reading_condition'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    df_output['Department_and_Reason_condition'] = ((df_input['Department'].isin(['BBA', 'English', 'JMC', 'Others'])) & (df_input['Reason for reading books'] != 'Academic Purpose')).astype(int)
    df_output['Manage_books_and_Frequency_condition'] = ((df_input['How to manage books for reading'] == 'Others') & (df_input['Frequency of reading books'].isin(['Rarely', 'Once a week']))).astype(int)
    df_output['Time_spent_and_Frequency_condition'] = ((df_input['Amount of time spent reading books per day'] <= 0.5) & (df_input['Frequency of reading books'] != 'On everyday basis')).astype(int)
    return df_output

