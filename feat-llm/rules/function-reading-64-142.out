def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge', 'Keep me informative']).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(['Rarely', 'Occasionally']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number_of_ebooks_read_last_two_years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Favorite_books_for_leisure_time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['Change_after_reading_books'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    df_output['Department'] = df_input['Department'].isin(['English', 'BBA', 'JMC', 'Textile', 'NFE']).astype(int)
    df_output['How_to_manage_books'] = df_input['How to manage books for reading'].isin(['Borrow', 'Others']).astype(int)
    df_output['Format_used_for_reading_books'] = df_input['The format that you used for reading books'].isin(['Printed', 'E-books']).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_2'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Frequency_of_reading_books_is_On_everyday_basis'] = (df_input['Frequency of reading books'] == 'On everyday basis').astype(int)
    df_output['Number_of_printed_books_in_range'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_ebooks_in_range'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_after_reading_is_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Department_in_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']).astype(int)
    df_output['How_to_manage_books_in_selected'] = df_input['How to manage books for reading'].isin(['Used-all', 'Buy']).astype(int)
    df_output['Format_used_for_reading_is_Both'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    df_output['Favorite_books_in_selected'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    return df_output

