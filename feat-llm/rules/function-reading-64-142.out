def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Frequency_On_everyday_or_Weekly'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Time_spent_reading_ge_1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Ebooks_read_in_range'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read_in_range'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Department_in_list'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']).astype(int)
    df_output['Read_printed_books_in_Library'] = (df_input['Where do you read printed books'] == 'Library').astype(int)
    df_output['Change_after_reading_increase_academic_or_creative'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Creative Thinking']).astype(int)
    df_output['Format_used_Both'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    df_output['Gender_Male_or_Female'] = df_input['Gender'].isin(['Male', 'Female']).astype(int)
    return df_output