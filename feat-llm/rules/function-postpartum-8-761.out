def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Angry after latest childbirth is Yes'] = (df_input['Angry after latest childbirth'] == 'Yes').astype(int)
    df_output['Abuse is Yes'] = (df_input['Abuse'] == 'Yes').astype(int)
    df_output['Newborn illness is Yes'] = (df_input['Newborn illness'] == 'Yes').astype(int)
    df_output['Mode of delivery is Caesarean Section'] = (df_input['Mode of delivery'] == 'Caesarean Section').astype(int)
    df_output['Total children is More than two'] = (df_input['Total children'] > 2).astype(int)
    df_output['Husband’s monthly income is More than 30000'] = (df_input['Husband’s monthly income'] == 'More than 30000').astype(int)
    df_output['Age of newborn is 6 months to 1 year'] = df_input['Age of newborn'].apply(lambda x: 1 if x in ['6 months', '7 months', '8 months', '9 months', '10 months', '11 months', '1 year'] else 0)
    df_output['Occupation before latest pregnancy is Housewife'] = (df_input['Occupation before latest pregnancy'] == 'Housewife').astype(int)
    df_output['Addiction is No'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Age is within range of [28, 33]'] = df_input['Age'].apply(lambda x: 1 if 28 <= x <= 33 else 0)
    return df_output

