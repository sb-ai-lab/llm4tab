def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_childbirth_Yes'] = (df_input['Angry after latest childbirth'] == 'Yes').astype(int)
    df_output['Abuse_No'] = (df_input['Abuse'] == 'No').astype(int)
    df_output['Newborn_illness_Yes_or_No'] = df_input['Newborn illness'].isin(['Yes', 'No']).astype(int)
    df_output['Mode_of_delivery_Caesarean_Section'] = (df_input['Mode of delivery'] == 'Caesarean Section').astype(int)
    df_output['Total_children_One_or_Two'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Husband_monthly_income_5000_to_10000_or_20000_to_30000'] = df_input["Husband’s monthly income"].isin(['5000 to 10000', '20000 to 30000']).astype(int)
    df_output['Age_of_newborn_Older_than_1.5_year_or_1_year_to_1.5_year'] = df_input['Age of newborn'].isin(['Older than 1.5 year', '1 year to 1.5 year']).astype(int)
    df_output['Occupation_before_latest_pregnancy_Teacher_or_Student_or_Other'] = df_input['Occupation before latest pregnancy'].isin(['Teacher', 'Student', 'Other']).astype(int)
    df_output['Addiction_No'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Age_within_26_to_31'] = df_input['Age'].between(26, 31).astype(int)
    return df_output

