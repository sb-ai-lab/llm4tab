def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling for regular activities is No'] = (df_input['Feeling for regular activities'] == 'No').astype(int)
    df_output['Diseases during pregnancy is No'] = (df_input['Diseases during pregnancy'] == 'No').astype(int)
    df_output['Addiction is No'] = (df_input['Addiction'] == 'No').astype(int)
    df_output['Regular checkups is Yes'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    df_output["Husband's education level is University"] = (df_input["Husband's education level"] == 'University').astype(int)
    df_output['Education Level is University'] = (df_input['Education Level'] == 'University').astype(int)
    df_output['Monthly income before latest pregnancy in range'] = df_input['Monthly income before latest pregnancy'].isin(['10000 to 20000', '20000 to 30000']).astype(int)
    df_output['Current monthly income in range'] = df_input['Current monthly income'].isin(['10000 to 20000', '20000 to 30000']).astype(int)
    df_output['Number of household members is 2 to 5'] = (df_input['Number of household members'] == '2 to 5').astype(int)
    df_output['Number of the latest pregnancy <= 2'] = (pd.to_numeric(df_input['Number of the latest pregnancy'], errors='coerce') <= 2).fillna(0).astype(int)
    return df_output

