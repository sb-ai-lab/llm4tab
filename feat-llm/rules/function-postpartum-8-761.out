def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities'] = df_input['Feeling for regular activities'].isin(['Tired', 'Worried', 'Afraid']).astype(int)
    df_output['Diseases_during_pregnancy'] = (df_input['Diseases during pregnancy'] == 'Chronic Disease').astype(int)
    df_output['Regular_checkups'] = (df_input['Regular checkups'] == 'No').astype(int)
    df_output['Monthly_income_before_latest_pregnancy'] = df_input['Monthly income before latest pregnancy'].isin(['No', 'Less than 5000', '5000 to 10000']).astype(int)
    df_output['Current_monthly_income'] = df_input['Current monthly income'].isin(['No', 'Less than 5000']).astype(int)
    df_output['Number_of_household_members'] = df_input['Number of household members'].isin(['6 to 8', '9 or more']).astype(int)
    df_output['Number_of_latest_pregnancy'] = (pd.to_numeric(df_input['Number of the latest pregnancy'], errors='coerce') >= 3).fillna(0).astype(int)
    if 'Addiction' in df_input.columns:
        df_output['Addiction'] = (df_input['Addiction'] == 'No').astype(int)
    else:
        df_output['Addiction'] = 1
    df_output['Husband_education_level'] = df_input["Husband's education level"].isin(['College', 'High School', 'No']).astype(int)
    df_output['Education_Level'] = df_input['Education Level'].isin(['College', 'High School', 'No']).astype(int)
    return df_output

