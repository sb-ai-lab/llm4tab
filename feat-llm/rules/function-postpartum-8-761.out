def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Received_Support_Low'] = (df_input['Recieved Support'] == 'Low').astype(int)
    df_output['Monthly_income_selected'] = df_input['Monthly income before latest pregnancy'].isin(['No', '10000 to 20000', '20000 to 30000', 'More than 30000']).astype(int)
    df_output['Fear_of_pregnancy_Yes'] = (df_input['Fear of pregnancy'] == 'Yes').astype(int)
    df_output['Relationship_father_newborn_Good'] = (df_input['Relationship between father and newborn'] == 'Good').astype(int)
    df_output['Education_Level_University'] = (df_input['Education Level'] == 'University').astype(int)
    df_output['Total_children_One_Two'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Pregnancy_length_selected'] = df_input['Pregnancy length'].isin(['9 months', '10 months']).astype(int)
    df_output['Mode_of_delivery_Caesarean_Section'] = (df_input['Mode of delivery'] == 'Caesarean Section').astype(int)
    df_output['Pregnancy_plan_Yes_No'] = df_input['Pregnancy plan'].isin(['Yes', 'No']).astype(int)
    df_output['Husband_education_College_University'] = df_input["Husband's education level"].isin(['College', 'University']).astype(int)
