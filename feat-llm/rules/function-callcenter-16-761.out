def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_Complaints'] = df_input['The_reason_of_the_call'].isin(['Complaints']).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_le_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_le_3_1'] = (df_input['Satisfaction_with_the_doctors_response'] <= 3.1).astype(int)
    df_output['How_often_do_you_receive_call_center_news_lt_2'] = (df_input['How_often_do_you_receive_call_center_news'] < 2.0).astype(int)
    df_output['Call_151_No'] = df_input['Call_151'].isin(['No']).astype(int)
    df_output['Aware_151_No'] = df_input['Aware_151'].isin(['No']).astype(int)
    df_output['Education_Bachelor_or_Master_and_communication_skills_le_3'] = ((df_input['Education'].isin(['Bachelor', 'Master'])) & (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0)).astype(int)
    df_output['Gender_Female_and_satisfaction_le_3'] = ((df_input['Gender'].isin(['Female'])) & (df_input['Satisfaction_with_the_doctors_response'] <= 3.0)).astype(int)
    df_output['Governorate_Farwaniya_or_Around_and_communication_skills_le_3'] = ((df_input['Governorate'].isin(['Farwaniya', 'Around'])) & (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0)).astype(int)
    df_output['Age_18_24_or_25_29_and_call_reason_Complaints_and_communication_skills_le_3'] = ((df_input['Age'].isin(['18-24', '25-29'])) & (df_input['The_reason_of_the_call'].isin(['Complaints'])) & (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0)).astype(int)
    return df_output

