def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Satisfaction_with_the_doctors_response_gt_3_5'] = (df_input['Satisfaction_with_the_doctors_response'] > 3.5).astype(int)  
    df_output['Call_center_employee_communication_skills_evaluation_gt_3_0'] = (df_input['Call_center_employee_communication_skills_evaluation'] > 3.0).astype(int)  
    df_output['How_often_do_you_receive_call_center_news_ge_2_5'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.5).astype(int)  
    df_output['The_reason_of_the_call_in_selected'] = df_input['The_reason_of_the_call'].isin(['Medical_Consultation', 'Vaccination', 'Inquiries_COVID19']).astype(int)  
    df_output['Call_151_Yes'] = (df_input['Call_151'] == 'Yes').astype(int)  
    cond_nat = (df_input['Nationality'] == 'Unspecified') & (df_input['Call_center_employee_communication_skills_evaluation'] == 3.0) & (df_input['How_often_do_you_receive_call_center_news'] >= 2.0)  
    df_output['Nationality_Unspecified_and_CommSkills_3_and_News_ge_2'] = cond_nat.astype(int)  
    cond_edu = (df_input['Education'] == 'High school') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)  
    df_output['Education_High_school_and_Satisfaction_ge_3'] = cond_edu.astype(int)  
    cond_gender = (df_input['Gender'] == 'Male') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)  
    df_output['Gender_Male_and_Satisfaction_ge_3'] = cond_gender.astype(int)  
    cond_age = df_input['Age'].isin(['18-24', '25-29']) & (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)  
    df_output['Age_18_24_25_29_and_CommSkills_ge_3'] = cond_age.astype(int)  
    cond_marital = df_input['Marital_Status'].isin(['Single', 'Widow']) & (df_input['Satisfaction_with_the_doctors_response'] > 3.5)  
    df_output['Marital_Single_Widow_and_Satisfaction_gt_3_5'] = cond_marital.astype(int)  
    return df_output