def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = (df_input['social_connection_frequency'] == 'Monthly').astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].isin(['Large events', 'Never']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].isin(['Support', 'Honesty']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].isin(['Avoid conflict', 'Apologize first']).astype(int)
    df_output['family_support_level'] = (df_input['family_support_level'] == 'Sometimes').astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].isin(['Social media', 'Alone time']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].isin(['Extrovert', 'Ambivert']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].isin(['Excited', 'Neutral']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].isin(['Express emotion strongly', 'Talk openly']).astype(int)
    df_output['primary_anger_sources'] = (df_input['primary_anger_sources'] == 'Unnecessary criticism').astype(int)
    return df_output

