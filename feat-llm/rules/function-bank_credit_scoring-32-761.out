def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['credit_history_in_A1_A2_A3_B1_B2_B3_C1_C3'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1', 'C3']).astype(int)
    df_output['PDN_lt_0.4_and_Initial_limit_ge_8000'] = ((df_input['PDN'] < 0.4) & (df_input['Initial limit'] >= 8000)).astype(int)
    df_output['INCOME_ge_2000'] = (df_input['INCOME'] >= 2000).astype(int)
    df_output['Debt_ge_8000_and_Initial_limit_ge_15000_and_PDN_lt_0.4'] = ((df_input['Debt'] >= 8000) & (df_input['Initial limit'] >= 15000) & (df_input['PDN'] < 0.4)).astype(int)
    df_output['EDU_University_and_Credit_history_in_B1_B2'] = ((df_input['EDU'] == 'University') & (df_input['Credit history rating'].isin(['B1', 'B2']))).astype(int)
    df_output['TERM_le_36_and_INCOME_ge_4000'] = ((df_input['TERM'] <= 36) & (df_input['INCOME'] >= 4000)).astype(int)
    df_output['INDUSTRYNAME_in_selected_and_PDN_lt_0.4'] = ((df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Medicine and healthcare', 'Information Technology'])) & (df_input['PDN'] < 0.4)).astype(int)
    df_output['FAMILYSTATUS_eq_1_and_PDN_lt_0.4'] = ((df_input['FAMILYSTATUS'] == 1) & (df_input['PDN'] < 0.4)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_le_1_and_PDN_lt_0.2'] = ((df_input['UNDERAGECHILDRENCOUNT'] <= 1) & (df_input['PDN'] < 0.2)).astype(int)
    df_output['LV_AREA_in_selected_and_Credit_history_in_A1_B2_B1'] = (df_input['LV_AREA'].str.lower().isin(['g. minsk', 'minskaja oblast']) & df_input['Credit history rating'].isin(['A1', 'B2', 'B1'])).astype(int)
    return df_output

