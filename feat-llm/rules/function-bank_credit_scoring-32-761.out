def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating'] = df_input['Credit history rating'].isin(['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1', 'C3']).astype(int)
    df_output['PDN'] = ((df_input['PDN'] <= 0.4) & (df_input['PDN'] >= 0.01)).astype(int)
    df_output['INCOME'] = (df_input['INCOME'] >= 1590).astype(int)
    df_output['Initial_limit'] = ((df_input['Initial limit'] >= 20000) | (df_input['Initial limit'] >= 4200)).astype(int)
    df_output['Debt'] = ((df_input['Debt'] >= 9000) | (df_input['Debt'] >= 2800)).astype(int)
    df_output['EDU'] = (df_input['EDU'] == 'University').astype(int)
    df_output['TERM'] = (df_input['TERM'] <= 60).astype(int)
    df_output['SEX'] = (df_input['SEX'] == 'Female').astype(int)
    df_output['INDUSTRYNAME'] = df_input['INDUSTRYNAME'].isin(['Finance and Insurance', 'Medicine and healthcare', 'Public Administration', 'Information Technology', 'Agriculture']).astype(int)
    df_output['FAMILYSTATUS'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)
    return df_output