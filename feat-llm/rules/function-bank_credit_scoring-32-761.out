def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Credit_history_rating_in_E_D'] = df_input['Credit history rating'].isin(['E1', 'D3', 'D2', 'D1', 'E2', 'E3']).astype(int)
    df_output['PDN_ge_0_3'] = (df_input['PDN'] >= 0.3).astype(int)
    df_output['Debt_in_8000_20000'] = ((df_input['Debt'] >= 8000) & (df_input['Debt'] <= 20000)).astype(int)
    df_output['Initial_limit_le_15000'] = (df_input['Initial limit'] <= 15000).astype(int)
    df_output['INCOME_le_2000'] = (df_input['INCOME'] <= 2000).astype(int)
    df_output['Overdue_days_gt_0'] = (df_input['Overdue days'] > 0).astype(int)
    df_output['EDU_in_College_Incomplete'] = df_input['EDU'].isin(['College', 'Incomplete']).astype(int)
    df_output['TERM_36_to_60'] = ((df_input['TERM'] >= 36) & (df_input['TERM'] <= 60)).astype(int)
    df_output['UNDERAGECHILDRENCOUNT_ge_1'] = (df_input['UNDERAGECHILDRENCOUNT'] >= 1).astype(int)
    df_output['FAMILYSTATUS_in_1_2'] = df_input['FAMILYSTATUS'].isin([1, 2]).astype(int)
    return df_output

