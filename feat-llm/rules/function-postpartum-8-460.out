def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband_in_Neutral_Bad_Poor'] = df_input['Relationship with husband'].isin(['Neutral', 'Bad', 'Poor']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_Yes'] = (df_input.get('Major changes or losses during pregnancy', '') == 'Yes').astype(int)
    df_output['Relationship_between_father_and_newborn_in_Neutral_Bad'] = df_input.get('Relationship between father and newborn', pd.Series()).isin(['Neutral', 'Bad']).astype(int)
    df_output['Addiction_in_Smoking_Drinking_Drugs'] = df_input.get('Addiction', pd.Series()).isin(['Smoking', 'Drinking', 'Drugs']).astype(int)
    df_output['Age_of_newborn_in_0_to_6_months_6_months_to_1_year'] = df_input.get('Age of newborn', pd.Series()).isin(['0 to 6 months', '6 months to 1 year']).astype(int)
    df_output['Number_of_household_members_in_2_to_5'] = df_input.get('Number of household members', pd.Series()).isin(['2 to 5']).astype(int)
    df_output['Occupation_After_Your_Latest_Childbirth_in_Housewife_House_wife_Other'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'House wife', 'Other']).astype(int)
    df_output['Age_<=_29'] = (df_input['Age'] <= 29).astype(int)
    df_output['Number_of_the_latest_pregnancy_1'] = (df_input.get('Number of the latest pregnancy', pd.Series()) == 1).astype(int)
    df_output['Residence_is_City_with_other_risk_factors'] = ((df_input.get('Residence', pd.Series()) == 'City') & 
                                                             ((df_input['Relationship with husband'].isin(['Bad', 'Neutral', 'Poor'])) | 
                                                              (df_input.get('Addiction', pd.Series()).isin(['Smoking', 'Drinking', 'Drugs'])))).astype(int)
    return df_output

