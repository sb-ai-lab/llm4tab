def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Fear_of_pregnancy_No'] = (df_input['Fear of pregnancy'] == 'No').astype(int)
    df_output['Relationship_with_newborn_Good_or_Very_good'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Relationship_father_newborn_Good_or_Very_good'] = df_input['Relationship between father and newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Relax_sleep_when_newborn_tended_Yes'] = (df_input['Relax/sleep when the newborn is asleep'] == 'Yes').astype(int)
    df_output['Diseases_during_pregnancy_No'] = (df_input['Diseases during pregnancy'] == 'No').astype(int)
    df_output['Breastfeed_Yes'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    df_output['Total_children_in_Two_or_More'] = df_input['Total children'].isin(['Two', 'More than two', 'More than Two']).astype(int)
    df_output['Age_in_28_to_40'] = ((df_input['Age'] >= 28) & (df_input['Age'] <= 40)).astype(int)
    df_output['Residence_in_City_or_Village'] = df_input['Residence'].isin(['City', 'Village']).astype(int)
    df_output['Gender_of_newborn_Boy_or_Girl'] = df_input['Gender of newborn'].isin(['Boy', 'Girl']).astype(int)
    return df_output

