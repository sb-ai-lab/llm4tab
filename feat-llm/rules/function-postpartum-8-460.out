def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Abuse_Yes'] = (df_input.get('Abuse') == 'Yes').astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_Yes'] = (df_input.get('Major changes or losses during pregnancy') == 'Yes').astype(int)
    df_output['History_of_pregnancy_loss_Miscarriage_or_Stillborn'] = df_input.get('History of pregnancy loss').isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Current_monthly_income_No'] = (df_input.get('Current monthly income') == 'No').astype(int)
    df_output['Diseases_during_pregnancy_Chronic_or_NonChronic'] = df_input.get('Diseases during pregnancy').isin(['Chronic Disease', 'Non-Chronic Disease']).astype(int)
    df_output['Addiction_No_or_any'] = 1
    df_output['Marital_status_Married_or_Divorced'] = df_input.get('Marital status').isin(['Married', 'Divorced']).astype(int)
    df_output['Residence_Village'] = (df_input.get('Residence') == 'Village').astype(int)
    df_output['Number_of_latest_pregnancy_ge_2'] = (pd.to_numeric(df_input.get('Number of the latest pregnancy'), errors='coerce') >= 2).astype(int)
    df_output['Monthly_income_before_latest_pregnancy_No_or_Low'] = df_input.get('Monthly income before latest pregnancy').isin(['No', 'Less than 5000']).astype(int)
    return df_output

