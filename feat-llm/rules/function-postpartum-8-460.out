    df_output['Marital_status_Married'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Residence_City'] = (df_input['Residence'] == 'City').astype(int)
    df_output['Number_of_latest_pregnancy_in_range'] = df_input['Number of the latest pregnancy'].between(1,2).astype(int)
