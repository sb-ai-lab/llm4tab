def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['History_of_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery', 'Still-born delivery']).astype(int)  
    df_output['Relax_sleep_newborn'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)  
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['Medium', 'High']).astype(int)  
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Neutral', 'Bad', 'Poor']).astype(int)  
    df_output['Newborn_illness'] = (df_input['Newborn illness'] == 'Yes').astype(int)  
    df_output['Age_immediate_older_children'] = (df_input['Age of immediate older children'] == 'No').astype(int)  
    df_output['Total_children'] = df_input['Total children'].isin(['One', 'Two']).astype(int)  
    df_output['Marital_status'] = (df_input['Marital status'] == 'Married').astype(int)  
    df_output['Occupation_after_latest_childbirth'] = (df_input['Occupation After Your Latest Childbirth'].str.replace(" ", "").str.lower() == 'housewife').astype(int)  
    df_output['Age'] = (df_input['Age'] <= 32).astype(int)  
    return df_output