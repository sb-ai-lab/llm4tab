def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Fear of pregnancy is Yes'] = (df_input.get('Fear of pregnancy', '') == 'Yes').astype(int)
    df_output['Relationship with the newborn is in [Neutral, Bad]'] = df_input.get('Relationship with the newborn', '').isin(['Neutral', 'Bad']).astype(int)
    df_output['Relax/sleep when newborn is tended is No'] = (df_input.get('Relax/sleep when the newborn is asleep', '') == 'No').astype(int)
    df_output['Diseases during pregnancy is in [Chronic Disease, Non-Chronic Disease, Chronic disease, Non-chronic disease]'] = df_input.get('Diseases during pregnancy', '').str.lower().isin(['chronic disease', 'non-chronic disease']).astype(int)
    df_output['Total children is in [One]'] = (df_input.get('Total children', '') == 'One').astype(int)
    df_output['Age is within range [20, 29]'] = df_input.get('Age', 0).between(20, 29).astype(int)
    df_output['Relationship between father and newborn is in [Neutral, Bad]'] = df_input.get('Relationship between father and newborn', '').isin(['Neutral', 'Bad']).astype(int)
    df_output['Breastfeed is Yes'] = (df_input.get('Breastfeed', '') == 'Yes').astype(int)
    df_output['Residence is City'] = (df_input.get('Residence', '') == 'City').astype(int)
    df_output['Gender of newborn is in [Boy, Girl]'] = df_input.get('Gender of newborn', '').isin(['Boy', 'Girl']).astype(int)
    return df_output

