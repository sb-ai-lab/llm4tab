def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call'] = df_input['The_reason_of_the_call'].isin(['Inquiries', 'Inquiries_COVID19', 'Vaccination']).astype(int)
    df_output['Call_151'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['Age'] = df_input['Age'].isin(['18-24']).astype(int)
    df_output['Education'] = df_input['Education'].isin(['Bachelor', 'High school']).astype(int)
    df_output['Governorate'] = df_input['Governorate'].isin(['Farwaniya', 'Capital', 'AlAhmadi']).astype(int)
    df_output['How_often_do_you_receive_call_center_news'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.5).astype(int)
    df_output['Gender'] = (df_input['Gender'] == 'Female').astype(int)
    return df_output

