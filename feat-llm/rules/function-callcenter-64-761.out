    df_output['Aware_151_is_Yes'] = (df_input['Aware_151'] == 'Yes').astype(int)
    df_output['Age_in_18_24_30_39_40_49'] = df_input['Age'].isin(['18-24', '30-39', '40-49']).astype(int)
