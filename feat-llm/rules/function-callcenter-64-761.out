def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call_in_selected'] = df_input['The_reason_of_the_call'].isin(['Complaints', 'Inquiries', 'Inquiries_COVID19']).astype(int)
    df_output['Call_151_is_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_is_No_or_Yes'] = df_input['Aware_151'].isin(['No', 'Yes']).astype(int)
    df_output['Age_in_18_24'] = (df_input['Age'] == '18-24').astype(int)
    df_output['Education_in_selected'] = df_input['Education'].isin(['High school', 'Bachelor']).astype(int)
    df_output['How_often_do_you_receive_call_center_news_gt_2_5'] = (df_input['How_often_do_you_receive_call_center_news'] > 2.5).astype(int)
    df_output['Marital_Status_in_Single'] = (df_input['Marital_Status'] == 'Single').astype(int)
    df_output['Nationality_in_selected'] = df_input['Nationality'].isin(['Kuwaiti', 'Unspecified']).astype(int)
    return df_output