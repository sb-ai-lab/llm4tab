def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation_lt_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] < 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_lt_3'] = (df_input['Satisfaction_with_the_doctors_response'] < 3.0).astype(int)
    df_output['The_reason_of_the_call_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_151_Yes'] = (df_input['Call_151'] == 'Yes').astype(int)
    df_output['Aware_151_Yes'] = (df_input['Aware_151'] == 'Yes').astype(int)
    df_output['Age_in_18_24_30_39'] = df_input['Age'].isin(['18-24', '30-39']).astype(int)
    df_output['Education_in_Bachelor_Diploma'] = df_input['Education'].isin(['Bachelor', 'Diploma']).astype(int)
    df_output['Governorate_in_Mubarak_AlKabir_Jahra'] = df_input['Governorate'].isin(['Mubarak AlKabir', 'Jahra']).astype(int)
