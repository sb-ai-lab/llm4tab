def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['ASSAULT', 'BATTERY', 'NARCOTICS', 'WEAPONS VIOLATION', 'THEFT']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['AGGRAVATED - OTHER DANGEROUS WEAPON', 'DOMESTIC BATTERY SIMPLE', 'UNLAWFUL POSSESSION - HANDGUN', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'POSSESS - CANNABIS 30 GRAMS OR LESS', 'RETAIL THEFT', 'SIMPLE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['DEPARTMENT STORE', 'STREET', 'APARTMENT', 'TAVERN / LIQUOR STORE', 'COMMERCIAL / BUSINESS OFFICE']).astype(int)
    df_output['Domestic_is_0_or_1'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['04A', '06', '08A', '08B', '15', '18']).astype(int)
    df_output['Primary_Assault_Description_Simple'] = ((df_input['Primary Type'] == 'ASSAULT') & (df_input['Description'] == 'SIMPLE')).astype(int)
    df_output['Primary_Battery_Description_Simple_Domestic_1'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'SIMPLE') & (df_input['Domestic'] == 1)).astype(int)
    narcotics_desc = ['POSSESS - CANNABIS 30 GRAMS OR LESS', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS']
    df_output['Primary_Narcotics_Description_in_list'] = ((df_input['Primary Type'] == 'NARCOTICS') & (df_input['Description'].isin(narcotics_desc))).astype(int)
    df_output['District_in_range_Battery_or_Assault'] = ((df_input['District'].between(1,25)) & (df_input['Primary Type'].isin(['BATTERY', 'ASSAULT']))).astype(int)
    df_output['Beat_in_range_Weapons_or_Narcotics'] = ((df_input['Beat'].between(600,1900)) & (df_input['Primary Type'].isin(['WEAPONS VIOLATION', 'NARCOTICS']))).astype(int)
    return df_output

---VERSION---

