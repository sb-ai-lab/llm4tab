    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['BATTERY', 'ASSAULT', 'WEAPONS VIOLATION', 'NARCOTICS', 'THEFT']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['DOMESTIC BATTERY SIMPLE', 'AGGRAVATED - OTHER DANGEROUS WEAPON', 'UNLAWFUL POSSESSION - HANDGUN', 'POSSESS - CANNABIS 30 GRAMS OR LESS', 'MANUFACTURE / DELIVER - CANNABIS OVER 10 GRAMS', 'SIMPLE', 'RETAIL THEFT']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['STREET', 'DEPARTMENT STORE', 'APARTMENT', 'TAVERN / LIQUOR STORE']).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['08A', '08B', '15', '18', '06']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 900) & (df_input['Beat'] <= 2600)).astype(int)
    df_output['District'] = ((df_input['District'] >= 6) & (df_input['District'] <= 25)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 1) & (df_input['Ward'] <= 46)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 3) & (df_input['Community Area'] <= 73)).astype(int)
    df_output['Year'] = (df_input['Year'] == 2025).astype(int)
    return df_output

