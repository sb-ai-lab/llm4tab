def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G8III', 'K0III', 'B9III/IV', 'G5III', 'K1III']).astype(int)
    df_output['Amag_le_2'] = (df_input['Amag'] <= 2.0).astype(int)
    df_output['B_V_ge_0_9'] = (df_input['B-V'] >= 0.9).astype(int)
    df_output['Plx_lt_5'] = (df_input['Plx'] < 5).astype(int)
    df_output['Vmag_le_6'] = (df_input['Vmag'] <= 6.0).astype(int)
    df_output['SpType_contains_III_IV'] = df_input['SpType'].str.contains('III|IV', regex=True).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= -5.0) & (df_input['Amag'] <= 2.0)).astype(int)
    df_output['B_V_in_range'] = ((df_input['B-V'] >= 0.8) & (df_input['B-V'] <= 1.8)).astype(int)
    df_output['e_Plx_lt_1'] = (df_input['e_Plx'] < 1.0).astype(int)
    df_output['Plx_le_3_Amag_lt_1_5'] = ((df_input['Plx'] <= 3) & (df_input['Amag'] < 1.5)).astype(int)
    return df_output

