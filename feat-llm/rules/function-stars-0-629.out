def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'K5V', 'B8V', 'B9V']).astype(int)
    df_output['Amag_ge_4'] = (df_input['Amag'] >= 4.0).astype(int)
    df_output['B_V_le_0_8'] = (df_input['B-V'] <= 0.8).astype(int)
    df_output['Vmag_gt_8'] = (df_input['Vmag'] > 8.0).astype(int)
    df_output['Plx_ge_10'] = (df_input['Plx'] >= 10).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 4.0) & (df_input['Amag'] <= 10.0)).astype(int)
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['B_V_lt_1_and_Amag_gt_3_5'] = ((df_input['B-V'] < 1.0) & (df_input['Amag'] > 3.5)).astype(int)
    df_output['Plx_e_Plx_ratio_gt_10_and_Amag_gt_4'] = ((df_input['Plx'] / df_input['e_Plx'] > 10) & (df_input['Amag'] > 4.0)).astype(int)
    df_output['Vmag_ge_6_and_SpType_in_list'] = ((df_input['Vmag'] >= 6.0) & (df_input['SpType'].isin(['F3V', 'G1V']))).astype(int)
    return df_output

