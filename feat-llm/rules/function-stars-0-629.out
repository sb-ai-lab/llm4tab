def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'K5V', 'B8V', 'B9V']).astype(int)
    df_output['Amag_gt_3'] = (df_input['Amag'] > 3.0).astype(int)
    df_output['B_V_lt_0_8'] = (df_input['B-V'] < 0.8).astype(int)
    df_output['Plx_ge_10'] = (df_input['Plx'] >= 10).astype(int)
    df_output['Vmag_gt_8'] = (df_input['Vmag'] > 8.0).astype(int)
    df_output['SpType_no_III_IV'] = (~df_input['SpType'].str.contains('III|IV')).astype(int)
    df_output['Amag_in_4_10'] = df_input['Amag'].between(4.0, 10.0).astype(int)
    df_output['B_V_in_0_0_6'] = df_input['B-V'].between(0.0, 0.6).astype(int)
    df_output['e_Plx_lt_0_5'] = (df_input['e_Plx'] < 0.5).astype(int)
    df_output['Plx_gt_5_Amag_gt_2_5'] = ((df_input['Plx'] > 5) & (df_input['Amag'] > 2.5)).astype(int)
    return df_output

