def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G9III', 'K0III', 'K5III', 'B9III/IV', 'G8III']).astype(int)
    df_output['Amag_le_2'] = (df_input['Amag'] <= 2.0).astype(int)
    df_output['B_V_ge_1'] = (df_input['B-V'] >= 1.0).astype(int)
    df_output['SpType_ends_III_or_III_IV'] = df_input['SpType'].str.endswith('III') | df_input['SpType'].str.endswith('III/IV')
    df_output['SpType_ends_III_or_III_IV'] = df_output['SpType_ends_III_or_III_IV'].astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= -5.0) & (df_input['Amag'] <= 2.0)).astype(int)
    df_output['Plx_lt_10_Amag_le_2_5'] = ((df_input['Plx'] < 10) & (df_input['Amag'] <= 2.5)).astype(int)
    df_output['B_V_gt_1_2_Amag_lt_1_5'] = ((df_input['B-V'] > 1.2) & (df_input['Amag'] < 1.5)).astype(int)
    df_output['Vmag_lt_6_SpType_in_list'] = ((df_input['Vmag'] < 6.0) & (df_input['SpType'].isin(['K5III', 'G8III']))).astype(int)
    df_output['Plx_e_Plx_ratio_gt_5_Amag_lt_3'] = ((df_input['Plx'] / df_input['e_Plx'] > 5) & (df_input['Amag'] < 3.0)).astype(int)
    df_output['SpType_in_list_B_V_gt_0_9'] = ((df_input['SpType'].isin(['K0III', 'G8III', 'B9III/IV'])) & (df_input['B-V'] > 0.9)).astype(int)
    return df_output