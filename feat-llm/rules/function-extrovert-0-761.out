def extracting_features_1(df_input):
    conditions = {
        'social_connection_frequency': ['Daily', 'Weekly', 'weekly'],
        'gathering_size_preference': ['Small gatherings', 'Both'],
        'valued_friendship_traits': ['Support', 'Loyalty', 'Honesty', 'All', 'All the three and trust'],
        'conflict_resolution_style': ['Talk it out', 'Apologize first'],
        'family_support_level': ['Yes', 'Sometimes', 'yes'],
        'social_battery_recharge': ['Talking to someone', 'Social media'],
        'social_orientation_type': ['Extrovert', 'Ambivert'],
        'social_anxiety_level': ['Neutral', 'Excited'],
        'emotional_expression_method': ['Talk openly', 'Express emotion strongly'],
        'primary_anger_sources': ['Injustice', 'Selfishness']
    }
    df_output = pd.DataFrame()
    for col, valid_vals in conditions.items():
        df_output[col] = df_input[col].isin(valid_vals).astype(int)
    return df_output

