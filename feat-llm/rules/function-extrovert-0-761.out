def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.lower().isin(['never', 'rarely', 'monthly']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.lower().isin(['never', 'large events']).astype(int)
    def check_valued_traits(val):
        if pd.isna(val):
            return 1
        val_lower = val.lower()
        exclude = ['support', 'loyalty', 'honesty', 'all', 'all the three and trust', 'understanding person']
        for ex in exclude:
            if ex in val_lower:
                return 0
        return 1
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].apply(check_valued_traits)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.lower().isin(['alone time', 'social media', 'none of the above']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.lower().isin(['introvert', 'not sure']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.lower().isin(['avoid it', 'nervous']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.lower().isin(['being interrupted', 'unnecessary criticism']).astype(int)
    return df_output

