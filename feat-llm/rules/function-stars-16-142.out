    df_output['Amag_le_15.0'] = (df_input['Amag'] <= 15.0).astype(int)
    df_output['Plx_le_10.0'] = (df_input['Plx'] <= 10.0).astype(int)
    df_output['Vmag_le_7.5'] = (df_input['Vmag'] <= 7.5).astype(int)
    df_output['e_Plx_le_1.5'] = (df_input['e_Plx'] <= 1.5).astype(int)
    df_output['B-V_in_range'] = ((df_input['B-V'] >= 0.7) & (df_input['B-V'] <= 1.4)).astype(int)
    df_output['Amag_in_range'] = ((df_input['Amag'] >= 12.5) & (df_input['Amag'] <= 15.0)).astype(int)
    df_output['Vmag_in_range'] = ((df_input['Vmag'] >= 1.5) & (df_input['Vmag'] <= 7.5)).astype(int)
    return df_output

