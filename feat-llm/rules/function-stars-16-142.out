def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_contains_III_or_II_or_Ib'] = df_input['SpType'].str.contains('III|II|Ib', regex=True).astype(int)
    df_output['Amag_le_15'] = (df_input['Amag'] <= 15.0).astype(int)
    df_output['Vmag_le_7'] = (df_input['Vmag'] <= 7.0).astype(int)
    df_output['Plx_le_3'] = (df_input['Plx'] <= 3.0).astype(int)
    df_output['B_V_ge_0_7'] = (df_input['B-V'] >= 0.7).astype(int)
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G8III', 'K2III', 'B9.5III', 'B6III', 'G2III', 'K1IIICN']).astype(int)
    df_output['Amag_in_range_12_5_15'] = ((df_input['Amag'] >= 12.5) & (df_input['Amag'] <= 15.0)).astype(int)
    df_output['B_V_ge_0_9_and_Amag_le_15'] = ((df_input['B-V'] >= 0.9) & (df_input['Amag'] <= 15.0)).astype(int)
    df_output['Plx_le_2_and_Vmag_le_5'] = ((df_input['Plx'] <= 2.0) & (df_input['Vmag'] <= 5.0)).astype(int)
    df_output['SpType_contains_III_and_B_V_ge_0_7'] = (df_input['SpType'].str.contains('III', regex=False) & (df_input['B-V'] >= 0.7)).astype(int)
    return df_output

