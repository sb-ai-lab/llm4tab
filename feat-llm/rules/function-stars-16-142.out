def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'F5V', 'F6V', 'F0V', 'A1V', 'A7IV/V']).astype(int)  
    df_output['Amag_ge_16'] = (df_input['Amag'] >= 16).astype(int)  
    df_output['B_V_le_0_6'] = (df_input['B-V'] <= 0.6).astype(int)  
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5).astype(int)  
    df_output['Vmag_ge_7'] = (df_input['Vmag'] >= 7).astype(int)  
    df_output['SpType_contains_V_not_III_II'] = df_input['SpType'].apply(lambda x: int(('V' in x) and ('III' not in x) and ('II' not in x)))  
    df_output['Amag_in_range'] = df_input['Amag'].between(16, 19).astype(int)  
    df_output['Plx_in_range'] = df_input['Plx'].between(5, 20).astype(int)  
    df_output['e_Plx_le_1_2'] = (df_input['e_Plx'] <= 1.2).astype(int)  
    df_output['B_V_in_range'] = df_input['B-V'].between(0.0, 0.6).astype(int)  
    return df_output

