def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['B9.5III', 'K1IIICN', 'B1Ib/II', 'G2III', 'G8III', 'K2III', 'B6III']).astype(int)
    df_output['SpType_contains_luminosity_class'] = df_input['SpType'].str.contains('III|Ib/II|II', regex=True).astype(int)
