def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['G1V', 'F3V', 'F0V', 'F5V', 'F6V', 'A1V', 'A7IV/V', 'B8V', 'B9V']).astype(int)
    df_output['Amag_ge_16'] = (df_input['Amag'] >= 16.0).astype(int)
    df_output['Vmag_ge_5'] = (df_input['Vmag'] >= 5.0).astype(int)
    df_output['Plx_ge_5'] = (df_input['Plx'] >= 5.0).astype(int)
    df_output['B_V_in_range'] = ((df_input['B-V'] >= -0.1) & (df_input['B-V'] <= 0.6)).astype(int)
    df_output['e_Plx_le_1_1'] = (df_input['e_Plx'] <= 1.1).astype(int)
    df_output['SpType_in_F_list_and_Amag_ge_17'] = ((df_input['SpType'].isin(['F0V', 'F5V', 'F6V'])) & (df_input['Amag'] >= 17.0)).astype(int)
    df_output['Plx_in_range_and_Vmag_ge_5'] = ((df_input['Plx'] >= 7.0) & (df_input['Plx'] <= 20.0) & (df_input['Vmag'] >= 5.0)).astype(int)
    df_output['SpType_endswith_V'] = df_input['SpType'].str.endswith('V').astype(int)
    df_output['B_V_le_0_6_and_Amag_ge_16'] = ((df_input['B-V'] <= 0.6) & (df_input['Amag'] >= 16.0)).astype(int)
    return df_output

