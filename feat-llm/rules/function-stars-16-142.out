def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_in_list'] = df_input['SpType'].isin(['B9III', 'B6III', 'G2III', 'K1IIICN', 'G8III', 'B1Ib/II', 'K2III', 'B9.5III']).astype(int)
    df_output['Amag_le_15'] = (df_input['Amag'] <= 15).astype(int)
    df_output['B_V_ge_0_7'] = (df_input['B-V'] >= 0.7).astype(int)
    df_output['Plx_le_10'] = (df_input['Plx'] <= 10).astype(int)
    df_output['Vmag_le_5'] = (df_input['Vmag'] <= 5).astype(int)
    df_output['SpType_contains_III_II_Ib'] = df_input['SpType'].str.contains('III|II|Ib', regex=True).fillna(False).astype(int)
    df_output['Amag_in_12_15'] = ((df_input['Amag'] >= 12) & (df_input['Amag'] <= 15)).astype(int)
    df_output['Plx_in_0_5_10'] = ((df_input['Plx'] >= 0.5) & (df_input['Plx'] <= 10)).astype(int)
    df_output['B_V_in_0_7_1_4'] = ((df_input['B-V'] >= 0.7) & (df_input['B-V'] <= 1.4)).astype(int)
    df_output['e_Plx_ge_0_5'] = (df_input['e_Plx'] >= 0.5).astype(int)
    return df_output