def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.lower().isin(['monthly', 'never']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.lower().isin(['large events', 'never']).astype(int)
    def valued_trait_check(x):
        x_lower = str(x).lower()
        if ('loyalty' in x_lower or 'support' in x_lower) and ('honesty' not in x_lower) and ('all' not in x_lower) and ('trust' not in x_lower) and ('understanding person' not in x_lower):
            return 1
        else:
            return 0
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].apply(valued_trait_check)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.lower().isin(['avoid conflict', 'let time fix it']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.lower().isin(['no', 'never']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.lower().isin(['alone time', 'none of the above']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.lower().isin(['introvert', 'not sure']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.lower().isin(['avoid it', 'nervous']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.lower().isin(['stay silent', 'other']).astype(int)
    df_output['primary_anger_sources'] = df_input['primary_anger_sources'].str.lower().isin(['unnecessary criticism', 'selfishness']).astype(int)
    return df_output

