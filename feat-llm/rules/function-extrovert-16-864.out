def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency'] = df_input['social_connection_frequency'].str.strip().str.capitalize().isin(['Never', 'Monthly']).astype(int)
    df_output['gathering_size_preference'] = df_input['gathering_size_preference'].str.strip().str.capitalize().isin(['Large events', 'Never']).astype(int)
    df_output['valued_friendship_traits'] = df_input['valued_friendship_traits'].str.strip().str.capitalize().isin(['Loyalty', 'Support']).astype(int)
    df_output['conflict_resolution_style'] = df_input['conflict_resolution_style'].str.strip().str.capitalize().isin(['Avoid conflict', 'Let time fix it']).astype(int)
    df_output['family_support_level'] = df_input['family_support_level'].str.strip().str.capitalize().isin(['No', 'Never']).astype(int)
    df_output['social_battery_recharge'] = df_input['social_battery_recharge'].str.strip().str.capitalize().isin(['Alone time', 'None of the above']).astype(int)
    df_output['social_orientation_type'] = df_input['social_orientation_type'].str.strip().str.capitalize().isin(['Introvert', 'Not sure']).astype(int)
    df_output['social_anxiety_level'] = df_input['social_anxiety_level'].str.strip().str.capitalize().isin(['Avoid it', 'Nervous']).astype(int)
    df_output['emotional_expression_method'] = df_input['emotional_expression_method'].str.strip().str.capitalize().isin(['Stay silent', 'Other']).astype(int)
    cond = (df_input['social_connection_frequency'].str.strip().str.capitalize() == 'Weekly') & (df_input['emotional_expression_method'].str.strip().str.capitalize() == 'Express emotion strongly')
    df_output['social_connection_frequency_weekly_and_emotional_expression_strong'] = cond.astype(int)
    return df_output

