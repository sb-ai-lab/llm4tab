def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['social_connection_frequency_in_Daily_Weekly'] = df_input['social_connection_frequency'].str.lower().isin(['daily', 'weekly']).astype(int)
    df_output['gathering_size_preference_in_Small_Both'] = df_input['gathering_size_preference'].str.lower().isin(['small gatherings', 'both']).astype(int)
    df_output['valued_friendship_traits_in_Honesty_Support'] = df_input['valued_friendship_traits'].str.lower().isin(['honesty', 'support']).astype(int)
    df_output['conflict_resolution_style_in_Talk_Apologize'] = df_input['conflict_resolution_style'].str.lower().isin(['talk it out', 'apologize first']).astype(int)
    df_output['family_support_level_in_Yes_Sometimes'] = df_input['family_support_level'].str.lower().isin(['yes', 'sometimes']).astype(int)
    df_output['social_battery_recharge_in_Talking_SocialMedia'] = df_input['social_battery_recharge'].str.lower().isin(['talking to someone', 'social media']).astype(int)
    df_output['social_orientation_type_in_Extrovert_Ambivert'] = df_input['social_orientation_type'].str.lower().isin(['extrovert', 'ambivert']).astype(int)
    df_output['social_anxiety_level_in_Neutral_Excited'] = df_input['social_anxiety_level'].str.lower().isin(['neutral', 'excited']).astype(int)
    df_output['emotional_expression_method_in_Talk_Express'] = df_input['emotional_expression_method'].str.lower().isin(['talk openly', 'express emotion strongly']).astype(int)
    cond = (df_input['social_connection_frequency'].str.lower() == 'never') & (df_input['emotional_expression_method'].str.lower() == 'stay silent') & (df_input['social_orientation_type'].str.lower() == 'ambivert')
    df_output['special_condition'] = cond.astype(int)
    return df_output

