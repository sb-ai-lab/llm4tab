def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_input['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p')
    df_output['Primary_Type_NARCOTICS'] = (df_input['Primary Type'] == 'NARCOTICS').astype(int)
    df_output['Description_NARCOTICS'] = df_input['Description'].isin([
        'POSSESS - HEROIN (WHITE)', 'POSSESS - CANNABIS MORE THAN 30 GRAMS',
        'POSSESS - PCP', 'MANUFACTURE / DELIVER - COCAINE', 'FOUND SUSPECT NARCOTICS'
    ]).astype(int)
    df_output['Weapons_Unlawful_Handgun'] = ((df_input['Primary Type'] == 'WEAPONS VIOLATION') & (df_input['Description'] == 'UNLAWFUL POSSESSION - HANDGUN')).astype(int)
    df_output['Location_Primary_Narcotics'] = ((df_input['Location Description'].isin(['STREET', 'SIDEWALK'])) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)
    df_output['FBI_Code_18_15'] = df_input['FBI Code'].isin(['18', '15']).astype(int)
    df_output['Theft_Retail'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT')).astype(int)
    df_output['Battery_Simple_Street'] = ((df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'SIMPLE') & (df_input['Location Description'] == 'STREET')).astype(int)
    df_output['Domestic0_Narcotics'] = ((df_input['Domestic'] == 0) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)
    df_output['Beat_1000_2000_Narcotics'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 2000) & (df_input['Primary Type'] == 'NARCOTICS')).astype(int)
    start_date = pd.to_datetime('01/10/2025 00:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/27/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date_Range_Primary'] = ((df_input['Date'] >= start_date) & (df_input['Date'] <= end_date) & (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))).astype(int)
    return df_output

