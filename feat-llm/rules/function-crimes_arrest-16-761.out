def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_in_list'] = df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION', 'BATTERY', 'THEFT']).astype(int)
    df_output['Description_in_list'] = df_input['Description'].isin(['POSSESS - PCP', 'POSSESS - CANNABIS MORE THAN 30 GRAMS', 'POSSESS - HEROIN (WHITE)', 'MANUFACTURE / DELIVER - COCAINE', 'RETAIL THEFT', 'UNLAWFUL POSSESSION - HANDGUN', 'SIMPLE']).astype(int)
    df_output['Location_Description_in_list'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK', 'DEPARTMENT STORE']).astype(int)
    df_output['Domestic_is_0'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_in_list'] = df_input['FBI Code'].isin(['18', '15', '08B', '06']).astype(int)
    df_output['Primary_NARCOTICS_and_Description_contains_POSSESS_or_MANUFACTURE'] = (
        (df_input['Primary Type'] == 'NARCOTICS') & 
        (df_input['Description'].str.contains('POSSESS') | df_input['Description'].str.contains('MANUFACTURE / DELIVER'))
    ).astype(int)
    df_output['Primary_WEAPONS_and_Description_UNLAWFUL_POSSESSION_HANDGUN'] = (
        (df_input['Primary Type'] == 'WEAPONS VIOLATION') & 
        (df_input['Description'] == 'UNLAWFUL POSSESSION - HANDGUN')
    ).astype(int)
    df_output['Location_STREET_and_FBI_Code_18'] = (
        (df_input['Location Description'] == 'STREET') & 
        (df_input['FBI Code'] == '18')
    ).astype(int)
    df_output['Beat_in_range_and_District_in_list'] = (
        (df_input['Beat'] >= 1100) & (df_input['Beat'] <= 1700) & 
        (df_input['District'].isin([11, 15, 16, 18, 19]))
    ).astype(int)
    df_output['Year_2025_and_Primary_NARCOTICS'] = (
        (df_input['Year'] == 2025) & 
        (df_input['Primary Type'] == 'NARCOTICS')
    ).astype(int)
    return df_output

