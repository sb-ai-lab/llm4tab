def extracting_features_1(df_input):
    import pandas as pd
    df_output = pd.DataFrame()
    df_output['Primary_Type_NARCOTICS'] = (df_input['Primary Type'] == 'NARCOTICS').astype(int)
    df_output['Primary_Type_WEAPONS_VIOLATION'] = (df_input['Primary Type'] == 'WEAPONS VIOLATION').astype(int)
    df_output['Primary_Type_THEFT_Description_RETAIL_THEFT'] = ((df_input['Primary Type'] == 'THEFT') & (df_input['Description'] == 'RETAIL THEFT')).astype(int)
    df_output['Description_POSSESS_PCP_HEROIN_CANNABIS_COCAINE'] = df_input['Description'].isin(['POSSESS - PCP', 'POSSESS - HEROIN (WHITE)', 'POSSESS - CANNABIS MORE THAN 30 GRAMS', 'MANUFACTURE / DELIVER - COCAINE']).astype(int)
    df_output['Location_Description_STREET_SIDEWALK'] = df_input['Location Description'].isin(['STREET', 'SIDEWALK']).astype(int)
    df_output['FBI_Code_18'] = (df_input['FBI Code'] == '18').astype(int)
    df_output['Domestic0_PrimaryType_BATTERY_Description_SIMPLE'] = ((df_input['Domestic'] == 0) & (df_input['Primary Type'] == 'BATTERY') & (df_input['Description'] == 'SIMPLE')).astype(int)
    df_output['Beat_1100_1700_District_11_17'] = ((df_input['Beat'] >= 1100) & (df_input['Beat'] <= 1700) & (df_input['District'] >= 11) & (df_input['District'] <= 17)).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/10/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/30/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date_range_PrimaryType_NARCOTICS_WEAPONS'] = (((df_input['Date_parsed'] >= start_date) & (df_input['Date_parsed'] <= end_date)) & (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))).astype(int)
    df_output['Lat_Long_PrimaryType_NARCOTICS_THEFT'] = (((df_input['Latitude'] >= 41.85) & (df_input['Latitude'] <= 41.97)) & ((df_input['Longitude'] >= -87.75) & (df_input['Longitude'] <= -87.60)) & (df_input['Primary Type'].isin(['NARCOTICS', 'THEFT']))).astype(int)
    df_input.drop(columns=['Date_parsed'], inplace=True)
    return df_output

