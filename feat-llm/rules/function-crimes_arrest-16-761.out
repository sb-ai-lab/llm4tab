def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_CRIMINAL_DAMAGE'] = (df_input['Primary Type'] == 'CRIMINAL DAMAGE').astype(int)
    df_output['Primary_Type_THEFT_Description_500_AND_UNDER_TO_PROPERTY'] = (
        (df_input['Primary Type'] == 'THEFT') & 
        (df_input['Description'].isin(['$500 AND UNDER', 'TO PROPERTY']))
    ).astype(int)
    df_output['Domestic_1'] = (df_input['Domestic'] == 1).astype(int)
    df_output['Location_Description_selected'] = df_input['Location Description'].isin([
        'ALLEY', 'NURSING / RETIREMENT HOME', 'HOSPITAL BUILDING / GROUNDS', 'APARTMENT'
    ]).astype(int)
    df_output['FBI_Code_14_06'] = df_input['FBI Code'].isin(['14', '06']).astype(int)
    df_output['Primary_Type_BATTERY_Description_selected'] = (
        (df_input['Primary Type'] == 'BATTERY') & 
        (df_input['Description'].isin(['AGGRAVATED - HANDGUN', 'DOMESTIC BATTERY SIMPLE']))
    ).astype(int)
    df_output['Beat_1000_1200_District_10'] = (
        (df_input['Beat'] >= 1000) & (df_input['Beat'] <= 1200) & (df_input['District'] == 10)
    ).astype(int)
    df_output['Ward_20_30_Community_Area_25_35'] = (
        (df_input['Ward'] >= 20) & (df_input['Ward'] <= 30) & 
        (df_input['Community Area'] >= 25) & (df_input['Community Area'] <= 35)
    ).astype(int)
    df_output['Date_01_01_2025_to_01_20_2025_Primary_Type_THEFT'] = (
        (pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p') >= pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')) &
        (pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p') <= pd.to_datetime('01/20/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')) &
        (df_input['Primary Type'] == 'THEFT')
    ).astype(int)
    df_output['Description_RETAIL_THEFT_Primary_Type_not_NARCOTICS_WEAPONS_VIOLATION'] = (
        (df_input['Description'] == 'RETAIL THEFT') & 
        (~df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))
    ).astype(int)
    return df_output

