def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_NARCOTICS'] = (df_input['Primary Type'] == 'NARCOTICS').astype(int)
    df_output['Primary_Type_WEAPONS_VIOLATION'] = (df_input['Primary Type'] == 'WEAPONS VIOLATION').astype(int)
    df_output['Primary_Type_BATTERY_Description_SIMPLE_Domestic_0'] = (
        (df_input['Primary Type'] == 'BATTERY') & 
        (df_input['Description'] == 'SIMPLE') & 
        (df_input['Domestic'] == 0)
    ).astype(int)
    df_output['Primary_Type_THEFT_Description_RETAIL_THEFT'] = (
        (df_input['Primary Type'] == 'THEFT') & 
        (df_input['Description'] == 'RETAIL THEFT')
    ).astype(int)
    df_output['Location_Street_Sidewalk_Primary_Narcotics_Weapons'] = (
        (df_input['Location Description'].isin(['STREET', 'SIDEWALK'])) & 
        (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))
    ).astype(int)
    df_output['FBI_Code_18_15'] = df_input['FBI Code'].astype(str).isin(['18', '15']).astype(int)
    df_output['Domestic_0_Primary_Narcotics_Weapons'] = (
        (df_input['Domestic'] == 0) & 
        (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))
    ).astype(int)
    df_output['Description_Drug_Possession'] = df_input['Description'].isin([
        'POSSESS - PCP', 
        'POSSESS - HEROIN (WHITE)', 
        'POSSESS - CANNABIS MORE THAN 30 GRAMS', 
        'MANUFACTURE / DELIVER - COCAINE'
    ]).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/10/2025', format='%m/%d/%Y')
    end_date = pd.to_datetime('01/21/2025', format='%m/%d/%Y')
    df_output['Date_in_range_Primary_Narcotics'] = (
        (df_input['Date_parsed'] >= start_date) & 
        (df_input['Date_parsed'] <= end_date) & 
        (df_input['Primary Type'] == 'NARCOTICS')
    ).astype(int)
    df_output['Beat_in_range_Primary_Narcotics_Weapons'] = (
        (df_input['Beat'] >= 1000) & 
        (df_input['Beat'] <= 1700) & 
        (df_input['Primary Type'].isin(['NARCOTICS', 'WEAPONS VIOLATION']))
    ).astype(int)
    df_output.drop(columns=['Date_parsed'], inplace=True)
    return df_output