    df_output['Received Support Low and Number of household members 6 to 8'] = ((df_input['Recieved Support'] == 'Low') & (df_input['Number of household members'] == '6 to 8')).astype(int)  
    df_output['Abuse No and Received Support Low and Angry after latest child birth Yes'] = ((df_input['Abuse'] == 'No') & (df_input['Recieved Support'] == 'Low') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)  
    df_output['Received Support Low and Relax/sleep when newborn is tended Yes and Angry after latest child birth Yes'] = ((df_input['Recieved Support'] == 'Low') & (df_input['Relax/sleep when newborn is tended'] == 'Yes') & (df_input['Angry after latest child birth'] == 'Yes')).astype(int)  
