def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Marital status'] = df_input['Marital status'].isin(['Married']).astype(int)
    df_output['Relationship with husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Recieved Support'] = df_input['Recieved Support'].isin(['High']).astype(int)
    df_output['Feeling about motherhood'] = df_input['Feeling about motherhood'].isin(['Happy']).astype(int)
    df_output['Regular checkups'] = df_input['Regular checkups'].isin(['Yes']).astype(int)
    df_output['Addiction'] = df_input['Addiction'].isin(['No']).astype(int)
    df_output['Trust and share feelings'] = df_input['Trust and share feelings'].isin(['Yes']).astype(int)
    df_output['Worry about newborn'] = df_input['Worry about newborn'].isin(['No']).astype(int)
    df_output['Relax/sleep when the newborn is asleep'] = df_input['Relax/sleep when the newborn is asleep'].isin(['Yes']).astype(int)
    df_output['Need for Support'] = df_input['Need for Support'].isin(['Low', 'No']).astype(int)
    return df_output

