def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Age'] = df_input['Age'].apply(lambda x: 1 if 30 <= x <= 45 else 0)
    df_output['Residence'] = df_input['Residence'].apply(lambda x: 1 if x == 'City' else 0)
    df_output['Education Level'] = df_input['Education Level'].apply(lambda x: 1 if x in ['University', 'College'] else 0)
    df_output['Marital status'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Married' else 0)
    df_output['Occupation before latest pregnancy'] = df_input['Occupation before latest pregnancy'].apply(lambda x: 1 if x in ['Doctor', 'Teacher', 'Service', 'Business'] else 0)
    df_output['Monthly income before latest pregnancy'] = df_input['Monthly income before latest pregnancy'].apply(lambda x: 1 if x in ['More than 30000', '20000 to 30000'] else 0)
    df_output['Relationship with husband'] = df_input['Relationship with husband'].apply(lambda x: 1 if x in ['Good', 'Friendly'] else 0)
    df_output['Recieved Support'] = df_input['Recieved Support'].apply(lambda x: 1 if x == 'High' else 0)
    df_output['Feeling about motherhood'] = df_input['Feeling about motherhood'].apply(lambda x: 1 if x == 'Happy' else 0)
    df_output['Regular checkups'] = df_input['Regular checkups'].apply(lambda x: 1 if x == 'Yes' else 0)
    return df_output

