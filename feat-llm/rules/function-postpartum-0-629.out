def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_about_motherhood'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Bad', 'Poor']).astype(int)
    df_output['Received_Support'] = df_input['Recieved Support'].isin(['Low']).astype(int)
    df_output['Abuse'] = df_input['Abuse'].isin(['Yes']).astype(int)
    df_output['Need_for_Support'] = df_input['Need for Support'].isin(['High', 'Medium']).astype(int)
    df_output['Trust_and_share_feelings'] = df_input['Trust and share feelings'].isin(['No']).astype(int)
    df_output['Relationship_with_newborn'] = df_input['Relationship with the newborn'].isin(['Bad', 'Neutral']).astype(int)
    df_output['History_of_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy'] = df_input['Major changes or losses during pregnancy'].isin(['Yes']).astype(int)
    df_output['Angry_after_latest_child_birth'] = df_input['Angry after latest child birth'].isin(['Yes']).astype(int)
    return df_output

