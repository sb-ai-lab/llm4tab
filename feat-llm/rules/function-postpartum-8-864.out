def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['Family_type_condition'] = df_input['Family type'].isin(['Nuclear', 'Joint']).astype(int) * (df_input['Abuse'] == 'No').astype(int)  
    df_output['Abuse_condition'] = (df_input['Abuse'] == 'No').astype(int)  
    df_output['Relationship_newborn_condition'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)  
    df_output['Pregnancy_plan_condition'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)  
    df_output['Received_Support_condition'] = (df_input['Received Support'] == 'High').astype(int)  
    df_output['Feeling_regular_activities_condition'] = (df_input['Feeling for regular activities'] == 'No').astype(int)  
    df_output['Age_newborn_condition'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year']).astype(int)  
    occupation_after = ['Student', 'Housewife', 'Service', 'Teacher', 'Doctor']  
    df_output['Occupation_after_latest_childbirth_condition'] = df_input['Occupation After Your Latest Childbirth'].isin(occupation_after).astype(int) * (df_input['Abuse'] == 'No').astype(int)  
    education_levels = ['University', 'College', 'High School']  
    df_output['Education_Level_condition'] = df_input['Education Level'].str.title().isin([e.title() for e in education_levels]).astype(int)  
    income_levels = ['No', '20000 to 30000', 'More than 30000']  
    df_output['Monthly_income_before_latest_pregnancy_condition'] = df_input['Monthly income before latest pregnancy'].isin(income_levels).astype(int) * (df_input['Received Support'] == 'High').astype(int) * (df_input['Abuse'] == 'No').astype(int)  
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Abuse_Yes'] = (df_input['Abuse'] == 'Yes').astype(int)
    df_output['Relationship_Neutral_Bad'] = df_input['Relationship with the newborn'].isin(['Neutral', 'Bad']).astype(int)
    df_output['Received_Support_Low_Medium'] = df_input['Received Support'].isin(['Low', 'Medium']).astype(int)
    df_output['Feeling_Worried_Tired_Afraid'] = df_input['Feeling for regular activities'].isin(['Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Pregnancy_plan_No_unplanned'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    df_output['Family_type_Joint_and_Support_Low_Medium'] = ((df_input['Family type'] == 'Joint') & (df_input['Received Support'].isin(['Low', 'Medium']))).astype(int)
    df_output['Monthly_income_Low_Medium'] = (df_input['Monthly income before latest pregnancy'].isin(['Less than 5000', '5000 to 10000', 'No']) & df_input['Received Support'].isin(['Low', 'Medium'])).astype(int)
    df_output['Occupation_After_Childbirth_Student_Housewife_Abuse_LowSupport'] = ((df_input['Occupation After Your Latest Childbirth'].isin(['Student', 'Housewife'])) & ((df_input['Abuse'] == 'Yes') | (df_input['Received Support'].isin(['Low'])))).astype(int)
    df_output['Age_of_newborn_Tired_Worried'] = (df_input['Age of newborn'].isin(['0 to 6 months', '1 year to 1.5 year', 'Older than 1.5 year']) & df_input['Feeling for regular activities'].isin(['Tired', 'Worried'])).astype(int)
    df_output['Education_Level_Abuse_LowSupport'] = (df_input['Education Level'].isin(['Primary School', 'No', 'High school']) & ((df_input['Abuse'] == 'Yes') | (df_input['Received Support'].isin(['Low'])))).astype(int)
    return df_output

