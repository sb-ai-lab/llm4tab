def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship with husband'] = df_input['Relationship with husband'].isin(['Good', 'Friendly']).astype(int)
    df_output['Family type'] = (df_input['Family type'] == 'Nuclear').astype(int)
    df_output['Total children'] = (df_input['Total children'] == 'One').astype(int)
    df_output['Number of household members'] = df_input['Number of household members'].between(2,5).astype(int)
    df_output['Birth compliancy'] = (df_input['Birth compliancy'] == 'No').astype(int)
    df_output['Relationship between father and newborn'] = df_input['Relationship between father and newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Age'] = df_input['Age'].between(20,30).astype(int)
    df_output['Trust and share feelings'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['Education Level'] = df_input['Education Level'].isin(['University', 'College']).astype(int)
    df_output['Pregnancy plan'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)
    return df_output

