def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_husband'] = df_input['Relationship with husband'].isin(['Neutral', 'Bad', 'Poor']).astype(int)
    df_output['Family_type'] = (df_input['Family type'] == 'Joint').astype(int)
    df_output['Total_children'] = df_input['Total children'].isin(['Two', 'More than two']).astype(int)
    df_output['Number_of_household_members'] = df_input['Number of household members'].isin(['6 to 8', '9 or more']).astype(int)
    df_output['Birth_compliancy'] = (df_input['Birth compliancy'] == 'Yes').astype(int)
    df_output['Relationship_between_father_and_newborn'] = df_input['Relationship between father and newborn'].isin(['Neutral', 'Bad']).astype(int)
    df_output['Age'] = df_input['Age'].between(24, 35).astype(int)
    df_output['Trust_and_share_feelings'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Education_Level'] = df_input['Education Level'].isin(['Primary School', 'High School']).astype(int)
    df_output['Pregnancy_plan'] = (df_input['Pregnancy plan'] == 'No').astype(int)
    return df_output

