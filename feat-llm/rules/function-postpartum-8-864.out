def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry after latest child birth'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Relax/sleep when newborn is tended'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Worry about newborn'] = (df_input['Worry about newborn'] == 'Yes').astype(int)
    df_output['Number of the latest pregnancy'] = (df_input['Number of the latest pregnancy'] <= 2).astype(int)
    df_output['Pregnancy plan'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)
    df_output['History of pregnancy loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery', 'Still-born delivery']).astype(int)
    df_output['Birth compliancy'] = df_input['Birth compliancy'].apply(lambda x: 1 if x in ['Yes', 'No'] else 0)
    df_output['Diseases during pregnancy'] = (df_input['Diseases during pregnancy'] == 'No').astype(int)
    df_output['Education Level'] = (df_input['Education Level'] == 'University').astype(int)
    df_output['Occupation before latest pregnancy'] = df_input['Occupation before latest pregnancy'].isin(['Student', 'Other']).astype(int)
    return df_output