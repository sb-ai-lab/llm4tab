def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['LIQUOR LAW VIOLATION', 'NARCOTICS', 'WEAPONS VIOLATION', 'THEFT', 'CRIMINAL DAMAGE', 'BATTERY']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['POSSESS - HEROIN (WHITE)', 'MANUFACTURE / DELIVER - COCAINE', 'UNLAWFUL POSSESSION - HANDGUN', 'RETAIL THEFT', 'TO VEHICLE', 'DOMESTIC BATTERY SIMPLE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['BAR OR TAVERN', 'SIDEWALK', 'DEPARTMENT STORE', 'CTA BUS']).astype(int)
    df_output['Domestic'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].astype(str).isin(['18', '15', '22', '06', '14', '08B']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 300) & (df_input['Beat'] <= 2000)).astype(int)
    df_output['District'] = df_input['District'].isin([3, 4, 11, 16, 18, 19, 25]).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 9) & (df_input['Ward'] <= 42)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 7) & (df_input['Community Area'] <= 76)).astype(int)
    df_output['Date'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p').dt.hour >= 17
    df_output['Date'] = df_output['Date'].astype(int)
    return df_output