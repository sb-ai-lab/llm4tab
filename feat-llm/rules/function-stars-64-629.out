def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['SpType_contains_V'] = df_input['SpType'].str.contains('V').astype(int)
    df_output['SpType_contains_IV_not_III_II'] = df_input['SpType'].apply(lambda x: ('IV' in x) and ('III' not in x) and ('II' not in x)).astype(int)
    df_output['Amag_ge_17'] = (df_input['Amag'] >= 17).astype(int)
    df_output['B_V_le_0_6'] = (df_input['B-V'] <= 0.6).astype(int)
    df_output['Plx_ge_6'] = (df_input['Plx'] >= 6).astype(int)
    df_output['Vmag_between_6_and_10'] = ((df_input['Vmag'] >= 6) & (df_input['Vmag'] <= 10)).astype(int)
    df_output['e_Plx_le_1_5'] = (df_input['e_Plx'] <= 1.5).astype(int)
    df_output['SpType_not_contains_III_II_III_IV_II_III'] = df_input['SpType'].apply(lambda x: all(sub not in x for sub in ['III', 'II', 'III/IV', 'II/III'])).astype(int)
    df_output['Amag_in_17_21'] = ((df_input['Amag'] >= 17) & (df_input['Amag'] <= 21)).astype(int)
    df_output['B_V_in_0_2_0_6'] = ((df_input['B-V'] >= 0.2) & (df_input['B-V'] <= 0.6)).astype(int)
    return df_output

