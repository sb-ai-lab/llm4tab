def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books_is_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day_ge_1'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Frequency_of_reading_books_in_Daily_Several_times_a_week'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['Number_of_e_books_read_last_two_years_in_6_10_11_15_16_20_More_than_20'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number_of_printed_books_read_last_two_years_in_6_10_11_15_16_20_More_than_20'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Favorite_books_for_reading_leisure_in_Non_Fiction_Biography'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Change_after_reading_books_is_Increase_Academic_Performance'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Who_influenced_you_to_read_books_in_Teachers_Parents'] = df_input['Who influenced you to read books'].isin(['Teachers', 'Parents']).astype(int)
    df_output['Department_in_CSE_SWE_Pharmacy_EEE_Civil_CIS_MCT'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'CIS', 'MCT']).astype(int)
    df_output['Format_used_for_reading_books_in_E_books_Buy_Used_all'] = df_input['The format that you used for reading books'].isin(['E-books', 'Buy', 'Used-all']).astype(int)
    return df_output

