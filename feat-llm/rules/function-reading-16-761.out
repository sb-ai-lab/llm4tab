def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['time_spent_reading_lt_0_5'] = (df_input['Amount of time spent reading books per day'] < 0.5).astype(int)
    df_output['reason_reading_in_list'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge', 'Keep me informative']).astype(int)
    df_output['frequency_reading_in_list'] = df_input['Frequency of reading books'].isin(['Less than once a year', 'Once or twice a year']).astype(int)
    df_output['ebooks_read_in_list'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['printed_books_read_in_list'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['favorite_books_in_list'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['department_in_list'] = df_input['Department'].isin(['BBA', 'English', 'JMC', 'NFE', 'Others']).astype(int)
    df_output['change_not_in_list'] = (~df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill'])).astype(int)
    df_output['manage_books_in_list'] = df_input['How to manage books for reading'].isin(['Borrow', 'Others']).astype(int)
    freq_map = {
        'On everyday basis': 30,
        'A few times a week': 12,
        'A few times a month': 3,
        'Once or twice a year': 0.17,
        'Less than once a year': 0.05
    }
    freq_num = df_input['Frequency of reading books'].map(freq_map)
    df_output['frequency_reading_le_1_per_month'] = (freq_num <= 1).astype(int)
    return df_output

