def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Reason_for_reading_books'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    freq_condition_1 = df_input['Frequency of reading books'].isin(['On everyday basis', 'Several times a week'])
    df_output['Frequency_of_reading_books_1'] = freq_condition_1.astype(int)
    ebooks_condition = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20'])
    df_output['Number_of_e_books_read_last_two_years'] = ebooks_condition.astype(int)
    printed_condition = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20'])
    df_output['Number_of_printed_books_read_last_two_years'] = printed_condition.astype(int)
    fav_books_condition = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography'])
    df_output['Favorite_books_for_leisure'] = fav_books_condition.astype(int)
    dept_condition = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'Textile', 'CIS'])
    df_output['Department'] = dept_condition.astype(int)
    change_condition = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Problem Solving Skill'])
    df_output['Change_after_reading_books'] = change_condition.astype(int)
    manage_books_condition = df_input['How to manage books for reading'].isin(['E-books', 'Buy', 'Used-all'])
    df_output['How_to_manage_books'] = manage_books_condition.astype(int)
    freq_condition_2 = df_input['Frequency of reading books'].isin(['Several times a week', 'On everyday basis'])
    df_output['Frequency_of_reading_books_2'] = freq_condition_2.astype(int)
    return df_output

