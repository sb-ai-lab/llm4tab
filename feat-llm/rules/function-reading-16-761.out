def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_for_reading_books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge', 'Keep me informative']).astype(int)
    df_output['Department'] = df_input['Department'].isin(['English', 'BBA', 'JMC', 'Others']).astype(int)
    df_output['Favorite_books_for_leisure'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Biography', 'Others']).astype(int)
    freq_values = ['A few times a month', 'Rarely', 'Once a week']
    df_output['Frequency_of_reading_books'] = df_input['Frequency of reading books'].isin(freq_values).astype(int)
    df_output['Amount_of_time_spent_reading_books_per_day'] = (df_input['Amount of time spent reading books per day'] < 1).astype(int)
    ebooks_values = [float('nan'), '1-5']
    df_output['Number_of_e_books_read_last_two_years'] = df_input['Number of e-books you read last two years'].apply(lambda x: 1 if (pd.isna(x) or x == '1-5') else 0)
    pbooks_values = [float('nan'), '1-5']
    df_output['Number_of_printed_books_read_last_two_years'] = df_input['Number of printed books you read last two years'].apply(lambda x: 1 if (pd.isna(x) or x == '1-5') else 0)
    df_output['Change_after_reading_books'] = (df_input['What is the change that you fell after reading books'] != 'Increase Academic Performance').astype(int)
    df_output['Who_influenced_you_to_read_books'] = df_input['Who influenced you to read books'].isin(['Friends', 'Family', 'Self-motivation']).astype(int)
    df_output['How_to_manage_books_for_reading'] = df_input['How to manage books for reading'].isin(['Buy', 'Used-all', 'Others']).astype(int)
    return df_output

