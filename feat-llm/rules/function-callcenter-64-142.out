def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['The_reason_of_the_call_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_151_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_No'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['How_often_do_you_receive_call_center_news'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.0).astype(int)
    high_satisfaction = df_input['Satisfaction_with_the_doctors_response'] >= 3.0
    df_output['Marital_Status_Married_or_Single_high_satisfaction'] = ((df_input['Marital_Status'].isin(['Married', 'Single'])) & high_satisfaction).astype(int)
    df_output['Governorate_Around_or_Capital_high_satisfaction'] = ((df_input['Governorate'].isin(['Around', 'Capital'])) & high_satisfaction).astype(int)
    df_output['Education_Bachelor_Diploma_Master_Doctor_high_satisfaction'] = ((df_input['Education'].isin(['Bachelor', 'Diploma', 'Master', 'Doctor'])) & high_satisfaction).astype(int)
    df_output['Gender_Female_high_satisfaction'] = ((df_input['Gender'] == 'Female') & high_satisfaction).astype(int)
    return df_output

