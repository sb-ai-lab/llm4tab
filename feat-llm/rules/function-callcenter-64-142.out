def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Call_center_employee_communication_skills_evaluation_lt_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] < 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_lt_3'] = (df_input['Satisfaction_with_the_doctors_response'] < 3.0).astype(int)
    df_output['The_reason_of_the_call_in_list'] = df_input['The_reason_of_the_call'].isin(['Vaccination', 'Inquiries', 'Inquiries_COVID19', 'Medical_Consultation']).astype(int)
    df_output['Call_151_Yes'] = (df_input['Call_151'] == 'Yes').astype(int)
    df_output['Aware_151_Yes'] = (df_input['Aware_151'] == 'Yes').astype(int)
    df_output['How_often_do_you_receive_call_center_news_lt_2'] = (df_input['How_often_do_you_receive_call_center_news'] < 2.0).astype(int)
    df_output['Education_in_list_and_low_satisfaction'] = ((df_input['Education'].isin(['Bachelor', 'High school', 'Master'])) & (df_input['Satisfaction_with_the_doctors_response'] < 3.0)).astype(int)
    df_output['Age_in_list_and_low_communication'] = ((df_input['Age'].isin(['18-24', '25-29', '30-39'])) & (df_input['Call_center_employee_communication_skills_evaluation'] < 3.0)).astype(int)
    df_output['Gender_Male_and_low_satisfaction'] = ((df_input['Gender'] == 'Male') & (df_input['Satisfaction_with_the_doctors_response'] < 3.0)).astype(int)
    df_output['Nationality_Kuwaiti_and_low_satisfaction'] = ((df_input['Nationality'] == 'Kuwaiti') & (df_input['Satisfaction_with_the_doctors_response'] < 3.0)).astype(int)
    return df_output

