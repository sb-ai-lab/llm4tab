def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_3.0'] = (df_input['Call_center_employee_communication_skills_evaluation'] == 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_3.0'] = (df_input['Satisfaction_with_the_doctors_response'] == 3.0).astype(int)
    df_output['Call_151_No'] = (df_input['Call_151'] == 'No').astype(int)
    df_output['Aware_151_No'] = (df_input['Aware_151'] == 'No').astype(int)
    df_output['Age_in_selected'] = df_input['Age'].isin(['18-24', '30-39', '50-59']).astype(int)
    df_output['Education_in_selected'] = df_input['Education'].isin(['Bachelor', 'High school', 'Diploma', 'Master']).astype(int)
    df_output['Nationality_Kuwaiti'] = (df_input['Nationality'] == 'Kuwaiti').astype(int)
    df_output['How_often_do_you_receive_call_center_news_ge_2.2'] = (df_input['How_often_do_you_receive_call_center_news'] >= 2.2).astype(int)
    df_output['Marital_Status_in_selected'] = df_input['Marital_Status'].isin(['Single', 'Married']).astype(int)
    return df_output