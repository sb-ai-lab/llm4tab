def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Department'] = df_input['Department'].isin(['English', 'BBA', 'JMC', 'Others']).astype(int)
    df_output['Reason for reading books'] = df_input['Reason for reading books'].isin(['Entertainment Purpose', 'To increase my English vocabulary knowledge', 'Keep me informative']).astype(int)
    df_output['Amount of time spent reading books per day'] = (df_input['Amount of time spent reading books per day'] < 0.5).astype(int)
    df_output['Number of e-books you read last two years'] = df_input['Number of e-books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Number of printed books you read last two years'] = df_input['Number of printed books you read last two years'].isin(['1-5', float('nan')]).astype(int)
    df_output['Favorite books for reading to spend leisure time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Fiction', 'Politics', 'Others']).astype(int)
    df_output['Frequency of reading books'] = df_input['Frequency of reading books'].isin(['Rarely', 'Once a month', 'Once in a while']).astype(int)
    df_output['How to manage books for reading'] = df_input['How to manage books for reading'].isin(['Others', 'E-books']).astype(int)
    df_output['What is the change that you fell after reading books'] = (~df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Creative Thinking'])).astype(int)
    df_output['The format that you used for reading books'] = df_input['The format that you used for reading books'].isin(['E-books', 'Others']).astype(int)
    return df_output

