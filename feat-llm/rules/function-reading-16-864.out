def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Department'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'MCT', 'Textile', 'CIS']).astype(int)
    df_output['Reason for reading books'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Amount of time spent reading books per day'] = (df_input['Amount of time spent reading books per day'] >= 1).astype(int)
    df_output['Number of e-books you read last two years'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Number of printed books you read last two years'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Favorite books for reading to spend leisure time'] = df_input['Favorite books for reading to spend leisure time'].isin(['Non-Fiction', 'Biography']).astype(int)
    df_output['Frequency of reading books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'A few times a week']).astype(int)
    df_output['How to manage books for reading'] = df_input['How to manage books for reading'].isin(['Borrow', 'Buy', 'Used-all']).astype(int)
    df_output['What is the change that you fell after reading books'] = df_input['What is the change that you fell after reading books'].isin(['Increase Academic Performance', 'Increase Creative Thinking']).astype(int)
    df_output['The format that you used for reading books'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    return df_output

