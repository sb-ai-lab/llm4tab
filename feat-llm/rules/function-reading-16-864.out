def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Reason_Academic_Purpose'] = (df_input['Reason for reading books'] == 'Academic Purpose').astype(int)
    df_output['Time_spent_reading_2_or_more'] = (df_input['Amount of time spent reading books per day'] >= 2).astype(int)
    df_output['Frequency_reading_books'] = df_input['Frequency of reading books'].isin(['On everyday basis', 'Almost every day']).astype(int)
    df_output['Department_selected'] = df_input['Department'].isin(['CSE', 'SWE', 'Pharmacy', 'EEE', 'Civil', 'Textile', 'MCT', 'CIS']).astype(int)
    df_output['E_books_read'] = df_input['Number of e-books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Printed_books_read'] = df_input['Number of printed books you read last two years'].isin(['6-10', '11-15', '16-20', 'More than 20']).astype(int)
    df_output['Change_after_reading'] = (df_input['What is the change that you fell after reading books'] == 'Increase Academic Performance').astype(int)
    df_output['Manage_books'] = df_input['How to manage books for reading'].isin(['E-books', 'Borrow', 'Buy']).astype(int)
    df_output['Format_used'] = (df_input['The format that you used for reading books'] == 'Both').astype(int)
    df_output['Influenced_by'] = df_input['Who influenced you to read books'].isin(['Self-Decision', 'Teachers', 'Parents']).astype(int)
    return df_output

