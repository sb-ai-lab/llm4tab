def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities_in_list_AND_Angry_after_latest_child_birth_No'] = (
        df_input['Feeling for regular activities'].isin(['No', 'Tired', 'Worried', 'Afraid']) &
        (df_input['Angry after latest child birth'] == 'No')
    ).astype(int)
    df_output['Newborn_illness_No'] = (df_input['Newborn illness'] == 'No').astype(int)
    df_output['Relationship_with_newborn_Good'] = (df_input['Relationship with the newborn'] == 'Good').astype(int)
    df_output['Relationship_father_newborn_Good'] = (df_input['Relationship between father and newborn'] == 'Good').astype(int)
    df_output['Current_monthly_income_in_list'] = df_input['Current monthly income'].isin(['No', '5000 to 10000', '20000 to 30000']).astype(int)
    df_output['Number_of_household_members_in_list'] = df_input['Number of household members'].isin(['2 to 5', '6 to 8']).astype(int)
    df_output['Age_in_range_19_36'] = ((df_input['Age'] >= 19) & (df_input['Age'] <= 36)).astype(int)
    df_output['Occupation_after_latest_childbirth_in_list'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'Business', 'Service']).astype(int)
    df_output['Number_of_latest_pregnancy_ge_1'] = (df_input['Number of the latest pregnancy'] >= 1).astype(int)
    df_output['Feeling_for_regular_activities_No_AND_Angry_after_latest_child_birth_No'] = (
        (df_input['Feeling for regular activities'] == 'No') &
        (df_input['Angry after latest child birth'] == 'No')
    ).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_child_birth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Feeling_for_regular_activities_in_list'] = df_input['Feeling for regular activities'].isin(['No', 'Worried', 'Tired', 'Afraid']).astype(int)
    df_output['Current_monthly_income_No'] = (df_input['Current monthly income'] == 'No').astype(int)
    df_output['Number_of_household_members_in_range'] = df_input['Number of household members'].isin(['2 to 5', '6 to 8']).astype(int)
    df_output['Relationship_with_newborn_Good'] = (df_input['Relationship with the newborn'] == 'Good').astype(int)
    df_output['Relationship_between_father_and_newborn_in_list'] = df_input['Relationship between father and newborn'].isin(['Good', 'Neutral']).astype(int)
    df_output['Occupation_After_Your_Latest_Childbirth_Housewife'] = (df_input['Occupation After Your Latest Childbirth'] == 'Housewife').astype(int)
    df_output['Number_of_the_latest_pregnancy_in_range'] = df_input['Number of the latest pregnancy'].between(1,3).astype(int)
    df_output['Age_in_range'] = df_input['Age'].between(18,30).astype(int)
    df_output['Newborn_illness_in_list'] = df_input['Newborn illness'].isin(['No', 'Yes']).astype(int)
    return df_output

