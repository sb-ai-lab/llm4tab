def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Need for Support is No'] = (df_input['Need for Support'] == 'No').astype(int)
    df_output['Feeling about motherhood is Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Angry after latest child birth is No'] = (df_input['Angry after latest child birth'] == 'No').astype(int)
    df_output['Relax/sleep when newborn is tended is Yes'] = (df_input['Relax/sleep when newborn is tended'] == 'Yes').astype(int)
    df_output['Major changes or losses during pregnancy is No'] = (df_input['Major changes or losses during pregnancy'] == 'No').astype(int)
    df_output['Birth compliancy is No'] = (df_input['Birth compliancy'] == 'No').astype(int)
    income_conditions = ['5000 to 10000', '10000 to 20000', '20000 to 30000', 'More than 30000']
    df_output['Current monthly income in specified ranges'] = df_input['Current monthly income'].isin(income_conditions).astype(int)
    df_output['Family type is Joint'] = (df_input['Family type'] == 'Joint').astype(int)
    df_output['Breastfeed is Yes'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    cond_mode_delivery = df_input['Mode of delivery'].isin(['Normal Delivery', 'Caesarean Section'])
    cond_need_support_low = (df_input['Need for Support'] == 'Low')
    cond_angry_no = (df_input['Angry after latest child birth'] == 'No')
    df_output['Mode of delivery in specified and Need for Support Low and Angry No'] = (cond_mode_delivery & cond_need_support_low & cond_angry_no).astype(int)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Angry_after_latest_child_birth_Yes'] = (df_input['Angry after latest child birth'] == 'Yes').astype(int)
    df_output['Need_for_Support_Medium_or_Low'] = df_input['Need for Support'].isin(['Medium', 'Low']).astype(int)
    df_output['Relax_sleep_when_newborn_is_tended_No'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Feeling_about_motherhood_Sad_or_Neutral'] = df_input['Feeling about motherhood'].isin(['Sad', 'Neutral']).astype(int)
    df_output['Major_changes_or_losses_during_pregnancy_Yes'] = (df_input['Major changes or losses during pregnancy'] == 'Yes').astype(int)
    df_output['Birth_compliancy_Yes'] = (df_input['Birth compliancy'] == 'Yes').astype(int)
    df_output['Current_monthly_income_No'] = (df_input['Current monthly income'] == 'No').astype(int)
    df_output['Family_type_Nuclear'] = (df_input['Family type'] == 'Nuclear').astype(int)
    df_output['Breastfeed_No'] = (df_input['Breastfeed'] == 'No').astype(int)
    cond_mode_delivery = (df_input['Mode of delivery'] == 'Caesarean Section')
    cond_angry = (df_input['Angry after latest child birth'] == 'Yes')
    cond_support = df_input['Need for Support'].isin(['Low', 'Medium'])
    df_output['Mode_of_delivery_Caesarean_and_Angry_Yes_and_Support_Low_Medium'] = (cond_mode_delivery & cond_angry & cond_support).astype(int)
    return df_output

