def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Breastfeed'] = df_input['Breastfeed'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Relax/sleep when newborn is tended'] = df_input['Relax/sleep when newborn is tended'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Trust and share feelings'] = df_input['Trust and share feelings'].apply(lambda x: 1 if x in ['No', 'Yes'] else 0)
    df_output['Need for Support'] = df_input['Need for Support'].apply(lambda x: 1 if x in ['No', 'Low'] else 0)
    df_output['Regular checkups'] = df_input['Regular checkups'].apply(lambda x: 1 if x == 'Yes' else 0)
    df_output['Marital status'] = df_input['Marital status'].apply(lambda x: 1 if x == 'Married' else 0)
    df_output['Mode of delivery'] = df_input['Mode of delivery'].apply(lambda x: 1 if x in ['Caesarean Section', 'Normal Delivery'] else 0)
    df_output['Age of newborn'] = df_input['Age of newborn'].apply(lambda x: 1 if x in ['0 to 6 months', '6 months to 1 year', 'Older than 1.5 year'] else 0)
    df_output['Number of the latest pregnancy'] = df_input['Number of the latest pregnancy'].apply(lambda x: 1 if x >= 1 else 0)
    df_output['Residence'] = df_input['Residence'].apply(lambda x: 1 if x in ['City', 'Village'] else 0)
    return df_output

---DIVIDER---

def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Need for Support_Medium_Low'] = df_input['Need for Support'].isin(['Medium', 'Low']).astype(int)
    df_output['Relax/sleep when newborn is tended_No'] = (df_input['Relax/sleep when newborn is tended'] == 'No').astype(int)
    df_output['Trust and share feelings_No_Yes'] = df_input['Trust and share feelings'].isin(['No', 'Yes']).astype(int)
    df_output['Breastfeed_Yes_No'] = df_input['Breastfeed'].isin(['Yes', 'No']).astype(int)
    df_output['Mode of delivery_Caesarean_Normal'] = df_input['Mode of delivery'].isin(['Caesarean Section', 'Normal Delivery']).astype(int)
    df_output['Age of newborn_0_to_6m_6m_to_1y_1y_to_1.5y'] = df_input['Age of newborn'].isin(['0 to 6 months', '6 months to 1 year', '1 year to 1.5 year']).astype(int)
    df_output['Marital status_Married'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Number of the latest pregnancy_>=1'] = (df_input['Number of the latest pregnancy'] >= 1).astype(int)
    df_output['Residence_City_Village'] = df_input['Residence'].isin(['City', 'Village']).astype(int)
    df_output['Regular checkups_Yes'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    return df_output