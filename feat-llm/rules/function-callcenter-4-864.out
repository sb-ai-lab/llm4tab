def extracting_features_0(df_input):  
    df_output = pd.DataFrame()  
    df_output['The_reason_of_the_call_is_Complaints'] = (df_input['The_reason_of_the_call'] == 'Complaints').astype(int)  
    df_output['Call_center_employee_communication_skills_evaluation_lt_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] < 3.0).astype(int)  
    df_output['Satisfaction_with_the_doctors_response_lt_3'] = (df_input['Satisfaction_with_the_doctors_response'] < 3.0).astype(int)  
    df_output['Call_151_is_Yes'] = (df_input['Call_151'] == 'Yes').astype(int)  
    df_output['Aware_151_is_Yes_and_Call_151_is_Yes'] = ((df_input['Aware_151'] == 'Yes') & (df_input['Call_151'] == 'Yes')).astype(int)  
    df_output['How_often_do_you_receive_call_center_news_le_2_5'] = (df_input['How_often_do_you_receive_call_center_news'] <= 2.5).astype(int)  
    df_output['Age_in_18_24_25_29_and_The_reason_of_the_call_is_Complaints'] = ((df_input['Age'].isin(['18-24', '25-29'])) & (df_input['The_reason_of_the_call'] == 'Complaints')).astype(int)  
    df_output['Education_in_High_school_Bachelor_and_Satisfaction_lt_3'] = ((df_input['Education'].isin(['High school', 'Bachelor'])) & (df_input['Satisfaction_with_the_doctors_response'] < 3.0)).astype(int)  
    df_output['Governorate_is_Farwaniya_and_Communication_skills_lt_3'] = ((df_input['Governorate'] == 'Farwaniya') & (df_input['Call_center_employee_communication_skills_evaluation'] < 3.0)).astype(int)  
    df_output['Gender_is_Male_and_The_reason_is_Complaints_and_Satisfaction_lt_3'] = ((df_input['Gender'] == 'Male') & (df_input['The_reason_of_the_call'] == 'Complaints') & (df_input['Satisfaction_with_the_doctors_response'] < 3.0)).astype(int)  
    return df_output

