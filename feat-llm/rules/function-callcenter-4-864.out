def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_Complaints'] = df_input['The_reason_of_the_call'].isin(['Complaints']).astype(int)
    df_output['Call_center_employee_communication_skills_evaluation_le_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_lt_3'] = (df_input['Satisfaction_with_the_doctors_response'] < 3.0).astype(int)
    df_output['Call_151_Yes'] = df_input['Call_151'].isin(['Yes']).astype(int)
    df_output['Aware_151_Yes'] = df_input['Aware_151'].isin(['Yes']).astype(int)
    df_output['How_often_do_you_receive_call_center_news_lt_3'] = (df_input['How_often_do_you_receive_call_center_news'] < 3.0).astype(int)
    df_output['Education_low'] = df_input['Education'].isin(['High school', 'Less than high school', 'Diploma']).astype(int)
    df_output['Age_young'] = df_input['Age'].isin(['18-24', '25-29']).astype(int)
    df_output['Governorate_selected'] = df_input['Governorate'].isin(['Farwaniya', 'Around']).astype(int)
    df_output['Gender_Male'] = df_input['Gender'].isin(['Male']).astype(int)
    return df_output

