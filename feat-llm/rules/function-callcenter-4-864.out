def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['The_reason_of_the_call_condition'] = df_input['The_reason_of_the_call'].isin(['Complaints', 'Inquiries', 'Medical_Consultation', 'Inquiries_COVID19']).astype(int)
    low_ratings_complaints = (df_input['The_reason_of_the_call'] == 'Complaints') & ((df_input['Call_center_employee_communication_skills_evaluation'] <= 3.0) | (df_input['Satisfaction_with_the_doctors_response'] < 3.0))
    df_output.loc[low_ratings_complaints, 'The_reason_of_the_call_condition'] = 0
    df_output['Call_center_employee_communication_skills_evaluation_condition'] = (df_input['Call_center_employee_communication_skills_evaluation'] > 3.0).astype(int)
    df_output['Satisfaction_with_the_doctors_response_condition'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)
    df_output['How_often_do_you_receive_call_center_news_condition'] = (df_input['How_often_do_you_receive_call_center_news'] >= 3.0).astype(int)
    df_output['Call_151_condition'] = (df_input['Call_151'] == 'No').astype(int)
    aware_yes_high_satisfaction = (df_input['Aware_151'] == 'Yes') & (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)
    aware_no = (df_input['Aware_151'] == 'No')
    df_output['Aware_151_condition'] = (aware_no | aware_yes_high_satisfaction).astype(int)
    df_output['Education_condition'] = df_input['Education'].isin(['Bachelor', 'Master', 'Doctor']).astype(int)
    df_output['Age_condition'] = df_input['Age'].isin(['30-39', '40-49', '50-59', '60 and above']).astype(int)
    df_output['Governorate_condition'] = df_input['Governorate'].isin(['Capital', 'Mubarak AlKabir', 'AlAhmadi']).astype(int)
    df_output['Gender_condition'] = (df_input['Gender'] == 'Female').astype(int)
    return df_output

