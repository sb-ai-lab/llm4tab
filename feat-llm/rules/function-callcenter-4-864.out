def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['Satisfaction_with_the_doctors_response_ge_3'] = (df_input['Satisfaction_with_the_doctors_response'] >= 3.0).astype(int)  
    df_output['Call_center_employee_communication_skills_evaluation_ge_3'] = (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0).astype(int)  
    df_output['The_reason_of_the_call_in_selected'] = df_input['The_reason_of_the_call'].isin(['Inquiries', 'Medical_Consultation', 'Vaccination']).astype(int)  
    df_output['Call_151_No_and_The_reason_Complaints_and_Satisfaction_ge_3'] = ((df_input['Call_151'] == 'No') &  
                                                                             (df_input['The_reason_of_the_call'] == 'Complaints') &  
                                                                             (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    df_output['How_often_do_you_receive_call_center_news_gt_2_5'] = (df_input['How_often_do_you_receive_call_center_news'] > 2.5).astype(int)  
    df_output['Aware_151_No_and_Call_151_No_and_Satisfaction_ge_3'] = ((df_input['Aware_151'] == 'No') &  
                                                                      (df_input['Call_151'] == 'No') &  
                                                                      (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    df_output['Age_in_18_24_25_29_and_Communication_skills_ge_3'] = (df_input['Age'].isin(['18-24', '25-29']) &  
                                                                     (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)  
    df_output['Education_High_school_and_Satisfaction_ge_3'] = ((df_input['Education'] == 'High school') &  
                                                                (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    df_output['Governorate_Capital_and_Communication_skills_ge_3'] = ((df_input['Governorate'] == 'Capital') &  
                                                                      (df_input['Call_center_employee_communication_skills_evaluation'] >= 3.0)).astype(int)  
    df_output['Gender_Male_and_The_reason_Complaints_and_Satisfaction_ge_3'] = ((df_input['Gender'] == 'Male') &  
                                                                               (df_input['The_reason_of_the_call'] == 'Complaints') &  
                                                                               (df_input['Satisfaction_with_the_doctors_response'] >= 3.0)).astype(int)  
    return df_output