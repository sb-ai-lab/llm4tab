    df_output['B-V_in_1.0_1.4'] = ((df_input['B-V'] >= 1.0) & (df_input['B-V'] <= 1.4)).astype(int)
    df_output['SpType_III_or_II_III'] = df_input['SpType'].str.contains('III|II/III', regex=True).astype(int)
    df_output['Plx_in_0.1_3'] = ((df_input['Plx'] >= 0.1) & (df_input['Plx'] <= 3)).astype(int)
