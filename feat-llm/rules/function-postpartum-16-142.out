def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities_No'] = (df_input['Feeling for regular activities'] == 'No').astype(int)
    df_output['Trust_and_share_feelings_Yes'] = (df_input['Trust and share feelings'] == 'Yes').astype(int)
    df_output['Relax_sleep_when_newborn_asleep_Yes'] = (df_input['Relax/sleep when the newborn is asleep'] == 'Yes').astype(int)
    df_output['Feeling_about_motherhood_Happy'] = (df_input['Feeling about motherhood'] == 'Happy').astype(int)
    df_output['Number_of_household_members_2_to_5'] = df_input['Number of household members'].between(2,5).astype(int)
    df_output['Number_of_latest_pregnancy_ge_2'] = (df_input['Number of the latest pregnancy'] >= 2).astype(int)
    df_output['Occupation_After_Latest_Childbirth_in_Service_Doctor_Student'] = df_input['Occupation After Your Latest Childbirth'].isin(['Service', 'Doctor', 'Student']).astype(int)
    df_output['Feeling_for_regular_activities_Worried_and_Trust_and_share_feelings_Yes'] = ((df_input['Feeling for regular activities'] == 'Worried') & (df_input['Trust and share feelings'] == 'Yes')).astype(int)
    df_output['Age_26_to_37'] = df_input['Age'].between(26,37).astype(int)
    df_output['Occupation_before_latest_pregnancy_in_Service_Doctor_Student'] = df_input['Occupation before latest pregnancy'].isin(['Service', 'Doctor', 'Student']).astype(int)
    return df_output

