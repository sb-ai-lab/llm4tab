def extracting_features_1(df_input):  
    df_output = pd.DataFrame()  
    df_output['History_of_pregnancy_loss'] = df_input['History of pregnancy loss'].isin(['Miscarriage', 'Still-born Delivery']).astype(int)  
    df_output['Received_Support'] = df_input['Received Support'].isin(['Low', 'Medium']).astype(int)  
    df_output['Birth_compliancy_Yes'] = (df_input['Birth compliancy'] == 'Yes').astype(int)  
    df_output['Marital_status_Divorced'] = (df_input['Marital status'] == 'Divorced').astype(int)  
    df_output['Diseases_during_pregnancy'] = df_input['Diseases during pregnancy'].isin(['Chronic Disease', 'Non-Chronic Disease']).astype(int)  
    df_output['Husband_education_level'] = df_input['Husband\'s education level'].isin(['No', 'Primary School', 'High School']).astype(int)  
    df_output['Age_of_immediate_older_children_No'] = (df_input['Age of immediate older children'] == 'No').astype(int)  
    df_output['Pregnancy_plan_No'] = (df_input['Pregnancy plan'] == 'No').astype(int)  
    df_output['Relationship_with_newborn_Neutral_or_Bad'] = df_input['Relationship with the newborn'].isin(['Neutral', 'Bad']).astype(int)  
    df_output['Family_type_Joint'] = (df_input['Family type'] == 'Joint').astype(int)  
    return df_output

