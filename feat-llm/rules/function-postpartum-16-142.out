def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Feeling_for_regular_activities_in_Tired_No'] = df_input['Feeling for regular activities'].isin(['Tired', 'No']).astype(int)
    df_output['Relax_sleep_when_newborn_asleep_No'] = (df_input['Relax/sleep when the newborn is asleep'] == 'No').astype(int)
    df_output['Feeling_about_motherhood_in_Neutral_Sad'] = df_input['Feeling about motherhood'].isin(['Neutral', 'Sad']).astype(int)
    df_output['Number_of_household_members_in_6_to_8'] = df_input['Number of household members'].isin(['6', '7', '8', 6, 7, 8]).astype(int)
    df_output['Trust_and_share_feelings_No'] = (df_input['Trust and share feelings'] == 'No').astype(int)
    df_output['Number_of_latest_pregnancy_1'] = (df_input['Number of the latest pregnancy'] == 1).astype(int)
    df_output['Feeling_for_regular_activities_Tired_and_Relax_sleep_Yes'] = ((df_input['Feeling for regular activities'] == 'Tired') & (df_input['Relax/sleep when the newborn is asleep'] == 'Yes')).astype(int)
    df_output['Occupation_After_Your_Latest_Childbirth_in_Housewife_House_wife_Other'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'House wife', 'Other']).astype(int)
    df_output['Age_in_20_to_31'] = ((df_input['Age'] >= 20) & (df_input['Age'] <= 31)).astype(int)
    df_output['Feeling_for_regular_activities_Worried_and_Number_of_household_members_in_6_to_8'] = ((df_input['Feeling for regular activities'] == 'Worried') & df_input['Number of household members'].isin(['6', '7', '8', 6, 7, 8])).astype(int)
    return df_output

