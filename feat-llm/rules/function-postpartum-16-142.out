def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Mode_of_delivery'] = df_input['Mode of delivery'].isin(['Caesarean Section']).astype(int)
    df_output['Relationship_with_inlaws'] = df_input['Relationship with the in-laws'].isin(['Good', 'Neutral', 'Friendly']).astype(int)
    df_output['Residence'] = (df_input['Residence'] == 'City').astype(int)
    df_output['Regular_checkups'] = (df_input['Regular checkups'] == 'Yes').astype(int)
    df_output['Husband_monthly_income'] = df_input["Husband’s monthly income"].isin(['More than 30000', '20000 to 30000']).astype(int)
    df_output['Breastfeed'] = (df_input['Breastfeed'] == 'Yes').astype(int)
    df_output['Birth_compliancy'] = df_input['Birth compliancy'].isin(['No', 'Yes']).astype(int)
    df_output['Total_children'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Occupation_after_latest_childbirth'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'Other', 'Service', 'Doctor']).astype(int)
    df_output['Gender_of_newborn'] = df_input['Gender of newborn'].isin(['Girl', 'Boy']).astype(int)
    return df_output

