def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Relationship_with_newborn_good_or_very_good'] = df_input['Relationship with the newborn'].isin(['Good', 'Very good']).astype(int)
    df_output['Pregnancy_plan_yes'] = (df_input['Pregnancy plan'] == 'Yes').astype(int)
    df_output['History_of_pregnancy_loss_no'] = (df_input['History of pregnancy loss'] == 'No').astype(int)
    df_output['Received_Support_high'] = (df_input['Received Support'] == 'High').astype(int)
    df_output['Birth_compliancy_no'] = (df_input['Birth compliancy'] == 'No').astype(int)
    df_output['Marital_status_married'] = (df_input['Marital status'] == 'Married').astype(int)
    df_output['Family_type_nuclear_or_joint'] = df_input['Family type'].isin(['Nuclear', 'Joint']).astype(int)
    df_output['Husband_education_university_or_college'] = df_input["Husband's education level"].isin(['University', 'College']).astype(int)
    df_output['Diseases_during_pregnancy_no'] = (df_input['Diseases during pregnancy'] == 'No').astype(int)
    df_output['Age_of_immediate_older_children_in_list'] = df_input['Age of immediate older children'].isin(['No', '7yr to 12yr', '13yr or more']).astype(int)
    return df_output

