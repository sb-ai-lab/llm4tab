def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Mode_of_delivery_Normal_Delivery'] = (df_input['Mode of delivery'] == 'Normal Delivery').astype(int)
    df_output['Relationship_with_inlaws_Bad_Poor_Neutral'] = df_input['Relationship with the in-laws'].isin(['Bad', 'Poor', 'Neutral']).astype(int)
    df_output['Residence_Village'] = (df_input['Residence'] == 'Village').astype(int)
    df_output['Husband_monthly_income_Low'] = df_input['Husband’s monthly income'].isin(['No', 'Less than 5000', '5000 to 10000']).astype(int)
    df_output['Breastfeed_No'] = (df_input['Breastfeed'] == 'No').astype(int)
    df_output['Birth_compliancy_Yes'] = (df_input['Birth compliancy'] == 'Yes').astype(int)
    df_output['Total_children_One_Two'] = df_input['Total children'].isin(['One', 'Two']).astype(int)
    df_output['Occupation_After_Childbirth_Housewife_Other'] = df_input['Occupation After Your Latest Childbirth'].isin(['Housewife', 'Other', 'House wife']).astype(int)
    return df_output