def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'CRIMINAL DAMAGE', 'NARCOTICS', 'OTHER OFFENSE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['RETAIL THEFT', '$500 AND UNDER', 'TO PROPERTY', 'SIMPLE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['SMALL RETAIL STORE', 'OTHER (SPECIFY)', 'STREET', 'SCHOOL - PUBLIC BUILDING']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '14', '18']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1400) & (df_input['Beat'] <= 1800)).astype(int)
    df_output['District'] = ((df_input['District'] >= 10) & (df_input['District'] <= 20)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 30) & (df_input['Ward'] <= 40)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 10) & (df_input['Community Area'] <= 30)).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/20/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    return df_output

