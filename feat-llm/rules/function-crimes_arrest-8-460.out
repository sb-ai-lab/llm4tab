def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary_Type_Condition'] = df_input['Primary Type'].isin(['BATTERY', 'WEAPONS VIOLATION', 'ASSAULT', 'THEFT']).astype(int)
    desc_condition = df_input['Description'].isin(['AGGRAVATED - OTHER DANGEROUS WEAPON', 'UNLAWFUL POSSESSION - HANDGUN', 'RETAIL THEFT'])
    simple_with_arrest = (df_input['Description'] == 'SIMPLE') & (df_input['Arrest'] == True)
    df_output['Description_Condition'] = (desc_condition | simple_with_arrest).astype(int)
    df_output['Location_Description_Condition'] = df_input['Location Description'].isin(['DEPARTMENT STORE', 'APARTMENT', 'STREET']).astype(int)
    df_output['Domestic_Condition'] = df_input['Domestic'].isin([0,1]).astype(int)
    df_output['FBI_Code_Condition'] = df_input['FBI Code'].isin(['08B', '15', '04A', '06']).astype(int)
    beat_condition = df_input['Beat'].between(1000, 1900)
    district_condition = df_input['District'].isin([10, 12, 14, 18])
    df_output['Beat_District_Condition'] = (beat_condition & district_condition).astype(int)
    ward_condition = df_input['Ward'].between(1, 42)
    community_condition = df_input['Community Area'].between(8, 31)
    df_output['Ward_Community_Condition'] = (ward_condition & community_condition).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    date_condition = df_input['Date_parsed'].between(pd.to_datetime('01/10/2025'), pd.to_datetime('01/29/2025'))
    df_output['Date_Condition'] = date_condition.astype(int)
    lat_condition = df_input['Latitude'].between(41.85, 41.91)
    df_output['Latitude_Condition'] = lat_condition.astype(int)
    long_condition = df_input['Longitude'].between(-87.69, -87.62)
    df_output['Longitude_Condition'] = long_condition.astype(int)
    return df_output

