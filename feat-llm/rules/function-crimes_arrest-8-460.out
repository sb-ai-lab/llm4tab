def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'BATTERY', 'CRIMINAL DAMAGE']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['SIMPLE', '$500 AND UNDER', 'TO PROPERTY', 'RETAIL THEFT']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['SMALL RETAIL STORE', 'SCHOOL - PUBLIC BUILDING', 'OTHER (SPECIFY)']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['06', '08B', '14']).astype(int)
    df_output['Beat'] = ((df_input['Beat'] >= 1400) & (df_input['Beat'] <= 1800)).astype(int)
    df_output['District'] = df_input['District'].isin([14, 16, 5, 17]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([9, 32, 33, 45]).astype(int)
    df_output['Community Area'] = df_input['Community Area'].isin([10, 14, 24, 49]).astype(int)
    date_format = "%m/%d/%Y %I:%M:%S %p"
    start_date = pd.to_datetime("01/04/2025 10:00:00 PM", format=date_format)
    end_date = pd.to_datetime("01/29/2025 01:41:00 AM", format=date_format)
    dates = pd.to_datetime(df_input['Date'], format=date_format, errors='coerce')
    date_in_range = (dates >= start_date) & (dates <= end_date)
    aggravated_weapons = df_input['Description'].str.contains('AGGRAVATED|WEAPON', case=False, na=False)
    df_output['Date'] = (date_in_range & (~aggravated_weapons)).astype(int)
    return df_output

