def extracting_features_1(df_input):
    df_output = pd.DataFrame()
    df_output['Primary Type'] = df_input['Primary Type'].isin(['THEFT', 'ASSAULT', 'WEAPONS VIOLATION', 'BATTERY']).astype(int)
    df_output['Description'] = df_input['Description'].isin(['RETAIL THEFT', 'AGGRAVATED - OTHER DANGEROUS WEAPON', 'UNLAWFUL POSSESSION - HANDGUN', 'SIMPLE']).astype(int)
    df_output['Location Description'] = df_input['Location Description'].isin(['DEPARTMENT STORE', 'STREET', 'APARTMENT']).astype(int)
    df_output['Domestic'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI Code'] = df_input['FBI Code'].isin(['04A', '06', '08B', '15']).astype(int)
    df_output['Beat'] = (((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 1300)) | ((df_input['Beat'] >= 1800) & (df_input['Beat'] <= 1900))).astype(int)
    df_output['District'] = df_input['District'].isin([10, 12, 14, 18]).astype(int)
    df_output['Ward'] = df_input['Ward'].isin([1, 22, 25, 32, 42]).astype(int)
    df_output['Community Area'] = df_input['Community Area'].isin([8, 22, 30, 31]).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/21/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/29/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    return df_output

