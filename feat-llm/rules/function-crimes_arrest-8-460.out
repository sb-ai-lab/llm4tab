def extracting_features_0(df_input):
    df_output = pd.DataFrame()
    df_output['PrimaryType_Desc_Cond1'] = ((df_input['Primary Type'].isin(['THEFT', 'CRIMINAL DAMAGE', 'BATTERY'])) & 
                                           (df_input['Description'].isin(['SIMPLE', '$500 AND UNDER']))).astype(int)
    df_output['PrimaryType_Desc_Cond2'] = ((df_input['Primary Type'] == 'THEFT') & 
                                           (df_input['Description'] == 'RETAIL THEFT')).astype(int)
    df_output['Location_Cond'] = df_input['Location Description'].isin(['SCHOOL - PUBLIC BUILDING', 'SMALL RETAIL STORE', 'OTHER (SPECIFY)']).astype(int)
    df_output['Domestic_Cond'] = (df_input['Domestic'] == 0).astype(int)
    df_output['FBI_Code_Cond'] = df_input['FBI Code'].isin(['06', '14']).astype(int)
    df_output['Beat_District_Cond'] = ((df_input['Beat'] >= 1400) & (df_input['Beat'] <= 1800) & 
                                      (df_input['District'].isin([14,16,17]))).astype(int)
    df_output['Ward_CommArea_Cond'] = ((df_input['Ward'] >= 30) & (df_input['Ward'] <= 45) & 
                                      (df_input['Community Area'] >= 10) & (df_input['Community Area'] <= 24)).astype(int)
    df_input['Date_parsed'] = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/01/2025')
    end_date = pd.to_datetime('01/20/2025')
    df_output['Date_Cond'] = ((df_input['Date_parsed'] >= start_date) & (df_input['Date_parsed'] <= end_date)).astype(int)
    df_output['Latitude_Cond'] = ((df_input['Latitude'] >= 41.90) & (df_input['Latitude'] <= 42.00)).astype(int)
    df_output['Longitude_Cond'] = ((df_input['Longitude'] >= -87.80) & (df_input['Longitude'] <= -87.70)).astype(int)
    df_output.drop(columns=['Date_parsed'], inplace=True, errors='ignore')
    return df_output

