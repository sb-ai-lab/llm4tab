    df_output['Beat'] = ((df_input['Beat'] >= 1000) & (df_input['Beat'] <= 1300)).astype(int)
    df_output['District'] = ((df_input['District'] >= 10) & (df_input['District'] <= 18)).astype(int)
    df_output['Ward'] = ((df_input['Ward'] >= 20) & (df_input['Ward'] <= 45)).astype(int)
    df_output['Community Area'] = ((df_input['Community Area'] >= 8) & (df_input['Community Area'] <= 32)).astype(int)
    date_parsed = pd.to_datetime(df_input['Date'], format='%m/%d/%Y %I:%M:%S %p', errors='coerce')
    start_date = pd.to_datetime('01/12/2025 12:00:00 AM', format='%m/%d/%Y %I:%M:%S %p')
    end_date = pd.to_datetime('01/31/2025 11:59:59 PM', format='%m/%d/%Y %I:%M:%S %p')
    df_output['Date'] = ((date_parsed >= start_date) & (date_parsed <= end_date)).astype(int)
    return df_output

